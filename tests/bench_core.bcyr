# bench_core.bcyr -- agnoshi core benchmarks

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/process.cyr"

# Shared harness — pulled in for its agnsh.cyr / ui.cyr forward-ref stubs.
# The benchmarks don't use check()/report(); DCE prunes them from the binary.
include "tests/harness.cyr"

include "src/sanitize.cyr"
include "src/mode.cyr"
include "src/permissions.cyr"
include "src/intent.cyr"
include "src/commands.cyr"
include "src/translate.cyr"
include "src/interpreter.cyr"
include "src/history.cyr"
include "src/security.cyr"

var _interp = 0;
var _s_list = 0;
var _s_cd = 0;
var _s_find = 0;
var _s_git = 0;
var _s_shell = 0;
var _s_home = 0;
var _s_safepath = 0;
var _s_badpath = 0;
# history/add_at_cap — CommandHistory_add once the ring is AT max_size, which
# is the steady state for any real session (default cap 10000). The two
# alternating commands defeat the consecutive-duplicate dedup so every call
# takes the trim path; a 1000-entry cap keeps the benchmark quick while still
# showing the per-add cost of that path.
var _hist = 0;
var _hist_flip = 0;

fn work_history_add() {
    if (_hist_flip == 0) {
        CommandHistory_add(_hist, "git status --short");
        _hist_flip = 1;
    } else {
        CommandHistory_add(_hist, "ls -la /tmp");
        _hist_flip = 0;
    }
    return 0;
}
fn work_parse_list() { Interpreter_parse(_interp, _s_list); return 0; }
fn work_parse_cd() { Interpreter_parse(_interp, _s_cd); return 0; }
fn work_parse_find() { Interpreter_parse(_interp, _s_find); return 0; }
fn work_parse_git() { Interpreter_parse(_interp, _s_git); return 0; }
fn work_parse_shell() { Interpreter_parse(_interp, _s_shell); return 0; }

fn work_translate_list() {
    var intent = Intent_new(IntentTag.LIST_FILES);
    store64(intent + 40, 3);
    Interpreter_translate(_interp, intent);
    return 0;
}

fn work_translate_cd() {
    var intent = Intent_new(IntentTag.CHANGE_DIR);
    store64(intent + 8, _s_home);
    Interpreter_translate(_interp, intent);
    return 0;
}

fn work_perm() {
    var e = vec_new();
    analyze_command_permission("ls", e, 0);
    analyze_command_permission("/usr/bin/dd", e, 0);
    analyze_command_permission("apt", e, 0);
    analyze_command_permission("cp", e, 0);
    analyze_command_permission("cd", e, 0);
    return 0;
}

fn work_basename() {
    get_command_basename("/usr/bin/dd");
    get_command_basename("./rm");
    get_command_basename("ls");
    return 0;
}

fn work_safe_path() {
    is_safe_path(_s_safepath);
    is_safe_path(_s_badpath);
    return 0;
}

# security/context_new — the start-up work security_init adds to every host agnsh since 2.0.2: three id
# syscalls and the two sudo probes. The username is looked up on first use, so no /etc/passwd read.
fn work_security_ctx() { SecurityContext_new(0); return 0; }

var N = 10000;

fn main() {
    alloc_init();
    _interp = Interpreter_new();
    _s_list = str_from("show me all files");
    _s_cd = str_from("go to /home");
    _s_find = str_from("find files named foo");
    _s_git = str_from("git status");
    _s_shell = str_from("ls -la /tmp");
    _s_home = str_from("/home");
    _s_safepath = str_from("/home/user/file.txt");
    _s_badpath = str_from("../../../etc/shadow");
    # Non-existent path => CommandHistory_new skips the file-load branch.
    # Pre-fill to the cap so every benchmarked add exercises the trim path.
    _hist = CommandHistory_new("/nonexistent/agnsh-bench-history", 1000);
    for (var hi = 0; hi < 1000; hi = hi + 1) {
        if (hi % 2 == 0) { CommandHistory_add(_hist, "seed command alpha"); }
        else { CommandHistory_add(_hist, "seed command beta"); }
    }

    var all = vec_new();

    var b1 = bench_new("parse/list_files");
    bench_run(b1, &work_parse_list, N);
    vec_push(all, b1);

    var b2 = bench_new("parse/cd");
    bench_run(b2, &work_parse_cd, N);
    vec_push(all, b2);

    var b3 = bench_new("parse/find_files");
    bench_run(b3, &work_parse_find, N);
    vec_push(all, b3);

    var b4 = bench_new("parse/git_status");
    bench_run(b4, &work_parse_git, N);
    vec_push(all, b4);

    var b5 = bench_new("parse/shell_cmd");
    bench_run(b5, &work_parse_shell, N);
    vec_push(all, b5);

    var b6 = bench_new("translate/list_files");
    bench_run(b6, &work_translate_list, N);
    vec_push(all, b6);

    var b7 = bench_new("translate/cd");
    bench_run(b7, &work_translate_cd, N);
    vec_push(all, b7);

    var b8 = bench_new("perm/classify_5");
    bench_run(b8, &work_perm, N);
    vec_push(all, b8);

    var b9 = bench_new("sanitize/basename");
    bench_run(b9, &work_basename, N);
    vec_push(all, b9);

    var b10 = bench_new("sanitize/safe_path");
    bench_run(b10, &work_safe_path, N);
    vec_push(all, b10);

    var b11 = bench_new("history/add_at_cap");
    bench_run(b11, &work_history_add, N);
    vec_push(all, b11);

    var b12 = bench_new("security/context_new");
    bench_run(b12, &work_security_ctx, N);
    vec_push(all, b12);

    bench_report_all(all);
    return 0;
}
# Bare top-level call + SYS_EXIT — the canonical entry form (see CLAUDE.md § Cyrius).
fn _entry(): i64 { var rr = main(); syscall(SYS_EXIT, rr); return 0; }
_entry();
