# 1.9.3: run_agnos.cyr's pure command-line parsers now sit outside the
# CYRIUS_TARGET_AGNOS block, so a host build gets exactly those and nothing
# else. This is the first time the shell's untrusted-input parsers are
# reachable from the test suite.
include "src/run_agnos.cyr"
include "src/run_host.cyr"
include "src/security.cyr"
include "src/nlexec.cyr"

# Compose a SecurityContext (56 bytes — uid, gid, euid, username,
# is_root, restricted, sudo_available) by hand for the security tests
# so each gated state can be exercised independently of the runtime UID.
fn _mock_sec(is_root, restricted, sudo_available) {
    var p = alloc(56);
    store64(p, 1000);
    store64(p + 8, 1000);
    store64(p + 16, 1000);
    store64(p + 24, str_from("alice"));
    store64(p + 32, is_root);
    store64(p + 40, restricted);
    store64(p + 48, sudo_available);
    return p;
}

# Copy a cstring literal into a scratch buffer. The amp cases need a WRITABLE
# buffer so the "does not mutate" assertions are meaningful — asserting
# non-mutation of a read-only literal would prove nothing.
# Does `cstr` end with `suffix`? Test-local: the source has no suffix helper
# and adding one for a single assertion would be inventing API to satisfy a test.
fn _t_ends_with(cstr, suffix): i64 {
    var cl = strlen(cstr);
    var sl = strlen(suffix);
    if (sl > cl) { return 0; }
    var off = cl - sl;
    var i = 0;
    while (i < sl) {
        if (load8(cstr + off + i) != load8(suffix + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn _t_cpy(dst, src): i64 {
    var i = 0;
    while (load8(src + i) != 0) { store8(dst + i, load8(src + i)); i = i + 1; }
    store8(dst + i, 0);
    return 0;
}

# ================================================================
# 1.9.10 test seams
# ================================================================
# Three surfaces in this binary could not be asserted at all before this
# release, for three different structural reasons. Each gets the smallest seam
# that makes it assertable, and no more.
#
#  1. THE AUDIT WRITERS. audit_one_shot / audit_exec / audit_exec_ctx /
#     audit_exec_bg_done resolve their destination by calling audit_log_path()
#     internally (deliberately — see the comment in audit.cyr), so a test had no
#     file to read back and could not check what a record SAYS. Seam:
#     audit_path_override_set in statepaths.cyr, guarded by lint Category H.
#
#  2. THE STDIN READERS. verb_read_yes routes through read_line, which lives in
#     src/agnsh.cyr — a file a test binary cannot include, because it owns
#     `main` and calls `_entry()` at top level. Seam: the test binary supplies
#     its OWN read_line below. The forward reference sanitize.cyr already makes
#     resolves against it, so verb_read_yes and verb_confirm are exercised as
#     written, with scripted input instead of a terminal.
#
#  3. THE WRITERS TO fd 1 / fd 2. eprint_* / verb_out_* write to a fixed
#     descriptor. Seam: none in the source at all — the test dup2's the
#     descriptor at a scratch file and reads it back, which is strictly better
#     than a redirectable-fd global because the production code stays fixed.

var _t_cap_buf[8192];

# Substring search over a byte range (the captured buffers are not cstrings —
# an audit log holds NULs only by accident, but a captured stream may hold
# anything, so length is carried explicitly rather than inferred).
fn _t_mem_find(hay, haylen, needle): i64 {
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > haylen) { return 0; }
    var i = 0;
    while (i + nlen <= haylen) {
        var j = 0;
        while (j < nlen) {
            if (load8(hay + i + j) != load8(needle + j)) { j = nlen + 1; }
            else { j = j + 1; }
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _t_slurp(path): i64 {
    var n = file_read_all(path, &_t_cap_buf, 8191);
    if (n < 0) { n = 0; }
    store8(&_t_cap_buf + n, 0);
    return n;
}

# Does the file at `path` contain `needle`?
fn _t_file_has(path, needle): i64 {
    var n = _t_slurp(path);
    return _t_mem_find(&_t_cap_buf, n, needle);
}

fn _t_count_nl(path): i64 {
    var n = _t_slurp(path);
    var c = 0;
    var i = 0;
    while (i < n) {
        if (load8(&_t_cap_buf + i) == 10) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# How many times `needle` occurs in the file at `path` (its first 8191 bytes).
fn _t_count_in(path, needle): i64 {
    var n = _t_slurp(path);
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    var c = 0;
    var i = 0;
    while (i + nlen <= n) {
        if (_t_mem_find(&_t_cap_buf + i, nlen, needle) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Redirect `fd` at a truncated scratch file, saving the original into `savefd`.
# Returns the scratch fd, or -1. dup2 alone is enough for save-and-restore: no
# plain dup() is needed if the caller names a spare descriptor.
fn _t_capture_begin(fd, savefd, path): i64 {
    if (sys_dup2(fd, savefd) < 0) { return 0 - 1; }
    var out = file_open(path, OPEN_WRONLY | OPEN_CREAT | OPEN_TRUNC, 384);
    if (out < 0) { return 0 - 1; }
    sys_dup2(out, fd);
    file_close(out);
    return 0;
}

# Write a cstring to `path`, replacing whatever was there. Used to stage input
# for the readers that take fd 0 directly, and to build fixture files.
fn _t_write_cstr(path, cstr): i64 {
    var fd = file_open(path, OPEN_WRONLY | OPEN_CREAT | OPEN_TRUNC, 384);
    if (fd < 0) { return 0 - 1; }
    var n = strlen(cstr);
    if (n > 0) { file_write(fd, cstr, n); }
    file_close(fd);
    return n;
}

# Point fd 0 at `path`, saving the real stdin into `savefd`.
# ApprovalManager_request reads fd 0 with a raw SYS_READ rather than through
# read_line, so the scripted-stdin seam in harness.cyr cannot reach it.
fn _t_stdin_from(path, savefd): i64 {
    if (sys_dup2(0, savefd) < 0) { return 0 - 1; }
    var in_fd = file_open(path, 0, 0);
    if (in_fd < 0) { return 0 - 1; }
    sys_dup2(in_fd, 0);
    file_close(in_fd);
    return 0;
}

fn _t_stdin_restore(savefd): i64 {
    sys_dup2(savefd, 0);
    file_close(savefd);
    return 0;
}

fn _t_capture_end(fd, savefd): i64 {
    sys_dup2(savefd, fd);
    file_close(savefd);
    return 0;
}

fn main() {
    alloc_init();
    println("=== agnoshi core tests ===");
    check("mode display AUTO", streq(mode_display(Mode.AI_AUTONOMOUS), "AI-AUTO"));
    check("mode display ASSIST", streq(mode_display(Mode.AI_ASSISTED), "AI-ASSIST"));
    check("mode display HUMAN", streq(mode_display(Mode.HUMAN), "HUMAN"));
    check("mode display STRICT", streq(mode_display(Mode.STRICT), "STRICT"));

    check("autonomous yes", mode_ai_autonomous(Mode.AI_AUTONOMOUS) == 1);
    check("autonomous no", mode_ai_autonomous(Mode.HUMAN) == 0);

    check("available auto", mode_ai_available(Mode.AI_AUTONOMOUS) == 1);
    check("available human no", mode_ai_available(Mode.HUMAN) == 0);

    check("strict yes", mode_strict_approval(Mode.STRICT) == 1);
    check("strict no", mode_strict_approval(Mode.HUMAN) == 0);

    var mgr = ModeManager_new(Mode.HUMAN, 1);
    check("mgr initial", ModeManager_current(mgr) == Mode.HUMAN);

    var r = ModeManager_switch(mgr, Mode.AI_ASSISTED);
    check("switch ok", r == 0);
    check("switched", ModeManager_current(mgr) == Mode.AI_ASSISTED);

    r = ModeManager_revert(mgr);
    check("revert ok", r == 0);
    check("reverted", ModeManager_current(mgr) == Mode.HUMAN);

    r = ModeManager_revert(mgr);
    check("revert none", r == (0 - 1));

    var mgr2 = ModeManager_new(Mode.HUMAN, 0);
    r = ModeManager_switch(mgr2, Mode.AI_ASSISTED);
    check("disabled switch fails", r == (0 - 1));
    check("disabled unchanged", ModeManager_current(mgr2) == Mode.HUMAN);

    check("perm safe no approve", perm_requires_approval(PermissionLevel.SAFE) == 0);
    check("perm read no approve", perm_requires_approval(PermissionLevel.READ_ONLY) == 0);
    check("perm sys approve", perm_requires_approval(PermissionLevel.SYSTEM_WRITE) == 1);
    check("perm admin approve", perm_requires_approval(PermissionLevel.ADMIN) == 1);
    check("perm blocked approve", perm_requires_approval(PermissionLevel.BLOCKED) == 1);

    check("ai allows safe", perm_ai_allowed(PermissionLevel.SAFE) == 1);
    check("ai blocks blocked", perm_ai_allowed(PermissionLevel.BLOCKED) == 0);

    check("root safe", check_permission("root", PermissionLevel.SAFE) == 1);
    check("root admin", check_permission("root", PermissionLevel.ADMIN) == 1);
    check("user safe", check_permission("user", PermissionLevel.SAFE) == 1);
    check("user admin no", check_permission("user", PermissionLevel.ADMIN) == 0);
    check("user blocked no", check_permission("user", PermissionLevel.BLOCKED) == 0);

    var empty = vec_new();
    check("classify ls", analyze_command_permission("ls", empty, 0) == PermissionLevel.READ_ONLY);
    check("classify cat", analyze_command_permission("cat", empty, 0) == PermissionLevel.READ_ONLY);
    check("classify cd", analyze_command_permission("cd", empty, 0) == PermissionLevel.SAFE);
    check("classify cp", analyze_command_permission("cp", empty, 0) == PermissionLevel.USER_WRITE);
    check("classify apt", analyze_command_permission("apt", empty, 0) == PermissionLevel.ADMIN);
    check("classify dd", analyze_command_permission("dd", empty, 0) == PermissionLevel.BLOCKED);
    check("classify chmod", analyze_command_permission("chmod", empty, 0) == PermissionLevel.BLOCKED);

    check("classify absolute dd", analyze_command_permission("/usr/bin/dd", empty, 0) == PermissionLevel.BLOCKED);
    check("classify relative rm", analyze_command_permission("./chmod", empty, 0) == PermissionLevel.BLOCKED);

    var config = ShellConfig_default();
    check("config mode", load64(config) == Mode.AI_ASSISTED);
    # ⛔ This asserted `== 10000` until 1.9.10 — and passed, because the value
    # it locked in was the one nothing used. The interactive loop hardcoded
    # 1000, config.cyr declared 10000, and config.cyr is not in the binary's
    # include graph, so the documented figure was never in force. Asserting the
    # CONSTANT rather than a literal is the point: if the two ever drift apart
    # again, this test cannot silently agree with the wrong one.
    check("config history == HISTORY_MAX_ENTRIES",
      load64(config + 8) == HISTORY_MAX_ENTRIES);
    check("HISTORY_MAX_ENTRIES is the live cap", HISTORY_MAX_ENTRIES == 1000);
    check("config ai", load64(config + 16) == 1);
    check("config approval", load64(config + 32) == 300);

    # The table must describe the LIVE interactive loop in agnsh.cyr. Before
    # 1.9.1 it claimed `cd` and `undo` (neither implemented in the shipped
    # binary) and omitted `version` and `run` (both real arms), and this test
    # locked the wrong answer in by asserting `cd`.
    check("builtin exit", is_builtin("exit") == 1);
    check("builtin help", is_builtin("help") == 1);
    check("builtin mode", is_builtin("mode") == 1);
    check("builtin version", is_builtin("version") == 1);
    check("builtin run", is_builtin("run") == 1);
    check("not builtin ls", is_builtin("ls") == 0);
    check("not builtin git", is_builtin("git") == 0);
    # cd / undo live in the non-compiled session.cyr + checkpoint.cyr. They must
    # NOT be advertised until those modules are actually wired in.
    check("cd not yet a builtin", is_builtin("cd") == 0);
    check("undo not yet a builtin", is_builtin("undo") == 0);

    var intent = Intent_new(IntentTag.LIST_FILES);
    check("intent tag", load64(intent) == IntentTag.LIST_FILES);
    check("intent field1 zero", load64(intent + 8) == 0);

    var opts = list_options_pack(1, 1, 0, 0, 1);
    check("opts all", list_options_all(opts) == 1);
    check("opts long", list_options_long(opts) == 1);
    check("opts human", list_options_human(opts) == 0);
    check("opts recursive", list_options_recursive(opts) == 1);

    var targs = vec_new();
    vec_push(targs, "-la");
    var t = Translation_new("ls", targs, "List files", PermissionLevel.READ_ONLY, "ls");
    check("translation cmd", streq(load64(t), "ls") == 1);
    check("translation perm", load64(t + 24) == PermissionLevel.READ_ONLY);

    var interp = Interpreter_new();
    var pe = Interpreter_parse(interp, str_from(""));
    var pe_tag = load64(pe);
    check("parse empty unknown", pe_tag == IntentTag.UNKNOWN);
    var p_show = Interpreter_parse(interp, str_from("show me all files"));
    check("parse show files", load64(p_show) == IntentTag.LIST_FILES);
    var p_list = Interpreter_parse(interp, str_from("list the directory"));
    check("parse list directory", load64(p_list) == IntentTag.LIST_FILES);
    check("parse cd",
      load64(Interpreter_parse(interp, str_from("cd /tmp"))) == IntentTag.CHANGE_DIR);
    check("parse go to",
      load64(Interpreter_parse(interp, str_from("go to /home"))) == IntentTag.CHANGE_DIR);
    check("parse find named",
      load64(Interpreter_parse(interp, str_from("find files named foo in /tmp"))) == IntentTag.FIND_FILES);
    check("parse search content",
      load64(Interpreter_parse(interp, str_from("search for hello in /tmp"))) == IntentTag.SEARCH_CONTENT);
    check("parse create dir",
      load64(Interpreter_parse(interp, str_from("create a directory named foo"))) == IntentTag.CREATE_DIR);
    check("parse remove",
      load64(Interpreter_parse(interp, str_from("remove the file foo.txt"))) == IntentTag.REMOVE);
    check("parse install",
      load64(Interpreter_parse(interp, str_from("install vim"))) == IntentTag.INSTALL_PACKAGE);
    check("parse git status",
      load64(Interpreter_parse(interp, str_from("git status"))) == IntentTag.GIT_STATUS);
    check("parse git commit",
      load64(Interpreter_parse(interp, str_from("git commit -m hello"))) == IntentTag.GIT_COMMIT);
    check("parse firewall list",
      load64(Interpreter_parse(interp, str_from("firewall list rules"))) == IntentTag.FIREWALL_LIST);
    check("parse pipeline",
      load64(Interpreter_parse(interp, str_from("ls | grep foo"))) == IntentTag.PIPELINE);

    check("query ip address NETWORK",
      load64(Interpreter_parse(interp, str_from("what is my ip address"))) == IntentTag.NETWORK_INFO);
    check("query my ip NETWORK",
      load64(Interpreter_parse(interp, str_from("my ip"))) == IntentTag.NETWORK_INFO);
    check("query ip route NETWORK",
      load64(Interpreter_parse(interp, str_from("ip route table"))) == IntentTag.NETWORK_INFO);
    check("query uptime SYSTEM",
      load64(Interpreter_parse(interp, str_from("uptime"))) == IntentTag.SYSTEM_INFO);
    check("query load avg SYSTEM",
      load64(Interpreter_parse(interp, str_from("load average"))) == IntentTag.SYSTEM_INFO);
    check("query kernel version SYSTEM",
      load64(Interpreter_parse(interp, str_from("kernel version"))) == IntentTag.SYSTEM_INFO);
    check("query memory usage MEMORY",
      load64(Interpreter_parse(interp, str_from("memory usage"))) == IntentTag.MEMORY_INFO);
    check("query disk space DISK",
      load64(Interpreter_parse(interp, str_from("disk space"))) == IntentTag.DISK_USAGE);
    check("query free space DISK",
      load64(Interpreter_parse(interp, str_from("free space"))) == IntentTag.DISK_USAGE);
    check("query how full DISK",
      load64(Interpreter_parse(interp, str_from("how full is the disk"))) == IntentTag.DISK_USAGE);
    check("query running process PROC",
      load64(Interpreter_parse(interp, str_from("running processes"))) == IntentTag.SHOW_PROCESSES);
    check("query whats running PROC",
      load64(Interpreter_parse(interp, str_from("what is running"))) == IntentTag.SHOW_PROCESSES);
    check("query active process PROC",
      load64(Interpreter_parse(interp, str_from("active processes"))) == IntentTag.SHOW_PROCESSES);

    check("question what generic falls QUESTION",
      load64(Interpreter_parse(interp, str_from("what year is it"))) == IntentTag.QUESTION);
    check("question how generic falls QUESTION",
      load64(Interpreter_parse(interp, str_from("how does dns work"))) == IntentTag.QUESTION);
    check("question explain generic falls QUESTION",
      load64(Interpreter_parse(interp, str_from("explain unix sockets"))) == IntentTag.QUESTION);

    check("shell fallback raw",
      load64(Interpreter_parse(interp, str_from("foo bar baz"))) == IntentTag.SHELL_COMMAND);

    # Substring-trap immunity: "remove" must NOT route to MOVE (today's
    # input_has_word is word-prefix, not substring containment, so the
    # embedded "move" inside "remove" is invisible to the MOVE check).
    check("remove file routes to REMOVE",
      load64(Interpreter_parse(interp, str_from("remove the file foo.txt"))) == IntentTag.REMOVE);
    check("rm at token start routes to REMOVE",
      load64(Interpreter_parse(interp, str_from("rm foo.txt"))) == IntentTag.REMOVE);
    check("delete routes to REMOVE",
      load64(Interpreter_parse(interp, str_from("delete the temp dir"))) == IntentTag.REMOVE);
    check("move actual routes to MOVE",
      load64(Interpreter_parse(interp, str_from("move foo to bar"))) == IntentTag.MOVE);
    check("rename routes to MOVE",
      load64(Interpreter_parse(interp, str_from("rename foo to bar"))) == IntentTag.MOVE);
    # Plural-tolerance: "file" needle must still match "files", "process"
    # must match "processes". Word-prefix matching gives us this for free.
    check("plural files via show",
      load64(Interpreter_parse(interp, str_from("show me the files"))) == IntentTag.LIST_FILES);
    check("plural processes via state-query",
      load64(Interpreter_parse(interp, str_from("running processes"))) == IntentTag.SHOW_PROCESSES);
    check("plural directories via show",
      load64(Interpreter_parse(interp, str_from("show me the directories"))) == IntentTag.LIST_FILES);

    # Service-status NL — "is X running"/"active"/"enabled" + "status of X"
    # all map to SERVICE_CONTROL with action="status" and target=X.
    check("is X running routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("is nginx running"))) == IntentTag.SERVICE_CONTROL);
    check("is X active routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("is sshd active"))) == IntentTag.SERVICE_CONTROL);
    check("is X enabled routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("is cronie enabled"))) == IntentTag.SERVICE_CONTROL);
    check("status of X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("status of nginx"))) == IntentTag.SERVICE_CONTROL);
    # Verify target extraction populates field2 (intent + 16).
    var svc_intent = Interpreter_parse(interp, str_from("is nginx running"));
    check("is X running extracts target",
      load64(svc_intent + 16) != 0);
    # Negative: a statement like "the application is running" must NOT
    # route to SERVICE_CONTROL (no "is " prefix).
    check("statement falls through service-query gate",
      load64(Interpreter_parse(interp, str_from("the application is running"))) != IntentTag.SERVICE_CONTROL);

    # Imperative service actions — "start nginx" / "stop sshd" / etc. all
    # map to SERVICE_CONTROL. Gated on exactly two tokens.
    check("start X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("start nginx"))) == IntentTag.SERVICE_CONTROL);
    check("stop X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("stop sshd"))) == IntentTag.SERVICE_CONTROL);
    check("restart X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("restart cron"))) == IntentTag.SERVICE_CONTROL);
    check("reload X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("reload nginx"))) == IntentTag.SERVICE_CONTROL);
    check("enable X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("enable cron"))) == IntentTag.SERVICE_CONTROL);
    check("disable X routes to SERVICE_CONTROL",
      load64(Interpreter_parse(interp, str_from("disable apache"))) == IntentTag.SERVICE_CONTROL);
    # Negative: multi-token NL ("start a new project") falls through —
    # the 2-token gate keeps statements from getting hijacked.
    check("start multi-word falls through",
      load64(Interpreter_parse(interp, str_from("start a new project"))) != IntentTag.SERVICE_CONTROL);
    # Negative: "enable firewall" must keep routing to FIREWALL_ENABLE via
    # parse_admin_ops (which runs before parse_service_action).
    check("enable firewall stays FIREWALL_ENABLE",
      load64(Interpreter_parse(interp, str_from("enable firewall"))) == IntentTag.FIREWALL_ENABLE);
    check("disable ufw stays FIREWALL_DISABLE",
      load64(Interpreter_parse(interp, str_from("disable ufw"))) == IntentTag.FIREWALL_DISABLE);

    # Translator coverage — slice 5: core filesystem + process + system.
    # Verifies each translate_X populates the right command name, the
    # right permission level, and (where applicable) the safety-check
    # fallback to translate_unknown when its input is unsafe or missing.

    # translate_list_files — opts pack: long+all → "-l", "-a"
    var lf_intent = Intent_new(IntentTag.LIST_FILES);
    store64(lf_intent + 8, str_from("/tmp"));
    store64(lf_intent + 40, list_options_pack(1, 1, 0, 0, 0));
    var lf_t = translate_list_files(lf_intent);
    check("translate_list_files cmd", streq(load64(lf_t), "ls") == 1);
    check("translate_list_files perm", load64(lf_t + 24) == PermissionLevel.READ_ONLY);
    check("translate_list_files args has 3", vec_len(load64(lf_t + 8)) == 3);

    # translate_show_file — happy path
    var sf_intent = Intent_new(IntentTag.SHOW_FILE);
    store64(sf_intent + 8, str_from("/tmp/foo.txt"));
    var sf_t = translate_show_file(sf_intent);
    check("translate_show_file cmd", streq(load64(sf_t), "cat") == 1);
    check("translate_show_file perm", load64(sf_t + 24) == PermissionLevel.READ_ONLY);
    # translate_show_file — unsafe path falls to translate_unknown
    var sf_bad = Intent_new(IntentTag.SHOW_FILE);
    store64(sf_bad + 8, str_from("../etc/passwd"));
    var sf_bt = translate_show_file(sf_bad);
    check("translate_show_file unsafe → unknown",
      streq(load64(sf_bt), "echo") == 1);
    # translate_show_file — null path also falls
    var sf_null = Intent_new(IntentTag.SHOW_FILE);
    var sf_nt = translate_show_file(sf_null);
    check("translate_show_file null → unknown",
      streq(load64(sf_nt), "echo") == 1);

    # translate_find_files
    var ff_intent = Intent_new(IntentTag.FIND_FILES);
    store64(ff_intent + 8, str_from("foo.txt"));
    store64(ff_intent + 16, str_from("/tmp"));
    var ff_t = translate_find_files(ff_intent);
    check("translate_find_files cmd", streq(load64(ff_t), "find") == 1);
    check("translate_find_files perm", load64(ff_t + 24) == PermissionLevel.READ_ONLY);

    # translate_search_content
    var sc_intent = Intent_new(IntentTag.SEARCH_CONTENT);
    store64(sc_intent + 8, str_from("hello"));
    store64(sc_intent + 16, str_from("/tmp"));
    var sc_t = translate_search_content(sc_intent);
    check("translate_search_content cmd", streq(load64(sc_t), "grep") == 1);
    check("translate_search_content perm", load64(sc_t + 24) == PermissionLevel.READ_ONLY);

    # translate_change_dir — happy path + null fallback
    var cd_intent = Intent_new(IntentTag.CHANGE_DIR);
    store64(cd_intent + 8, str_from("/home"));
    var cd_t = translate_change_dir(cd_intent);
    check("translate_change_dir cmd", streq(load64(cd_t), "cd") == 1);
    check("translate_change_dir perm", load64(cd_t + 24) == PermissionLevel.SAFE);
    var cd_null = Intent_new(IntentTag.CHANGE_DIR);
    var cd_nt = translate_change_dir(cd_null);
    check("translate_change_dir null → unknown",
      streq(load64(cd_nt), "echo") == 1);

    # translate_create_dir
    var mkd_intent = Intent_new(IntentTag.CREATE_DIR);
    store64(mkd_intent + 8, str_from("/tmp/newdir"));
    var mkd_t = translate_create_dir(mkd_intent);
    check("translate_create_dir cmd", streq(load64(mkd_t), "mkdir") == 1);
    check("translate_create_dir perm", load64(mkd_t + 24) == PermissionLevel.USER_WRITE);

    # translate_copy — both paths set
    var cp_intent = Intent_new(IntentTag.COPY);
    store64(cp_intent + 8, str_from("/tmp/src"));
    store64(cp_intent + 16, str_from("/tmp/dst"));
    var cp_t = translate_copy(cp_intent);
    check("translate_copy cmd", streq(load64(cp_t), "cp") == 1);
    check("translate_copy perm", load64(cp_t + 24) == PermissionLevel.USER_WRITE);
    # translate_copy — missing destination falls to unknown
    var cp_miss = Intent_new(IntentTag.COPY);
    store64(cp_miss + 8, str_from("/tmp/src"));
    var cp_mt = translate_copy(cp_miss);
    check("translate_copy missing dst → unknown",
      streq(load64(cp_mt), "echo") == 1);

    # translate_move
    var mv_intent = Intent_new(IntentTag.MOVE);
    store64(mv_intent + 8, str_from("/tmp/from"));
    store64(mv_intent + 16, str_from("/tmp/to"));
    var mv_t = translate_move(mv_intent);
    check("translate_move cmd", streq(load64(mv_t), "mv") == 1);
    check("translate_move perm", load64(mv_t + 24) == PermissionLevel.USER_WRITE);

    # translate_remove — BLOCKED permission level (caller must approve)
    var rm_intent = Intent_new(IntentTag.REMOVE);
    store64(rm_intent + 8, str_from("/tmp/foo"));
    var rm_t = translate_remove(rm_intent);
    check("translate_remove cmd", streq(load64(rm_t), "rm") == 1);
    check("translate_remove perm BLOCKED", load64(rm_t + 24) == PermissionLevel.BLOCKED);
    # translate_remove with recursive flag set
    var rm_r = Intent_new(IntentTag.REMOVE);
    store64(rm_r + 8, str_from("/tmp/dir"));
    store64(rm_r + 40, 1);
    var rm_rt = translate_remove(rm_r);
    check("translate_remove recursive args has -r and path",
      vec_len(load64(rm_rt + 8)) == 2);

    # translate_show_processes — no fields needed
    var ps_t = translate_show_processes(Intent_new(IntentTag.SHOW_PROCESSES));
    check("translate_show_processes cmd", streq(load64(ps_t), "ps") == 1);
    check("translate_show_processes perm", load64(ps_t + 24) == PermissionLevel.READ_ONLY);

    # translate_kill_process — valid pid
    var kp_intent = Intent_new(IntentTag.KILL_PROCESS);
    store64(kp_intent + 40, 1234);
    var kp_t = translate_kill_process(kp_intent);
    check("translate_kill_process cmd", streq(load64(kp_t), "kill") == 1);
    check("translate_kill_process perm ADMIN", load64(kp_t + 24) == PermissionLevel.ADMIN);
    # translate_kill_process — invalid pid (0) falls to unknown
    var kp_bad = Intent_new(IntentTag.KILL_PROCESS);
    var kp_bt = translate_kill_process(kp_bad);
    check("translate_kill_process pid=0 → unknown",
      streq(load64(kp_bt), "echo") == 1);

    # translate_system_info
    var si_t = translate_system_info(Intent_new(IntentTag.SYSTEM_INFO));
    check("translate_system_info cmd", streq(load64(si_t), "uname") == 1);
    check("translate_system_info perm", load64(si_t + 24) == PermissionLevel.READ_ONLY);

    # translate_network_info
    var ni_t = translate_network_info(Intent_new(IntentTag.NETWORK_INFO));
    check("translate_network_info cmd", streq(load64(ni_t), "ip") == 1);
    check("translate_network_info perm", load64(ni_t + 24) == PermissionLevel.READ_ONLY);

    # translate_disk_usage
    var du_t = translate_disk_usage(Intent_new(IntentTag.DISK_USAGE));
    check("translate_disk_usage cmd", streq(load64(du_t), "df") == 1);
    check("translate_disk_usage perm", load64(du_t + 24) == PermissionLevel.READ_ONLY);

    # translate_memory_info — the answer to a memory question must BE about
    # memory. Asserted next to translate_disk_usage on purpose: these two were
    # the pair that crossed.
    var mi_t = translate_memory_info(Intent_new(IntentTag.MEMORY_INFO));
    check("translate_memory_info cmd", streq(load64(mi_t), "free") == 1);
    check("translate_memory_info perm", load64(mi_t + 24) == PermissionLevel.READ_ONLY);
    check("translate_memory_info is not df", streq(load64(mi_t), "df") == 0);
    check("translate_memory_info is not uname", streq(load64(mi_t), "uname") == 0);

    # ⚠ Dispatch reachability. Interpreter_translate routes extended tags
    # through a bounded range; a tag added above that bound parses correctly and
    # then translates to `echo`, silently. Going through Interpreter_translate
    # (not translate_memory_info directly) is what makes this test load-bearing.
    var mi_disp = Interpreter_translate(Interpreter_new(), Intent_new(IntentTag.MEMORY_INFO));
    check("MEMORY_INFO is reachable through the dispatch",
      streq(load64(mi_disp), "free") == 1);

    # translate_install_package — needs a packages vec at intent + 56
    var ip_intent = Intent_new(IntentTag.INSTALL_PACKAGE);
    var ip_pkgs = vec_new();
    vec_push(ip_pkgs, str_from("vim"));     # a Str, as extract_after produces (2.0.0: args are read)
    store64(ip_intent + 56, ip_pkgs);
    var ip_t = translate_install_package(ip_intent);
    check("translate_install_package cmd", streq(load64(ip_t), "apt") == 1);
    check("translate_install_package perm ADMIN", load64(ip_t + 24) == PermissionLevel.ADMIN);

    # translate_shell_command — permission derived from analyze_command_permission
    var sh_intent = Intent_new(IntentTag.SHELL_COMMAND);
    store64(sh_intent + 8, "ls");
    var sh_args = vec_new();
    store64(sh_intent + 56, sh_args);
    var sh_t = translate_shell_command(sh_intent);
    check("translate_shell_command cmd ls", streq(load64(sh_t), "ls") == 1);
    check("translate_shell_command perm READ_ONLY", load64(sh_t + 24) == PermissionLevel.READ_ONLY);
    # SHELL_COMMAND with admin command picks up ADMIN classification
    var sh_admin = Intent_new(IntentTag.SHELL_COMMAND);
    store64(sh_admin + 8, "apt");
    store64(sh_admin + 56, vec_new());
    var sh_at = translate_shell_command(sh_admin);
    check("translate_shell_command apt → ADMIN",
      load64(sh_at + 24) == PermissionLevel.ADMIN);

    # Translator coverage — slice 6: git (10 translators). All emit
    # command="git" with the operation name as the first arg. Permission
    # is READ_ONLY for status/diff/log, USER_WRITE for everything that
    # mutates the repo or remote.

    # translate_git_commit — happy path with safe message
    var gc_intent = Intent_new(IntentTag.GIT_COMMIT);
    store64(gc_intent + 8, str_from("wip: refactor"));
    var gc_t = translate_git_commit(gc_intent);
    check("translate_git_commit cmd", streq(load64(gc_t), "git") == 1);
    check("translate_git_commit perm", load64(gc_t + 24) == PermissionLevel.USER_WRITE);
    # translate_git_commit — -a flag set
    var gc_a = Intent_new(IntentTag.GIT_COMMIT);
    store64(gc_a + 8, str_from("fix bug"));
    store64(gc_a + 40, 1);
    var gc_at = translate_git_commit(gc_a);
    check("translate_git_commit -a adds flag",
      vec_len(load64(gc_at + 8)) == 4);
    # translate_git_commit — unsafe message (leading dash) falls to unknown.
    # Locks `is_safe_commit_message`'s reject-leading-dash rule that closed
    # the v1.0 security audit H7 finding (argument injection).
    var gc_bad = Intent_new(IntentTag.GIT_COMMIT);
    store64(gc_bad + 8, str_from("-rf evil"));
    var gc_bt = translate_git_commit(gc_bad);
    check("translate_git_commit leading-dash → unknown",
      streq(load64(gc_bt), "echo") == 1);

    # translate_git_diff
    var gd_intent = Intent_new(IntentTag.GIT_DIFF);
    var gd_t = translate_git_diff(gd_intent);
    check("translate_git_diff cmd", streq(load64(gd_t), "git") == 1);
    check("translate_git_diff perm READ_ONLY", load64(gd_t + 24) == PermissionLevel.READ_ONLY);
    # --staged flag
    var gd_st = Intent_new(IntentTag.GIT_DIFF);
    store64(gd_st + 40, 1);
    var gd_stt = translate_git_diff(gd_st);
    check("translate_git_diff --staged adds flag",
      vec_len(load64(gd_stt + 8)) == 2);

    # translate_git_branch
    var gb_intent = Intent_new(IntentTag.GIT_BRANCH);
    store64(gb_intent + 8, str_from("feature-x"));
    var gb_t = translate_git_branch(gb_intent);
    check("translate_git_branch cmd", streq(load64(gb_t), "git") == 1);
    check("translate_git_branch perm", load64(gb_t + 24) == PermissionLevel.USER_WRITE);
    # -d delete flag
    var gb_del = Intent_new(IntentTag.GIT_BRANCH);
    store64(gb_del + 8, str_from("stale"));
    store64(gb_del + 40, 1);
    var gb_dt = translate_git_branch(gb_del);
    check("translate_git_branch -d adds flag",
      vec_len(load64(gb_dt + 8)) == 3);

    # translate_git_status
    var gs_t = translate_git_status(Intent_new(IntentTag.GIT_STATUS));
    check("translate_git_status cmd", streq(load64(gs_t), "git") == 1);
    check("translate_git_status perm READ_ONLY", load64(gs_t + 24) == PermissionLevel.READ_ONLY);

    # translate_git_log
    var gl_t = translate_git_log(Intent_new(IntentTag.GIT_LOG));
    check("translate_git_log cmd", streq(load64(gl_t), "git") == 1);
    check("translate_git_log perm READ_ONLY", load64(gl_t + 24) == PermissionLevel.READ_ONLY);
    # log carries --oneline + -20
    check("translate_git_log args=3", vec_len(load64(gl_t + 8)) == 3);

    # translate_git_push
    var gp_t = translate_git_push(Intent_new(IntentTag.GIT_PUSH));
    check("translate_git_push cmd", streq(load64(gp_t), "git") == 1);
    check("translate_git_push perm USER_WRITE", load64(gp_t + 24) == PermissionLevel.USER_WRITE);

    # translate_git_pull
    var gpl_t = translate_git_pull(Intent_new(IntentTag.GIT_PULL));
    check("translate_git_pull cmd", streq(load64(gpl_t), "git") == 1);
    check("translate_git_pull perm USER_WRITE", load64(gpl_t + 24) == PermissionLevel.USER_WRITE);

    # translate_git_checkout
    var gco_intent = Intent_new(IntentTag.GIT_CHECKOUT);
    store64(gco_intent + 8, str_from("main"));
    var gco_t = translate_git_checkout(gco_intent);
    check("translate_git_checkout cmd", streq(load64(gco_t), "git") == 1);
    check("translate_git_checkout perm", load64(gco_t + 24) == PermissionLevel.USER_WRITE);

    # translate_git_merge
    var gm_intent = Intent_new(IntentTag.GIT_MERGE);
    store64(gm_intent + 8, str_from("feature-x"));
    var gm_t = translate_git_merge(gm_intent);
    check("translate_git_merge cmd", streq(load64(gm_t), "git") == 1);
    check("translate_git_merge perm", load64(gm_t + 24) == PermissionLevel.USER_WRITE);

    # translate_git_stash
    var gst_intent = Intent_new(IntentTag.GIT_STASH);
    store64(gst_intent + 8, str_from("pop"));
    var gst_t = translate_git_stash(gst_intent);
    check("translate_git_stash cmd", streq(load64(gst_t), "git") == 1);
    check("translate_git_stash perm", load64(gst_t + 24) == PermissionLevel.USER_WRITE);

    # Translator coverage — slice 7: user/group + firewall + remaining.
    # All admin-class operations (every user/group write, every firewall
    # mutation) land at ADMIN permission so the approval workflow gates
    # them. The two query-shape branches (firewall_list/status,
    # group_list) sit at READ_ONLY.

    # translate_user_add
    var ua_intent = Intent_new(IntentTag.USER_ADD);
    store64(ua_intent + 8, str_from("alice"));
    var ua_t = translate_user_add(ua_intent);
    check("translate_user_add cmd", streq(load64(ua_t), "useradd") == 1);
    check("translate_user_add perm ADMIN", load64(ua_t + 24) == PermissionLevel.ADMIN);

    # translate_user_delete
    var ud_intent = Intent_new(IntentTag.USER_DELETE);
    store64(ud_intent + 8, str_from("alice"));
    var ud_t = translate_user_delete(ud_intent);
    check("translate_user_delete cmd", streq(load64(ud_t), "userdel") == 1);
    check("translate_user_delete perm ADMIN", load64(ud_t + 24) == PermissionLevel.ADMIN);

    # translate_passwd
    var pw_intent = Intent_new(IntentTag.PASSWD);
    store64(pw_intent + 8, str_from("alice"));
    var pw_t = translate_passwd(pw_intent);
    check("translate_passwd cmd", streq(load64(pw_t), "passwd") == 1);
    check("translate_passwd perm ADMIN", load64(pw_t + 24) == PermissionLevel.ADMIN);

    # translate_group_add
    var ga_intent = Intent_new(IntentTag.GROUP_ADD);
    store64(ga_intent + 8, str_from("devs"));
    var ga_t = translate_group_add(ga_intent);
    check("translate_group_add cmd", streq(load64(ga_t), "groupadd") == 1);
    check("translate_group_add perm ADMIN", load64(ga_t + 24) == PermissionLevel.ADMIN);

    # translate_group_list — query, READ_ONLY
    var gli_t = translate_group_list(Intent_new(IntentTag.GROUP_LIST));
    check("translate_group_list cmd", streq(load64(gli_t), "groups") == 1);
    check("translate_group_list perm READ_ONLY", load64(gli_t + 24) == PermissionLevel.READ_ONLY);

    # translate_firewall_allow — mutating, ADMIN
    var fa_intent = Intent_new(IntentTag.FIREWALL_ALLOW);
    store64(fa_intent + 8, str_from("8080"));
    var fa_t = translate_firewall_allow(fa_intent);
    check("translate_firewall_allow cmd", streq(load64(fa_t), "ufw") == 1);
    check("translate_firewall_allow perm ADMIN", load64(fa_t + 24) == PermissionLevel.ADMIN);

    # translate_firewall_deny
    var fd_intent = Intent_new(IntentTag.FIREWALL_DENY);
    store64(fd_intent + 8, str_from("23"));
    var fd_t = translate_firewall_deny(fd_intent);
    check("translate_firewall_deny cmd", streq(load64(fd_t), "ufw") == 1);
    check("translate_firewall_deny perm ADMIN", load64(fd_t + 24) == PermissionLevel.ADMIN);

    # translate_firewall_list — query, READ_ONLY
    var fli_t = translate_firewall_list(Intent_new(IntentTag.FIREWALL_LIST));
    check("translate_firewall_list cmd", streq(load64(fli_t), "ufw") == 1);
    check("translate_firewall_list perm READ_ONLY", load64(fli_t + 24) == PermissionLevel.READ_ONLY);

    # translate_firewall_status — query, READ_ONLY
    var fst_t = translate_firewall_status(Intent_new(IntentTag.FIREWALL_STATUS));
    check("translate_firewall_status cmd", streq(load64(fst_t), "ufw") == 1);
    check("translate_firewall_status perm READ_ONLY", load64(fst_t + 24) == PermissionLevel.READ_ONLY);

    # translate_firewall_enable / disable — both ADMIN
    var fen_t = translate_firewall_enable(Intent_new(IntentTag.FIREWALL_ENABLE));
    check("translate_firewall_enable cmd", streq(load64(fen_t), "ufw") == 1);
    check("translate_firewall_enable perm ADMIN", load64(fen_t + 24) == PermissionLevel.ADMIN);
    var fdi_t = translate_firewall_disable(Intent_new(IntentTag.FIREWALL_DISABLE));
    check("translate_firewall_disable cmd", streq(load64(fdi_t), "ufw") == 1);
    check("translate_firewall_disable perm ADMIN", load64(fdi_t + 24) == PermissionLevel.ADMIN);

    # translate_firewall_delete
    var fde_intent = Intent_new(IntentTag.FIREWALL_DELETE);
    store64(fde_intent + 8, str_from("8080"));
    var fde_t = translate_firewall_delete(fde_intent);
    check("translate_firewall_delete cmd", streq(load64(fde_t), "ufw") == 1);
    check("translate_firewall_delete perm ADMIN", load64(fde_t + 24) == PermissionLevel.ADMIN);

    # translate_service_control — happy path + null-action fallback.
    # (Bare imperative parse paths cover this end-to-end in the parse-side
    # tests above; here we lock the translator's own contract.)
    var sctl_intent = Intent_new(IntentTag.SERVICE_CONTROL);
    store64(sctl_intent + 8, str_from("start"));
    # A Str, as the parser stores it (extract_last_arg). This was the bare literal, which the
    # translator never read until 2.0.0 made its args real argv (arg_cstr reads the field as a Str).
    store64(sctl_intent + 16, str_from("nginx"));
    var sctl_t = translate_service_control(sctl_intent);
    check("translate_service_control cmd", streq(load64(sctl_t), "systemctl") == 1);
    check("translate_service_control perm ADMIN", load64(sctl_t + 24) == PermissionLevel.ADMIN);
    var sctl_null = Intent_new(IntentTag.SERVICE_CONTROL);
    var sctl_nt = translate_service_control(sctl_null);
    check("translate_service_control null action → unknown",
      streq(load64(sctl_nt), "echo") == 1);

    # translate_audit_view + translate_agent_info — both route through
    # MCP (Translation_with_mcp). field+8 must be a Str (json_escape
    # uses str_len), matching the parser's extract_after output.
    var av_intent = Intent_new(IntentTag.AUDIT_VIEW);
    store64(av_intent + 8, str_from("agent-1"));
    var av_t = translate_audit_view(av_intent);
    check("translate_audit_view cmd echo", streq(load64(av_t), "echo") == 1);
    check("translate_audit_view perm ADMIN", load64(av_t + 24) == PermissionLevel.ADMIN);
    check("translate_audit_view mcp_tool set", load64(av_t + 40) != 0);
    # Null-field path — json_escape returns "" for null, no crash.
    var av_null = Intent_new(IntentTag.AUDIT_VIEW);
    var av_nt = translate_audit_view(av_null);
    check("translate_audit_view null field cmd echo", streq(load64(av_nt), "echo") == 1);

    var ag_intent = Intent_new(IntentTag.AGENT_INFO);
    store64(ag_intent + 8, str_from("agent-1"));
    var ag_t = translate_agent_info(ag_intent);
    check("translate_agent_info cmd echo", streq(load64(ag_t), "echo") == 1);
    check("translate_agent_info perm READ_ONLY", load64(ag_t + 24) == PermissionLevel.READ_ONLY);
    check("translate_agent_info mcp_tool set", load64(ag_t + 40) != 0);

    # translate_question + translate_unknown — both echo, both SAFE.
    var q_t = translate_question(Intent_new(IntentTag.QUESTION));
    check("translate_question cmd echo", streq(load64(q_t), "echo") == 1);
    check("translate_question perm SAFE", load64(q_t + 24) == PermissionLevel.SAFE);
    var u_t = translate_unknown(Intent_new(IntentTag.UNKNOWN));
    check("translate_unknown cmd echo", streq(load64(u_t), "echo") == 1);
    check("translate_unknown perm SAFE", load64(u_t + 24) == PermissionLevel.SAFE);

    # Slice 8 — coverage anchors for internal helpers. The script
    # `scripts/check-coverage.sh` does a fn-name grep against this file;
    # several helpers (parse_X dispatch arms, ci string ops, tokenizer,
    # mode helpers) are exercised transitively through the parse /
    # translate tests above but need a direct name reference to register.
    # Each anchor doubles as a contract check on the helper's behavior.

    # String helpers (sanitize.cyr)
    check("str_byte_at h", str_byte_at(str_from("hello"), 0) == 104);
    check("str_contains_ci hit", str_contains_ci(str_from("Hello World"), "world") == 1);
    check("str_contains_ci miss", str_contains_ci(str_from("foo"), "bar") == 0);
    check("str_find_ci hit", str_find_ci(str_from("Hello World"), "World") == 6);
    check("str_find_ci miss", str_find_ci(str_from("foo"), "bar") == (0 - 1));
    check("str_find_ci_from", str_find_ci_from(str_from("aaa bbb aaa"), "aaa", 1) == 8);
    check("str_split_ci basic", vec_len(str_split_ci(str_from("a then b"), " then ")) == 2);
    check("strip_control_chars drops",
      str_len(strip_control_chars(str_from("hi"))) == 2);
    # print_str_safe is io-side; just anchor the name via a direct call.
    print_str_safe(str_from(""));

    # str_to_int (sanitize-adjacent helper in main.cyr / commands flow)
    check("str_to_int basic", str_to_int(str_from("42")) == 42);

    # split_command_line (commands.cyr) — exercise through SHELL_COMMAND
    # fallback test which sets the args vec; here add a direct call
    # contract check.
    var scl_cmd_out[1];
    var scl_args_out = vec_new();
    var scl_argc = split_command_line(str_from("ls -la /tmp"), &scl_cmd_out, scl_args_out);
    check("split_command_line argc", scl_argc == 2);

    # Interpreter dispatch arms — parse_show_commands, parse_file_ops,
    # parse_system_ops, parse_git_ops, parse_admin_ops, parse_service_query,
    # parse_service_action, parse_state_queries, parse_file_phrases and
    # parse_git_anchored all return 0 on a clearly non-matching input; the
    # anchors lock that contract. The specific-tier arms (ADR-007) take the
    # line's PhraseIndex as well as the line.
    var nm = str_from("xyzqq");
    var nm_pix[PIX_BYTES];
    phrase_index(&nm_pix, nm);
    check("parse_show_commands no-match", parse_show_commands(nm) == 0);
    check("parse_file_ops no-match", parse_file_ops(nm) == 0);
    check("parse_system_ops no-match", parse_system_ops(nm) == 0);
    check("parse_git_ops no-match", parse_git_ops(nm) == 0);
    check("parse_admin_ops no-match", parse_admin_ops(nm, &nm_pix) == 0);
    check("parse_service_query no-match", parse_service_query(nm, &nm_pix) == 0);
    check("parse_service_action no-match", parse_service_action(nm) == 0);
    check("parse_state_queries no-match", parse_state_queries(nm, &nm_pix) == 0);
    check("parse_file_phrases no-match", parse_file_phrases(nm, &nm_pix) == 0);
    check("parse_git_anchored no-match", parse_git_anchored(nm, &nm_pix) == 0);

    # token_count (interpreter.cyr)
    check("token_count empty", token_count(str_from("")) == 0);
    check("token_count single", token_count(str_from("foo")) == 1);
    check("token_count multi", token_count(str_from("foo bar baz")) == 3);

    # translate_core / translate_extended dispatch — both return 0 for
    # an out-of-range tag.
    check("translate_core out-of-range",
      translate_core(99, Intent_new(IntentTag.UNKNOWN)) == 0);
    check("translate_extended out-of-range",
      translate_extended(99, Intent_new(IntentTag.UNKNOWN)) == 0);

    # mode helpers
    check("mode_prompt_prefix HUMAN",
      streq(mode_prompt_prefix(Mode.HUMAN), "[HUMAN]") == 1);
    check("mode_prompt_prefix STRICT",
      streq(mode_prompt_prefix(Mode.STRICT), "[STRICT]") == 1);
    var tg_mgr = ModeManager_new(Mode.HUMAN, 1);
    var tg_r = ModeManager_toggle(tg_mgr);
    check("ModeManager_toggle ok", tg_r == 0);
    check("ModeManager_toggle changes mode",
      ModeManager_current(tg_mgr) == Mode.AI_ASSISTED);

    # Permission-classifier predicates (permissions.cyr)
    check("is_blocked_command dd", is_blocked_command("dd") == 1);
    check("is_blocked_command ls negative", is_blocked_command("ls") == 0);
    check("is_readonly_command ls", is_readonly_command("ls") == 1);
    check("is_write_command mv", is_write_command("mv") == 1);
    check("is_safe_command cd", is_safe_command("cd") == 1);

    # is_safe_arg / is_shell_metachar (sanitize.cyr)
    check("is_safe_arg clean", is_safe_arg("hello") == 1);
    check("is_safe_arg metachar", is_safe_arg("foo;bar") == 0);
    check("is_shell_metachar semi", is_shell_metachar(59) == 1);
    check("is_shell_metachar letter", is_shell_metachar(97) == 0);

    # is_word_prefix (the slice-2 helper that retired the substring trap)
    check("is_word_prefix hit", is_word_prefix(str_from("show me files"), "file") == 1);
    check("is_word_prefix no-match", is_word_prefix(str_from("show me files"), "wibble") == 0);
    check("is_word_prefix substring trap immune",
      is_word_prefix(str_from("remove the file"), "move") == 0);

    # mode_description (mode.cyr) — paired with mode_display already tested.
    check("mode_description HUMAN non-empty",
      strlen(mode_description(Mode.HUMAN)) > 0);

    # list_options_time bit (intent.cyr) — the only bit-accessor not
    # exercised by the opts-pack test above.
    var opt_t = list_options_pack(0, 0, 0, 1, 0);
    check("list_options_time on", list_options_time(opt_t) == 1);

    # build_safe_env (sanitize.cyr) — dead in the agnsh binary today
    # (no shell exec path wired in) but needed for v1.2.x interactive
    # shell. Anchor the contract: returns a non-empty env vec with PATH
    # as the first entry.
    var se_env = build_safe_env();
    check("build_safe_env non-empty", vec_len(se_env) >= 1);
    check("build_safe_env PATH first",
      streq(vec_get(se_env, 0), "PATH=/usr/bin:/bin:/usr/sbin:/sbin") == 1);

    # === Approval workflow (src/approval.cyr) ===
    # v1.2.1 lead-item coverage: decision matrix is the gate between
    # permission classification and command execution. Risk mapping,
    # auto-approve behavior, and the blocklist are all unit-testable
    # without invoking the interactive UI.

    # risk_from_permission — the spine of the approval decision.
    check("risk SAFE = LOW",
      risk_from_permission(PermissionLevel.SAFE) == RiskLevel.LOW);
    check("risk READ_ONLY = LOW",
      risk_from_permission(PermissionLevel.READ_ONLY) == RiskLevel.LOW);
    check("risk USER_WRITE = MEDIUM",
      risk_from_permission(PermissionLevel.USER_WRITE) == RiskLevel.MEDIUM);
    check("risk SYSTEM_WRITE = HIGH",
      risk_from_permission(PermissionLevel.SYSTEM_WRITE) == RiskLevel.HIGH);
    check("risk ADMIN = HIGH",
      risk_from_permission(PermissionLevel.ADMIN) == RiskLevel.HIGH);
    check("risk BLOCKED = CRITICAL",
      risk_from_permission(PermissionLevel.BLOCKED) == RiskLevel.CRITICAL);

    # risk_icon — the labels the approval UI prints.
    check("risk_icon LOW", streq(risk_icon(RiskLevel.LOW), "[LOW]") == 1);
    check("risk_icon MED", streq(risk_icon(RiskLevel.MEDIUM), "[MED]") == 1);
    check("risk_icon HIGH", streq(risk_icon(RiskLevel.HIGH), "[HIGH]") == 1);
    check("risk_icon CRIT",
      streq(risk_icon(RiskLevel.CRITICAL), "[CRIT]") == 1);

    # ApprovalManager_assess_risk — composes analyze_command_permission +
    # risk_from_permission. Verify the end-to-end mapping for each
    # PermissionLevel bucket.
    var am = ApprovalManager_new();
    var empty_args = vec_new();
    check("assess_risk ls = LOW",
      ApprovalManager_assess_risk(am, "ls", empty_args, 0) == RiskLevel.LOW);
    check("assess_risk cp = MEDIUM",
      ApprovalManager_assess_risk(am, "cp", empty_args, 0) == RiskLevel.MEDIUM);
    check("assess_risk apt = HIGH",
      ApprovalManager_assess_risk(am, "apt", empty_args, 0) == RiskLevel.HIGH);
    check("assess_risk dd = CRITICAL",
      ApprovalManager_assess_risk(am, "dd", empty_args, 0) == RiskLevel.CRITICAL);

    # ApprovalManager_is_blocked — pattern-based blocklist (substring
    # match). Default state is empty.
    check("is_blocked default empty",
      ApprovalManager_is_blocked(am, str_from("ls")) == 0);
    ApprovalManager_block_pattern(am, str_from("rm -rf /"));
    check("is_blocked after pattern add",
      ApprovalManager_is_blocked(am, str_from("rm -rf /home")) == 1);
    check("is_blocked unrelated cmd",
      ApprovalManager_is_blocked(am, str_from("ls -la")) == 0);

    # set_auto_approve — flips the auto-approve-low-risk bit at offset 8.
    var am2 = ApprovalManager_new();
    check("auto_approve default off", load64(am2 + 8) == 0);
    ApprovalManager_set_auto_approve(am2, 1);
    check("auto_approve on", load64(am2 + 8) == 1);
    ApprovalManager_set_auto_approve(am2, 0);
    check("auto_approve off", load64(am2 + 8) == 0);

    # === Audit-log JSON shape (src/audit.cyr) ===
    # v1.2.1 lead-item: audit-log shape. AuditEntry_to_json is the
    # serializer every -c invocation and (future) interactive command
    # routes through; lock the field order, the JSON-string quoting on
    # text fields, and the integer-not-string serialization of the
    # `approved` flag. The test_core stub for chrono_now_rfc3339 (line
    # 17) returns a deterministic timestamp so the assertion is stable.
    var ae = AuditEntry_new(
      str_from("alice"),
      str_from("auto"),
      str_from("ls -la"),
      str_from("ls"),
      1,
      str_from("executed")
      );
    var ae_json = AuditEntry_to_json(ae);
    # Field-by-field substring check rather than full-string equality
    # so we stay under the 120-char lint cap. Each assertion locks one
    # contract: the field is present, the field is quoted as JSON, the
    # value lands intact, and `approved` is an integer (not a string).
    check("audit json has timestamp",
      str_contains_ci(ae_json, "\"timestamp\":\"2026-01-01T00:00:00Z\"") == 1);
    check("audit json has user", str_contains_ci(ae_json, "\"user\":\"alice\"") == 1);
    check("audit json has mode", str_contains_ci(ae_json, "\"mode\":\"auto\"") == 1);
    check("audit json has input", str_contains_ci(ae_json, "\"input\":\"ls -la\"") == 1);
    check("audit json has action", str_contains_ci(ae_json, "\"action\":\"ls\"") == 1);
    check("audit json has result", str_contains_ci(ae_json, "\"result\":\"executed\"") == 1);
    # `approved` must be a raw integer, not a quoted string. Filtering
    # tools and downstream parsers depend on this typing.
    check("audit json approved=1 raw int",
      str_contains_ci(ae_json, "\"approved\":1") == 1);
    check("audit json approved not quoted",
      str_contains_ci(ae_json, "\"approved\":\"1\"") == 0);

    # `approved=0` path — deny / blocked entries record the integer 0.
    var ae_deny = AuditEntry_new(
      str_from("alice"),
      str_from("strict"),
      str_from("rm -rf /"),
      str_from("rm"),
      0,
      str_from("blocked")
      );
    var ae_dj = AuditEntry_to_json(ae_deny);
    check("audit json approved=0 raw int",
      str_contains_ci(ae_dj, "\"approved\":0") == 1);
    check("audit json blocked result",
      str_contains_ci(ae_dj, "\"result\":\"blocked\"") == 1);

    # JSON-string escaping — embedded `"` in the input field exercises
    # json_escape (sanitize.cyr) on the audit path. Pre-v1.0 audit C4
    # fix was the injection vector; the assertion locks the fix in
    # place from the audit side too.
    var ae_esc = AuditEntry_new(
      str_from("alice"),
      str_from("auto"),
      str_from("echo \"hi\""),
      str_from("echo"),
      1,
      str_from("executed")
      );
    var ae_ej = AuditEntry_to_json(ae_esc);
    check("audit json escapes inner quotes",
      str_contains_ci(ae_ej, "\"input\":\"echo \\\"hi\\\"\"") == 1);

    # === SecurityContext + sudo re-verification (src/security.cyr) ===
    # v1.2.1 lead-item sub-bullet "sudo re-verification timing":
    #   (1) The decision-time gate `SecurityContext_can_escalate` must
    #       deny when restricted=1, when sudo_available=0, or when
    #       is_root=1 — locks the three guarded states.
    #   (2) The escalation-time helper `verify_sudo_path` must re-check
    #       both existence AND root-ownership at the call site rather
    #       than trusting the session-init cache. The test pins one
    #       happy-path against the real `/usr/bin/sudo` and one
    #       negative against a known-missing path so a regression in
    #       the verifier itself surfaces here.

    # SecurityContext_is_root / is_restricted / username — pure accessors
    var sec_r = _mock_sec(1, 0, 1);
    check("SecurityContext_is_root yes", SecurityContext_is_root(sec_r) == 1);
    var sec_nr = _mock_sec(0, 0, 1);
    check("SecurityContext_is_root no", SecurityContext_is_root(sec_nr) == 0);
    var sec_rstr = _mock_sec(0, 1, 1);
    check("SecurityContext_is_restricted yes",
      SecurityContext_is_restricted(sec_rstr) == 1);
    check("SecurityContext_is_restricted no",
      SecurityContext_is_restricted(sec_nr) == 0);

    # can_escalate gate — the v1.2.1 contract: deny if restricted=1,
    # OR sudo unavailable, OR running as root.
    check("can_escalate normal user OK",
      SecurityContext_can_escalate(_mock_sec(0, 0, 1)) == 1);
    check("can_escalate restricted blocked",
      SecurityContext_can_escalate(_mock_sec(0, 1, 1)) == 0);
    check("can_escalate sudo missing blocked",
      SecurityContext_can_escalate(_mock_sec(0, 0, 0)) == 0);
    check("can_escalate root blocked",
      SecurityContext_can_escalate(_mock_sec(1, 0, 1)) == 0);

    # verify_sudo_path — re-verification helper. Pin against
    # /usr/bin/sudo if it's actually installed root-owned on this
    # host (true on every standard Linux); fall through gracefully
    # when running in a container without sudo. Either way the
    # "missing path" negative case stays deterministic.
    if (file_exists("/usr/bin/sudo") == 1) {
        check("verify_sudo_path /usr/bin/sudo verifies",
          verify_sudo_path("/usr/bin/sudo") == 1);
    }
    check("verify_sudo_path nonexistent rejected",
      verify_sudo_path("/nonexistent/sudo/path") == 0);

    # security_check_sudo — at-init coarse availability check. The
    # cached form `SecurityContext.sudo_available` is set from this
    # at SecurityContext_new; later escalations re-check via
    # verify_sudo_path. The fact that both paths agree on "sudo
    # available" on this host is the integration invariant.
    var sudo_init = security_check_sudo();
    if (file_exists("/usr/bin/sudo") == 1) {
        check("security_check_sudo finds installed sudo", sudo_init == 1);
    }

    # === 2.0.2: the context in the binary — security_init and restricted sessions ===
    # SecurityContext_new reads the real ids. Asserted against the same syscalls rather than literals,
    # so the suite holds when it runs as root (a container) as well as for an ordinary user.
    var sc_uid = sys_getuid();
    var sc_euid = sys_geteuid();
    var sc_root = 0;
    if (sc_uid == 0 || sc_euid == 0) { sc_root = 1; }
    var sctx = SecurityContext_new(0);
    check("SecurityContext_new reads the uid, gid and euid",
      load64(sctx) == sc_uid && load64(sctx + 8) == sys_getgid() && load64(sctx + 16) == sc_euid);
    check("SecurityContext_new: is_root follows the ids", SecurityContext_is_root(sctx) == sc_root);
    check("SecurityContext_new: a host session is restricted exactly when it runs as root",
      SecurityContext_is_restricted(sctx) == sc_root);
    check("SecurityContext_new(1) is restricted whoever runs it",
      SecurityContext_is_restricted(SecurityContext_new(1)) == 1);
    check("SecurityContext_new: sudo_available is security_check_sudo's answer",
      load64(sctx + 48) == security_check_sudo());
    check("SecurityContext_new leaves the username for first use", load64(sctx + 24) == 0);
    var sc_name = SecurityContext_username(sctx);
    check("SecurityContext_username looks the name up on first use",
      sc_name != 0 && str_eq(sc_name, security_get_username_safe(sc_uid)) == 1);
    check("...and keeps it", SecurityContext_username(sctx) == sc_name);
    check("SecurityContext_username returns a name already set",
      str_eq(SecurityContext_username(_mock_sec(0, 0, 1)), str_from("alice")) == 1);
    # security_get_username over the real /etc/passwd: every Linux host has root at uid 0.
    if (file_exists("/etc/passwd") == 1) {
        check("security_get_username(0) is root", str_eq(security_get_username(0), str_from("root")) == 1);
    }
    check("an unassigned uid is uid_<n>",
      str_eq(security_get_username(3999999999), str_from("uid_3999999999")) == 1);
    check("...and passes the username check as that",
      str_eq(security_get_username_safe(3999999999), str_from("uid_3999999999")) == 1);
    # security_init / security_restricted: the session context, and the one question nlexec asks it.
    check("security_restricted is 0 before security_init", security_ctx == 0 && security_restricted() == 0);
    var sc_init = security_init();
    check("security_init builds the session context", sc_init != 0 && security_ctx == sc_init);
    check("security_restricted answers for it",
      security_restricted() == SecurityContext_is_restricted(sc_init));
    security_ctx = _mock_sec(1, 1, 0);
    check("a restricted context is restricted", security_restricted() == 1);
    security_ctx = _mock_sec(0, 0, 1);
    check("an unrestricted one is not", security_restricted() == 0);
    security_ctx = 0;                           # the NL tests below expect an unrestricted suite
    # security_warn_restricted: the interactive shell's start-up line, on stderr, for root only.
    var sw_err = tmp_state_path("agnsh_selftest_secwarn");
    _t_capture_begin(2, 10, sw_err);
    var sw_root = security_warn_restricted(_mock_sec(1, 1, 0));
    var sw_user = security_warn_restricted(_mock_sec(0, 0, 1));
    var sw_flag = security_warn_restricted(_mock_sec(0, 1, 1));
    var sw_none = security_warn_restricted(0);
    _t_capture_end(2, 10);
    check("a restricted root session warns", sw_root == 1);
    check("...on stderr, saying natural-language lines are not run", _t_file_has(sw_err,
        "WARNING: agnsh is running as root -- natural-language lines are reported, not run") == 1);
    check("...once", _t_count_nl(sw_err) == 1);
    check("an unrestricted session does not warn", sw_user == 0);
    check("a restricted session that is not root does not claim root", sw_flag == 0);
    check("no context, no warning", sw_none == 0);
    xunlink(sw_err);
    # execute_command / execute_with_privileges: the escalation path has no caller in the binary
    # (roadmap 2.0.x — approval-gated exec). The suite pins its refusals and never reaches sudo.
    var ec_args = vec_new();
    check("execute_command returns the child's status",
      execute_command("/bin/true", ec_args, 0) == 0 && execute_command("/bin/false", ec_args, 0) == 1);
    check("execute_with_privileges refuses a restricted session (-1)",
      execute_with_privileges(_mock_sec(0, 1, 1), "/bin/true", ec_args, 0) == 0 - 1);
    check("...and a session without sudo (-2)",
      execute_with_privileges(_mock_sec(0, 0, 0), "/bin/true", ec_args, 0) == 0 - 2);

    # AuditLogger_new / log — write a line to a temp file and read it
    # back. Verifies the file is created with append-mode and a
    # newline terminator, the end-to-end shape lands on disk.
    var log_path = "/tmp/.agnsh-test-audit.log";
    # Truncate any stale file from a previous test run. Use the stdlib
    # syscall wrappers (sys_unlink/sys_open/sys_read/sys_close) rather than
    # raw syscall(N, …): the wrappers carry the correct arity — raw
    # `syscall(2, path, flags)` is open() with the mode arg dropped, which
    # trips the 6.3.x syscall-arity lint — and they route to agnos numbers
    # under --agnos should these tests ever cross-build.
    sys_unlink(log_path);
    var logger = AuditLogger_new(log_path);
    AuditLogger_log(logger, ae);
    AuditLogger_log(logger, ae_deny);
    var rbuf[2048];
    var rfd = sys_open(log_path, 0, 0);
    check("audit log file opened for read", rfd >= 0);
    var rn = sys_read(rfd, &rbuf, 2047);
    sys_close(rfd);
    store8(&rbuf + rn, 0);
    check("audit log has two lines",
      rn > 0);

    # ── SHELL_COMMAND risk classification, END-TO-END through the real parser ──
    #
    # These MUST go through Interpreter_parse -> Interpreter_translate. Every
    # pre-1.9.1 test of this surface hand-stuffed a cstring literal into
    # `intent + 8` (`store64(sh_intent + 8, "ls")`) — which is the type
    # analyze_command_permission WANTS — while split_command_line actually
    # handed it a Str. So the unit tests passed against a classifier that was
    # 100% dead in production: `dd if=/dev/zero of=/dev/sda`, `mkfs`, `su` and
    # `shred /etc/shadow` all graded USER_WRITE/[MED] with `"approved":1`, and
    # the BLOCKED / "Approval required" branches were unreachable. The suite
    # was green through all of it. Drive the parser, never the fixture.
    var e2e = Interpreter_new();

    var e2e_dd = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("dd if=/dev/zero of=/dev/sda")));
    check("e2e dd -> BLOCKED", load64(e2e_dd + 24) == PermissionLevel.BLOCKED);

    var e2e_mkfs = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("mkfs /dev/sda1")));
    check("e2e mkfs -> BLOCKED", load64(e2e_mkfs + 24) == PermissionLevel.BLOCKED);

    var e2e_shred = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("shred /etc/shadow")));
    check("e2e shred -> BLOCKED", load64(e2e_shred + 24) == PermissionLevel.BLOCKED);

    var e2e_su = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("su")));
    check("e2e su -> ADMIN", load64(e2e_su + 24) == PermissionLevel.ADMIN);

    # SYSTEM_WRITE had NO producer in any test before 1.9.1 — it is reachable
    # only through has_system_path_arg, which walks the args vec and was dead
    # for the same reason. This is its first assertion.
    var e2e_cp = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("cp /tmp/x /etc/passwd")));
    check("e2e cp to /etc -> SYSTEM_WRITE",
      load64(e2e_cp + 24) == PermissionLevel.SYSTEM_WRITE);

    # NOTE: `rm ...` never reaches SHELL_COMMAND — the NL parser claims it as
    # IntentTag.REMOVE (8) first, so analyze_command_permission's `rm` branch
    # and rm_has_dangerous_flags are unreachable FROM THE PARSER and are only
    # exercised by the direct-call tests above. This anchor therefore locks the
    # REMOVE path's own BLOCKED verdict, not the shell path. (Args-vec walking
    # on the shell path is covered by the cp -> SYSTEM_WRITE case above, which
    # goes through has_system_path_arg.)
    var e2e_rmr = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("rm -r somedir")));
    check("e2e rm -r -> BLOCKED (via REMOVE, not SHELL_COMMAND)",
      load64(e2e_rmr + 24) == PermissionLevel.BLOCKED);
    check("rm parses as REMOVE, never SHELL_COMMAND",
      load64(Interpreter_parse(e2e, str_from("rm -rf /var/tmp/x"))) == IntentTag.REMOVE);

    # Negative side: safe/read-only commands must NOT be over-classified.
    var e2e_ls = Interpreter_translate(e2e,
      Interpreter_parse(e2e, str_from("ls -la /tmp")));
    check("e2e ls -> READ_ONLY", load64(e2e_ls + 24) == PermissionLevel.READ_ONLY);

    # The command word reaching Translation.command must be a real cstring —
    # a blank `action` in the audit record was the visible symptom of the Str
    # leak (`"action":""` for every SHELL_COMMAND line).
    check("e2e command word is a usable cstring",
      streq(load64(e2e_dd), "dd") == 1);
    check("e2e args are usable cstrings",
      streq(vec_get(load64(e2e_cp + 8), 1), "/etc/passwd") == 1);

    # ---- 1.9.1 P(-1) hardening anchors ----

    # History cap. add() now trims LAZILY (amortized O(1) instead of an
    # O(n) whole-vec rebuild per add — 17.5us -> 298ns at cap=1000), so
    # `count` may exceed max_size by a bounded slack. What must hold is that
    # it stays BOUNDED; unbounded growth was never the old behaviour and must
    # not become the new one.
    var hcap = CommandHistory_new("/nonexistent/agnsh-test-history", 32);
    for (var hh = 0; hh < 500; hh = hh + 1) {
        if (hh % 2 == 0) { CommandHistory_add(hcap, "alpha cmd"); }
        else { CommandHistory_add(hcap, "beta cmd"); }
    }
    check("history stays bounded under churn", CommandHistory_len(hcap) <= 48);
    check("history retains at least the cap", CommandHistory_len(hcap) >= 32);
    # Consecutive-duplicate dedup must still hold after the trim rewrite.
    var hdup = CommandHistory_new("/nonexistent/agnsh-test-history2", 100);
    CommandHistory_add(hdup, "same");
    CommandHistory_add(hdup, "same");
    check("history dedups consecutive duplicates", CommandHistory_len(hdup) == 1);

    # is_shell_metachar — 2 of 10 entries were asserted before 1.9.1, yet every
    # path/arg guard in the binary rests on this table.
    check("metachar ;", is_shell_metachar(59) == 1);
    check("metachar |", is_shell_metachar(124) == 1);
    check("metachar &", is_shell_metachar(38) == 1);
    check("metachar $", is_shell_metachar(36) == 1);
    check("metachar (", is_shell_metachar(40) == 1);
    check("metachar )", is_shell_metachar(41) == 1);
    check("metachar <", is_shell_metachar(60) == 1);
    check("metachar >", is_shell_metachar(62) == 1);
    check("metachar backtick", is_shell_metachar(96) == 1);
    check("metachar newline", is_shell_metachar(10) == 1);
    check("non-metachar letter", is_shell_metachar(97) == 0);
    check("non-metachar slash", is_shell_metachar(47) == 0);

    # mode_needs_confirm — the HUMAN/STRICT gate in front of every program
    # launch. Had zero assertions.
    check("confirm HUMAN", mode_needs_confirm(Mode.HUMAN) == 1);
    check("confirm STRICT", mode_needs_confirm(Mode.STRICT) == 1);
    check("no confirm AUTO", mode_needs_confirm(Mode.AI_AUTONOMOUS) == 0);
    check("no confirm ASSIST", mode_needs_confirm(Mode.AI_ASSISTED) == 0);

    # Str-side safety predicates — these are the ones the live translators
    # actually call, and they had no direct assertions.
    check("safe_path_in_str rejects traversal",
      safe_path_in_str(str_from("../../etc/shadow")) == 0);
    check("safe_path_in_str rejects metachar",
      safe_path_in_str(str_from("/tmp/x; rm -rf /")) == 0);
    check("safe_path_in_str accepts plain", safe_path_in_str(str_from("/tmp/ok.txt")) == 1);
    check("safe_path_in_str rejects null", safe_path_in_str(0) == 0);
    check("safe_arg_in_str rejects metachar",
      safe_arg_in_str(str_from("foo`whoami`")) == 0);
    check("safe_arg_in_str rejects empty", safe_arg_in_str(str_from("")) == 0);
    check("safe_arg_in_str accepts plain", safe_arg_in_str(str_from("plainarg")) == 1);
    # H7 leading-dash argument injection. The cstring is_safe_commit_message was
    # handed a Str by translate_git_commit, so the guard never fired; the _in_str
    # twin is the one the live path now calls. Drive the real parser.
    check("commit msg guard rejects leading dash",
      safe_commit_message_in_str(str_from("-oh-no-a-flag")) == 0);
    check("commit msg guard accepts normal", safe_commit_message_in_str(str_from("fix bug")) == 1);
    check("commit msg guard rejects empty", safe_commit_message_in_str(str_from("")) == 0);
    var e2e_gc = Interpreter_new();
    var gc_e2e = Interpreter_translate(e2e_gc,
      Interpreter_parse(e2e_gc, str_from("git commit -m -oh-no-a-flag")));
    check("e2e dashed commit msg is refused (falls to unknown)",
      streq(load64(gc_e2e), "git") == 0);

    # ---- 1.9.2 exec-audit surface ----
    # The exec vocabulary must stay DISJOINT from the six parse-time labels, so a
    # consumer can separate "the shell considered this" from "the shell did this"
    # with one select. audit_exec_outcome is the single mapping point.
    check("outcome negative -> error", streq(audit_exec_outcome(0 - 1), "error") == 1);
    check("outcome zero -> executed", streq(audit_exec_outcome(0), "executed") == 1);
    check("outcome positive -> failed", streq(audit_exec_outcome(1), "failed") == 1);
    check("outcome 127 -> failed", streq(audit_exec_outcome(127), "failed") == 1);

    # exit_code must serialise as JSON `null` when no code applies (a refusal or
    # the pre-launch line), and as a bare number otherwise — never as the raw
    # sentinel, which a consumer could mistake for a real status.
    var ax_none = AuditEntry_new(
      str_from("user"), str_from("AI-AUTO"), str_from("run /bin/x"),
      str_from("/bin/x"), 0, str_from("denied"));
    var ax_none_j = AuditEntry_to_json(ax_none);
    check("no-exit record serialises exit_code null",
      str_contains(ax_none_j, str_from("\"exit_code\":null")) == 1);
    check("no-exit record does not leak the sentinel",
      str_contains(ax_none_j, str_from("999999")) == 0);

    var ax_ok = AuditEntry_new_x(
      str_from("user"), str_from("AI-AUTO"), str_from("run /bin/echo"),
      str_from("/bin/echo"), 1, str_from("executed"), 0);
    check("executed record carries exit_code 0",
      str_contains(AuditEntry_to_json(ax_ok), str_from("\"exit_code\":0")) == 1);

    var ax_fail = AuditEntry_new_x(
      str_from("user"), str_from("AI-AUTO"), str_from("run /bin/false"),
      str_from("/bin/false"), 1, str_from("failed"), 1);
    var ax_fail_j = AuditEntry_to_json(ax_fail);
    check("failed record carries exit_code 1",
      str_contains(ax_fail_j, str_from("\"exit_code\":1")) == 1);
    check("failed record is still approved (it ran)",
      str_contains(ax_fail_j, str_from("\"approved\":1")) == 1);

    # The parse-time constructor must keep its 6-arg shape — the exec field is
    # additive, and the non-exec call sites must not have to know about it.
    # ---- 1.9.3 exec-path parsers (first host coverage) ----
    # Writable scratch buffer, so the non-mutation assertions below are real.
    var pbuf[64];

    # sh_exit_status (2.0.1): an agnos wait status as the shell reports it. agnos 1.57.7 encodes a
    # death by signal N as 0x100 | N; ADR-008 § 4 promises 128 + N, as host_exec already returns.
    check("exit_status: exit 0 stays 0", sh_exit_status(0) == 0);
    check("exit_status: exit 3 stays 3", sh_exit_status(3) == 3);
    check("exit_status: exit 255 stays 255", sh_exit_status(255) == 255);
    check("exit_status: a fault (128 + vector) stays an exit code", sh_exit_status(142) == 142);
    check("exit_status: SIGKILL (0x100 | 9) -> 137", sh_exit_status(0x100 | 9) == 137);
    check("exit_status: SIGTERM (0x100 | 15) -> 143", sh_exit_status(0x100 | 15) == 143);
    check("exit_status: a launch failure passes through", sh_exit_status(0 - 1) == 0 - 1);
    check("exit_status: WOULD_BLOCK passes through", sh_exit_status(0 - 2) == 0 - 2);

    # _sh_find_pipe / _sh_find_redirect: offset of the separator, -1 when absent.
    check("find_pipe absent", _sh_find_pipe("ls -la") == 0 - 1);
    check("find_pipe at offset", _sh_find_pipe("ls | wc") == 3);
    check("find_redirect absent", _sh_find_redirect("ls -la") == 0 - 1);
    check("find_redirect at offset", _sh_find_redirect("ls > f") == 3);

    # _sh_bin_segment prefixes "/bin/" and trims; _sh_path_segment just trims.
    check("bin_segment prefixes /bin/",
      streq(_sh_bin_segment("  ls -la  ", 0, 10), "/bin/ls -la") == 1);
    check("bin_segment empty -> 0", _sh_bin_segment("    ", 0, 4) == 0);
    check("path_segment trims", streq(_sh_path_segment("  /tmp/f  ", 0, 10), "/tmp/f") == 1);
    check("path_segment empty -> 0", _sh_path_segment("   ", 0, 3) == 0);

    # sh_scan_trailing_amp: length of the command part for a background request,
    # -1 when the line is not one.
    _t_cpy(&pbuf, "sleeper &");
    check("amp detected -> command length", sh_scan_trailing_amp(&pbuf) == 7);
    # ⛔ THE REGRESSION THIS SLICE EXISTS FOR. The old sh_strip_trailing_amp
    # truncated the caller's buffer in place, at the TOP of
    # sh_try_bareword_launch — before the existence probe, and therefore before
    # the fall-through that hands the line back to the NL path. `sleeper &` with
    # no /bin/sleeper reached the parser, the history file and the audit record
    # as plain `sleeper`: the line the shell reported was not the line typed.
    check("amp scan does NOT mutate the caller's buffer",
      streq(&pbuf, "sleeper &") == 1);

    _t_cpy(&pbuf, "sleeper");
    check("no amp -> -1", sh_scan_trailing_amp(&pbuf) == 0 - 1);
    check("no amp leaves line intact", streq(&pbuf, "sleeper") == 1);

    # Padding on either side of the `&` is excluded from the command length.
    _t_cpy(&pbuf, "sleeper   &   ");
    check("amp with padding -> command length", sh_scan_trailing_amp(&pbuf) == 7);
    check("padded amp does not mutate", streq(&pbuf, "sleeper   &   ") == 1);

    # A bare `&` has a zero-length command part; the launcher treats that as
    # "not a bareword launch" and falls through to the NL path.
    _t_cpy(&pbuf, "&");
    check("bare amp -> length 0", sh_scan_trailing_amp(&pbuf) == 0);
    _t_cpy(&pbuf, "prog & extra");
    check("amp not trailing -> -1", sh_scan_trailing_amp(&pbuf) == 0 - 1);

    # str_cat3_cstr — used to build every launch-confirmation prompt. Its alloc
    # was unchecked; it now returns 0 on failure and verb_confirm declines rather
    # than strlen()-ing a null pointer (fail closed: the HUMAN/STRICT gate must
    # never proceed on a prompt it could not render).
    check("str_cat3_cstr concatenates",
      streq(str_cat3_cstr("run ", "/bin/ls", " &"), "run /bin/ls &") == 1);
    check("str_cat3_cstr handles empty parts",
      streq(str_cat3_cstr("", "x", ""), "x") == 1);

    # ---- 1.9.4 portable open flags ----
    # Pinned because a WRONG constant here fails SILENTLY and dangerously. These
    # are the Linux values (the Darwin branch is compiled out here).
    # ⛔ UNTIL 1.9.13 THIS BLOCK PINNED THE BUG IT WAS WRITTEN TO PREVENT. It
    # asserted OPEN_NOFOLLOW == 131072 and != 32768 on every arch — right for
    # x86_64, exactly backwards for aarch64, where arm64's uapi fcntl.h makes
    # 32768 O_NOFOLLOW and 131072 O_LARGEFILE. CI only runs the x86_64 build, so
    # the pin passed for twelve releases while the aarch64 binary followed
    # symlinks. The literals are now per-arch, and the 1.9.13 block at the end of
    # main plants a real symlink — a constant pin alone cannot catch this class.
    check("OPEN_WRONLY", OPEN_WRONLY == 1);
    check("OPEN_CREAT", OPEN_CREAT == 64);
    check("OPEN_APPEND", OPEN_APPEND == 1024);
    check("OPEN_TRUNC", OPEN_TRUNC == 512);
    check("OPEN_NOFOLLOW is this target's O_NOFOLLOW", OPEN_NOFOLLOW == O_NOFOLLOW);
    check("OPEN_NOFOLLOW is not this target's O_LARGEFILE", OPEN_NOFOLLOW != O_LARGEFILE);
    #ifdef CYRIUS_ARCH_X86
    check("x86_64 O_NOFOLLOW is 0400000", OPEN_NOFOLLOW == 131072);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    check("aarch64 O_NOFOLLOW is 0100000", OPEN_NOFOLLOW == 32768);
    #endif
    check("STATE_FILE_MODE is 0600", STATE_FILE_MODE == 384);
    # The audit log opens append+create, NEVER truncate — the Darwin decoding of
    # the old hardcoded 1089 included O_TRUNC, which would have emptied the log
    # on every open.
    check("audit flags exclude TRUNC",
      ((OPEN_WRONLY | OPEN_CREAT | OPEN_APPEND | OPEN_NOFOLLOW) & OPEN_TRUNC) == 0);
    # ---- 1.9.5 parser shadowing ----
    # Each of these produced a WRONG COMMAND from a reasonable sentence, because
    # a broad parser earlier in the dispatch claimed the input before the
    # specific parser that already handled it correctly could see it.
    var sh = Interpreter_new();

    # (1) parse_file_ops (2nd) claimed every "delete"/"remove", so USER_DELETE
    # and FIREWALL_DELETE (parse_admin_ops, 5th) were unreachable and the shell
    # emitted `rm` against a file named after the account or the rule.
    check("delete user -> USER_DELETE",
      load64(Interpreter_parse(sh, str_from("delete user bob"))) == IntentTag.USER_DELETE);
    check("remove user -> USER_DELETE",
      load64(Interpreter_parse(sh, str_from("remove user bob"))) == IntentTag.USER_DELETE);
    check("delete firewall rule -> FIREWALL_DELETE",
      load64(Interpreter_parse(sh, str_from("delete firewall rule 22"))) == IntentTag.FIREWALL_DELETE);
    # ...and the guard must use WHOLE-token matching. With prefix matching,
    # "user" also fires on "user_data.txt" and a plain file deletion would be
    # routed into user management.
    check("remove user_data.txt stays REMOVE",
      load64(Interpreter_parse(sh, str_from("remove user_data.txt"))) == IntentTag.REMOVE);
    check("delete report.txt stays REMOVE",
      load64(Interpreter_parse(sh, str_from("delete report.txt"))) == IntentTag.REMOVE);
    check("remove usergroups.txt stays REMOVE",
      load64(Interpreter_parse(sh, str_from("remove usergroups.txt"))) == IntentTag.REMOVE);

    # (2) parse_show_commands (1st) matched "content" and returned LIST_FILES,
    # whose path comes from `extract_after(" in ")` — absent here — so the
    # command became a bare `ls` and the FILENAME WAS DROPPED.
    var shcof = Interpreter_parse(sh, str_from("show contents of /etc/hosts"));
    check("show contents of FILE -> SHOW_FILE", load64(shcof) == IntentTag.SHOW_FILE);
    check("show contents of FILE keeps the filename",
      streq(str_cstr(load64(shcof + 8)), "/etc/hosts") == 1);

    # (3) The SEARCH_CONTENT gate accepts " in ", "within" and "inside", but both
    # fields were extracted with " in " only — so the "inside" phrasing passed
    # the gate and produced a BARE grep: no pattern, no path.
    var si = Interpreter_parse(sh, str_from("search for hello inside /tmp"));
    check("search inside -> SEARCH_CONTENT", load64(si) == IntentTag.SEARCH_CONTENT);
    check("search inside extracts the pattern",
      streq(str_cstr(load64(si + 8)), "hello") == 1);
    check("search inside extracts the path",
      streq(str_cstr(load64(si + 16)), "/tmp") == 1);
    var sw = Interpreter_parse(sh, str_from("search for needle within /var/log"));
    check("search within extracts the pattern",
      streq(str_cstr(load64(sw + 8)), "needle") == 1);
    # the original " in " phrasing must keep working
    var sin = Interpreter_parse(sh, str_from("search for hello in /tmp"));
    check("search in still extracts the pattern",
      streq(str_cstr(load64(sin + 8)), "hello") == 1);
    check("search in still extracts the path",
      streq(str_cstr(load64(sin + 16)), "/tmp") == 1);

    # (4) The bare "usage" keyword in parse_show_commands claimed memory
    # questions and answered them with `df -h` — a DISK report. 1.9.5 stopped
    # that, but only got them as far as SYSTEM_INFO -> `uname -a`, which does
    # not report memory either; these two checks asserted that half-fix as if
    # it were the answer. 1.9.10 gave memory its own intent.
    check("show memory usage -> MEMORY_INFO",
      load64(Interpreter_parse(sh, str_from("show memory usage"))) == IntentTag.MEMORY_INFO);
    check("show free memory -> MEMORY_INFO",
      load64(Interpreter_parse(sh, str_from("show free memory"))) == IntentTag.MEMORY_INFO);
    check("ram usage -> MEMORY_INFO",
      load64(Interpreter_parse(sh, str_from("ram usage"))) == IntentTag.MEMORY_INFO);
    check("how much memory -> MEMORY_INFO",
      load64(Interpreter_parse(sh, str_from("how much memory"))) == IntentTag.MEMORY_INFO);
    check("bare show memory -> MEMORY_INFO",
      load64(Interpreter_parse(sh, str_from("show memory"))) == IntentTag.MEMORY_INFO);
    # The three query lanes must stay disjoint — memory, disk and system each
    # answer their own question. This is the pairing the roadmap asked for: the
    # anchors sit together so the two cannot re-cross unnoticed.
    check("system info stays SYSTEM_INFO",
      load64(Interpreter_parse(sh, str_from("system info"))) == IntentTag.SYSTEM_INFO);
    check("show hostname stays SYSTEM_INFO",
      load64(Interpreter_parse(sh, str_from("show hostname"))) == IntentTag.SYSTEM_INFO);
    # ⚠ The MEMORY_INFO arm keys on the bare words "memory"/"ram" (two checks
    # instead of six — see the note in parse_state_queries). Until 1.9.16 that
    # was safe because the file parser ran first; since ADR-007 the state parser
    # runs first, and what keeps it safe is its own rule: a bare word is only
    # whole (`memory.txt` is not `memory`), and a sentence that opens with a file
    # verb declines it (opens_with_file_verb). These pin that: a line that merely
    # NAMES a file called memory is a file operation, not a question about RAM.
    check("delete memory.txt is a file op, not a memory query",
      load64(Interpreter_parse(sh, str_from("delete memory.txt"))) == IntentTag.REMOVE);
    check("read the file memory is a file op",
      load64(Interpreter_parse(sh, str_from("read the file memory"))) == IntentTag.SHOW_FILE);
    # `find ram.log` lands on SHELL_COMMAND (a bare `find` is treated as a shell
    # command — pre-existing, unrelated to this arm). What matters here is only
    # that a filename containing "ram" is not read as a question about RAM.
    check("a filename containing ram is not a memory query",
      load64(Interpreter_parse(sh, str_from("find ram.log"))) != IntentTag.MEMORY_INFO);
    check("find files named ram.log is a search",
      load64(Interpreter_parse(sh, str_from("find files named ram.log"))) == IntentTag.FIND_FILES);
    check("list files in /memory is a listing",
      load64(Interpreter_parse(sh, str_from("list files in /memory"))) == IntentTag.LIST_FILES);
    # ...without breaking real disk questions.
    check("show disk usage stays DISK_USAGE",
      load64(Interpreter_parse(sh, str_from("show disk usage"))) == IntentTag.DISK_USAGE);
    check("show disk space stays DISK_USAGE",
      load64(Interpreter_parse(sh, str_from("show disk space"))) == IntentTag.DISK_USAGE);
    check("show storage usage stays DISK_USAGE",
      load64(Interpreter_parse(sh, str_from("show storage usage"))) == IntentTag.DISK_USAGE);
    # ...and without breaking plain listing.
    check("show me all files stays LIST_FILES",
      load64(Interpreter_parse(sh, str_from("show me all files"))) == IntentTag.LIST_FILES);
    check("list files in /tmp stays LIST_FILES",
      load64(Interpreter_parse(sh, str_from("list files in /tmp"))) == IntentTag.LIST_FILES);

    # ---- 1.9.7: functions that were unreachable while they lived in agnsh.cyr ----
    # src/agnsh.cyr scored 0/14 on coverage for a structural reason, not a
    # quality one: a test binary cannot include an entry file that owns `main`
    # and calls `_entry()` at top level. These moved to statepaths.cyr /
    # audit.cyr / mode.cyr in 1.9.7 and are now assertable.

    # classify_audit_result — the six PARSE-time labels. This is the function
    # that decides what a security log says about an action the shell declined
    # to run, and it had no direct assertion at all.
    check("audit class: question -> needs_llm",
      streq(classify_audit_result(IntentTag.QUESTION, PermissionLevel.SAFE, "x"), "needs_llm") == 1);
    check("audit class: pipeline -> needs_exec",
      streq(classify_audit_result(IntentTag.PIPELINE, PermissionLevel.SAFE, "x"), "needs_exec") == 1);
    check("audit class: unknown-intent -> rejected_safety",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.SAFE,
          "Unknown intent"), "rejected_safety") == 1);
    check("audit class: blocked -> blocked",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.BLOCKED, "x"), "blocked") == 1);
    check("audit class: admin -> needs_approval",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.ADMIN, "x"), "needs_approval") == 1);
    check("audit class: system_write -> needs_approval",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.SYSTEM_WRITE, "x"), "needs_approval") == 1);
    check("audit class: safe -> proposed",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.SAFE, "x"), "proposed") == 1);
    check("audit class: read_only -> proposed",
      streq(classify_audit_result(IntentTag.LIST_FILES, PermissionLevel.READ_ONLY, "x"), "proposed") == 1);
    # 2.0.0: an understood USER_WRITE line does not run without approval (ADR-008), so it is not
    # "proposed" any more; the SHELL_COMMAND fall-through keeps the classifier's view.
    check("classify: an understood user-write line needs approval",
      streq(classify_audit_result(IntentTag.COPY, PermissionLevel.USER_WRITE, "x"), "needs_approval") == 1);
    check("classify: the shell-command fall-through at user-write stays proposed",
      streq(classify_audit_result(IntentTag.SHELL_COMMAND, PermissionLevel.USER_WRITE, "x"), "proposed") == 1);
    # Tag order matters: PIPELINE has no translator arm, so it falls to
    # translate_unknown and carries the SAME "Unknown intent" description as a
    # real safety rejection. The tag must win, or a pipeline would be logged as
    # a safety refusal that never happened.
    check("audit class: pipeline beats the unknown-intent stamp",
      streq(classify_audit_result(IntentTag.PIPELINE, PermissionLevel.SAFE, "Unknown intent"), "needs_exec") == 1);

    # The exec-surface vocabulary must stay disjoint from the parse-time one, so
    # one `select` separates what the shell DID from what it merely considered.
    check("exec and parse label sets are disjoint",
      streq(audit_exec_outcome(0), "proposed") == 0);

    # tmp_state_path — the HOME-unset fallback. Uid-qualified since 1.9.4 so two
    # users on one box cannot collide (or pre-create each other's audit log).
    var tsp = tmp_state_path("agnsh_audit.log");
    check("tmp path is under /tmp", cstr_starts_with(tsp, "/tmp/agnsh_audit.log.") == 1);
    check("tmp path is uid-qualified (longer than the bare name)",
      strlen(tsp) > strlen("/tmp/agnsh_audit.log"));

    # try_mode_switch — the CLI/interactive mode gate. Unknown names must be
    # REFUSED, not silently downgraded (the 1.9.1 fail-open).
    var tms = ModeManager_new(Mode.HUMAN, 1);
    check("mode switch auto", try_mode_switch(tms, "auto") == 1);
    check("mode switch applied", ModeManager_current(tms) == Mode.AI_AUTONOMOUS);
    check("mode switch strict", try_mode_switch(tms, "strict") == 1);
    check("mode switch assist", try_mode_switch(tms, "assist") == 1);
    check("mode switch human", try_mode_switch(tms, "human") == 1);
    check("mode switch rejects a typo", try_mode_switch(tms, "assit") == 0);
    check("mode unchanged after a rejected switch", ModeManager_current(tms) == Mode.HUMAN);

    # ---- 1.9.7: safety predicates and helpers with no prior assertion ----
    # These are all pure and were simply never asserted. The corrected coverage
    # gate surfaced them; testing them is the point of the slice, not a way to
    # move the number.
    check("traversal cstr detects ..", has_path_traversal_cstr("/tmp/../etc") == 1);
    check("traversal cstr plain ok", has_path_traversal_cstr("/tmp/ok") == 0);
    check("traversal cstr single dot ok", has_path_traversal_cstr("/tmp/.x") == 0);
    check("traversal cstr null", has_path_traversal_cstr(0) == 0);
    check("metachar cstr detects ;", has_shell_metachars_cstr("a;b") == 1);
    check("metachar cstr plain ok", has_shell_metachars_cstr("plain") == 0);
    check("metachar cstr null", has_shell_metachars_cstr(0) == 0);
    check("metachar str detects pipe", has_shell_metachars(str_from("a|b")) == 1);
    check("metachar str plain ok", has_shell_metachars(str_from("plain")) == 0);
    check("traversal str detects ..", path_traversal_in_str(str_from("../x")) == 1);
    check("traversal str plain ok", path_traversal_in_str(str_from("/tmp/x")) == 0);
    check("metachar_in_str detects backtick",
      shell_metachars_in_str(str_from("a`b")) == 1);
    check("metachar_in_str plain ok", shell_metachars_in_str(str_from("plain")) == 0);

    # input_starts_with gates the interrogative parses ("is X running"), so a
    # statement like "the app is running" must NOT match.
    check("starts_with matches", input_starts_with(str_from("is nginx running"), "is ") == 1);
    check("starts_with rejects mid-string",
      input_starts_with(str_from("the app is running"), "is ") == 0);
    check("starts_with is case-insensitive",
      input_starts_with(str_from("IS nginx running"), "is ") == 1);

    # extract_between / extract_last_arg — the extractors 1.9.5 showed can
    # silently return the wrong span. extract_between FALLS BACK to "everything
    # after before_kw" when after_kw is absent; that behaviour is load-bearing
    # and must stay pinned, because 1.9.5's first fix attempt assumed it
    # returned 0 instead.
    check("extract_between spans",
      streq(str_cstr(extract_between(str_from("copy a.txt to b.txt"), "copy ", " to ")), "a.txt") == 1);
    check("extract_between falls back when after_kw is absent",
      streq(str_cstr(extract_between(str_from("copy a.txt"), "copy ", " to ")), "a.txt") == 1);
    check("extract_between missing before_kw -> 0",
      extract_between(str_from("nope"), "copy ", " to ") == 0);
    check("extract_last_arg takes the final token",
      streq(str_cstr(extract_last_arg(str_from("add user alice"))), "alice") == 1);
    check("extract_last_arg ignores trailing spaces",
      streq(str_cstr(extract_last_arg(str_from("add user bob   "))), "bob") == 1);

    # mode_from_name — the CLI mode parser. Its DEFAULT parameter is the
    # fail-open hazard 1.9.1 closed at the call site, so pin both directions.
    check("mode_from_name auto", mode_from_name("auto", 0 - 1) == Mode.AI_AUTONOMOUS);
    check("mode_from_name assist", mode_from_name("assist", 0 - 1) == Mode.AI_ASSISTED);
    check("mode_from_name human", mode_from_name("human", 0 - 1) == Mode.HUMAN);
    check("mode_from_name strict", mode_from_name("strict", 0 - 1) == Mode.STRICT);
    check("mode_from_name unknown returns the supplied default",
      mode_from_name("assit", 0 - 1) == 0 - 1);

    # is_admin_command — 32 table entries, no prior assertion. Also exercises
    # the 1.9.6 first-byte gate on a table other than the blocked one.
    check("admin cmd apt", is_admin_command("apt") == 1);
    check("admin cmd systemctl", is_admin_command("systemctl") == 1);
    check("admin cmd useradd", is_admin_command("useradd") == 1);
    check("admin cmd not ls", is_admin_command("ls") == 0);
    # same first byte as "apt" but not in the table — the gate must not pass it
    check("admin cmd not awk", is_admin_command("awk") == 0);

    check("builtin_description known", strlen(builtin_description("help")) > 0);
    check("builtin_description unknown is empty", strlen(builtin_description("nope")) == 0);

    var afd = AuditFilter_default();
    check("audit filter default limit", load64(afd + 16) == 0 - 1);

    # History accessors over a constructed (file-less) history.
    var hq = CommandHistory_new("/nonexistent/agnsh-test-hist3", 100);
    CommandHistory_add(hq, "git status");
    CommandHistory_add(hq, "ls -la");
    CommandHistory_add(hq, "git log");
    check("history len", CommandHistory_len(hq) == 3);
    check("history recent returns n", vec_len(CommandHistory_get_recent(hq, 2)) == 2);
    check("history recent clamps to len", vec_len(CommandHistory_get_recent(hq, 99)) == 3);
    check("history search matches", vec_len(CommandHistory_search(hq, str_from("git"))) == 2);
    check("history search no match", vec_len(CommandHistory_search(hq, str_from("zzz"))) == 0);

    # sh_first_word_eq — the word-boundary check behind the cat->owl nudge. The
    # boundary is the whole point: `cat` and `cat x` match, `catalog` must not.
    check("first_word_eq exact", sh_first_word_eq("cat", "cat") == 1);
    check("first_word_eq with args", sh_first_word_eq("cat file.txt", "cat") == 1);
    check("first_word_eq rejects a longer word", sh_first_word_eq("catalog", "cat") == 0);
    check("first_word_eq rejects a different word", sh_first_word_eq("dog", "cat") == 0);
    check("first_word_eq rejects a prefix of the needle", sh_first_word_eq("ca", "cat") == 0);

    # The state-file paths. Pure resolution, no I/O — assert the shape rather
    # than a literal, since HOME differs per environment.
    check("audit path ends with the conventional name",
      _t_ends_with(audit_log_path(), ".agnsh_audit.log") == 1);
    check("history path ends with the conventional name",
      _t_ends_with(history_path(), ".agnsh_history") == 1);

    # ---- 1.9.8: live defects found among the "latent" ones ----
    # ⛔ str_split's `sep` parameter is UNANNOTATED, so a bare literal is NOT
    # promoted to Str the way it is for `needle: Str` on str_contains. The raw
    # literal address is > 256, so str_split takes its Str path and reads the
    # literal's own bytes as a data pointer and a length. Result: a pipeline was
    # DETECTED and then never SPLIT.
    var pl = Interpreter_new();
    var pli = Interpreter_parse(pl, str_from("ls | grep foo"));
    check("pipeline detected", load64(pli) == IntentTag.PIPELINE);
    check("pipeline splits into TWO stages", vec_len(load64(pli + 56)) == 2);
    var pl3 = Interpreter_parse(pl, str_from("a | b | c"));
    check("pipeline splits three stages", vec_len(load64(pl3 + 56)) == 3);
    # the ` then ` form goes through str_split_ci, whose sep IS a cstring
    var plt = Interpreter_parse(pl, str_from("ls then wc"));
    check("then-form still splits", vec_len(load64(plt + 56)) == 2);
    # Direct confirmation of the underlying contract, so the reason stays pinned
    # even if the parser changes: a literal at str_split's sep does NOT split.
    check("str_split with str_from splits",
      vec_len(str_split(str_from("a | b"), str_from(" | "))) == 2);
    check("str_split with a byte separator splits",
      vec_len(str_split(str_from("a\nb"), 10)) == 2);

    # safe_branch_name_in_str — the ADR-006 Str twin. prompt_detect_git_branch
    # returns a Str, so the cstring original read the fat-pointer header and the
    # ANSI-escape guard on a value taken out of .git/HEAD never fired.
    check("branch name plain ok", safe_branch_name_in_str(str_from("main")) == 1);
    check("branch name with slash ok", safe_branch_name_in_str(str_from("feat/x")) == 1);
    check("branch name rejects escape", safe_branch_name_in_str(str_from("m\x1b[31main")) == 0);
    check("branch name rejects newline", safe_branch_name_in_str(str_from("a\nb")) == 0);
    check("branch name rejects DEL", safe_branch_name_in_str(str_from("a\x7fb")) == 0);
    check("branch name rejects empty", safe_branch_name_in_str(str_from("")) == 0);
    check("branch name rejects null", safe_branch_name_in_str(0) == 0);

    # audit_format_table held its "NO"/"yes" literals in VARIABLES and passed
    # them to Str-typed str_builder_add — a literal at that parameter is promoted
    # by the compiler, a variable-held one is not, so it read a garbage length.
    check("audit table empty case returns a real Str",
      str_len(audit_format_table(vec_new())) > 0);
    var atv = vec_new();
    vec_push(atv, AuditEntry_new(str_from("user"), str_from("AI-AUTO"),
        str_from("show files"), str_from("ls"), 1, str_from("proposed")));
    vec_push(atv, AuditEntry_new(str_from("user"), str_from("STRICT"),
        str_from("dd if=/dev/zero"), str_from("dd"), 0, str_from("blocked")));
    var att = audit_format_table(atv);
    check("audit table renders both rows", str_contains(att, str_from("dd")) == 1);
    check("audit table renders the approved column", str_contains(att, str_from("yes")) == 1);
    check("audit table renders the denied column", str_contains(att, str_from("NO")) == 1);

    # ---- SERVICE_CONTROL / GIT_STASH were entirely dead ----
    # ⛔ The parser stored bare cstring LITERALS into `intent + 8`
    # (`store64(intent + 8, "start")`), a field every consumer reads as a Str.
    # The field read back as garbage, every translator refused it, and two whole
    # intent categories emitted `echo` for the shell's entire history. Same bug
    # class as the 1.9.1 SHELL_COMMAND classifier, on the PRODUCING side.
    # Found by verifying the documented examples in docs/examples/ against the
    # binary — 5 of 46 rows did not match.
    var sv = Interpreter_new();
    var sv1 = Interpreter_translate(sv, Interpreter_parse(sv, str_from("start service nginx")));
    check("service control -> systemctl", streq(load64(sv1), "systemctl") == 1);
    # Since 2.0.0 Translation.args are cstrings (translate.cyr, ADR-006), so they compare directly —
    # the str_cstr these used to wrap them in now reads a cstring as a Str header.
    check("service control action survives",
      streq(vec_get(load64(sv1 + 8), 0), "start") == 1);
    var sv2 = Interpreter_translate(sv, Interpreter_parse(sv, str_from("restart service sshd")));
    check("service restart -> systemctl", streq(load64(sv2), "systemctl") == 1);
    var gs1 = Interpreter_translate(sv, Interpreter_parse(sv, str_from("git stash")));
    check("git stash -> git", streq(load64(gs1), "git") == 1);
    var gs2 = Interpreter_translate(sv, Interpreter_parse(sv, str_from("git stash pop")));
    check("git stash pop -> git", streq(load64(gs2), "git") == 1);
    check("git stash pop keeps its subcommand",
      streq(vec_get(load64(gs2 + 8), 1), "pop") == 1);
    # The stored field must be a real Str, not a cstring address.
    var svp = Interpreter_parse(sv, str_from("start service nginx"));
    check("intent field is a usable Str", str_len(load64(svp + 8)) == 5);

    # ---- 1.9.6 optimization: behaviour pinned across the rewrites ----
    # is_safe_path was four passes (two predicates, each with its own strlen and
    # scan) and is now one fused pass. The dot logic is the subtle part: a
    # SINGLE dot is fine, two CONSECUTIVE dots are traversal, and dots separated
    # by other characters must reset.
    check("safe_path plain", is_safe_path("/tmp/file.txt") == 1);
    check("safe_path single dot ok", is_safe_path("/tmp/.hidden") == 1);
    check("safe_path dots not adjacent ok", is_safe_path("/tmp/a.b.c") == 1);
    check("safe_path bare dot ok", is_safe_path(".") == 1);
    check("safe_path double dot rejected", is_safe_path("..") == 0);
    check("safe_path traversal rejected", is_safe_path("/tmp/../etc/shadow") == 0);
    check("safe_path embedded double dot rejected", is_safe_path("a..b") == 0);
    check("safe_path metachar rejected", is_safe_path("/tmp/x;evil") == 0);
    check("safe_path backtick rejected", is_safe_path("/tmp/`whoami`") == 0);
    check("safe_path null rejected", is_safe_path(0) == 0);

    # get_command_basename fused strlen+scan into one pass.
    check("basename of absolute", streq(get_command_basename("/usr/bin/dd"), "dd") == 1);
    check("basename of relative", streq(get_command_basename("./chmod"), "chmod") == 1);
    check("basename of bare", streq(get_command_basename("ls"), "ls") == 1);
    check("basename trailing slash -> empty", streq(get_command_basename("/usr/bin/"), "") == 1);
    check("basename of empty", streq(get_command_basename(""), "") == 1);

    # is_word_prefix_range is the shared matcher input_has_word now calls with
    # pre-trimmed bounds; is_word_prefix must still work from a raw needle.
    check("word_prefix finds plural", is_word_prefix(str_from("show files"), "file") == 1);
    check("word_prefix rejects substring", is_word_prefix(str_from("remove x"), "move") == 0);
    check("word_prefix_range equivalent",
      is_word_prefix_range(str_from("show files"), "file", 0, 4) == 1);
    # A padded needle must trim to the same answer through either entry point.
    check("word_prefix trims padding", is_word_prefix(str_from("show files"), " file ") == 1);
    check("input_has_word trims padding", input_has_word(str_from("show files"), " file ") == 1);
    # A phrase needle (internal space) must still dispatch to substring matching.
    check("input_has_word phrase", input_has_word(str_from("go to /tmp"), "go to") == 1);
    check("input_has_word phrase absent", input_has_word(str_from("goto /tmp"), "go to") == 0);

    # input_has_exact_word — the matcher the guards depend on.
    check("exact word matches a whole token",
      input_has_exact_word(str_from("delete user bob"), "user") == 1);
    check("exact word rejects a prefix",
      input_has_exact_word(str_from("remove user_data.txt"), "user") == 0);
    check("exact word matches at end of input",
      input_has_exact_word(str_from("show memory"), "memory") == 1);
    check("exact word is case-insensitive",
      input_has_exact_word(str_from("Delete USER bob"), "user") == 1);
    check("exact word absent -> 0",
      input_has_exact_word(str_from("delete report.txt"), "user") == 0);

    # input_has_phrase — the specific tier's matcher (ADR-007): whole words and
    # bounded phrases, with sentence punctuation as a boundary.
    check("phrase matches a whole word", input_has_phrase(str_from("show memory usage"), "memory") == 1);
    check("phrase rejects a token prefix", input_has_phrase(str_from("delete firewall.log"), "firewall") == 0);
    check("phrase rejects a word suffix", input_has_phrase(str_from("the program"), "ram") == 0);
    check("phrase rejects a snake_case extension",
      input_has_phrase(str_from("remove user_data.txt"), "remove user") == 0);
    check("phrase is case-insensitive", input_has_phrase(str_from("What Is My IP"), "my ip") == 1);
    check("sentence '?' is a boundary", input_has_phrase(str_from("what is my ip?"), "my ip") == 1);
    check("sentence-final '.' is a boundary", input_has_phrase(str_from("show memory."), "memory") == 1);
    check("'.' followed by a word byte is inside a word",
      input_has_phrase(str_from("open memory.txt"), "memory") == 0);
    check("a word after an inner '.' is not a new word",
      input_has_phrase(str_from("open foo.memory"), "memory") == 0);
    check("parentheses are boundaries", input_has_phrase(str_from("(memory)"), "memory") == 1);
    check("a path is one word", input_has_phrase(str_from("ls /var/memory"), "memory") == 0);
    check("a hyphen joins a word", input_has_phrase(str_from("ram-disk"), "ram") == 0);
    check("an empty phrase never matches", input_has_phrase(str_from("anything"), "") == 0);
    check("a phrase longer than the line", input_has_phrase(str_from("ram"), "ram usage") == 0);
    # The helpers the matcher and the PhraseIndex share, so the two cannot drift.
    check("_is_word_byte letter", _is_word_byte(109) == 1);
    check("_is_word_byte slash", _is_word_byte(47) == 1);
    check("_is_word_byte space", _is_word_byte(32) == 0);
    check("_is_word_byte dot", _is_word_byte(46) == 0);
    var wsa = str_data(str_from("a.b c"));
    check("_word_starts_at line start", _word_starts_at(wsa, 0) == 1);
    check("_word_starts_at after an inner dot", _word_starts_at(wsa, 2) == 0);
    check("_word_starts_at after a space", _word_starts_at(wsa, 4) == 1);
    var pat = str_from("my ip.");
    check("_phrase_at hit before a final dot", _phrase_at(str_data(pat), str_len(pat), 0, "my ip") == 1);
    check("_phrase_at miss off the end", _phrase_at(str_data(pat), str_len(pat), 3, "ip address") == 0);
    check("_phrase_at empty phrase", _phrase_at(str_data(pat), str_len(pat), 0, "") == 0);
    # The PhraseIndex — the same answers from one pass over the line.
    # Words: Show My IP then foo mean — `memory` sits after an inner dot, so it is
    # not a word start even though `mean` lets an `me…` phrase past both masks.
    var pxs = str_from("Show My IP. then foo.memory mean");
    var pxb[PIX_BYTES];
    phrase_index(&pxb, pxs);
    check("index counts letter-led words", load64(&pxb + PIX_COUNT) == 6);
    check("index hit", index_has_phrase(&pxb, "my ip") == 1);
    check("index rejects a letter no word starts with", index_has_phrase(&pxb, "uptime") == 0);
    check("index rejects a second letter no word has", index_has_phrase(&pxb, "storage usage") == 0);
    check("index honours the inner-dot rule", index_has_phrase(&pxb, "memory") == 0);
    check("index: an uppercase-led phrase takes the scan", index_has_phrase(&pxb, "My ip") == 1);
    check("index: an empty phrase", index_has_phrase(&pxb, "") == 0);
    # opens_with_file_verb — measured once, compared exactly (not as a prefix).
    check("file verb: delete", opens_with_file_verb(str_from("delete memory dump")) == 1);
    check("file verb: case-insensitive", opens_with_file_verb(str_from("Find files named ram")) == 1);
    check("file verb: a one-word line", opens_with_file_verb(str_from("cd")) == 1);
    check("file verb: a longer word is not the verb", opens_with_file_verb(str_from("deleted memory")) == 0);
    check("file verb: a shorter word is not the verb", opens_with_file_verb(str_from("del memory")) == 0);
    check("file verb: not a verb", opens_with_file_verb(str_from("show memory")) == 0);
    check("_first_word_eq exact", _first_word_eq(str_data(str_from("RM -rf")), 2, "rm") == 1);
    check("_first_word_eq longer verb", _first_word_eq(str_data(str_from("re x")), 2, "read") == 0);
    # trigger_claims — the file-verb rule for every specific trigger (ADR-007).
    check("trigger claims a line with no file verb",
      trigger_claims(str_from("show disk usage"), 0, 0) == 1);
    check("a file verb makes the trigger its object",
      trigger_claims(str_from("delete the disk usage report"), 0, 0) == 0);
    check("a trigger that starts the line is the action",
      trigger_claims(str_from("create user bob"), "create user", 0) == 1);
    check("the second lead is honoured",
      trigger_claims(str_from("remove user bob"), "delete user", "remove user") == 1);
    check("a lead elsewhere in the line does not claim",
      trigger_claims(str_from("copy the create user script"), "create user", 0) == 0);

    check("history flags include TRUNC",
      ((OPEN_WRONLY | OPEN_CREAT | OPEN_TRUNC | OPEN_NOFOLLOW) & OPEN_TRUNC) != 0);

    check("6-arg AuditEntry_new still valid",
      str_contains(AuditEntry_to_json(ax_none), str_from("\"result\":\"denied\"")) == 1);

    # Translator arg validation. Before 1.9.1 the coverage was INVERTED: the
    # low-risk file translators validated their input while every ADMIN-level
    # one (useradd / userdel / passwd / groupadd / firewall) and every git
    # translator emitted parser-supplied arguments verbatim. 16 translators
    # gained a guard; these anchor the ADMIN ones and the git ones, driven
    # through the real parser.
    var e2e_v = Interpreter_new();
    check("useradd refuses metachar arg",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("add user alice;evil")))), "useradd") == 0);
    check("groupadd refuses metachar arg",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("add group dev;evil")))), "groupadd") == 0);
    check("passwd refuses metachar arg",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("change password for alice|evil")))), "passwd") == 0);
    check("git checkout refuses metachar arg",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("git checkout main;evil")))), "git") == 0);
    # ...and must NOT over-reject legitimate input.
    check("useradd accepts a plain username",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("add user alice")))), "useradd") == 1);
    check("groupadd accepts a plain group",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("add group devs")))), "groupadd") == 1);
    check("git checkout accepts a plain branch",
      streq(load64(Interpreter_translate(e2e_v,
            Interpreter_parse(e2e_v, str_from("git checkout main")))), "git") == 1);

    # strip_control_chars — the only prior assertion fed an input with NO
    # control characters, so it would have passed against an empty function.
    var sc = strip_control_chars(str_from("a\x01b\x02c"));
    check("strip_control_chars drops C0", str_len(sc) == 3);

    # json_escape — the audit record is the security-relevant output.
    check("json_escape null is empty Str, not a cstring",
      str_len(json_escape(0)) == 0);
    check("json_escape escapes a quote",
      str_len(json_escape(str_from("a\"b"))) == 4);
    # Well-formed UTF-8 must pass through byte-exact, NOT be mangled into
    # per-byte \u00XX escapes (that would turn "é" into "Ã©").
    check("json_escape preserves valid UTF-8",
      str_len(json_escape(str_from("caf\xc3\xa9"))) == 5);
    # An invalid byte becomes U+FFFD (6 chars: \ u f f f d) so the audit line
    # stays parseable JSON instead of taking the whole log down.
    var jbad = str_builder_new();
    str_builder_add_byte(jbad, 97);
    str_builder_add_byte(jbad, 0xFF);
    check("json_escape replaces invalid byte",
      str_len(json_escape(str_builder_build(jbad))) == 7);

    # ================================================================
    # 1.9.10 — the audit surface, asserted by CONTENT
    # ================================================================
    # Six functions write the security log and NONE of them had an assertion of
    # any kind before this release: audit_one_shot, audit_exec, audit_exec_ctx,
    # audit_exec_bg_done, AuditLogger_log and audit_set_context. The audit trail
    # was simultaneously the most security-relevant code in the tree and the
    # least tested, for the purely structural reason that they resolve their own
    # destination path and a test had nothing to read back.
    #
    # These check what a record SAYS, not merely that a call returned 0. The
    # harness pins chrono_now_rfc3339 to a fixed timestamp, so even that field
    # is assertable.
    var alog = tmp_state_path("agnsh_selftest_audit.log");
    check("tmp_state_path is uid-qualified", _t_mem_find(alog, strlen(alog), "/tmp/agnsh_selftest_audit.log.") == 1);
    xunlink(alog);
    audit_path_override_set(alog);
    check("override redirects audit_log_path", streq(audit_log_path(), alog) == 1);

    # --- audit_one_shot: the PARSE-time record ---
    audit_one_shot("list files", "ls", PermissionLevel.READ_ONLY, "assist",
      IntentTag.LIST_FILES, "List files");
    check("one_shot writes a record", _t_count_nl(alog) == 1);
    check("one_shot records the typed input", _t_file_has(alog, "\"input\":\"list files\"") == 1);
    check("one_shot records the action", _t_file_has(alog, "\"action\":\"ls\"") == 1);
    check("one_shot records the mode", _t_file_has(alog, "\"mode\":\"assist\"") == 1);
    check("one_shot marks READ_ONLY approved", _t_file_has(alog, "\"approved\":1") == 1);
    check("one_shot result is proposed", _t_file_has(alog, "\"result\":\"proposed\"") == 1);
    # exit_code must be present-and-null, not absent: consumers select on a
    # stable record shape, and a missing key is a different thing from "did not
    # run". This is the field the 1.9.2 exec surface added.
    check("one_shot exit_code is null", _t_file_has(alog, "\"exit_code\":null") == 1);
    check("one_shot stamps the timestamp", _t_file_has(alog, "\"timestamp\":\"2026-01-01T00:00:00Z\"") == 1);

    # An ADMIN action is NOT auto-approved — this is the bit an auditor reads.
    xunlink(alog);
    audit_one_shot("install nginx", "apt", PermissionLevel.ADMIN, "human",
      IntentTag.INSTALL_PACKAGE, "Install a package");
    check("one_shot marks ADMIN unapproved", _t_file_has(alog, "\"approved\":0") == 1);

    # --- The log APPENDS. A truncating audit log destroys its own evidence. ---
    xunlink(alog);
    audit_one_shot("a", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    audit_one_shot("b", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    audit_one_shot("c", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    check("audit log appends, never truncates", _t_count_nl(alog) == 3);
    check("the first record survives later writes", _t_file_has(alog, "\"input\":\"a\"") == 1);

    # --- 0600 is enforced on EVERY open, not just on create ---
    # AuditLogger_log re-chmods each time precisely because a log created under
    # a different umask, restored from a backup or copied into place keeps
    # whatever mode it had. Prove the repair, not just the create.
    xunlink(alog);
    var loose = file_open(alog, OPEN_WRONLY | OPEN_CREAT | OPEN_TRUNC, 438);   # 0666
    if (loose >= 0) { file_close(loose); }
    sys_chmod(alog, 438);
    audit_one_shot("x", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    var ast[144];
    check("audit log mode is repaired to 0600 on an existing file",
      xstat(alog, &ast) == 0 && (load32(&ast + STAT_MODE) % 512) == 384);

    # --- audit_exec: the EXEC-time record, a disjoint vocabulary ---
    xunlink(alog);
    check("audit_exec reports success", audit_exec("run /bin/echo", "/bin/echo", "auto", "executed", 0) == 0);
    check("exec records the outcome label", _t_file_has(alog, "\"result\":\"executed\"") == 1);
    check("exec records a real exit code", _t_file_has(alog, "\"exit_code\":0") == 1);
    check("a child that ran was approved", _t_file_has(alog, "\"approved\":1") == 1);

    # A child that ran and FAILED was still approved — `approved` means the
    # shell permitted it, not that it succeeded. Conflating the two would make
    # every failing command read as a policy denial.
    xunlink(alog);
    audit_exec("run /bin/false", "/bin/false", "auto", "failed", 3);
    check("a failing child is still approved", _t_file_has(alog, "\"approved\":1") == 1);
    check("the child's own status is recorded", _t_file_has(alog, "\"exit_code\":3") == 1);

    # ONLY an explicit refusal is unapproved.
    xunlink(alog);
    audit_exec("run /etc/passwd", "/etc/passwd", "human", "denied", AUDIT_NO_EXIT);
    check("a refusal is unapproved", _t_file_has(alog, "\"approved\":0") == 1);
    check("a refusal has no exit code", _t_file_has(alog, "\"exit_code\":null") == 1);

    # --- audit_set_context / audit_exec_ctx ---
    # The context exists so the agnos-only launchers need no signature change.
    # What it must do is attribute the record to the line the USER TYPED, while
    # `action` stays the thing that ran.
    xunlink(alog);
    audit_set_context("run /bin/echo hello", "human");
    audit_exec_ctx("/bin/echo", "launched", AUDIT_NO_EXIT);
    check("ctx attributes the record to the typed line",
      _t_file_has(alog, "\"input\":\"run /bin/echo hello\"") == 1);
    check("ctx keeps action as what actually ran", _t_file_has(alog, "\"action\":\"/bin/echo\"") == 1);
    check("ctx carries the mode", _t_file_has(alog, "\"mode\":\"human\"") == 1);
    check("launched is written with no exit code", _t_file_has(alog, "\"result\":\"launched\"") == 1);

    # With NO context set, audit_exec_ctx must still produce a usable record
    # rather than a null-deref or an empty input — the fallback is the command.
    xunlink(alog);
    audit_set_context(0, 0);
    audit_exec_ctx("/bin/ls", "executed", 0);
    check("ctx falls back to the command when unset", _t_file_has(alog, "\"input\":\"/bin/ls\"") == 1);
    check("ctx falls back to an explicit unknown mode", _t_file_has(alog, "\"mode\":\"unknown\"") == 1);

    # --- audit_exec_bg_done ---
    # ⛔ THE REGRESSION THIS PINS: a background reap happens at some LATER prompt
    # tick, so the dispatch context points at whatever the user most recently
    # typed. Attributing the completion to that line would be an actively wrong
    # audit record — it would name a command that had nothing to do with the job.
    # bg_done therefore uses the stored command as BOTH input and action. That
    # is a deliberate asymmetry with audit_exec_ctx and exactly the kind of thing
    # a later "consistency" cleanup would quietly undo.
    xunlink(alog);
    audit_set_context("some unrelated later line", "assist");
    audit_exec_bg_done("/bin/sleep", 0);
    check("bg_done does NOT attribute the reap to the current line",
      _t_file_has(alog, "some unrelated later line") == 0);
    check("bg_done uses the job's own command as input",
      _t_file_has(alog, "\"input\":\"/bin/sleep\"") == 1);
    check("bg_done still takes mode from the context", _t_file_has(alog, "\"mode\":\"assist\"") == 1);
    check("bg_done maps a clean wait to executed", _t_file_has(alog, "\"result\":\"executed\"") == 1);

    xunlink(alog);
    audit_exec_bg_done("/bin/sleep", 7);
    check("bg_done maps a non-zero wait to failed", _t_file_has(alog, "\"result\":\"failed\"") == 1);
    xunlink(alog);
    audit_exec_bg_done("/bin/sleep", 0 - 1);
    check("bg_done maps a negative wait to error", _t_file_has(alog, "\"result\":\"error\"") == 1);

    # --- AuditLogger_log reports failure instead of pretending ---
    # A record that could not be written must not return success: the caller
    # would otherwise believe the action was logged when nothing was.
    # 1.9.15: and it says so on stderr (it used to fail silently). Captured, so the
    # warning is asserted here instead of leaking into the test run's output.
    var badlog = AuditLogger_new("/proc/definitely/not/writable/agnsh.log");
    var badcap = tmp_state_path("agnsh_selftest_badcap");
    audit_write_warned = 0;
    _t_capture_begin(2, 9, badcap);
    var badrc = AuditLogger_log(badlog, AuditEntry_new(str_from("u"), str_from("m"),
        str_from("i"), str_from("a"), 1, str_from("proposed")));
    _t_capture_end(2, 9);
    check("AuditLogger_log reports an unwritable path", badrc == 0 - 1);
    check("an unwritable audit log is reported on stderr",
      _t_file_has(badcap, "audit record could not be written") == 1);
    # The helper itself: -1 every time, a warning only the first time.
    audit_write_warned = 0;
    _t_capture_begin(2, 9, badcap);
    var awf1 = _audit_write_failed();
    var awf2 = _audit_write_failed();
    _t_capture_end(2, 9);
    check("_audit_write_failed returns -1 every time", awf1 == 0 - 1 && awf2 == 0 - 1);
    check("_audit_write_failed warns only the first time", _t_count_nl(badcap) == 1);
    xunlink(badcap);

    # --- AuditViewer ---
    # Documented as a v1.2.x stub that returns empty until the stdlib alignment
    # is done. Asserted so the stub is a KNOWN empty rather than an unexamined
    # one — if someone implements it, this test is where they find out it had a
    # contract.
    var aview = AuditViewer_new(alog);
    check("AuditViewer_new stores the path", load64(aview) == alog);
    check("AuditViewer_query is a documented empty stub",
      vec_len(AuditViewer_query(aview, AuditFilter_default())) == 0);

    xunlink(alog);
    audit_path_override_set(0);
    check("clearing the override restores real resolution",
      streq(audit_log_path(), alog) == 0);
    audit_set_context(0, 0);

    # ================================================================
    # 1.9.10 — the I/O surfaces, asserted through captured descriptors
    # ================================================================
    # These functions write to a fixed descriptor or read from stdin, so a unit
    # test could not observe them and every one of them was uncovered. Rather
    # than making the descriptor injectable in production code, the test dup2's
    # the descriptor at a scratch file: the shipped code stays exactly as
    # written, which is the point — a seam that changes what ships is testing
    # something other than what ships.
    var cappath = tmp_state_path("agnsh_selftest_cap");

    # --- eprint_str / eprint_line: diagnostics must reach STDERR, not STDOUT ---
    # ⛔ This is the whole reason 1.9.4 existed: every diagnostic went to stdout
    # via println(), so `agnsh -c "..." | jq` received "run: no such command" as
    # if it were data. Asserting the FD is the assertion that matters.
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    eprint_str(str_from("to-stderr"));
    _t_capture_end(2, 9);
    check("eprint_str writes to fd 2", _t_file_has(cappath, "to-stderr") == 1);
    check("eprint_str adds no newline", _t_count_nl(cappath) == 0);

    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    eprint_line(str_from("line-to-stderr"));
    _t_capture_end(2, 9);
    check("eprint_line writes to fd 2", _t_file_has(cappath, "line-to-stderr") == 1);
    check("eprint_line terminates the line", _t_count_nl(cappath) == 1);

    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    check("eprintln_cstr returns 0", eprintln_cstr("cstr-to-stderr") == 0);
    _t_capture_end(2, 9);
    check("eprintln_cstr writes to fd 2", _t_file_has(cappath, "cstr-to-stderr") == 1);
    check("eprintln_cstr terminates the line", _t_count_nl(cappath) == 1);

    # And the negative: a diagnostic must NOT appear on stdout. Without this,
    # the pair above would still pass if the function wrote to both.
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    eprintln_cstr("must-not-reach-stdout");
    _t_capture_end(1, 9);
    check("eprintln_cstr keeps stdout clean", _t_file_has(cappath, "must-not-reach-stdout") == 0);

    # --- verb_out_cstr / verb_out_nl: the confirm PROMPT is on stderr (2.0.0) ---
    # Until 2.0.0 the prompt was stdout "by design", as the interaction. ADR-008 gives
    # stdout to the program `-c` runs, so a prompt there would land in whatever a
    # script captures. Both halves asserted: stderr has it, stdout does not.
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    check("verb_out_cstr returns 0", verb_out_cstr("prompt-text") == 0);
    check("verb_out_nl returns 0", verb_out_nl() == 0);
    _t_capture_end(2, 9);
    check("verb_out_cstr writes to fd 2", _t_file_has(cappath, "prompt-text") == 1);
    check("verb_out_nl emits exactly one newline", _t_count_nl(cappath) == 1);
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    verb_out_cstr("prompt-not-on-stdout");
    _t_capture_end(1, 9);
    check("the prompt keeps stdout clean", _t_file_has(cappath, "prompt-not-on-stdout") == 0);

    # --- verb_read_yes / verb_confirm: the gate in front of every launch ---
    # ⛔ Until 1.9.10 the harness pinned read_line to a constant EOF, so the
    # branch that says YES — the one branch that actually starts a child — was
    # unreachable from any test. Fail-closed was verified; fail-open was not.
    _t_stdin_set("y");
    check("verb_read_yes accepts y", verb_read_yes() == 1);
    _t_stdin_set("Y");
    check("verb_read_yes accepts Y", verb_read_yes() == 1);
    _t_stdin_set("yes");
    check("verb_read_yes accepts yes", verb_read_yes() == 1);
    _t_stdin_set("n");
    check("verb_read_yes rejects n", verb_read_yes() == 0);
    _t_stdin_set("");
    check("verb_read_yes treats an empty line as no", verb_read_yes() == 0);
    _t_stdin_set(0);
    check("verb_read_yes treats EOF as no", verb_read_yes() == 0);
    # A leading space is NOT a yes — the check is on the first byte, so " y"
    # declines. Pinned because a future "be forgiving" tweak here would loosen
    # the launch gate.
    _t_stdin_set(" y");
    check("verb_read_yes does not accept a leading space", verb_read_yes() == 0);

    # 2.0.0: the prompt is on STDERR (ADR-008 — stdout is the program's), so fd 2 is captured.
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    _t_stdin_set("y");
    var vc_yes = verb_confirm("run /bin/echo");
    _t_capture_end(2, 9);
    check("verb_confirm proceeds on y", vc_yes == 1);
    check("verb_confirm shows what it is asking about",
      _t_file_has(cappath, "run /bin/echo") == 1);
    check("verb_confirm shows the y/N prompt", _t_file_has(cappath, "[y/N]") == 1);
    check("verb_confirm does not print aborted when it proceeds",
      _t_file_has(cappath, "(aborted)") == 0);

    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    _t_stdin_set(0);
    var vc_eof = verb_confirm("run /bin/echo");
    _t_capture_end(2, 9);
    check("verb_confirm declines at EOF", vc_eof == 0);
    check("verb_confirm reports the abort", _t_file_has(cappath, "(aborted)") == 1);

    # ⛔ FAIL CLOSED on a null action. str_cat3_cstr returns 0 when its
    # allocation fails, and every caller feeds its result straight in here. If
    # the prompt cannot be rendered the answer must be no — proceeding would run
    # a program the user was never asked about.
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    _t_stdin_set("y");
    var vc_null = verb_confirm(0);
    _t_capture_end(2, 9);
    check("verb_confirm declines when the prompt cannot be rendered", vc_null == 0);
    check("verb_confirm says why it declined",
      _t_file_has(cappath, "cannot render confirmation prompt") == 1);

    # --- sh_cat_owl_warning ---
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    var owl_hit = sh_cat_owl_warning("cat /etc/hosts");
    _t_capture_end(2, 9);
    check("cat is intercepted", owl_hit == 1);
    check("the nudge names owl", _t_file_has(cappath, "owl FILE") == 1);
    xunlink(cappath);
    _t_capture_begin(2, 9, cappath);
    var owl_bare = sh_cat_owl_warning("cat");
    var owl_miss = sh_cat_owl_warning("category of files");
    var owl_miss2 = sh_cat_owl_warning("ls");
    _t_capture_end(2, 9);
    check("bare cat is intercepted", owl_bare == 1);
    check("a word merely starting with cat is not", owl_miss == 0);
    check("an unrelated line is not", owl_miss2 == 0);

    # --- ApprovalManager_request ---
    # Reads fd 0 with a raw SYS_READ rather than through read_line, so the
    # scripted-stdin seam does not reach it; redirect the descriptor instead.
    var apath = tmp_state_path("agnsh_selftest_stdin");
    var apm = ApprovalManager_new();
    var apargs = vec_new();

    # A blocked pattern is refused WITHOUT reading stdin at all — the user is
    # never prompted for something that cannot be approved.
    ApprovalManager_block_pattern(apm, str_from("rm"));
    check("a blocked pattern is denied before any prompt",
      ApprovalManager_request(apm, str_from("rm"), apargs, 0, RiskLevel.LOW) == ApprovalResponse.DENIED);

    var apm2 = ApprovalManager_new();
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_write_cstr(apath, "a\n");
    _t_stdin_from(apath, 8);
    var ar_a = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("approval accepts a", ar_a == ApprovalResponse.APPROVED);
    check("the prompt names the command", _t_file_has(cappath, "systemctl") == 1);
    check("the prompt offers the three choices", _t_file_has(cappath, "[a]pprove") == 1);

    _t_write_cstr(apath, "d\n");
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_from(apath, 8);
    var ar_d = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("approval denies on d", ar_d == ApprovalResponse.DENIED);

    _t_write_cstr(apath, "m\n");
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_from(apath, 8);
    var ar_m = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("approval modifies on m", ar_m == ApprovalResponse.MODIFY);

    # ⛔ FAIL CLOSED: a bare Enter, an unrecognised key and EOF must all refuse.
    # An approval prompt that defaults to yes is worse than no prompt at all.
    _t_write_cstr(apath, "\n");
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_from(apath, 8);
    var ar_nl = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("a bare Enter denies", ar_nl == ApprovalResponse.DENIED);

    _t_write_cstr(apath, "q\n");
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_from(apath, 8);
    var ar_q = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("an unrecognised key denies", ar_q == ApprovalResponse.DENIED);

    _t_write_cstr(apath, "");
    xunlink(cappath);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_from(apath, 8);
    var ar_eof = ApprovalManager_request(apm2, str_from("systemctl"), apargs, 0, RiskLevel.HIGH);
    _t_stdin_restore(8);
    _t_capture_end(1, 9);
    check("EOF times out rather than approving", ar_eof == ApprovalResponse.TIMED_OUT);
    check("TIMED_OUT is not APPROVED", ApprovalResponse.TIMED_OUT != ApprovalResponse.APPROVED);

    # An auto-approving manager still short-circuits only LOW risk.
    var apm3 = ApprovalManager_new();
    store64(apm3 + 8, 1);
    check("auto-approve applies to LOW risk without reading stdin",
      ApprovalManager_request(apm3, str_from("ls"), apargs, 0, RiskLevel.LOW) == ApprovalResponse.APPROVED);
    xunlink(apath);

    # ================================================================
    # 1.9.10 — history persistence, asserted on disk
    # ================================================================
    var hpath = tmp_state_path("agnsh_selftest_hist");
    xunlink(hpath);
    var hh = CommandHistory_new(hpath, 3);
    CommandHistory_add(hh, "one");
    CommandHistory_add(hh, "two");
    CommandHistory_add(hh, "three");
    CommandHistory_add(hh, "four");
    CommandHistory_add(hh, "five");
    CommandHistory_save(hh);
    # ⛔ The on-disk file must honour the cap even though CommandHistory_add
    # trims lazily — `count` can transiently exceed max_size, and a save that
    # ignored that would grow the file without bound.
    check("save honours the cap", _t_count_nl(hpath) == 3);
    check("save keeps the most recent entries", _t_file_has(hpath, "five") == 1);
    check("save drops the oldest entries", _t_file_has(hpath, "one") == 0);
    var hst[144];
    check("the history file is 0600",
      xstat(hpath, &hst) == 0 && (load32(&hst + STAT_MODE) % 512) == 384);
    # 1.9.15: the mode is repaired through the OPEN fd (fchmod), not the path — so an
    # EXISTING file with a looser mode must still come back 0600 after a save. (A new
    # file is created 0600 at open, which is why the check above cannot see this path.)
    sys_chmod(hpath, 420);                                    # 0644
    CommandHistory_save(hh);
    check("save repairs an existing history file to 0600",
      xstat(hpath, &hst) == 0 && (load32(&hst + STAT_MODE) % 512) == 384);

    # Round-trip: what was saved must load back.
    # ⛔ THIS TEST FAILED THE FIRST TIME IT WAS WRITTEN, and the bug was in the
    # shell, not the test. CommandHistory_save terminates every entry with '\n',
    # so str_split on load left a trailing EMPTY element; the load cap counted it
    # as a line and started one entry too far in, silently dropping the OLDEST
    # real command on every startup. A full 1000-entry history loaded 999. The
    # empty element was filtered out downstream, so nothing ever looked wrong.
    # Nothing had round-tripped a saved file back through the loader until now.
    var hh2 = CommandHistory_new(hpath, 3);
    check("history round-trips through the file", load64(hh2 + 8) == 3);
    check("the round-trip keeps the oldest kept entry",
      str_contains(vec_get(load64(hh2), 0), str_from("three")) == 1);
    check("the round-trip keeps the newest entry",
      str_contains(vec_get(load64(hh2), 2), str_from("five")) == 1);

    # A file with NO trailing newline must load the same count — the two spellings
    # of "three entries" cannot disagree.
    _t_write_cstr(hpath, "three\nfour\nfive");
    check("a file without a trailing newline loads the same count",
      load64(CommandHistory_new(hpath, 3) + 8) == 3);

    # And the cap still bites when the file genuinely exceeds it.
    _t_write_cstr(hpath, "a\nb\nc\nd\ne\n");
    var hh3 = CommandHistory_new(hpath, 3);
    check("the load cap keeps exactly max_size", load64(hh3 + 8) == 3);
    check("the load cap keeps the NEWEST entries",
      str_contains(vec_get(load64(hh3), 0), str_from("c")) == 1);

    # --- _hist_read_tail: the two-pass tail read (1.9.4) ---
    # Added so a large history file loads its TAIL rather than its head, and
    # never asserted since. Both paths matter: under the cap it reads whole,
    # over the cap it must return the LAST maxlen bytes and say it truncated.
    var tpath = tmp_state_path("agnsh_selftest_tail");
    _t_write_cstr(tpath, "abcdefghij");
    var tbuf[64];
    var tcell2[1];
    var tn = _hist_read_tail(tpath, &tbuf, 64, &tcell2);
    check("tail reads a small file whole", tn == 10);
    check("a small file is not marked truncated", load64(&tcell2) == 0);

    var tn2 = _hist_read_tail(tpath, &tbuf, 4, &tcell2);
    check("tail returns exactly maxlen when over the cap", tn2 == 4);
    check("an over-cap read is marked truncated", load64(&tcell2) == 1);
    # ⛔ THE TAIL, NOT THE HEAD. A read that returned "abcd" would look correct
    # by length and be the wrong end of the file — the newest history lost and
    # the oldest kept.
    check("tail keeps the END of the file",
      load8(&tbuf) == 103 && load8(&tbuf + 3) == 106);
    check("a missing file reports failure",
      _hist_read_tail(tmp_state_path("agnsh_selftest_absent"), &tbuf, 64, &tcell2) == 0 - 1);
    xunlink(tpath);
    xunlink(hpath);
    xunlink(cappath);

    # ================================================================
    # 1.9.10 — the three fns credited only by a COMMENT mention
    # ================================================================
    # scripts/check-coverage.sh grepped the raw test files until this release,
    # so naming a function in a comment marked it covered. Fixing the gate
    # exposed these as never actually asserted.
    check("_cmd_eq matches an exact command", _cmd_eq("dd", 100, "dd") == 1);
    check("_cmd_eq rejects a different command", _cmd_eq("ls", 108, "dd") == 0);
    # The first-byte fast path is an optimisation, not a second opinion: a
    # mismatched c0 must reject even when the strings would otherwise match.
    check("_cmd_eq trusts the first-byte prefilter", _cmd_eq("dd", 120, "dd") == 0);
    check("_cmd_eq does not match a prefix", _cmd_eq("ddrescue", 100, "dd") == 0);

    var spargs = vec_new();
    vec_push(spargs, "/etc/passwd");
    check("has_system_path_arg flags /etc", has_system_path_arg(spargs, 1) == 1);
    var spargs2 = vec_new();
    vec_push(spargs2, "/home/user/notes.txt");
    check("has_system_path_arg ignores a home path", has_system_path_arg(spargs2, 1) == 0);
    var spargs3 = vec_new();
    vec_push(spargs3, "-r");
    vec_push(spargs3, "/usr/lib/x");
    check("has_system_path_arg scans every arg", has_system_path_arg(spargs3, 2) == 1);
    check("has_system_path_arg on no args is 0", has_system_path_arg(vec_new(), 0) == 0);

    check("extract_after takes what follows the keyword",
      streq(str_cstr(extract_after(str_from("delete file report.txt"), "file")), "report.txt") == 1);
    check("extract_after skips the separating spaces",
      streq(str_cstr(extract_after(str_from("delete file    report.txt"), "file")), "report.txt") == 1);
    check("extract_after returns 0 when the keyword is absent",
      extract_after(str_from("delete report.txt"), "file") == 0);
    check("extract_after returns 0 when nothing follows",
      extract_after(str_from("delete file"), "file") == 0);
    check("extract_after returns 0 on trailing space only",
      extract_after(str_from("delete file   "), "file") == 0);

    var mcp_t = Translation_with_mcp(str_from("audit"), vec_new(), str_from("d"),
      PermissionLevel.READ_ONLY, str_from("e"), str_from("audit_query"), str_from("{}"));
    check("Translation_with_mcp stores the tool", streq(str_cstr(load64(mcp_t + 40)), "audit_query") == 1);
    check("Translation_with_mcp stores the payload", streq(str_cstr(load64(mcp_t + 48)), "{}") == 1);
    check("Translation_with_mcp keeps the permission", load64(mcp_t + 24) == PermissionLevel.READ_ONLY);

    # ================================================================
    # 1.9.10 — sh_run_program: the launch gate
    # ================================================================
    # The function that decides whether an arbitrary on-disk binary runs. It was
    # the last host-reachable function in the tree with no assertion of any kind,
    # for the structural reason that it lived in the entry file; moved to
    # run_agnos.cyr in this release so it can be exercised.
    var rpath2 = tmp_state_path("agnsh_selftest_run.log");

    # ⛔ HUMAN MODE MUST NOT LAUNCH ON A DECLINED CONFIRM, and must say so in the
    # audit log. This is the one gate standing between a natural-language shell
    # and running an arbitrary binary; before 1.9.10 nothing tested it.
    xunlink(rpath2);
    audit_path_override_set(rpath2);
    audit_set_context("run /bin/true", "human");
    _t_capture_begin(1, 9, cappath);
    _t_stdin_set(0);
    var rr_declined = sh_run_program("/bin/true", Mode.HUMAN);
    _t_capture_end(1, 9);
    # 2.0.0: a refusal is EXIT_NOT_RUN (126), a launch that cannot happen EXIT_NOTHING_TO_RUN (127) —
    # the shell's own codes (ADR-008 § 4); both were 1 before.
    check("a declined confirm refuses to launch", rr_declined == EXIT_NOT_RUN);
    check("a declined launch is audited as denied", _t_file_has(rpath2, "\"result\":\"denied\"") == 1);
    check("a declined launch is audited as unapproved", _t_file_has(rpath2, "\"approved\":0") == 1);
    # ⛔ AND IT MUST NOT HAVE LAUNCHED. A `launched` record here would mean the
    # confirm was asked for, declined, and the program started anyway.
    check("a declined launch writes no launched record",
      _t_file_has(rpath2, "\"result\":\"launched\"") == 0);

    # An accepted confirm in HUMAN mode does launch, and produces the PAIR:
    # `launched` before the child starts, then the outcome. The pair is the
    # point — a launched with no matching outcome is the signal that a child
    # hung or took the machine down.
    xunlink(rpath2);
    _t_capture_begin(1, 9, cappath);
    _t_stdin_set("y");
    var rr_ok = sh_run_program("/bin/true", Mode.HUMAN);
    _t_capture_end(1, 9);
    check("an accepted confirm launches", rr_ok == 0);
    check("the launch is recorded before the child starts",
      _t_file_has(rpath2, "\"result\":\"launched\"") == 1);
    check("the outcome is recorded after it", _t_file_has(rpath2, "\"result\":\"executed\"") == 1);
    check("launched and outcome are two separate records", _t_count_nl(rpath2) == 2);

    # AUTO mode does not prompt at all — it must not consume stdin, and must
    # still write both records.
    xunlink(rpath2);
    _t_stdin_set("n");
    var rr_auto = sh_run_program("/bin/true", Mode.AI_AUTONOMOUS);
    check("AUTO mode launches without prompting", rr_auto == 0);
    check("AUTO mode does not consume the confirm answer", _t_stdin_reads == 0);
    check("AUTO mode still audits the launch", _t_count_nl(rpath2) == 2);

    # A non-zero child status is passed through, not swallowed, and lands in the
    # audit record as `failed` with the child's own code.
    xunlink(rpath2);
    var rr_false = sh_run_program("/bin/false", Mode.AI_AUTONOMOUS);
    check("a failing child's status is returned", rr_false == 1);
    check("a failing child is audited as failed", _t_file_has(rpath2, "\"result\":\"failed\"") == 1);
    check("a failing child's own exit code is recorded", _t_file_has(rpath2, "\"exit_code\":1") == 1);

    # A launch that cannot happen at all is an `error`, distinct from a child
    # that ran and failed — an operator reading the log must be able to tell
    # "never started" from "started and returned non-zero".
    xunlink(rpath2);
    var rr_missing = sh_run_program("/nonexistent/agnsh/selftest/binary", Mode.AI_AUTONOMOUS);
    check("a missing binary reports failure", rr_missing == EXIT_NOTHING_TO_RUN);
    check("a failed launch is audited as error", _t_file_has(rpath2, "\"result\":\"error\"") == 1);
    check("a failed launch is distinct from a failed child",
      _t_file_has(rpath2, "\"result\":\"failed\"") == 0);
    # ...and it must not claim a launch that never happened.
    check("a failed launch writes no launched record",
      _t_file_has(rpath2, "\"result\":\"launched\"") == 0);
    check("a failed launch is one record, not a pair", _t_count_nl(rpath2) == 1);

    xunlink(rpath2);
    audit_path_override_set(0);
    audit_set_context(0, 0);
    _t_stdin_set(0);

    # ================================================================
    # 1.9.13 — the state files refuse a planted symlink, on every arch
    # ================================================================
    # ⛔ The open-flag pins passed for twelve releases while the aarch64 build
    # followed symlinks (see the 1.9.4 block). This drives the REAL writers
    # through a REAL symlink, so it fails on any arch whose OPEN_NOFOLLOW is
    # wrong — proven when written: the aarch64 build of this file, run under
    # qemu-aarch64 with the 1.9.12 constant restored, fails the write-through
    # and re-permission checks below.
    var sl_target = tmp_state_path("agnsh_selftest_symlink_target");
    var sl_link = tmp_state_path("agnsh_selftest_symlink");
    xunlink(sl_link);
    xunlink(sl_target);
    _t_write_cstr(sl_target, "not a state file\n");
    sys_chmod(sl_target, 420);   # 0644, so a re-permission to 0600 is visible
    check("the test can plant a symlink", sys_symlink(sl_target, sl_link) == 0);

    # The audit writer APPENDS, then re-asserts 0600 by path.
    # 1.9.15: a refused audit write is no longer silent — it warns on stderr, once per
    # process. Two refused writes in the capture window must produce ONE warning line.
    audit_write_warned = 0;
    audit_path_override_set(sl_link);
    _t_capture_begin(2, 9, cappath);
    audit_one_shot("planted", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    audit_one_shot("planted again", "ls", PermissionLevel.SAFE, "auto", IntentTag.LIST_FILES, "d");
    _t_capture_end(2, 9);
    audit_path_override_set(0);
    check("the audit writer does not write through a symlinked log",
      _t_file_has(sl_target, "planted") == 0);
    check("the audit writer leaves the symlink target's length alone",
      _t_count_nl(sl_target) == 1);
    check("a refused audit write says so on stderr",
      _t_file_has(cappath, "audit record could not be written") == 1);
    check("...once per process, not once per command", _t_count_nl(cappath) == 1);

    # The history save TRUNCATES: through a symlink it rewrites the target, capped
    # at the history size — the destructive half of the bug. Its refusal goes to
    # stderr; capture it so the warning is asserted rather than just printed.
    var slh = CommandHistory_new(sl_link, 3);
    CommandHistory_add(slh, "planted");
    _t_capture_begin(2, 9, cappath);
    CommandHistory_save(slh);
    _t_capture_end(2, 9);
    check("the history save does not write through a symlinked file",
      _t_file_has(sl_target, "planted") == 0);
    check("the symlink target keeps its content",
      _t_file_has(sl_target, "not a state file") == 1);
    check("a refused history save says so on stderr",
      _t_file_has(cappath, "could not open history file") == 1);

    var slst[144];
    check("the symlink target is not re-permissioned to 0600",
      xstat(sl_target, &slst) == 0 && (load32(&slst + STAT_MODE) % 512) == 420);
    xunlink(sl_link);
    xunlink(sl_target);

    # ================================================================
    # 2.0.0 — the NL report folder (ADR-008)
    # ================================================================
    # The path rule: XDG_STATE_HOME if absolute, else $HOME/.local/state, else /tmp by uid.
    check("report dir from an absolute XDG_STATE_HOME",
      streq(report_dir_from("/x/state", "/home/u"), "/x/state/agnoshi/reports") == 1);
    check("report dir drops XDG_STATE_HOME's trailing slash",
      streq(report_dir_from("/x/state/", "/home/u"), "/x/state/agnoshi/reports") == 1);
    check("a relative XDG_STATE_HOME is ignored (XDG rule)",
      streq(report_dir_from("rel/state", "/home/u"), "/home/u/.local/state/agnoshi/reports") == 1);
    check("an empty XDG_STATE_HOME is ignored",
      streq(report_dir_from("", "/home/u"), "/home/u/.local/state/agnoshi/reports") == 1);
    check("HOME=/ gives /.local/state, not //.local/state",
      streq(report_dir_from(0, "/"), "/.local/state/agnoshi/reports") == 1);
    check("HOME's trailing slash is dropped",
      streq(report_dir_from(0, "/home/u/"), "/home/u/.local/state/agnoshi/reports") == 1);
    check("a relative HOME falls back to /tmp by uid",
      streq(report_dir_from(0, "relhome"), tmp_state_path("agnoshi-reports")) == 1);
    check("no HOME falls back to /tmp by uid",
      streq(report_dir_from(0, 0), tmp_state_path("agnoshi-reports")) == 1);
    check("report_dir follows the host rule",
      streq(report_dir(), report_dir_from(getenv("XDG_STATE_HOME"), getenv("HOME"))) == 1);
    check("_report_join drops one trailing slash", streq(_report_join("/a/", "/b"), "/a/b") == 1);
    check("_report_join from the root", streq(_report_join("/", "/x"), "/x") == 1);
    var rdig[24];
    check("_report_put_uint writes zero", _report_put_uint(&rdig, 0) == 1 && load8(&rdig) == 48);
    check("_report_put_uint writes every digit", _report_put_uint(&rdig, 12345) == 5
      && load8(&rdig) == 49 && load8(&rdig + 4) == 53);
    check("_report_put refuses no path", _report_put(0, str_from("x"), OPEN_TRUNC) == 0 - 1);
    # Names: fixed-width UTC stamp first, so they sort in time order.
    check("report name at the epoch", streq(report_file_name(0, 42, 0), "19700101T000000Z-42.txt") == 1);
    check("report name for a real time",
      streq(report_file_name(1758686131, 7, 0), "20250924T035531Z-7.txt") == 1);
    check("a second report in the same second gets a sequence number",
      streq(report_file_name(1758686131, 7, 2), "20250924T035531Z-7-2.txt") == 1);
    check("a sequenced name is a report name", _report_is_name(str_from("20250924T035531Z-7-2.txt")) == 1);
    check("a name ending in a dash is not", _report_is_name(str_from("20250924T035531Z-7-.txt")) == 0);
    check("a name with two sequence dashes is not",
      _report_is_name(str_from("20250924T035531Z-7-2-3.txt")) == 0);
    check("a report name is recognised", _report_is_name(str_from("20250924T035531Z-12345.txt")) == 1);
    check("latest.txt is not a report name", _report_is_name(str_from("latest.txt")) == 0);
    check("a name with no pid is not a report", _report_is_name(str_from("20250924T035531Z-.txt")) == 0);
    check("a name without the T is not a report", _report_is_name(str_from("20250924X035531Z-1.txt")) == 0);
    check("a name with another extension is not a report",
      _report_is_name(str_from("20250924T035531Z-1.log")) == 0);
    check("names order by time", _report_name_less(str_from("20250924T035531Z-9.txt"),
        str_from("20250924T035532Z-1.txt")) == 1);
    # The folder: created 0700; refused when it is a symlink or others can write it.
    var rdir = tmp_state_path("agnsh_selftest_reports");
    report_prune(rdir, 0);
    xunlink(str_cat3_cstr(rdir, "/", "latest.txt"));
    xunlink(str_cat3_cstr(rdir, "/", "notes.txt"));
    xrmdir(rdir);
    check("a fresh report folder is usable", report_dir_prepare(rdir) == 0);
    var rst[144];
    check("the report folder is created 0700",
      xstat(rdir, &rst) == 0 && (load32(&rst + STAT_MODE) % 512) == 448);
    sys_chmod(rdir, 511);
    check("a report folder others can write is refused",
      streq(report_dir_prepare(rdir), "others can write the report folder") == 1);
    sys_chmod(rdir, 448);
    var rlink = tmp_state_path("agnsh_selftest_reports_link");
    xunlink(rlink);
    sys_symlink(rdir, rlink);
    check("a symlinked report folder is refused",
      streq(report_dir_prepare(rlink), "the report folder is not a directory") == 1);
    xunlink(rlink);
    # Writing: an exclusive per-run file plus latest.txt, both 0600.
    var rbody = str_from("Intent: 0  Command: ls\n");
    var rpath = report_write(rdir, rbody, 1758686131, 7);
    check("a report is written", rpath != 0);
    check("...under its time-and-pid name",
      rpath != 0 && streq(rpath, str_cat3_cstr(rdir, "/", "20250924T035531Z-7.txt")) == 1);
    check("...with the report's content", rpath != 0 && _t_file_has(rpath, "Command: ls") == 1);
    check("...0600", rpath != 0 && xstat(rpath, &rst) == 0 && (load32(&rst + STAT_MODE) % 512) == 384);
    var rlatest = str_cat3_cstr(rdir, "/", "latest.txt");
    check("latest.txt holds the same report", _t_file_has(rlatest, "Command: ls") == 1);
    var rpath_seq = report_write(rdir, str_from("second\n"), 1758686131, 7);
    check("the same second and pid never overwrite a report (exclusive create)",
      _t_file_has(rpath, "second") == 0);
    check("...the second report takes the next sequence number", rpath_seq != 0
      && streq(rpath_seq, str_cat3_cstr(rdir, "/", "20250924T035531Z-7-1.txt")) == 1);
    # latest.txt planted as a symlink: the new report is still written, the target untouched.
    var rltarget = tmp_state_path("agnsh_selftest_latest_target");
    xunlink(rltarget);
    _t_write_cstr(rltarget, "not a report\n");
    xunlink(rlatest);
    sys_symlink(rltarget, rlatest);
    check("a report is written when latest.txt is a symlink",
      report_write(rdir, str_from("third\n"), 1758686132, 7) != 0);
    check("...and latest.txt's symlink target is untouched", _t_file_has(rltarget, "third") == 0);
    xunlink(rlatest);
    xunlink(rltarget);
    # Pruning keeps the newest and never touches latest.txt or a foreign file.
    report_write(rdir, str_from("4\n"), 1758686133, 7);
    report_write(rdir, str_from("5\n"), 1758686134, 7);
    _t_write_cstr(str_cat3_cstr(rdir, "/", "notes.txt"), "keep me\n");
    check("pruning to 2 removes the three oldest", report_prune(rdir, 2) == 3);
    check("...the oldest is gone",
      file_exists(str_cat3_cstr(rdir, "/", "20250924T035531Z-7.txt")) == 0);
    check("...the newest stays",
      file_exists(str_cat3_cstr(rdir, "/", "20250924T035534Z-7.txt")) == 1);
    check("...latest.txt stays", file_exists(rlatest) == 1);
    check("...a foreign file stays", file_exists(str_cat3_cstr(rdir, "/", "notes.txt")) == 1);
    report_prune(rdir, 0);
    xunlink(rlatest);
    xunlink(str_cat3_cstr(rdir, "/", "notes.txt"));
    xrmdir(rdir);

    # ================================================================
    # 2.0.0 — the NL verdict and the -c contract (ADR-008)
    # ================================================================
    var nlaudit = tmp_state_path("agnsh_selftest_nlaudit");
    xunlink(nlaudit);
    audit_path_override_set(nlaudit);
    check("a | line is the pipe form of PIPELINE", nl_is_pipe_line("ls | grep foo") == 1);
    check("a then line is not", nl_is_pipe_line("list files then show disk usage") == 0);
    # One verdict per kind of line: may it run, and if not, why and with which status.
    var nv = nl_verdict("show me all files", "AI-AUTO");
    check("a read-only line may run", load64(nv + NV_RUN) == 1 && load64(nv + NV_STATUS) == 0);
    check("...and its block is the 1.9.x report",
      str_eq_cstr(load64(nv + NV_BLOCK), "Intent: 0  Command: ls\n  Risk: [LOW]\n") == 1);
    nv = nl_verdict("copy a to b", "AI-AUTO");
    check("a user-write line does not run yet", load64(nv + NV_RUN) == 0 && load64(nv + NV_STATUS) == 126);
    check("...because it needs approval", streq(load64(nv + NV_REASON), "approval required") == 1);
    check("...and its block says it was not executed",
      str_contains_cstr(load64(nv + NV_BLOCK), "Approval required -- not executed") == 1);
    nv = nl_verdict("rm -rf /tmp/foo", "AI-AUTO");
    check("a blocked line is 126, blocked",
      load64(nv + NV_STATUS) == 126 && streq(load64(nv + NV_REASON), "blocked") == 1);
    check("...with the BLOCKED line", str_contains_cstr(load64(nv + NV_BLOCK), "WARNING: BLOCKED") == 1);
    nv = nl_verdict("what is dns", "AI-AUTO");
    check("a question is 127", load64(nv + NV_STATUS) == 127 && streq(load64(nv + NV_REASON), "a question") == 1);
    nv = nl_verdict("ls | grep foo", "AI-AUTO");
    check("a | line under the classifier is 127, a shell pipeline",
      load64(nv + NV_STATUS) == 127 && streq(load64(nv + NV_REASON), "a shell pipeline") == 1);
    check("...and on the host the hint says there is no pipeline launcher",
      str_contains_cstr(load64(nv + NV_BLOCK), "no pipeline launcher yet") == 1);
    nv = nl_verdict("list files then show disk usage", "AI-AUTO");
    check("a then request is 127, a multi-step request",
      load64(nv + NV_STATUS) == 127 && streq(load64(nv + NV_REASON), "a multi-step request") == 1);
    nv = nl_verdict("remove ../etc/passwd", "AI-AUTO");
    check("refused arguments are 126",
      load64(nv + NV_STATUS) == 126 && streq(load64(nv + NV_REASON), "arguments refused by the safety checks") == 1);
    nv = nl_verdict("", "AI-AUTO");
    check("an empty line is 127, not understood",
      load64(nv + NV_STATUS) == 127 && str_eq_cstr(load64(nv + NV_BLOCK), "Intent: 43 (UNKNOWN)\n") == 1);
    nv = nl_verdict("xyzzy plugh", "AI-AUTO");
    check("an unknown command is 127, not a known command -- not an approval case",
      load64(nv + NV_STATUS) == 127 && streq(load64(nv + NV_REASON), "not a known command") == 1);
    check("...and its block does not claim approval would run it",
      str_contains_cstr(load64(nv + NV_BLOCK), "Approval required") == 0);
    check("the parse-time audit record is still written", _t_file_has(nlaudit, "copy a to b") == 1);
    var nvx = alloc(NV_BYTES);
    var nsb = str_builder_new();
    str_builder_add_cstr(nsb, "block\n");
    _nv_not_run(nvx, nsb, "why", 127);
    check("_nv_not_run fills the verdict", load64(nvx + NV_RUN) == 0 && load64(nvx + NV_STATUS) == 127
      && streq(load64(nvx + NV_REASON), "why") == 1 && str_eq_cstr(load64(nvx + NV_BLOCK), "block\n") == 1);
    # The filed report and its result line.
    check("nl_outcome for a run", str_eq_cstr(nl_outcome(3, 0), "executed, exit 3") == 1);
    check("nl_outcome for a refusal", str_eq_cstr(nl_outcome(0, "blocked"), "not executed: blocked") == 1);
    var nrt = nl_report_text(nl_verdict("show me all files", "HUMAN"), "show me all files", "HUMAN",
      "T0", str_from("R0"));
    check("the report opens with the input, mode and time",
      str_starts_with(nrt, str_from("input: show me all files\nmode: HUMAN\ntime: T0\nIntent: 0")) == 1);
    check("the report ends with the result", str_ends_with(nrt, str_from("result: R0\n")) == 1);
    # nl_run_c: --dry-run prints the block on stdout, runs nothing, and files the report.
    var nldir = tmp_state_path("agnsh_selftest_nlreports");
    var nllatest = str_cat3_cstr(nldir, "/", "latest.txt");
    report_prune(nldir, 0);
    xunlink(nllatest);
    xrmdir(nldir);
    var capout = tmp_state_path("agnsh_selftest_capout");
    var caperr = tmp_state_path("agnsh_selftest_caperr");
    # NL execution (2.0.0): the translation as a command line, its program resolved on $PATH.
    var ncl = nl_command_line(load64(nl_verdict("show me all files", "AI-AUTO") + NV_TRANSLATION));
    check("the command line starts with the resolved program",
      ncl != 0 && load8(ncl) == 47 && _t_ends_with(ncl, "ls -a") == 1);
    var nfake_args = vec_new();
    vec_push(nfake_args, 0);
    vec_push(nfake_args, "x");
    var nfake = Translation_new("agnsh_no_such_prog_selftest", nfake_args, "d", PermissionLevel.READ_ONLY, "e");
    check("a program this host does not have gives no command line", nl_command_line(nfake) == 0);
    var nfake2 = Translation_new("sh", nfake_args, "d", PermissionLevel.READ_ONLY, "e");
    check("an absent argument is skipped", _t_ends_with(nl_command_line(nfake2), "sh x") == 1);
    var nvf = alloc(NV_BYTES);
    store64(nvf + NV_TRANSLATION, nfake);
    _t_capture_begin(2, 10, caperr);
    var nlf = nl_launch(nvf, Mode.AI_AUTONOMOUS);
    _t_capture_end(2, 10);
    check("nl_launch: no such program is LAUNCH_FAILED", nlf == LAUNCH_FAILED);
    check("...and says so", _t_file_has(caperr, "no such command on this system") == 1);
    # sh_launch_line keeps "no child ran" apart from a child's own status.
    check("sh_launch_line returns the child's status", sh_launch_line("/bin/false", Mode.AI_AUTONOMOUS) == 1);
    _t_capture_begin(2, 10, caperr);
    var sll_miss = sh_launch_line("/nonexistent/agnsh/selftest", Mode.AI_AUTONOMOUS);
    _t_stdin_set(0);
    var sll_decl = sh_launch_line("/bin/true", Mode.HUMAN);
    _t_capture_end(2, 10);
    check("sh_launch_line: a missing program is LAUNCH_FAILED", sll_miss == LAUNCH_FAILED);
    check("sh_launch_line: a declined prompt is LAUNCH_DECLINED", sll_decl == LAUNCH_DECLINED);
    # arg_cstr: a parser field (Str) becomes a cstring argument; an absent field stays absent.
    check("arg_cstr converts a Str", streq(arg_cstr(str_from("x.txt")), "x.txt") == 1);
    check("arg_cstr keeps an absent field absent", arg_cstr(0) == 0);
    _t_capture_begin(1, 9, capout);
    var nlr = nl_launch(nl_verdict("show me all files", "AI-AUTO"), Mode.AI_AUTONOMOUS);
    _t_capture_end(1, 9);
    check("nl_launch runs a read-only translation", nlr == 0);
    check("...whose output is the program's", _t_file_has(capout, "VERSION") == 1);
    _t_capture_begin(1, 9, capout);
    _t_capture_begin(2, 10, caperr);
    var nls = nl_run_c("show me all files", Mode.AI_AUTONOMOUS, 1, nldir);
    _t_capture_end(2, 10);
    _t_capture_end(1, 9);
    check("--dry-run exits 0 for a line that would run", nls == 0);
    check("--dry-run prints the report block on stdout", _t_file_has(capout, "Intent: 0  Command: ls") == 1);
    check("--dry-run adds nothing on stderr", _t_count_nl(caperr) == 0);
    check("--dry-run files the report", _t_file_has(nllatest, "result: not executed: dry run") == 1);
    # A line that does not run: stdout empty, one stderr line naming the reason and the report.
    _t_capture_begin(1, 9, capout);
    _t_capture_begin(2, 10, caperr);
    nls = nl_run_c("copy a to b", Mode.AI_AUTONOMOUS, 0, nldir);
    _t_capture_end(2, 10);
    _t_capture_end(1, 9);
    check("a line that does not run exits 126", nls == 126);
    check("...leaving stdout empty", _t_slurp(capout) == 0);
    check("...with one stderr line naming the reason and the report",
      _t_file_has(caperr, "agnsh: not executed: approval required -- report: ") == 1 && _t_count_nl(caperr) == 1);
    check("...whose report records the input", _t_file_has(nllatest, "input: copy a to b") == 1);
    check("...and the result", _t_file_has(nllatest, "result: not executed: approval required") == 1);
    # A line that runs: the program's output on stdout, nothing from agnsh on stderr, its status.
    _t_capture_begin(1, 9, capout);
    _t_capture_begin(2, 10, caperr);
    nls = nl_run_c("show me all files", Mode.AI_AUTONOMOUS, 0, nldir);
    _t_capture_end(2, 10);
    _t_capture_end(1, 9);
    check("a read-only line runs under -c and exits with its status", nls == 0);
    check("...stdout is the program's output", _t_file_has(capout, "VERSION") == 1
      && _t_file_has(capout, "Intent:") == 0);
    check("...agnsh says nothing on stderr", _t_count_nl(caperr) == 0);
    check("...and the report records the execution", _t_file_has(nllatest, "result: executed, exit 0") == 1);
    # HUMAN confirms; EOF declines.
    _t_capture_begin(2, 10, caperr);
    _t_stdin_set(0);
    nls = nl_run_c("show me all files", Mode.HUMAN, 0, nldir);
    _t_capture_end(2, 10);
    check("HUMAN mode declines at EOF: 126", nls == 126);
    check("...with the notice", _t_file_has(caperr, "agnsh: not executed: declined") == 1);
    # The interactive path prints the block, then runs.
    _t_capture_begin(1, 9, capout);
    var nli = nl_run_interactive("show me all files", Mode.AI_AUTONOMOUS);
    _t_capture_end(1, 9);
    check("interactive NL prints the report and runs the command", nli == 0
      && _t_file_has(capout, "Intent: 0  Command: ls") == 1 && _t_file_has(capout, "VERSION") == 1);
    _t_capture_begin(1, 9, capout);
    nli = nl_run_interactive("copy a to b", Mode.AI_AUTONOMOUS);
    _t_capture_end(1, 9);
    check("interactive NL does not run what needs approval", nli == 126
      && _t_file_has(capout, "Approval required -- not executed") == 1);
    # 2.0.2 — a restricted session (agnsh as root on a Linux host) runs no natural language.
    var rsaudit = tmp_state_path("agnsh_selftest_rsaudit");
    xunlink(rsaudit);
    audit_path_override_set(rsaudit);
    security_ctx = _mock_sec(1, 1, 0);
    nv = nl_verdict("show me all files", "AI-AUTO");
    check("restricted: a line that would run does not", load64(nv + NV_RUN) == 0
      && load64(nv + NV_STATUS) == 126 && streq(load64(nv + NV_REASON), NL_RESTRICTED) == 1);
    check("...its block says why", str_contains_cstr(load64(nv + NV_BLOCK),
        "Restricted -- not executed: agnsh is running as root") == 1);
    check("...and the verdict marks the shell's own refusal", load64(nv + NV_DENIED) == 1);
    check("nl_audit_denied records that refusal as denied",
      nl_audit_denied(nv) == 1 && _t_count_in(rsaudit, "\"result\":\"denied\"") == 1);
    nv = nl_verdict("copy a to b", "AI-AUTO");
    check("restricted: a line that would not run anyway keeps its reason",
      streq(load64(nv + NV_REASON), "approval required") == 1 && load64(nv + NV_DENIED) == 0
      && str_contains_cstr(load64(nv + NV_BLOCK), "Restricted") == 0);
    check("...and nl_audit_denied writes nothing for it", nl_audit_denied(nv) == 0
      && _t_count_in(rsaudit, "\"result\":\"denied\"") == 1);
    nv = nl_verdict("what is dns", "AI-AUTO");
    check("...and its status", load64(nv + NV_STATUS) == 127 && streq(load64(nv + NV_REASON), "a question") == 1);
    xunlink(rsaudit);
    _t_capture_begin(1, 9, capout);
    _t_capture_begin(2, 10, caperr);
    nls = nl_run_c("show me all files", Mode.AI_AUTONOMOUS, 0, nldir);
    _t_capture_end(2, 10);
    _t_capture_end(1, 9);
    check("restricted -c: 126, and nothing on stdout", nls == 126 && _t_slurp(capout) == 0);
    check("...the notice names the reason and the report",
      _t_file_has(caperr, "agnsh: not executed: running as root (restricted) -- report: ") == 1);
    check("...the report records it",
      _t_file_has(nllatest, "result: not executed: running as root (restricted)") == 1);
    check("...and the audit trail has its proposed and its denied record",
      _t_count_in(rsaudit, "\"result\":\"proposed\"") == 1 && _t_count_in(rsaudit, "\"result\":\"denied\"") == 1);
    _t_capture_begin(1, 9, capout);
    nls = nl_run_c("show me all files", Mode.AI_AUTONOMOUS, 1, nldir);
    _t_capture_end(1, 9);
    check("restricted --dry-run: 126, a line that would not run",
      nls == 126 && _t_file_has(capout, "Restricted -- not executed") == 1);
    check("...which refuses nothing, so it writes no denied record",
      _t_count_in(rsaudit, "\"result\":\"denied\"") == 1);
    _t_capture_begin(1, 9, capout);
    nli = nl_run_interactive("show me all files", Mode.AI_AUTONOMOUS);
    _t_capture_end(1, 9);
    check("restricted interactive: the block and 126, and ls never ran", nli == 126
      && _t_file_has(capout, "Restricted -- not executed") == 1 && _t_file_has(capout, "VERSION") == 0);
    check("...with its denied record", _t_count_in(rsaudit, "\"result\":\"denied\"") == 2);
    security_ctx = 0;
    nv = nl_verdict("show me all files", "AI-AUTO");
    check("unrestricted again, the same line may run", load64(nv + NV_RUN) == 1 && load64(nv + NV_DENIED) == 0);
    audit_path_override_set(nlaudit);
    xunlink(rsaudit);
    # An unusable report folder changes nothing but the notice.
    var nlbad = tmp_state_path("agnsh_selftest_nlbad");
    _t_write_cstr(nlbad, "a file, not a folder\n");
    _t_capture_begin(2, 10, caperr);
    nls = nl_run_c("what is dns", Mode.AI_AUTONOMOUS, 0, nlbad);
    _t_capture_end(2, 10);
    check("an unusable report folder does not change the status", nls == 127);
    check("...and the notice says why there is no report",
      _t_file_has(caperr, "-- no report: cannot create the report folder") == 1);
    xunlink(nlbad);
    report_prune(nldir, 0);
    xunlink(nllatest);
    xrmdir(nldir);
    xunlink(capout);
    xunlink(caperr);
    audit_path_override_set(0);
    xunlink(nlaudit);

    # ================================================================
    # 2.0.0 — the host's resolver, launcher and the shell-line gate (ADR-008 § 3)
    # ================================================================
    var hlog = tmp_state_path("agnsh_selftest_hostlog");
    xunlink(hlog);
    audit_path_override_set(hlog);
    # Program words: a plain name only — never a path, never a metacharacter. sh_prog_word_ok is
    # shared with agnos's bareword launcher since 2.0.1 (it was the host's _host_prog_word_ok).
    check("a program word", sh_prog_word_ok("ls", 2) == 1);
    check("a dotted program word", sh_prog_word_ok("python3.12", 10) == 1);
    check("g++ is a program word", sh_prog_word_ok("g++", 3) == 1);
    check("a path is not a program word", sh_prog_word_ok("a/b", 3) == 0);
    check("a metacharacter is not", sh_prog_word_ok("rm;x", 4) == 0);
    check("an empty word is not", sh_prog_word_ok("", 0) == 0);
    # Only the word is judged, never the rest of the line: agnos refused `ls $HOME` and `what is
    # $HOME` alike until 2.0.1, because it validated the whole line before any lookup.
    check("the word, not the line: `ls` of `ls $HOME`", sh_prog_word_ok("ls $HOME", 2) == 1);
    check("a sentence's `$HOME` is not a program word", sh_prog_word_ok("$HOME", 5) == 0);
    check("nor its `(in`", sh_prog_word_ok("(in", 3) == 0);
    check("nor `what's`", sh_prog_word_ok("what's", 6) == 0);
    # PATH lookup over a folder this test builds: an executable, a plain file, a directory.
    var pdir = tmp_state_path("agnsh_selftest_pathdir");
    var pprog = str_cat3_cstr(pdir, "/", "agnsh_selftest_prog");
    var pnox = str_cat3_cstr(pdir, "/", "agnsh_selftest_noexec");
    var pdirp = str_cat3_cstr(pdir, "/", "agnsh_selftest_dirprog");
    xunlink(pprog);
    xunlink(pnox);
    xrmdir(pdirp);
    xrmdir(pdir);
    xmkdir(pdir, 448);
    _t_write_cstr(pprog, "#!/bin/sh\nexit 7\n");
    sys_chmod(pprog, 448);
    _t_write_cstr(pnox, "not a program\n");
    xmkdir(pdirp, 448);
    check("PATH lookup finds an executable",
      streq(path_lookup_in("agnsh_selftest_prog", 19, pdir), pprog) == 1);
    check("...through a trailing slash, without doubling it",
      streq(path_lookup_in("agnsh_selftest_prog", 19, str_cat3_cstr(pdir, "/", "")), pprog) == 1);
    check("...past earlier entries that do not have it",
      streq(path_lookup_in("agnsh_selftest_prog", 19, str_cat3_cstr("/nonexistent/agnsh:", pdir, "")), pprog) == 1);
    check("a file without the exec bit is not a program", path_lookup_in("agnsh_selftest_noexec", 21, pdir) == 0);
    check("_host_is_exec_file: the executable", _host_is_exec_file(pprog) == 1);
    check("_host_is_exec_file: not the plain file", _host_is_exec_file(pnox) == 0);
    check("_host_is_exec_file: not a directory", _host_is_exec_file(pdirp) == 0);
    check("a directory is not a program", path_lookup_in("agnsh_selftest_dirprog", 22, pdir) == 0);
    # A relative entry is never searched — not even `.` holding the program. Run from inside pdir.
    var pcwd[4096];
    var pcwd_ok = syscall(SYS_GETCWD, &pcwd, 4096);
    sys_chdir(pdir);
    check("a relative PATH entry is never searched, even `.`",
      path_lookup_in("agnsh_selftest_prog", 19, ".") == 0);
    check("an empty PATH entry (the current folder) is never searched",
      path_lookup_in("agnsh_selftest_prog", 19, ":") == 0);
    if (pcwd_ok > 0) { sys_chdir(&pcwd); }
    check("no PATH at all falls back to the standard folders", path_lookup_in("sh", 2, 0) != 0);
    check("path_lookup reads this process's PATH", path_lookup("sh", 2) != 0);
    # argv: whitespace-split, no quoting; a resolved program replaces the first word.
    var hav = host_argv(0, "  a  b\tc ");
    check("host_argv splits on spaces and tabs", vec_len(hav) == 3 && streq(vec_get(hav, 2), "c") == 1);
    hav = host_argv("/x/a", "a b");
    check("host_argv puts the resolved program first",
      streq(vec_get(hav, 0), "/x/a") == 1 && streq(vec_get(hav, 1), "b") == 1);
    check("the environment is readable", host_environ_envp() != 0);
    # The launcher: exit status through, 127 for a program that cannot exec, 128+N for signal N.
    check("host_exec returns the child's status", host_exec(host_argv(pprog, "p")) == 7);
    check("host_exec: a missing program is 127 from the child",
      host_exec(host_argv("/nonexistent/agnsh/selftest", "x")) == 127);
    var hsig = vec_new();
    vec_push(hsig, path_lookup("sh", 2));
    vec_push(hsig, "-c");
    vec_push(hsig, "kill -TERM $$");
    check("a child killed by signal 15 is 143", host_exec(hsig) == 143);
    check("host_exec refuses an empty argv", host_exec(vec_new()) == 0 - 1);
    # Operators are shell syntax: refused on the host, never natural language.
    _t_capture_begin(2, 10, caperr);
    var hop1 = host_refuse_operators("ls | sort");
    var hop2 = host_refuse_operators("echo hi > x");
    var hop3 = host_refuse_operators("sleep 1 &");
    _t_capture_end(2, 10);
    check("a pipeline is refused on the host", hop1 == EXIT_NOTHING_TO_RUN);
    check("a redirect is refused on the host", hop2 == EXIT_NOTHING_TO_RUN);
    check("a background job is refused on the host", hop3 == EXIT_NOTHING_TO_RUN);
    check("...and each says so", _t_file_has(caperr, "pipelines are AGNOS-only") == 1
      && _t_file_has(caperr, "redirects are AGNOS-only") == 1 && _t_file_has(caperr, "background jobs") == 1);
    check("a plain line is not refused", host_refuse_operators("show files") == 0 - 1);
    # The shell-line gate: a BLOCKED line confirms in every mode.
    check("rm -rf is BLOCKED", shell_line_blocked("rm -rf x") == 1);
    check("a plain rm is not", shell_line_blocked("rm x") == 0);
    check("dd by path is BLOCKED (basename)", shell_line_blocked("/usr/bin/dd if=a of=b") == 1);
    check("ls is not", shell_line_blocked("ls -la") == 0);
    _t_stdin_set("n");
    check("an unblocked line in AUTO passes without a prompt", shell_launch_gate("run x", 0, Mode.AI_AUTONOMOUS) == 1
      && _t_stdin_reads == 0);
    _t_capture_begin(2, 10, caperr);
    _t_stdin_set(0);
    var hg_blk = shell_launch_gate("run rm -rf x", 1, Mode.AI_AUTONOMOUS);
    _t_capture_end(2, 10);
    check("a BLOCKED line prompts even in AUTO, and EOF declines", hg_blk == 0);
    check("...naming it BLOCKED", _t_file_has(caperr, "BLOCKED: run rm -rf x") == 1);
    _t_capture_begin(2, 10, caperr);
    _t_stdin_set("y");
    var hg_yes = shell_launch_gate("run rm -rf x", 1, Mode.AI_AUTONOMOUS);
    _t_capture_end(2, 10);
    check("...and an explicit yes proceeds", hg_yes == 1);
    _t_capture_begin(2, 10, caperr);
    _t_stdin_set(0);
    var hg_hum = shell_launch_gate("run x", 0, Mode.HUMAN);
    _t_capture_end(2, 10);
    check("HUMAN still confirms an unblocked line", hg_hum == 0);
    # Shell-first barewords.
    check("a bareword program runs", host_try_bareword_launch("true", Mode.AI_AUTONOMOUS) == 0);
    check("...its status is returned", host_try_bareword_launch("false", Mode.AI_AUTONOMOUS) == 1);
    check("a first word that is not a program falls through to NL",
      host_try_bareword_launch("notaprog_agnsh_selftest arg", Mode.AI_AUTONOMOUS) == 0 - 1);
    _t_capture_begin(2, 10, caperr);
    var hbw_meta = host_try_bareword_launch("ls $HOME", Mode.AI_AUTONOMOUS);
    _t_capture_end(2, 10);
    check("a program line with a metacharacter is refused, not NL", hbw_meta == EXIT_NOT_RUN);
    xunlink(hlog);
    _t_capture_begin(2, 10, caperr);
    _t_stdin_set(0);
    var hbw_blk = host_try_bareword_launch("rm -rf /nonexistent/agnsh/selftest", Mode.AI_AUTONOMOUS);
    _t_capture_end(2, 10);
    check("a typed BLOCKED line declined at EOF is 126", hbw_blk == EXIT_NOT_RUN);
    check("...audited as denied, never launched", _t_file_has(hlog, "\"result\":\"denied\"") == 1
      && _t_file_has(hlog, "\"result\":\"launched\"") == 0);
    # run with arguments on the host (2.0.0).
    _t_capture_begin(1, 9, capout);
    var hrun = sh_run_program("/bin/echo agnsh-run-args", Mode.AI_AUTONOMOUS);
    _t_capture_end(1, 9);
    check("run passes arguments on the host", hrun == 0 && _t_file_has(capout, "agnsh-run-args") == 1);
    xunlink(pprog);
    xunlink(pnox);
    xrmdir(pdirp);
    xrmdir(pdir);
    xunlink(capout);
    xunlink(caperr);
    audit_path_override_set(0);
    xunlink(hlog);

    return report();
}
# Bare top-level call + SYS_EXIT (not `var r = main()` / literal 60) — the
# canonical entry form: correct on host and, if cross-built, on agnos where
# exit is syscall 0 and a module-scope `var r = main()` would run before the
# arg-capture. See CLAUDE.md § Cyrius.
fn _entry(): i64 { var rr = main(); syscall(SYS_EXIT, rr); return 0; }
_entry();
