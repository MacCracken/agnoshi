# agnos_envprint.cyr — a fixture for scripts/agnos-qemu-test.py (2.2.0, ADR-012): prints the PWD and
# OLDPWD it was started with, one `ENVPRINT-<NAME>=<value>` line each, so the test can see what agnsh
# passed a child. On agnos the environment is the init stack's envp, which lib/io.cyr's getenv reads;
# kriya's `env` reads /proc/self/environ, which agnos does not have. Built --agnos and seeded as
# /bin/envprint.
include "lib/string.cyr"
include "lib/syscalls.cyr"

fn _ep_show(name) {
    var v = getenv(name);
    syscall(SYS_WRITE, 1, "ENVPRINT-", 9);
    syscall(SYS_WRITE, 1, name, strlen(name));
    syscall(SYS_WRITE, 1, "=", 1);
    if (v != 0) { syscall(SYS_WRITE, 1, v, strlen(v)); }
    syscall(SYS_WRITE, 1, "\n", 1);
    return 0;
}

fn main() {
    alloc_init();
    _ep_show("PWD");
    _ep_show("OLDPWD");
    return 0;
}

# Bare top-level call (see agnsh.cyr's _agnos_entry).
fn _entry(): i64 {
    var r = main();
    syscall(SYS_EXIT, r);
    return 0;
}
_entry();
