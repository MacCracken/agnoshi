struct Interpreter { initialized; }
fn Interpreter_new() {
    var p = alloc(8);
    store64(p, 1);
    return p;
}
fn input_has_word(input, word) {
    # Compound phrases (internal whitespace, e.g. "go to", "contents of",
    # " in ") match as case-insensitive substrings — their interior spaces
    # naturally anchor at word boundaries in the input. Single-token keywords
    # (e.g. "move", "rm", "file", "ip") go through the token-prefix matcher so
    # "file" finds "files" but "move" does NOT find "remove".
    #
    # ⚡ HOT: the parser makes DOZENS of these per input, and `parse/shell_cmd`
    # falls through the entire natural-language cascade to SHELL_COMMAND, paying
    # ~79 of them for one line. This used to cost SIX passes over the needle —
    # strlen, trim-forward, trim-backward, internal-space scan, and then
    # is_word_prefix repeating the strlen and both trims — all over a
    # compile-time literal.
    #
    # Structured around the overwhelmingly common case: a needle with NO
    # whitespace at all. One pass answers both "how long" and "any space", and
    # a spaceless needle needs no trimming and cannot be a phrase, so it goes
    # straight to the matcher with bounds already known. Only the handful of
    # padded/compound needles pay the careful path.
    var i = 0;
    var anysp = 0;
    while (1 == 1) {
        var c = load8(word + i);
        if (c == 0) { break; }
        if (c == 32) { anysp = 1; }
        if (c == 9) { anysp = 1; }
        i = i + 1;
    }
    if (anysp == 0) {
        if (i == 0) { return 1; }
        return is_word_prefix_range(input, word, 0, i);
    }
    # Whitespace present: it is either padding to trim or a real phrase.
    var w_start = 0;
    var w_end = i;
    while (w_start < w_end) {
        var c2 = load8(word + w_start);
        if (c2 != 32) { if (c2 != 9) { break; } }
        w_start = w_start + 1;
    }
    while (w_end > w_start) {
        var c3 = load8(word + w_end - 1);
        if (c3 != 32) { if (c3 != 9) { break; } }
        w_end = w_end - 1;
    }
    if (w_start >= w_end) { return 1; }        # all-whitespace needle
    for (var k = w_start; k < w_end; k = k + 1) {
        var c4 = load8(word + k);
        if (c4 == 32) { return str_contains_ci(input, word); }
        if (c4 == 9) { return str_contains_ci(input, word); }
    }
    # Padded but single-token (e.g. " rm "): trimmed bounds, no re-derivation.
    return is_word_prefix_range(input, word, w_start, w_end);
}
# ── Specific-tier matching (ADR-007) ──
# Can byte `c` continue a word? Letters, digits, '_', '-' and '/' (so a path or a snake_case
# filename is one word). '.' is decided by the callers: it continues a word only when a word
# byte follows it, so `firewall.log` is one word but a sentence-final `my ip.` ends one.
fn _is_word_byte(c) {
    if (c >= 97) { if (c <= 122) { return 1; } }    # a-z
    if (c >= 65) { if (c <= 90) { return 1; } }     # A-Z
    if (c >= 48) { if (c <= 57) { return 1; } }     # 0-9
    if (c == 95) { return 1; }                      # _
    if (c == 45) { return 1; }                      # -
    if (c == 47) { return 1; }                      # /
    return 0;
}
# Does a word start at offset `i` of `hd`? At the start of the line, or after a byte that
# cannot continue a word — except a '.' that follows a word byte: `foo.memory` is one word.
fn _word_starts_at(hd, i) {
    if (i == 0) { return 1; }
    var pc = load8(hd + i - 1);
    if (_is_word_byte(pc) == 1) { return 0; }
    if (pc == 46) { if (i > 1) { if (_is_word_byte(load8(hd + i - 2)) == 1) { return 0; } } }
    return 1;
}
# Does `phrase` (cstring) match at offset `i` of `hd` (`hlen` bytes) case-insensitively and
# end on a word boundary? `firewall.log` continues past the '.'; a sentence-final `my ip.`
# does not. An empty phrase never matches.
fn _phrase_at(hd, hlen, i, phrase) {
    var j = 0;
    while (1 == 1) {
        var nc = load8(phrase + j);
        if (nc == 0) { break; }
        if (i + j >= hlen) { return 0; }
        var hc = load8(hd + i + j);
        if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
        if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
        if (hc != nc) { return 0; }
        j = j + 1;
    }
    if (j == 0) { return 0; }
    var e = i + j;
    if (e >= hlen) { return 1; }
    var ec = load8(hd + e);
    if (_is_word_byte(ec) == 1) { return 0; }
    if (ec != 46) { return 1; }
    if (e + 1 >= hlen) { return 1; }
    if (_is_word_byte(load8(hd + e + 1)) == 1) { return 0; }
    return 1;
}
# 1 if `phrase` (cstring; one word or several separated by single spaces) occurs in `input`
# (Str) case-insensitively with a word boundary on BOTH ends. Everything the specific tier
# matches has these semantics, because every shadowing bug measured so far was a trigger that
# matched too much: `input_has_word`'s phrase path is a substring match ("remove user" hits
# `remove user_data.txt`) and its word path matches token PREFIXES ("firewall" hits
# `firewall.log`). Unlike input_has_exact_word, sentence punctuation is a boundary here —
# "what is my ip?" still matches `my ip` — because the phrases this tier replaced were
# substring matches that tolerated it.
#
# This is the reference form: it walks the whole line. The tier itself asks a PhraseIndex
# (below), which gives the same answer without re-walking the line for every phrase.
fn input_has_phrase(input, phrase) {
    var hlen = str_len(input);
    var hd = str_data(input);
    for (var i = 0; i < hlen; i = i + 1) {
        if (_word_starts_at(hd, i) == 1) {
            if (_phrase_at(hd, hlen, i, phrase) == 1) { return 1; }
        }
    }
    return 0;
}
# A PhraseIndex answers input_has_phrase for one line without re-walking it per phrase. The
# specific tier asks ~50 phrase questions of EVERY line, and asked by scanning they cost
# 4.3 µs on `show me all files` — 76% of that parse (1.9.16 measurement). The index walks the
# line once and records where each word that starts with a letter begins (every trigger phrase
# starts with one), a mask of those first letters and a mask of the letters that come second.
# A phrase is rejected by an AND unless some word shares its first two letters' masks, and
# the rest are compared only where a word begins with its first letter.
# The caller owns the PIX_BYTES buffer (Interpreter_parse keeps it on its stack).
enum PhraseIx {
    PIX_MASK = 0;       # bit (c - 'a') set when some word starts with the letter c
    PIX_MASK2 = 8;      # bit (c - 'a') set when the letter c is some word's second byte
    PIX_STR = 16;       # the Str that was indexed
    PIX_COUNT = 24;     # letter-led words seen — may exceed PIX_WORDS
    PIX_OFFS = 32;      # their byte offsets, one qword each, for the first PIX_WORDS
    PIX_WORDS = 24;
    PIX_BYTES = 224;    # PIX_OFFS + PIX_WORDS * 8
}
# Word starts are tracked with two flags rather than by calling _word_starts_at per byte —
# `pw`: the previous byte continues a word; `pdot`: it is a '.' inside one (`foo.memory`) —
# and the phrase-index tests hold this to input_has_phrase over the whole corpus.
fn phrase_index(pix, input) {
    var hlen = str_len(input);
    var hd = str_data(input);
    var mask = 0;
    var mask2 = 0;
    var n = 0;
    var pw = 0;
    var pdot = 0;
    for (var i = 0; i < hlen; i = i + 1) {
        var c = load8(hd + i);
        if (pw == 0) {
            if (pdot == 0) {
                var lc = c;
                if (lc >= 65) { if (lc <= 90) { lc = lc + 32; } }
                if (lc >= 97) {
                    if (lc <= 122) {
                        mask = mask | (1 << (lc - 97));
                        if (i + 1 < hlen) {
                            var c1 = load8(hd + i + 1);
                            if (c1 >= 65) { if (c1 <= 90) { c1 = c1 + 32; } }
                            if (c1 >= 97) { if (c1 <= 122) { mask2 = mask2 | (1 << (c1 - 97)); } }
                        }
                        if (n < PIX_WORDS) { store64(pix + PIX_OFFS + n * 8, i); }
                        n = n + 1;
                    }
                }
            }
        }
        pdot = 0;
        if (c == 46) { if (pw == 1) { pdot = 1; } }
        pw = _is_word_byte(c);
    }
    store64(pix + PIX_MASK, mask);
    store64(pix + PIX_MASK2, mask2);
    store64(pix + PIX_STR, input);
    store64(pix + PIX_COUNT, n);
    return pix;
}
# input_has_phrase over an indexed line. Trigger phrases are lowercase; one that does not
# start with a lowercase letter, or a line with more than PIX_WORDS words, falls back to the
# full scan — slower, never different.
fn index_has_phrase(pix, phrase) {
    var p0 = load8(phrase);
    if (p0 < 97) { return input_has_phrase(load64(pix + PIX_STR), phrase); }
    if (p0 > 122) { return input_has_phrase(load64(pix + PIX_STR), phrase); }
    if (((load64(pix + PIX_MASK) >> (p0 - 97)) & 1) == 0) { return 0; }
    var p1 = load8(phrase + 1);
    if (p1 >= 97) {
        if (p1 <= 122) {
            if (((load64(pix + PIX_MASK2) >> (p1 - 97)) & 1) == 0) { return 0; }
        }
    }
    var input = load64(pix + PIX_STR);
    var n = load64(pix + PIX_COUNT);
    if (n > PIX_WORDS) { return input_has_phrase(input, phrase); }
    var hd = str_data(input);
    var hlen = str_len(input);
    for (var k = 0; k < n; k = k + 1) {
        var i = load64(pix + PIX_OFFS + k * 8);
        var c = load8(hd + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c == p0) {
            if (_phrase_at(hd, hlen, i, phrase) == 1) { return 1; }
        }
    }
    return 0;
}
# Are the `wl` bytes at `hd` exactly the lowercase cstring `verb`, ignoring case?
fn _first_word_eq(hd, wl, verb) {
    for (var i = 0; i < wl; i = i + 1) {
        var v = load8(verb + i);
        if (v == 0) { return 0; }                   # the verb is shorter than the word
        var c = load8(hd + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != v) { return 0; }
    }
    if (load8(verb + wl) != 0) { return 0; }        # the verb is longer than the word
    return 1;
}
# Does the sentence open with a FILE-operation verb — parse_file_ops' own triggers, plus the
# shell spellings of the same actions? The specific tier asks through trigger_claims (below).
#
# The first word is measured once and each verb is one bounded compare that usually fails on
# its first byte; 22 prefix checks that each re-measured the verb cost 516 ns.
fn opens_with_file_verb(trimmed) {
    var hd = str_data(trimmed);
    var hlen = str_len(trimmed);
    var wl = 0;
    while (wl < hlen) {
        var c = load8(hd + wl);
        if (c == 32) { break; }
        if (c == 9) { break; }
        wl = wl + 1;
    }
    if (wl == 0) { return 0; }
    if (_first_word_eq(hd, wl, "delete") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "remove") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "rm") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "copy") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "cp") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "duplicate") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "move") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "mv") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "rename") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "find") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "locate") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "search") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "grep") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "read") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "cat") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "open") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "create") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "make") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "go") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "cd") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "change") == 1) { return 1; }
    if (_first_word_eq(hd, wl, "switch") == 1) { return 1; }
    return 0;
}
# The file-verb rule (ADR-007). A sentence that opens with a file verb IS that file operation,
# and a specific trigger later in it only names the operation's object: `delete the disk usage
# report`, `copy the add user script`, `read the firewall rules file`, `find files named ram`.
# With the triggers claiming such sentences, the specific-first order turned every one of them
# into the query or admin action its object mentions. A trigger claims one only when the verb
# is part of the trigger — when `lead1` or `lead2` (phrases, 0 for none) starts the line:
# `delete user bob`, `create group ops`, `change password alice`. Callers ask only after a
# trigger matched, so a line that matches none never pays for the verb check.
fn trigger_claims(trimmed, lead1, lead2) {
    if (opens_with_file_verb(trimmed) == 0) { return 1; }
    var hd = str_data(trimmed);
    var hlen = str_len(trimmed);
    if (lead1 != 0) { if (_phrase_at(hd, hlen, 0, lead1) == 1) { return 1; } }
    if (lead2 != 0) { if (_phrase_at(hd, hlen, 0, lead2) == 1) { return 1; } }
    return 0;
}
fn extract_last_arg(input) {
    var len = str_len(input);
    var pos = len - 1;
    while (pos >= 0) {
        if (str_byte_at(input, pos) != 32) { break; }
        pos = pos - 1;
    }
    var end = pos + 1;
    while (pos >= 0) {
        if (str_byte_at(input, pos) == 32) { break; }
        pos = pos - 1;
    }
    return str_substr(input, pos + 1, end);
}
fn extract_after(input, keyword) {
    var idx = str_find_ci(input, keyword);
    if (idx < 0) { return 0; }
    var start = idx + strlen(keyword);
    var len = str_len(input);
    while (start < len) {
        if (str_byte_at(input, start) != 32) { break; }
        start = start + 1;
    }
    if (start >= len) { return 0; }
    return str_trim(str_substr(input, start, len));
}
fn extract_between(input, before_kw, after_kw) {
    var start_idx = str_find_ci(input, before_kw);
    if (start_idx < 0) { return 0; }
    var start = start_idx + strlen(before_kw);
    var len = str_len(input);
    while (start < len) {
        if (str_byte_at(input, start) != 32) { break; }
        start = start + 1;
    }
    var end_idx = str_find_ci_from(input, after_kw, start);
    if (end_idx < 0) { return str_trim(str_substr(input, start, len)); }
    return str_trim(str_substr(input, start, end_idx));
}
fn parse_show_commands(trimmed) {
    if (input_has_word(trimmed, "file") == 1
      || input_has_word(trimmed, "dir") == 1
      || input_has_word(trimmed, "folder") == 1
      || input_has_word(trimmed, "content") == 1) {
        # `show contents of FILE` is claimed before this parser runs (ADR-007:
        # parse_file_phrases, specific tier). Until 1.9.16 this branch carried a
        # guard to hand that phrase on, because it ran first and "content" claimed it.
        var intent = Intent_new(IntentTag.LIST_FILES);
        var path = extract_after(trimmed, " in ");
        store64(intent + 8, path);
        var opts = 0;
        if (input_has_word(trimmed, "all") == 1) { opts = opts | 1; }
        if (input_has_word(trimmed, "detail") == 1 || input_has_word(trimmed, "long") == 1) { opts = opts | 2; }
        if (input_has_word(trimmed, "size") == 1 || input_has_word(trimmed, "human") == 1) { opts = opts | 4; }
        if (input_has_word(trimmed, "time") == 1 || input_has_word(trimmed, "recent") == 1) { opts = opts | 8; }
        if (input_has_word(trimmed, "recursive") == 1) { opts = opts | 16; }
        store64(intent + 40, opts);
        return intent;
    }
    if (input_has_word(trimmed, "process") == 1
      || input_has_word(trimmed, "task") == 1
      || input_has_word(trimmed, "running") == 1) {
        return Intent_new(IntentTag.SHOW_PROCESSES);
    }
    if (input_has_word(trimmed, "system") == 1
      || input_has_word(trimmed, "computer") == 1
      || input_has_word(trimmed, "machine") == 1) {
        return Intent_new(IntentTag.SYSTEM_INFO);
    }
    if (input_has_word(trimmed, "network") == 1
      || input_has_word(trimmed, "ip") == 1
      || input_has_word(trimmed, "net") == 1) {
        return Intent_new(IntentTag.NETWORK_INFO);
    }
    if (input_has_word(trimmed, "disk") == 1
      || input_has_word(trimmed, "space") == 1
      || input_has_word(trimmed, "usage") == 1) {
        # `show memory usage` never reaches this branch: parse_state_queries claims it
        # first (ADR-007, specific tier). Before 1.9.5 the bare "usage" keyword here
        # answered it with `df -h`; 1.9.5 to 1.9.15 carried a guard to hand it on.
        var intent = Intent_new(IntentTag.DISK_USAGE);
        store64(intent + 8, extract_after(trimmed, " in "));
        return intent;
    }
    if (input_has_word(trimmed, "audit") == 1 || input_has_word(trimmed, "security log") == 1) {
        var intent = Intent_new(IntentTag.AUDIT_VIEW);
        store64(intent + 8, extract_after(trimmed, "agent "));
        store64(intent + 16, extract_after(trimmed, "last "));
        return intent;
    }
    if (input_has_word(trimmed, "agent") == 1) {
        var intent = Intent_new(IntentTag.AGENT_INFO);
        store64(intent + 8, extract_after(trimmed, "agent "));
        return intent;
    }
    return 0;
}
fn parse_file_ops(trimmed) {
    if (input_has_word(trimmed, "read") == 1
      || input_has_word(trimmed, "cat") == 1
      || input_has_word(trimmed, "open") == 1) {
        var intent = Intent_new(IntentTag.SHOW_FILE);
        store64(intent + 8, extract_last_arg(trimmed));
        return intent;
    }
    if (input_has_word(trimmed, "find") == 1
      || input_has_word(trimmed, "locate") == 1
      || input_has_word(trimmed, "search for") == 1) {
        if (input_has_word(trimmed, "file") == 1
          || input_has_word(trimmed, "named") == 1
          || input_has_word(trimmed, "called") == 1) {
            var intent = Intent_new(IntentTag.FIND_FILES);
            store64(intent + 8, extract_after(trimmed, "named "));
            if (load64(intent + 8) == 0) { store64(intent + 8, extract_after(trimmed, "called ")); }
            if (load64(intent + 8) == 0) { store64(intent + 8, extract_last_arg(trimmed)); }
            store64(intent + 16, extract_after(trimmed, " in "));
            return intent;
        }
    }
    if (input_has_word(trimmed, "search") == 1 || input_has_word(trimmed, "grep") == 1) {
        if (input_has_word(trimmed, " in ") == 1
          || input_has_word(trimmed, "within") == 1
          || input_has_word(trimmed, "inside") == 1) {
            var intent = Intent_new(IntentTag.SEARCH_CONTENT);
            # ⛔ THE GATE AND THE EXTRACTORS DISAGREED. The branch above accepts
            # " in ", "within" OR "inside", but both fields were extracted using
            # " in " alone (plus a lone "within " fallback for the path). So
            # `search for hello inside /tmp` passed the gate and then produced a
            # BARE `grep` — no pattern, no path. ("inside" does not contain
            # " in ": the trailing space fails, so there was no accidental rescue.)
            #
            # ⚠ THE SEPARATOR MUST BE CHOSEN BEFORE EXTRACTING, not by chaining
            # `== 0` fallbacks. extract_between falls back to "everything after
            # before_kw" when after_kw is absent, so it NEVER returns 0 once
            # before_kw is present — a chain of 0-checks would keep the FIRST,
            # wrong answer and silently make the pattern "hello inside /tmp".
            var sep = 0;
            if (str_find_ci(trimmed, " in ") >= 0) { sep = " in "; }
            elif (str_find_ci(trimmed, " inside ") >= 0) { sep = " inside "; }
            elif (str_find_ci(trimmed, " within ") >= 0) { sep = " within "; }
            if (sep != 0) {
                store64(intent + 8, extract_between(trimmed, "for ", sep));
                if (load64(intent + 8) == 0) {
                    store64(intent + 8, extract_between(trimmed, "search ", sep));
                }
                store64(intent + 16, extract_after(trimmed, sep));
            }
            return intent;
        }
    }
    if (input_has_word(trimmed, "go to") == 1
      || input_has_word(trimmed, "change to") == 1
      || input_has_word(trimmed, "cd ") == 1
      || input_has_word(trimmed, "switch to") == 1) {
        var intent = Intent_new(IntentTag.CHANGE_DIR);
        store64(intent + 8, extract_last_arg(trimmed));
        return intent;
    }
    if (input_has_word(trimmed, "create") == 1 || input_has_word(trimmed, "make") == 1) {
        if (input_has_word(trimmed, "directory") == 1 || input_has_word(trimmed, "folder") == 1) {
            var intent = Intent_new(IntentTag.CREATE_DIR);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
    }
    if (input_has_word(trimmed, "copy") == 1 || input_has_word(trimmed, "duplicate") == 1) {
        var intent = Intent_new(IntentTag.COPY);
        store64(intent + 8, extract_between(trimmed, "copy ", " to "));
        if (load64(intent + 8) == 0) { store64(intent + 8, extract_between(trimmed, "duplicate ", " to ")); }
        store64(intent + 16, extract_after(trimmed, " to "));
        return intent;
    }
    if (input_has_word(trimmed, "move") == 1 || input_has_word(trimmed, "rename") == 1) {
        var intent = Intent_new(IntentTag.MOVE);
        store64(intent + 8, extract_between(trimmed, "move ", " to "));
        if (load64(intent + 8) == 0) { store64(intent + 8, extract_between(trimmed, "rename ", " to ")); }
        store64(intent + 16, extract_after(trimmed, " to "));
        return intent;
    }
    if (input_has_word(trimmed, "remove") == 1
      || input_has_word(trimmed, "delete") == 1
      || input_has_word(trimmed, "rm") == 1) {
        # ⛔ NEVER `rm` A WORD THAT NAMES AN ACCOUNT, A GROUP OR A FIREWALL RULE.
        # Since 1.9.16 the admin parser runs FIRST (ADR-007) and claims `delete user
        # bob` / `delete firewall rule 22` itself, so this is no longer the shadowing
        # fix it was in 1.9.5. It stays as the backstop for admin-shaped phrasings the
        # admin parser does not claim — `remove the user bob`, `remove group admins`
        # (there is no GROUP_DELETE) — which would otherwise become `rm bob` /
        # `rm admins`. Whole-token matching keeps `remove user_data.txt` a REMOVE.
        if (input_has_exact_word(trimmed, "user") == 1) { return 0; }
        if (input_has_exact_word(trimmed, "group") == 1) { return 0; }
        if (input_has_exact_word(trimmed, "firewall") == 1) { return 0; }
        var intent = Intent_new(IntentTag.REMOVE);
        store64(intent + 8, extract_last_arg(trimmed));
        store64(intent + 40, 0);
        if (input_has_word(trimmed, "recursive") == 1 || input_has_word(trimmed, "-r") == 1) {
            store64(intent + 40, 1);
        }
        return intent;
    }
    return 0;
}
fn parse_system_ops(trimmed) {
    if (input_has_word(trimmed, "kill") == 1 || input_has_word(trimmed, "terminate") == 1) {
        if (input_has_word(trimmed, "process") == 1 || input_has_word(trimmed, "pid") == 1) {
            var intent = Intent_new(IntentTag.KILL_PROCESS);
            store64(intent + 40, str_to_int(extract_last_arg(trimmed)));
            return intent;
        }
    }
    if (input_has_word(trimmed, "install") == 1 || input_has_word(trimmed, "add package") == 1) {
        var intent = Intent_new(IntentTag.INSTALL_PACKAGE);
        var pkg = extract_after(trimmed, "install ");
        if (pkg == 0) { pkg = extract_last_arg(trimmed); }
        var pkgs = vec_new();
        vec_push(pkgs, pkg);
        store64(intent + 56, pkgs);
        return intent;
    }
    if (input_has_word(trimmed, "service") == 1 || input_has_word(trimmed, "systemctl") == 1) {
        var intent = Intent_new(IntentTag.SERVICE_CONTROL);
        # ⛔ str_from, NOT a bare literal. `intent + 8` is read as a Str by every
        # consumer (safe_arg_in_str, str_len, the translators). Storing a raw
        # cstring here made SERVICE_CONTROL and GIT_STASH **entirely dead**: the
        # field read back as garbage/empty, every translator refused it, and
        # `start service nginx` / `git stash` emitted `echo` for the shell's whole
        # history. Same bug class as the 1.9.1 SHELL_COMMAND classifier, on the
        # producing side this time.
        if (input_has_word(trimmed, "start") == 1) { store64(intent + 8, str_from("start")); }
        elif (input_has_word(trimmed, "stop") == 1) { store64(intent + 8, str_from("stop")); }
        elif (input_has_word(trimmed, "restart") == 1) { store64(intent + 8, str_from("restart")); }
        elif (input_has_word(trimmed, "status") == 1) { store64(intent + 8, str_from("status")); }
        else { store64(intent + 8, str_from("list")); }
        store64(intent + 16, extract_last_arg(trimmed));
        return intent;
    }
    return 0;
}
fn parse_git_ops(trimmed) {
    if (input_has_word(trimmed, "commit") == 1) {
        var intent = Intent_new(IntentTag.GIT_COMMIT);
        store64(intent + 8, extract_after(trimmed, "-m "));
        if (load64(intent + 8) == 0) { store64(intent + 8, extract_after(trimmed, "message ")); }
        store64(intent + 40, 0);
        if (input_has_word(trimmed, "-a") == 1 || input_has_word(trimmed, "all") == 1) { store64(intent + 40, 1); }
        return intent;
    }
    if (input_has_word(trimmed, "diff") == 1) {
        var intent = Intent_new(IntentTag.GIT_DIFF);
        store64(intent + 40, 0);
        if (input_has_word(trimmed, "staged") == 1) { store64(intent + 40, 1); }
        return intent;
    }
    if (input_has_word(trimmed, "branch") == 1) {
        var intent = Intent_new(IntentTag.GIT_BRANCH);
        store64(intent + 8, extract_after(trimmed, "branch "));
        store64(intent + 40, 0);
        # `delete` / `remove` as whole words: `remove git branch foo` must delete foo, not create
        # it (1.9.16: the anchored git tier now claims that sentence), and a branch NAMED
        # `delete-old`, `deleted` or `remove-old` is created, not deleted — a token-prefix match
        # read `git branch delete-old` as `git branch -d delete-old`.
        if (input_has_exact_word(trimmed, "delete") == 1) { store64(intent + 40, 1); }
        if (input_has_exact_word(trimmed, "remove") == 1) { store64(intent + 40, 1); }
        return intent;
    }
    if (input_has_word(trimmed, "status") == 1) { return Intent_new(IntentTag.GIT_STATUS); }
    if (input_has_word(trimmed, "log") == 1) { return Intent_new(IntentTag.GIT_LOG); }
    if (input_has_word(trimmed, "push") == 1) {
        var intent = Intent_new(IntentTag.GIT_PUSH);
        store64(intent + 8, extract_after(trimmed, "push "));
        return intent;
    }
    if (input_has_word(trimmed, "pull") == 1) { return Intent_new(IntentTag.GIT_PULL); }
    if (input_has_word(trimmed, "checkout") == 1) {
        var intent = Intent_new(IntentTag.GIT_CHECKOUT);
        store64(intent + 8, extract_after(trimmed, "checkout "));
        return intent;
    }
    if (input_has_word(trimmed, "merge") == 1) {
        var intent = Intent_new(IntentTag.GIT_MERGE);
        store64(intent + 8, extract_after(trimmed, "merge "));
        return intent;
    }
    if (input_has_word(trimmed, "stash") == 1) {
        var intent = Intent_new(IntentTag.GIT_STASH);
        if (input_has_word(trimmed, "pop") == 1) { store64(intent + 8, str_from("pop")); }
        elif (input_has_word(trimmed, "list") == 1) { store64(intent + 8, str_from("list")); }
        elif (input_has_word(trimmed, "apply") == 1) { store64(intent + 8, str_from("apply")); }
        else { store64(intent + 8, str_from("push")); }
        return intent;
    }
    return 0;
}
# Specific tier (ADR-007). This parser runs BEFORE the broad file parser, so every trigger is a
# whole word or bounded phrase (input_has_phrase semantics, asked through the line's
# PhraseIndex), and a sentence that opens with a file verb is claimed only by a trigger that
# starts it (trigger_claims). Measured before the triggers were tightened, running it first
# turned `remove user_data.txt` into `userdel` (the old `remove user` substring match),
# `delete firewall.log` into a ufw rule deletion (the old `firewall` prefix match) and
# `remove the groups file` into `groups`.
fn parse_admin_ops(trimmed, pix) {
    # `delete firewall rule 22` is a firewall action; a file verb anywhere else makes the firewall
    # words its object (`read the firewall rules file`, `delete the firewall rules file`).
    var fw = 0;
    if (index_has_phrase(pix, "firewall") == 1 || index_has_phrase(pix, "ufw") == 1) {
        fw = trigger_claims(trimmed, "delete firewall", "delete ufw");
    }
    if (fw == 1) {
        if (input_has_word(trimmed, "allow") == 1) {
            var intent = Intent_new(IntentTag.FIREWALL_ALLOW);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
        if (input_has_word(trimmed, "deny") == 1) {
            var intent = Intent_new(IntentTag.FIREWALL_DENY);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
        if (input_has_word(trimmed, "list") == 1 || input_has_word(trimmed, "rules") == 1) {
            return Intent_new(IntentTag.FIREWALL_LIST);
        }
        if (input_has_word(trimmed, "status") == 1) { return Intent_new(IntentTag.FIREWALL_STATUS); }
        if (input_has_word(trimmed, "enable") == 1) { return Intent_new(IntentTag.FIREWALL_ENABLE); }
        if (input_has_word(trimmed, "disable") == 1) { return Intent_new(IntentTag.FIREWALL_DISABLE); }
        if (input_has_word(trimmed, "delete") == 1) {
            var intent = Intent_new(IntentTag.FIREWALL_DELETE);
            store64(intent + 8, extract_after(trimmed, "delete "));
            return intent;
        }
    }
    # Each account phrase that starts with a file verb is its own lead: `create user bob` is
    # an account action; `copy the add user script` is a copy.
    if (index_has_phrase(pix, "useradd") == 1
      || index_has_phrase(pix, "add user") == 1
      || index_has_phrase(pix, "create user") == 1) {
        if (trigger_claims(trimmed, "create user", 0) == 1) {
            var intent = Intent_new(IntentTag.USER_ADD);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
    }
    if (index_has_phrase(pix, "userdel") == 1
      || index_has_phrase(pix, "delete user") == 1
      || index_has_phrase(pix, "remove user") == 1) {
        if (trigger_claims(trimmed, "delete user", "remove user") == 1) {
            var intent = Intent_new(IntentTag.USER_DELETE);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
    }
    if (index_has_phrase(pix, "passwd") == 1 || index_has_phrase(pix, "change password") == 1) {
        if (trigger_claims(trimmed, "change password", 0) == 1) {
            var intent = Intent_new(IntentTag.PASSWD);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
    }
    if (index_has_phrase(pix, "groupadd") == 1
      || index_has_phrase(pix, "add group") == 1
      || index_has_phrase(pix, "create group") == 1) {
        if (trigger_claims(trimmed, "create group", 0) == 1) {
            var intent = Intent_new(IntentTag.GROUP_ADD);
            store64(intent + 8, extract_last_arg(trimmed));
            return intent;
        }
    }
    # A bare query word: `groups` / `list groups`, but not `remove the groups file`.
    if (index_has_phrase(pix, "groups") == 1) {
        if (trigger_claims(trimmed, 0, 0) == 1) { return Intent_new(IntentTag.GROUP_LIST); }
    }
    return 0;
}
fn token_count(input) {
    var hlen = str_len(input);
    var hd = str_data(input);
    var count = 0;
    var in_token = 0;
    for (var i = 0; i < hlen; i = i + 1) {
        var c = load8(hd + i);
        if (c == 32) {
            in_token = 0;
        } elif (c == 9) {
            in_token = 0;
        } else {
            if (in_token == 0) {
                count = count + 1;
                in_token = 1;
            }
        }
    }
    return count;
}
fn parse_service_action(trimmed) {
    # Imperative service control: "start nginx", "stop sshd", "restart cron",
    # "reload nginx", "enable nginx", "disable nginx". Gated on (a) input
    # opens with the imperative verb at token 0 and (b) exactly two tokens
    # — keeps "start a new project" / "stop wasting time" / "enable cron
    # service" from getting hijacked. parse_admin_ops runs first so
    # "enable firewall" / "disable ufw" still route to FIREWALL_ENABLE /
    # FIREWALL_DISABLE (those carry the firewall keyword and never reach
    # this branch). Multi-arg or flag-laden invocations should use the
    # existing `service`/`systemctl` prefix which routes through
    # parse_system_ops.
    if (token_count(trimmed) != 2) { return 0; }
    var action = 0;
    if (input_starts_with(trimmed, "start ") == 1) {
        action = "start";
    } elif (input_starts_with(trimmed, "stop ") == 1) {
        action = "stop";
    } elif (input_starts_with(trimmed, "restart ") == 1) {
        action = "restart";
    } elif (input_starts_with(trimmed, "reload ") == 1) {
        action = "reload";
    } elif (input_starts_with(trimmed, "enable ") == 1) {
        action = "enable";
    } elif (input_starts_with(trimmed, "disable ") == 1) {
        action = "disable";
    }
    if (action == 0) { return 0; }
    var name = extract_last_arg(trimmed);
    if (name == 0) { return 0; }
    var intent = Intent_new(IntentTag.SERVICE_CONTROL);
    store64(intent + 8, action);
    store64(intent + 16, name);
    return intent;
}
fn parse_service_query(trimmed, pix) {
    # "is X running" / "is X active" / "is X enabled" — interrogative form
    # only (input must start with "is "), so statements like "the
    # application is running" don't get hijacked into SERVICE_CONTROL.
    # Maps to SERVICE_CONTROL with action="status" and target=X — flows
    # through the existing translate_service_control which emits
    # `systemctl status <X>` at ADMIN permission level.
    if (input_starts_with(trimmed, "is ") == 1) {
        var name = 0;
        if (input_has_word(trimmed, "running") == 1) {
            name = extract_between(trimmed, "is ", " running");
        }
        if (name == 0 && input_has_word(trimmed, "active") == 1) {
            name = extract_between(trimmed, "is ", " active");
        }
        if (name == 0 && input_has_word(trimmed, "enabled") == 1) {
            name = extract_between(trimmed, "is ", " enabled");
        }
        if (name != 0) {
            var intent = Intent_new(IntentTag.SERVICE_CONTROL);
            store64(intent + 8, str_from("status"));
            store64(intent + 16, name);
            return intent;
        }
    }
    # "status of X" — interrogative or imperative ("status of nginx",
    # "show status of nginx") both work; the substring-anchored "status of"
    # only fires when the user is asking about a specific service.
    if (index_has_phrase(pix, "status of") == 1 && trigger_claims(trimmed, 0, 0) == 1) {
        var name = extract_after(trimmed, "status of ");
        if (name != 0) {
            var intent = Intent_new(IntentTag.SERVICE_CONTROL);
            store64(intent + 8, str_from("status"));
            store64(intent + 16, name);
            return intent;
        }
    }
    return 0;
}
# Specific tier (ADR-007). Every trigger here is a bounded word or phrase, and none claims a
# sentence that opens with a file verb (trigger_claims): `read the uptime file`, `find files
# named ram` and `delete the disk usage report` are file operations that mention a query word.
# With looser triggers and no verb rule, moving this parser ahead of parse_file_ops turned
# every one of those into a system query.
fn parse_state_queries(trimmed, pix) {
    var tag = 0 - 1;
    if (index_has_phrase(pix, "ip address") == 1
      || index_has_phrase(pix, "ip addresses") == 1
      || index_has_phrase(pix, "my ip") == 1
      || index_has_phrase(pix, "ip route") == 1
      || index_has_phrase(pix, "network status") == 1
      || index_has_phrase(pix, "network info") == 1
      || index_has_phrase(pix, "network information") == 1) {
        tag = IntentTag.NETWORK_INFO;
    } elif (index_has_phrase(pix, "load average") == 1
      || index_has_phrase(pix, "kernel version") == 1
      || index_has_phrase(pix, "system info") == 1
      || index_has_phrase(pix, "system information") == 1
      || index_has_phrase(pix, "uptime") == 1
      || index_has_phrase(pix, "hostname") == 1
      || index_has_phrase(pix, "hostnames") == 1) {
        tag = IntentTag.SYSTEM_INFO;
    } elif (index_has_phrase(pix, "memory") == 1 || index_has_phrase(pix, "ram") == 1) {
        # Memory questions get a memory answer (MEMORY_INFO, 1.9.10). ⚠ TWO CHECKS, NOT SIX:
        # every memory phrasing ("memory usage", "free memory", "ram usage", "how much memory")
        # contains `memory` or `ram` as a standalone word, so the two word checks subsume them;
        # the six-check spelling measured +3.9% on parse/shell_cmd, the path every unrecognised
        # line pays for.
        tag = IntentTag.MEMORY_INFO;
    } elif (index_has_phrase(pix, "disk space") == 1
      || index_has_phrase(pix, "free space") == 1
      || index_has_phrase(pix, "disk usage") == 1
      || index_has_phrase(pix, "how full") == 1
      || index_has_phrase(pix, "storage usage") == 1) {
        tag = IntentTag.DISK_USAGE;
    } elif (index_has_phrase(pix, "running process") == 1
      || index_has_phrase(pix, "running processes") == 1
      || index_has_phrase(pix, "what's running") == 1
      || index_has_phrase(pix, "what is running") == 1
      || index_has_phrase(pix, "whats running") == 1
      || index_has_phrase(pix, "active process") == 1
      || index_has_phrase(pix, "active processes") == 1
      || index_has_phrase(pix, "current processes") == 1) {
        tag = IntentTag.SHOW_PROCESSES;
    }
    if (tag < 0) { return 0; }
    if (trigger_claims(trimmed, 0, 0) == 0) { return 0; }
    var intent = Intent_new(tag);
    if (tag == IntentTag.DISK_USAGE) {
        store64(intent + 8, extract_after(trimmed, " in "));
        if (load64(intent + 8) == 0) { store64(intent + 8, extract_after(trimmed, " on ")); }
    }
    return intent;
}
# Specific tier (ADR-007): the one file phrase specific enough to run ahead of the broad
# parsers. It was parse_file_ops' second branch, where parse_show_commands' `content` keyword
# shadowed it until 1.9.5 bolted a guard onto that parser; claiming it first retires the guard.
fn parse_file_phrases(trimmed, pix) {
    if (index_has_phrase(pix, "contents of") == 1
      || index_has_phrase(pix, "file content") == 1
      || index_has_phrase(pix, "file contents") == 1) {
        var intent = Intent_new(IntentTag.SHOW_FILE);
        store64(intent + 8, extract_last_arg(trimmed));
        return intent;
    }
    return 0;
}
# Specific tier (ADR-007): a git subcommand named explicitly as `git <subcommand>`. The broad
# tier keeps the loose git gate (any `git` or `commit`) in its old place; this anchored form
# runs first so a file verb cannot claim an explicit git phrase — `delete git branch foo`
# used to become `rm foo`.
fn parse_git_anchored(trimmed, pix) {
    if (index_has_phrase(pix, "git") == 0) { return 0; }     # one check for the common case
    # A file verb in front of a git phrase is a git action only where git has one: a branch
    # can be deleted (`delete git branch foo`). `remove the git log` names no git action, so
    # it stays with the file parser rather than becoming `git log`.
    if (opens_with_file_verb(trimmed) == 1) {
        if (index_has_phrase(pix, "git branch") == 0) { return 0; }
    }
    if (index_has_phrase(pix, "git commit") == 1
      || index_has_phrase(pix, "git diff") == 1
      || index_has_phrase(pix, "git branch") == 1
      || index_has_phrase(pix, "git status") == 1
      || index_has_phrase(pix, "git log") == 1
      || index_has_phrase(pix, "git push") == 1
      || index_has_phrase(pix, "git pull") == 1
      || index_has_phrase(pix, "git checkout") == 1
      || index_has_phrase(pix, "git merge") == 1
      || index_has_phrase(pix, "git stash") == 1) {
        return parse_git_ops(trimmed);
    }
    return 0;
}
fn Interpreter_parse(self, input) {
    var trimmed = str_trim(input);
    var len = str_len(trimmed);
    if (len == 0) { return Intent_new(IntentTag.UNKNOWN); }
    if (str_contains(trimmed, " | ") == 1 || str_contains_ci(trimmed, " then ") == 1) {
        var intent = Intent_new(IntentTag.PIPELINE);
        var parts = vec_new();
        if (str_contains(trimmed, " | ") == 1) {
            # ⛔ str_split's `sep` parameter is UNANNOTATED, so a bare literal is
            # NOT promoted to Str the way it is for `needle: Str` on str_contains
            # just above. The raw literal address is > 256, so str_split_a takes
            # its STR path and reads load64(sep) / load64(sep+8) — the literal's
            # own bytes — as a data pointer and a length. The result: `ls | grep foo`
            # was DETECTED as a pipeline (str_contains works) and then never
            # SPLIT — one stage instead of two.
            parts = str_split(trimmed, str_from(" | "));
        } else {
            parts = str_split_ci(trimmed, " then ");
        }
        store64(intent + 56, parts);
        return intent;
    }
    # ── ADR-007: specific before broad. ──
    # The SPECIFIC tier claims only on anchored evidence — bounded phrases and whole words
    # (input_has_phrase semantics, asked through one PhraseIndex built here for the line), verb
    # position, token count — never a sentence that opens with a file verb unless its trigger
    # starts it (trigger_claims), and runs first. The BROAD tier's single keywords ("file",
    # "delete", "usage", "open") match anything that mentions them and run after, in their
    # historical order. Until 1.9.16 the broad parsers ran first and each
    # shadowing bug got a guard bolted onto the broad side; tests/test_parse_corpus.tcyr now
    # asserts both directions over the documented table, so a reordering or a new trigger that
    # re-routes a phrase fails CI instead of shipping.
    var pix[PIX_BYTES];
    phrase_index(&pix, trimmed);
    var s1 = parse_admin_ops(trimmed, &pix);
    if (s1 != 0) { return s1; }
    var s2 = parse_service_action(trimmed);
    if (s2 != 0) { return s2; }
    var s3 = parse_service_query(trimmed, &pix);
    if (s3 != 0) { return s3; }
    var s4 = parse_state_queries(trimmed, &pix);
    if (s4 != 0) { return s4; }
    var s5 = parse_file_phrases(trimmed, &pix);
    if (s5 != 0) { return s5; }
    var s6 = parse_git_anchored(trimmed, &pix);
    if (s6 != 0) { return s6; }
    # ── broad tier ──
    if (input_has_word(trimmed, "show") == 1
      || input_has_word(trimmed, "list") == 1
      || input_has_word(trimmed, "display") == 1) {
        var r = parse_show_commands(trimmed);
        if (r != 0) { return r; }
    }
    var r2 = parse_file_ops(trimmed);
    if (r2 != 0) { return r2; }
    var r3 = parse_system_ops(trimmed);
    if (r3 != 0) { return r3; }
    if (input_has_word(trimmed, "git") == 1 || input_has_word(trimmed, "commit") == 1) {
        var r4 = parse_git_ops(trimmed);
        if (r4 != 0) { return r4; }
    }
    if (input_has_word(trimmed, "what") == 1
      || input_has_word(trimmed, "how") == 1
      || input_has_word(trimmed, "why") == 1
      || input_has_word(trimmed, "when") == 1
      || input_has_word(trimmed, "explain") == 1) {
        var intent = Intent_new(IntentTag.QUESTION);
        store64(intent + 8, trimmed);
        return intent;
    }
    var intent = Intent_new(IntentTag.SHELL_COMMAND);
    var cmd_out[1];
    var args_out = vec_new();
    var argc = split_command_line(trimmed, &cmd_out, args_out);
    store64(intent + 8, load64(&cmd_out));
    store64(intent + 56, args_out);
    store64(intent + 40, argc);
    return intent;
}
fn translate_core(tag, intent) {
    match tag {
        0 => { return translate_list_files(intent); }
        1 => { return translate_show_file(intent); }
        2 => { return translate_find_files(intent); }
        3 => { return translate_search_content(intent); }
        4 => { return translate_change_dir(intent); }
        5 => { return translate_create_dir(intent); }
        6 => { return translate_copy(intent); }
        7 => { return translate_move(intent); }
        8 => { return translate_remove(intent); }
        9 => { return translate_show_processes(intent); }
        10 => { return translate_kill_process(intent); }
        11 => { return translate_system_info(intent); }
        12 => { return translate_network_info(intent); }
        13 => { return translate_disk_usage(intent); }
        14 => { return translate_install_package(intent); }
        15 => { return translate_shell_command(intent); }
        16 => { return translate_audit_view(intent); }
        17 => { return translate_agent_info(intent); }
        18 => { return translate_service_control(intent); }
        _ => { return 0; }
    }
    return 0;
}
fn translate_extended(tag, intent) {
    match tag {
        19 => { return translate_git_commit(intent); }
        20 => { return translate_git_diff(intent); }
        21 => { return translate_git_branch(intent); }
        22 => { return translate_git_status(intent); }
        23 => { return translate_git_log(intent); }
        24 => { return translate_git_push(intent); }
        25 => { return translate_git_pull(intent); }
        26 => { return translate_git_checkout(intent); }
        27 => { return translate_git_merge(intent); }
        28 => { return translate_git_stash(intent); }
        29 => { return translate_user_add(intent); }
        30 => { return translate_user_delete(intent); }
        31 => { return translate_passwd(intent); }
        32 => { return translate_group_add(intent); }
        33 => { return translate_group_list(intent); }
        34 => { return translate_firewall_allow(intent); }
        35 => { return translate_firewall_deny(intent); }
        36 => { return translate_firewall_list(intent); }
        37 => { return translate_firewall_status(intent); }
        38 => { return translate_firewall_enable(intent); }
        39 => { return translate_firewall_disable(intent); }
        40 => { return translate_firewall_delete(intent); }
        42 => { return translate_question(intent); }
        44 => { return translate_memory_info(intent); }
        _ => { return 0; }
    }
    return 0;
}
fn Interpreter_translate(self, intent) {
    var tag = load64(intent);
    if (tag <= 18) {
        var r = translate_core(tag, intent);
        if (r != 0) { return r; }
    }
    # ⚠ THE UPPER BOUND MUST COVER EVERY EXTENDED TAG. A tag added above this
    # range parses fine and then silently translates to `echo`, because the
    # dispatch never reaches its arm. Widened 42 -> 44 for MEMORY_INFO (1.9.10).
    if (tag >= 19 && tag <= 44) {
        var r = translate_extended(tag, intent);
        if (r != 0) { return r; }
    }
    return translate_unknown(intent);
}
