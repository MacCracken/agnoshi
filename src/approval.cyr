enum ApprovalResponse {
    APPROVED = 0;
    APPROVED_ONCE = 1;
    DENIED = 2;
    DENY_AND_BLOCK = 3;
    NEED_INFO = 4;
    MODIFY = 5;
    TIMED_OUT = 6;
    NO_ANSWER = 7;      # 2.1.3: stdin ended before an answer (a `-c` with nothing on stdin)
}
enum RiskLevel {
    LOW = 0;
    MEDIUM = 1;
    HIGH = 2;
    CRITICAL = 3;
}
fn risk_from_permission(perm) {
    if (perm == PermissionLevel.SAFE) { return RiskLevel.LOW; }
    if (perm == PermissionLevel.READ_ONLY) { return RiskLevel.LOW; }
    if (perm == PermissionLevel.USER_WRITE) { return RiskLevel.MEDIUM; }
    if (perm == PermissionLevel.SYSTEM_WRITE) { return RiskLevel.HIGH; }
    if (perm == PermissionLevel.ADMIN) { return RiskLevel.HIGH; }
    if (perm == PermissionLevel.BLOCKED) { return RiskLevel.CRITICAL; }
    return RiskLevel.HIGH;
}
fn risk_icon(level) {
    match level {
        0 => { return "[LOW]"; }
        1 => { return "[MED]"; }
        2 => { return "[HIGH]"; }
        3 => { return "[CRIT]"; }
        _ => { return "[???]"; }
    }
}
struct ApprovalManager {
    timeout_seconds;
    auto_approve_low_risk;
    blocked_patterns;
}
fn ApprovalManager_new() {
    var p = alloc(24);
    store64(p, 300);
    store64(p + 8, 0);
    store64(p + 16, vec_new());
    return p;
}
fn ApprovalManager_set_auto_approve(self, enabled) {
    store64(self + 8, enabled);
}
fn ApprovalManager_assess_risk(self, cmd, args, argc) {
    var perm = analyze_command_permission(cmd, args, argc);
    return risk_from_permission(perm);
}
fn ApprovalManager_is_blocked(self, cmd) {
    var nblocked = vec_len(load64(self + 16));
    for (var i = 0; i < nblocked; i = i + 1) {
        var pattern = vec_get(load64(self + 16), i);
        if (str_contains(cmd, pattern) == 1) {
            return 1;
        }
    }
    return 0;
}
fn ApprovalManager_block_pattern(self, pattern) {
    vec_push(load64(self + 16), pattern);
}
# Ask whether `action` — the command line about to run, a cstring — may run. `note` is a cstring the
# prompt ends with (what undo can do about it), or 0.
#
# ⭐ 2.1.3 — THE PROMPT HAS A CALLER: approval-gated NL exec (nlexec.cyr, ADR-011) asks here before a
# USER_WRITE, SYSTEM_WRITE or ADMIN translation runs, in every mode. Until 2.1.3 its only caller was
# session.cyr, outside the binary, and the prompt wrote to stdout, read fd 0 past read_line's carry
# buffer (a typed-ahead line was lost to it), returned TIMED_OUT for EOF, and offered a [m]odify that
# nothing implemented.
#
# The prompt goes to stderr — the shell talking, as verb_confirm's has since 2.0.0 (ADR-008) — and the
# answer is one line through read_line: y or Y approves; anything else, a bare Enter included, is
# DENIED. EOF is NO_ANSWER, and no line within `timeout_seconds` is TIMED_OUT (the host's poll;
# approval_input_wait in agnsh.cyr).
fn ApprovalManager_request(self, action, note, risk) {
    if (action == 0) {
        verb_out_cstr("  cannot render the approval prompt -- declining\n");
        return ApprovalResponse.DENIED;
    }
    if (ApprovalManager_is_blocked(self, str_from(action)) == 1) {
        return ApprovalResponse.DENIED;
    }
    if (load64(self + 8) == 1) {
        if (risk == RiskLevel.LOW) {
            return ApprovalResponse.APPROVED;
        }
    }
    verb_out_cstr("  \xE2\x9A\xA0 ");     # two-space indent + U+26A0 WARNING SIGN, as verb_confirm
    verb_out_cstr(risk_icon(risk));
    verb_out_cstr(" approve: ");
    # Control bytes stripped (the H5 mitigation, print_str_safe's): an escape sequence in a file name
    # must not redraw the line the user is approving.
    eprint_str(strip_control_chars(str_from(action)));
    if (note != 0) {
        verb_out_cstr(" -- ");
        verb_out_cstr(note);
    }
    verb_out_cstr(" ? [y/N] ");
    if (approval_input_wait(load64(self) * 1000) == 0) {
        verb_out_cstr("(timed out)");
        verb_out_nl();
        return ApprovalResponse.TIMED_OUT;
    }
    var rb[64];
    var n = read_line(&rb, 64);
    if (n < 0) {
        verb_out_cstr("(no answer)");
        verb_out_nl();
        return ApprovalResponse.NO_ANSWER;
    }
    if (n > 0) {
        var c = load8(&rb);
        if (c == 121) { return ApprovalResponse.APPROVED; }    # 'y'
        if (c == 89) { return ApprovalResponse.APPROVED; }     # 'Y'
    }
    verb_out_cstr("  (declined)");
    verb_out_nl();
    return ApprovalResponse.DENIED;
}
