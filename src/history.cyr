struct CommandHistory {
    entries;
    count;
    max_size;
    file_path;
}
# CommandHistory_new — file_path is a cstring (null-terminated buffer)
# because `file_exists`, `file_read_all`, and `syscall(SYS_OPEN)` all
# expect a cstring path. Entries are normalized to Str throughout so
# CommandHistory_add can use str_eq for dedup; the load-from-file path
# already yields Str via str_split.
fn CommandHistory_new(file_path, max_size) {
    var entries = vec_new();
    if (file_exists(file_path) == 1) {
        # Cyrius 5.10.x file_read_all is buffer-based — preallocate a
        # generous 64 KB scratch buffer (history files are line-oriented
        # and conventionally small; even 1000 long commands fit easily).
        var bufsize = 65536;
        var buf = alloc(bufsize);
        if (buf != 0) {
            var n = file_read_all(file_path, buf, bufsize - 1);
            if (n > 0) {
                store8(buf + n, 0);
                var content = str_new(buf, n);
                # Explicit byte separator (10 = '\n') — bypasses the
                # cstring-needle dispatch path that returned the whole
                # buffer as a single Str on a first probe.
                var lines = str_split(content, 10);
                var nlines = vec_len(lines);
                for (var i = 0; i < nlines; i = i + 1) {
                    var line = vec_get(lines, i);
                    if (str_len(line) > 0) {
                        vec_push(entries, line);
                    }
                }
            }
        }
    }
    var p = alloc(32);
    store64(p, entries);
    store64(p + 8, vec_len(entries));
    store64(p + 16, max_size);
    store64(p + 24, file_path);
    return p;
}
# CommandHistory_add — incoming `command_cstr` is the interactive_loop's
# stdin buffer (cstring); wrap as Str on entry so the entries vec stays
# uniformly Str-typed and the dedup check uses str_eq. Pre-v1.2.1 dedup
# was via streq(Str, cstring) which silently never matched.
fn CommandHistory_add(self, command_cstr) {
    # str_clone deep-copies into a fresh heap buffer so the stored Str
    # is independent of the caller's stdin scratch — interactive_loop
    # reuses a single static `var buf[4096]` across iterations, so a
    # naive str_from(command_cstr) would have every history entry's
    # data pointer aliased to whatever bytes happen to be in &buf at
    # display time. str_clone breaks that aliasing.
    var command = str_clone(str_from(command_cstr));
    if (load64(self + 8) > 0) {
        var last = vec_get(load64(self), load64(self + 8) - 1);
        if (str_eq(last, command) == 1) {
            return 0;
        }
    }
    vec_push(load64(self), command);
    store64(self + 8, load64(self + 8) + 1);
    # AMORTIZED TRIM. This used to rebuild the entire entries vec — a fresh
    # vec_new plus an n-element copy — on EVERY add once the history was at
    # capacity, which is the steady state for any real session (default cap
    # 10000). That made a routine add O(n) with a full reallocation each time,
    # and the discarded vec is never reclaimed. Measured at cap=1000:
    # 17.5us -> 0.36us per add.
    #
    # Instead let the vec overshoot by a slack margin, then drop the whole
    # overshoot in ONE rebuild: O(1) amortized. Between rebuilds `count` may
    # briefly exceed max_size, so every consumer that must honour the cap
    # (save) clamps explicitly rather than assuming the invariant.
    var cap = load64(self + 16);
    var slack = cap / 8;
    if (slack < 16) { slack = 16; }
    if (load64(self + 8) > cap + slack) {
        var drop = load64(self + 8) - cap;
        var new_entries = vec_new();
        for (var i = drop; i < load64(self + 8); i = i + 1) {
            vec_push(new_entries, vec_get(load64(self), i));
        }
        store64(self, new_entries);
        store64(self + 8, cap);
    }
    return 0;
}
fn CommandHistory_get_recent(self, n) {
    var result = vec_new();
    var start = load64(self + 8) - n;
    if (start < 0) { start = 0; }
    for (var i = start; i < load64(self + 8); i = i + 1) {
        vec_push(result, vec_get(load64(self), i));
    }
    return result;
}
fn CommandHistory_search(self, query) {
    var result = vec_new();
    for (var i = 0; i < load64(self + 8); i = i + 1) {
        var entry = vec_get(load64(self), i);
        if (str_contains(entry, query) == 1) {
            vec_push(result, entry);
        }
    }
    return result;
}
fn CommandHistory_save(self) {
    var builder = str_builder_new();
    # Clamp to max_size: CommandHistory_add trims lazily (see its note), so
    # `count` can transiently exceed the cap. Write only the most recent
    # max_size entries so the on-disk file always honours the documented cap.
    var scount = load64(self + 8);
    var scap = load64(self + 16);
    var sstart = 0;
    if (scap > 0 && scount > scap) { sstart = scount - scap; }
    for (var i = sstart; i < scount; i = i + 1) {
        str_builder_add(builder, vec_get(load64(self), i));
        str_builder_add(builder, "\n");
    }
    var content = str_builder_build(builder);
    # Cyrius 5.10.x file_write_all takes (path, buf, len). Pre-slice-7
    # this code was calling the v1.0 two-arg form `file_write_all(path,
    # content)` against a content Str — would have raised an arity
    # error on first wire-up. Pass content's data ptr + length. Skip
    # the v1.0-era fs_parent/fs_mkdir_p call (those helpers no longer
    # exist in 5.10.x); `$HOME` is the conventional parent and is
    # guaranteed to exist when the shell starts.
    # Open explicitly rather than via file_write_all so we can (a) pass
    # O_NOFOLLOW and (b) set 0600 AT CREATE. file_write_all opens
    # O_WRONLY|O_CREAT|O_TRUNC with a 0644-ish umask default and the chmod
    # below only tightened it AFTERWARDS — a create-then-chmod race in which
    # every command the user has ever typed is world-readable for the window
    # between the two calls (and permanently, if the process dies in it).
    # O_NOFOLLOW additionally refuses a pre-placed symlink at the path.
    # 1|64|512 = O_WRONLY|O_CREAT|O_TRUNC; 384 = 0600.
    var hfd = file_open(load64(self + 24), 1 | 64 | 512 | O_NOFOLLOW_LINUX, 384);
    if (hfd < 0) {
        var hopen = "agnsh: warning: could not open history file for writing\n";
        sys_write(2, hopen, strlen(hopen));
        return 0 - 1;
    }
    # The write return was previously discarded, so a full disk silently lost
    # history while the chmod check below still reported success — the user was
    # pointed at a permissions problem that did not exist.
    var hlen = str_len(content);
    var hw = file_write(hfd, str_data(content), hlen);
    file_close(hfd);
    if (hw != hlen) {
        var hshort = "agnsh: warning: history file write was short or failed\n";
        sys_write(2, hshort, strlen(hshort));
        return 0 - 1;
    }
    # Use the lib/io.cyr `sys_chmod` wrapper — aarch64 has no bare
    # SYS_CHMOD (the generic syscall table only exposes fchmodat).
    # Check the return: if chmod fails, the history file stays at
    # the umask default (typically 0644 = world-readable). On a
    # multi-user system that leaks every shell command the user has
    # ever typed. Surface the failure via stderr; the file write
    # itself already succeeded so we don't return an error from
    # save() — but the operator can react.
    var chmod_rc = sys_chmod(load64(self + 24), 384);
    if (chmod_rc != 0) {
        # strlen(), not a hand-counted literal: this read 52 bytes from a
        # 50-byte literal, emitting 2 bytes of adjacent .rodata to stderr.
        var hwarn = "agnsh: warning: chmod 0600 failed on history file\n";
        sys_write(2, hwarn, strlen(hwarn));
    }
    return 0;
}
fn CommandHistory_len(self) {
    return load64(self + 8);
}
