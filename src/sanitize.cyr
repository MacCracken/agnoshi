var _sanitize_loaded = 1;

# O_NOFOLLOW — refuse to open a symlink at the final path component. Used on
# the two shell state files ($HOME/.agnsh_audit.log, $HOME/.agnsh_history),
# which an attacker with prior write access to $HOME could otherwise pre-place
# as symlinks to redirect (and, via the follow-up chmod, re-permission) an
# arbitrary user-owned file.
#
# ⚠ THERE IS NO PER-ARCH SPLIT, despite what the v1.3.1 audit and
# docs/guides/security-model.md said until 1.9.1. Both are (1 << 17) = 131072:
# asm-generic/fcntl.h defines O_NOFOLLOW as (1 << 17) and NEITHER x86_64 nor
# aarch64 overrides it (32-bit arm does — that is where the confusion came
# from). The previously-published aarch64 value 0o100000 = 32768 is
# O_LARGEFILE: shipping it would have opened the audit log with O_LARGEFILE and
# left the symlink race fully intact on the aarch64 release artifact, while the
# CHANGELOG claimed it closed. Do not "restore" a per-arch #ifdef here.
#
# On agnos the bit is dropped, not miscompiled: file_open (lib/io.cyr:75) masks
# only 3|64|512|1024 into the AO_* namespace, so this degrades gracefully until
# agnos gains an AO_NOFOLLOW bit (tracked in the roadmap).
# ⛔ THE NUMERIC OPEN FLAGS ARE NOT PORTABLE, AND agnsh HARDCODED THE LINUX ONES.
# `1089` (O_WRONLY|O_CREAT|O_APPEND on Linux) decodes on Darwin as
# O_WRONLY|O_ASYNC|O_TRUNC — no O_CREAT and, fatally, O_TRUNC. On a macOS host
# the audit log would have been TRUNCATED on every single open and never created
# in the first place: the shell's whole trail replaced by its most recent line,
# or nothing at all. Named constants, split by target.
#
# NB the values below are LINUX values on agnos too, and deliberately so:
# lib/io.cyr's file_open takes Linux-shaped flags and maps them into the AO_*
# namespace itself (`flags & 64` -> AO_CREAT, `& 512` -> AO_TRUNC,
# `& 1024` -> AO_APPEND). Handing it agnos-native bits would double-translate.
#
# ⚠ The Darwin branch is written from the documented <sys/fcntl.h> values and is
# NOT compile-verified here: this toolchain exposes no macOS target
# (`cyrius build` offers --aarch64/--win/--agnos), so nothing in CI can reach it.
#ifdef CYRIUS_TARGET_MACOS
var OPEN_WRONLY = 1;
var OPEN_CREAT = 512;      # 0x0200
var OPEN_APPEND = 8;       # 0x0008
var OPEN_TRUNC = 1024;     # 0x0400
var OPEN_NOFOLLOW = 256;   # 0x0100
#endif
#ifndef CYRIUS_TARGET_MACOS
var OPEN_WRONLY = 1;
var OPEN_CREAT = 64;       # 0o100
var OPEN_APPEND = 1024;    # 0o2000
var OPEN_TRUNC = 512;      # 0o1000
# O_NOFOLLOW is (1 << 17) on BOTH x86_64 and aarch64 Linux — there is no
# per-arch split; see the 1.9.1 note. On agnos file_open drops the bit.
var OPEN_NOFOLLOW = 131072;
#endif

# 0600 — owner read/write only. The mode every shell state file is created with.
var STATE_FILE_MODE = 384;

fn str_byte_at(s, i) {
    return load8(str_data(s) + i);
}
fn eprint_str(s) {
    syscall(SYS_WRITE, 2, str_data(s), str_len(s));
}
fn eprint_line(s) {
    eprint_str(s);
    syscall(SYS_WRITE, 2, "\n", 1);
}
# Write a NUL-terminated cstring + newline to STDERR.
#
# ⛔ Every diagnostic in the shell used to go to STDOUT via println(). Two
# problems, and the second got worse in 1.9.2. (1) It corrupts piped output:
# `agnsh -c "..." | jq` receives `run: no such command` as if it were data.
# (2) Now that agnsh actually executes programs, the child's stdout and the
# shell's own error text share a stream, so a caller cannot tell the program's
# output from the shell's complaint about it. Diagnostics belong on fd 2; the
# Str-side helpers above already existed and had zero call sites.
fn eprintln_cstr(cstr): i64 {
    syscall(SYS_WRITE, 2, cstr, strlen(cstr));
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}
# Case-insensitive contains/find/split helpers. Haystack is a Str
# (the parser entry trims input to Str at the top of Interpreter_parse);
# needle is always a cstring literal at the call sites. Using
# `str_len(needle)` would read load64(needle+8) as a Str header on the
# raw cstring address — bogus length, parser never matches anything
# and every input falls through to SHELL_COMMAND. Reach for `strlen`
# on the cstring side and pointer-arith directly off the needle.
fn str_contains_ci(haystack, needle) {
    var hlen = str_len(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var hd = str_data(haystack);
    for (var i = 0; i <= hlen - nlen; i = i + 1) {
        var found = 1;
        for (var j = 0; j < nlen; j = j + 1) {
            var hc = load8(hd + i + j);
            var nc = load8(needle + j);
            if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
            if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
            if (hc != nc) { found = 0; }
        }
        if (found == 1) { return 1; }
    }
    return 0;
}
fn str_find_ci(haystack, needle) {
    var hlen = str_len(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    if (nlen > hlen) { return 0 - 1; }
    var hd = str_data(haystack);
    for (var i = 0; i <= hlen - nlen; i = i + 1) {
        var found = 1;
        for (var j = 0; j < nlen; j = j + 1) {
            var hc = load8(hd + i + j);
            var nc = load8(needle + j);
            if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
            if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
            if (hc != nc) { found = 0; }
        }
        if (found == 1) { return i; }
    }
    return 0 - 1;
}
fn str_find_ci_from(haystack, needle, from) {
    var hlen = str_len(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return from; }
    if (from + nlen > hlen) { return 0 - 1; }
    var hd = str_data(haystack);
    for (var i = from; i <= hlen - nlen; i = i + 1) {
        var found = 1;
        for (var j = 0; j < nlen; j = j + 1) {
            var hc = load8(hd + i + j);
            var nc = load8(needle + j);
            if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
            if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
            if (hc != nc) { found = 0; }
        }
        if (found == 1) { return i; }
    }
    return 0 - 1;
}
fn str_split_ci(input, sep) {
    var result = vec_new();
    var idx = str_find_ci(input, sep);
    if (idx < 0) {
        vec_push(result, input);
        return result;
    }
    var sep_len = strlen(sep);
    vec_push(result, str_substr(input, 0, idx));
    vec_push(result, str_substr(input, idx + sep_len, str_len(input)));
    return result;
}
# Returns 1 if `input` (Str) starts with `prefix_cstr` (cstring),
# case-insensitive. Used by the parser to gate on interrogative form
# ("is X running" — only fires when the input opens with "is ", so a
# statement like "the application is running" doesn't get routed to
# SERVICE_CONTROL).
fn input_starts_with(input, prefix_cstr) {
    var plen = strlen(prefix_cstr);
    if (plen > str_len(input)) { return 0; }
    var hd = str_data(input);
    for (var i = 0; i < plen; i = i + 1) {
        var hc = load8(hd + i);
        var pc = load8(prefix_cstr + i);
        if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
        if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
        if (hc != pc) { return 0; }
    }
    return 1;
}
# Word-prefix matcher. Returns 1 if `word` (cstring, leading/trailing
# whitespace ignored) is a prefix of any whitespace-delimited token in
# `input` (Str), case-insensitive.
#
# Designed for keyword-style intent parsing where two properties matter
# simultaneously: (a) plural-tolerance — "file" should match "files",
# "process" should match "processes"; (b) substring-trap immunity —
# "move" must NOT match "remove", "rm" must NOT match "warm". Strict
# whole-token matching gives (b) but loses (a); raw substring gives (a)
# but loses (b). Token-prefix lands in the middle: matches stems / plurals
# while requiring the needle to start at a whitespace boundary.
fn is_word_prefix(input, word) {
    var w_start = 0;
    var w_end = strlen(word);
    while (w_start < w_end) {
        var c = load8(word + w_start);
        if (c != 32) {
            if (c != 9) { break; }
        }
        w_start = w_start + 1;
    }
    while (w_end > w_start) {
        var c = load8(word + w_end - 1);
        if (c != 32) {
            if (c != 9) { break; }
        }
        w_end = w_end - 1;
    }
    var wlen = w_end - w_start;
    if (wlen <= 0) { return 1; }
    var hlen = str_len(input);
    if (wlen > hlen) { return 0; }
    var hd = str_data(input);
    var i = 0;
    while (i <= hlen - wlen) {
        var at_token_start = 0;
        if (i == 0) {
            at_token_start = 1;
        } else {
            var pc = load8(hd + i - 1);
            if (pc == 32) { at_token_start = 1; }
            if (pc == 9) { at_token_start = 1; }
            if (pc == 10) { at_token_start = 1; }
        }
        if (at_token_start == 1) {
            var matched = 1;
            for (var j = 0; j < wlen; j = j + 1) {
                var hc = load8(hd + i + j);
                var nc = load8(word + w_start + j);
                if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
                if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
                if (hc != nc) { matched = 0; }
            }
            if (matched == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}
# Whole-token match: 1 if `word` (cstring) appears in `input` (Str) as a
# COMPLETE whitespace-delimited token, case-insensitive.
#
# The distinction from is_word_prefix matters for disambiguation. is_word_prefix
# deliberately matches token PREFIXES so "file" finds "files" — but that also
# means "user" finds "user_data.txt", so a guard written with it would route
# `remove user_data.txt` to the user-management parser and try to delete an
# account named after a text file. This variant requires a boundary on BOTH
# sides, so `delete user bob` matches and `remove user_data.txt` does not.
fn input_has_exact_word(input, word) {
    var wlen = strlen(word);
    if (wlen == 0) { return 0; }
    var hlen = str_len(input);
    if (wlen > hlen) { return 0; }
    var hd = str_data(input);
    var i = 0;
    while (i <= hlen - wlen) {
        var at_start = 0;
        if (i == 0) {
            at_start = 1;
        } else {
            var pc = load8(hd + i - 1);
            if (pc == 32) { at_start = 1; }
            if (pc == 9) { at_start = 1; }
            if (pc == 10) { at_start = 1; }
        }
        if (at_start == 1) {
            var matched = 1;
            for (var j = 0; j < wlen; j = j + 1) {
                var hc = load8(hd + i + j);
                var nc = load8(word + j);
                if (hc >= 65) { if (hc <= 90) { hc = hc + 32; } }
                if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
                if (hc != nc) { matched = 0; }
            }
            if (matched == 1) {
                var e = i + wlen;
                if (e >= hlen) { return 1; }
                var ec = load8(hd + e);
                if (ec == 32) { return 1; }
                if (ec == 9) { return 1; }
                if (ec == 10) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}
fn is_shell_metachar(ch) {
    if (ch == 59) { return 1; }
    if (ch == 124) { return 1; }
    if (ch == 38) { return 1; }
    if (ch == 36) { return 1; }
    if (ch == 40) { return 1; }
    if (ch == 41) { return 1; }
    if (ch == 60) { return 1; }
    if (ch == 62) { return 1; }
    if (ch == 96) { return 1; }
    if (ch == 10) { return 1; }
    return 0;
}
fn has_shell_metachars(s) {
    var len = str_len(s);
    for (var i = 0; i < len; i = i + 1) {
        if (is_shell_metachar(str_byte_at(s, i)) == 1) {
            return 1;
        }
    }
    return 0;
}
fn is_safe_arg(s) {
    if (s == 0) { return 0; }
    var len = strlen(s);
    if (len == 0) { return 0; }
    if (len > 4096) { return 0; }
    return (has_shell_metachars_cstr(s) == 0);
}
fn has_path_traversal_cstr(path) {
    if (path == 0) { return 0; }
    var len = strlen(path);
    if (len < 2) { return 0; }
    for (var i = 0; i < len - 1; i = i + 1) {
        if (load8(path + i) == 46) {
            if (load8(path + i + 1) == 46) {
                return 1;
            }
        }
    }
    return 0;
}
fn has_shell_metachars_cstr(path) {
    if (path == 0) { return 0; }
    var len = strlen(path);
    for (var i = 0; i < len; i = i + 1) {
        if (is_shell_metachar(load8(path + i)) == 1) {
            return 1;
        }
    }
    return 0;
}
fn is_safe_path(path) {
    if (path == 0) { return 0; }
    if (has_path_traversal_cstr(path) == 1) { return 0; }
    if (has_shell_metachars_cstr(path) == 1) { return 0; }
    return 1;
}
# Str-aware variants of the safety predicates. The parser side
# (extract_after / extract_between in interpreter.cyr) returns Str
# fat-pointers, and translate_X writes those Strs into intent fields.
# The original `is_safe_path` / `is_safe_arg` are cstring-only
# (`load8(path + i)` dereferences the raw address) — passing a Str
# fat-pointer to them reads the 16-byte Str header as if it were
# string data, falsely flagging traversal/metachars and routing every
# parsed write-side intent (copy/move/remove/create-dir/show-file/
# find-files/search-content) to `translate_unknown`. Pre-v1.2.1 the
# binary silently echoed instead of running the intended command for
# every NL filesystem operation. The _str variants use `str_byte_at`
# (which goes through `str_data`) and `strlen` (overload-dispatched
# to `strlen_str` on a Str input).
fn path_traversal_in_str(s) {
    if (s == 0) { return 0; }
    var len = str_len(s);
    if (len < 2) { return 0; }
    for (var i = 0; i < len - 1; i = i + 1) {
        if (str_byte_at(s, i) == 46) {
            if (str_byte_at(s, i + 1) == 46) {
                return 1;
            }
        }
    }
    return 0;
}
fn shell_metachars_in_str(s) {
    if (s == 0) { return 0; }
    var len = str_len(s);
    for (var i = 0; i < len; i = i + 1) {
        if (is_shell_metachar(str_byte_at(s, i)) == 1) {
            return 1;
        }
    }
    return 0;
}
fn safe_path_in_str(s) {
    if (s == 0) { return 0; }
    if (path_traversal_in_str(s) == 1) { return 0; }
    if (shell_metachars_in_str(s) == 1) { return 0; }
    return 1;
}
fn safe_arg_in_str(s) {
    if (s == 0) { return 0; }
    var len = str_len(s);
    if (len == 0) { return 0; }
    if (len > 4096) { return 0; }
    return (shell_metachars_in_str(s) == 0);
}
# Str-side twin of is_safe_commit_message (ADR-006). The cstring original is
# handed a Str by translate_git_commit — the parser fills intent+8 via
# extract_after, which returns str_trim(str_substr(...)) — so its strlen(msg)
# walked the 16-byte Str header and load8(msg) read the low byte of the data
# POINTER, never the message. The H7 leading-dash argument-injection guard was
# therefore inert on the only path that calls it:
# `git commit -m -oh-no-a-flag` was accepted and emitted verbatim, where git
# reads the value as a flag rather than a message.
fn safe_commit_message_in_str(s) {
    if (s == 0) { return 0; }
    var len = str_len(s);
    if (len == 0) { return 0; }
    if (str_byte_at(s, 0) == 45) { return 0; }
    return 1;
}
fn get_command_basename(cmd) {
    if (cmd == 0) { return cmd; }
    var len = strlen(cmd);
    if (len == 0) { return cmd; }
    var last_slash = 0 - 1;
    for (var i = 0; i < len; i = i + 1) {
        if (load8(cmd + i) == 47) {
            last_slash = i;
        }
    }
    if (last_slash >= 0) {
        return cmd + last_slash + 1;
    }
    return cmd;
}
fn is_safe_username(name) {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len == 0) { return 0; }
    if (len > 256) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        var ch = load8(name + i);
        if (ch >= 97 && ch <= 122) { continue; }
        if (ch >= 65 && ch <= 90) { continue; }
        if (ch >= 48 && ch <= 57) { continue; }
        if (ch == 95) { continue; }
        if (ch == 45) { continue; }
        return 0;
    }
    return 1;
}
fn strip_control_chars(s) {
    if (s == 0) { return s; }
    var len = str_len(s);
    var builder = str_builder_new();
    for (var i = 0; i < len; i = i + 1) {
        var ch = str_byte_at(s, i);
        if (ch == 9) { str_builder_add(builder, " "); }
        elif (ch == 10) { str_builder_add(builder, " "); }
        elif (ch < 32) { }
        elif (ch == 127) { }
        else { str_builder_add_byte(builder, ch); }
    }
    return str_builder_build(builder);
}
fn print_str_safe(s) {
    var safe = strip_control_chars(s);
    str_print(safe);
}
# Escape a Str for embedding inside a JSON string literal.
#
# Returns the escaped CONTENT ONLY — every caller supplies its own surrounding
# quotes (audit.cyr's `"{\"input\":\""` + value + `"\",…"`, translate.cyr's
# `"{\"agent\":\""` + value + `"\"}"`).
#
# ⛔ The null branch used to `return "\"\""` — a raw CSTRING, where every other
# return is a Str, and carrying two quote characters the caller also emits. Both
# halves were bugs: str_builder_add is declared `(sb, s: Str)` and reads
# load64(s + 8) as a length, so a cstring return meant a memcpy of whatever the
# adjacent .rodata happened to decode to; and the stray quotes would have closed
# the JSON string early. Reachable because str_from returns 0 on allocation
# failure (str_new_a -> `return 0`). This is also the source of the two
# long-standing `assigning non-pointer to typed pointer` warnings at
# translate.cyr:494/508 — the compiler could not settle the return type.
#
# ⛔ Bytes >= 0x80 used to be copied through unvalidated, so a single high byte
# in NL input made the audit record invalid UTF-8 and therefore invalid JSON.
# `jq`/serde/encoding_json all reject the line — and on a whole-file parse one
# poisoned line takes the entire audit log down with it, which an actor whose
# own entry would read `rejected_safety` could trigger deliberately.
#
# UTF-8 is VALIDATED rather than blanket-escaped: naively emitting \u00XX per
# high byte is byte-exact but semantically wrong (é = C3 A9 would become the
# mojibake "Ã©"), so well-formed sequences pass through verbatim and only
# genuinely invalid bytes become U+FFFD. Overlong forms, surrogates and
# out-of-range lead bytes are all rejected.
fn json_escape(s): Str {
    if (s == 0) { return str_from(""); }
    var len = str_len(s);
    var builder = str_builder_new();
    var i = 0;
    while (i < len) {
        var ch = str_byte_at(s, i);
        if (ch == 34) { str_builder_add(builder, "\\\""); i = i + 1; }
        elif (ch == 92) { str_builder_add(builder, "\\\\"); i = i + 1; }
        elif (ch == 10) { str_builder_add(builder, "\\n"); i = i + 1; }
        elif (ch == 13) { str_builder_add(builder, "\\r"); i = i + 1; }
        elif (ch == 9) { str_builder_add(builder, "\\t"); i = i + 1; }
        elif (ch == 8) { str_builder_add(builder, "\\b"); i = i + 1; }
        elif (ch == 12) { str_builder_add(builder, "\\f"); i = i + 1; }
        elif (ch < 32) { i = i + 1; }
        elif (ch == 127) { i = i + 1; }
        elif (ch < 128) { str_builder_add_byte(builder, ch); i = i + 1; }
        else {
            var seqlen = 0;
            var lo = 0x80;
            var hi = 0xBF;
            if (ch >= 0xC2 && ch <= 0xDF) { seqlen = 2; }
            elif (ch >= 0xE0 && ch <= 0xEF) {
                seqlen = 3;
                if (ch == 0xE0) { lo = 0xA0; }
                if (ch == 0xED) { hi = 0x9F; }
            }
            elif (ch >= 0xF0 && ch <= 0xF4) {
                seqlen = 4;
                if (ch == 0xF0) { lo = 0x90; }
                if (ch == 0xF4) { hi = 0x8F; }
            }
            var ok = 0;
            if (seqlen != 0 && i + seqlen <= len) {
                ok = 1;
                for (var k = 1; k < seqlen; k = k + 1) {
                    var cb = str_byte_at(s, i + k);
                    var blo = 0x80;
                    var bhi = 0xBF;
                    if (k == 1) { blo = lo; bhi = hi; }
                    if (cb < blo || cb > bhi) { ok = 0; }
                }
            }
            if (ok == 1) {
                for (var m = 0; m < seqlen; m = m + 1) {
                    str_builder_add_byte(builder, str_byte_at(s, i + m));
                }
                i = i + seqlen;
            } else {
                str_builder_add(builder, "\\ufffd");
                i = i + 1;
            }
        }
    }
    return str_builder_build(builder);
}
fn build_safe_env() {
    var env = vec_new();
    vec_push(env, "PATH=/usr/bin:/bin:/usr/sbin:/sbin");
    # getenv returns a raw cstring; str_cat wants (Str, Str), so wrap the
    # value in str_from. Passing the bare cstring made str_cat read it as a
    # Str header and fault — latent because build_safe_env isn't wired into an
    # exec path yet and the core test formerly stubbed getenv→0 (skipping this
    # branch entirely). Surfaced by the 6.3.x test migration.
    var home = getenv("HOME");
    if (home != 0) {
        vec_push(env, str_cat(str_from("HOME="), str_from(home)));
    }
    var lang = getenv("LANG");
    if (lang != 0) {
        vec_push(env, str_cat(str_from("LANG="), str_from(lang)));
    }
    var term = getenv("TERM");
    if (term != 0) {
        vec_push(env, str_cat(str_from("TERM="), str_from(term)));
    }
    return env;
}
fn is_valid_pid(pid) {
    if (pid <= 0) { return 0; }
    if (pid > 4194304) { return 0; }
    return 1;
}
fn is_safe_branch_name(name) {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len == 0) { return 0; }
    if (len > 256) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        var ch = load8(name + i);
        if (ch >= 97 && ch <= 122) { continue; }
        if (ch >= 65 && ch <= 90) { continue; }
        if (ch >= 48 && ch <= 57) { continue; }
        if (ch == 45) { continue; }
        if (ch == 95) { continue; }
        if (ch == 47) { continue; }
        if (ch == 46) { continue; }
        return 0;
    }
    return 1;
}
fn is_safe_commit_message(msg) {
    if (msg == 0) { return 0; }
    var len = strlen(msg);
    if (len == 0) { return 0; }
    if (load8(msg) == 45) { return 0; }
    return 1;
}

# ================================================================
# Shell confirm + output helpers (relocated from verbs.cyr at 1.5.0)
# ================================================================
# The in-process FS verbs were removed in agnoshi 1.5.0 — agnsh now DELEGATES
# cp/mv/rm/ls/mkdir/rmdir/touch/echo/wc/find/grep to the staged /bin/kriya
# dispatcher and cat to /bin/owl (see run_agnos.cyr's bareword launcher). These
# few helpers survived because sh_run_program (the `run` builtin) still uses them
# for its mode-gated launch confirm; re-homed here (target-agnostic, included
# before the agnsh.cyr body) rather than deleted with the verbs.

# Mode-gated destructive-action confirmation. Modes (0=AI_AUTONOMOUS,
# 1=AI_ASSISTED, 2=HUMAN, 3=STRICT; src/mode.cyr): AUTO+ASSIST run directly,
# HUMAN+STRICT prompt before a consequential action.
fn mode_needs_confirm(mode): i64 {
    if (mode == 2) { return 1; }
    if (mode == 3) { return 1; }
    return 0;
}

# Write a cstring / a newline to stdout (syscall-direct, no Str churn).
fn verb_out_cstr(cstr): i64 {
    syscall(SYS_WRITE, 1, cstr, strlen(cstr));
    return 0;
}
fn verb_out_nl(): i64 {
    syscall(SYS_WRITE, 1, "\n", 1);
    return 0;
}

# Read one confirm line; return 1 iff its first byte is 'y'/'Y'. Routes through
# read_line (defined in agnsh.cyr, forward-referenced across the compilation
# unit) so the interactive line discipline + carry buffer apply; EOF/empty -> no.
fn verb_read_yes(): i64 {
    var rb[64];
    var n = read_line(&rb, 64);
    if (n <= 0) { return 0; }
    var c = load8(&rb);
    if (c == 121) { return 1; }   # 'y'
    if (c == 89) { return 1; }    # 'Y'
    return 0;
}

# Prompt `  ⚠ <action> ? [y/N] `, read one line, return 1 to PROCEED / 0 to
# ABORT (prints "(aborted)" itself). Only called when mode_needs_confirm==1.
fn verb_confirm(action_cstr): i64 {
    # ⛔ FAIL CLOSED. `action_cstr` is built by str_cat3_cstr, which returns 0 if
    # the allocation fails; verb_out_cstr would then strlen() a null pointer. More
    # importantly this is the HUMAN/STRICT gate in front of every program launch,
    # so the only safe answer when the prompt cannot even be rendered is "no".
    # Proceeding on an un-shown confirmation would run the program the user was
    # never asked about.
    if (action_cstr == 0) {
        verb_out_cstr("  cannot render confirmation prompt -- declining\n");
        return 0;
    }
    verb_out_cstr("  \xE2\x9A\xA0 ");   # two-space indent + U+26A0 WARNING SIGN
    verb_out_cstr(action_cstr);
    verb_out_cstr(" ? [y/N] ");
    if (verb_read_yes() == 1) { return 1; }
    verb_out_cstr("  (aborted)");
    verb_out_nl();
    return 0;
}

# Build the cstring `a + b + c` (all NUL-terminated) into a fresh heap buffer.
fn str_cat3_cstr(a, b, c): i64 {
    var la = strlen(a);
    var lb = strlen(b);
    var lc = strlen(c);
    var buf = alloc(la + lb + lc + 1);
    # Returns 0 on allocation failure. Unchecked, the memcpys below wrote through
    # a null base. Every caller feeds the result straight to verb_confirm, which
    # now treats 0 as "cannot prompt" and declines — see there.
    if (buf == 0) { return 0; }
    memcpy(buf, a, la);
    memcpy(buf + la, b, lb);
    memcpy(buf + la + lb, c, lc);
    store8(buf + la + lb + lc, 0);
    return buf;
}

# ----------------------------------------------------------------
# cat -> owl redirect nudge (1.5.0)
# ----------------------------------------------------------------
# kriya provides every delegated file verb EXCEPT cat — owl is AGNOS's cat, and
# kriya has none by design. There is no /bin/cat, so a typed `cat FILE` would
# otherwise fall to the NL-intent path with no useful feedback. Intercept a
# leading `cat` word and nudge the user to owl. Returns 1 if it handled the line
# (caller should skip further dispatch), else 0.
fn sh_first_word_eq(line_cstr, word_cstr): i64 {
    var i = 0;
    while (1 == 1) {
        var wc = load8(word_cstr + i);
        if (wc == 0) {
            var lc = load8(line_cstr + i);
            if (lc == 0) { return 1; }     # exact match (bare `cat`)
            if (lc == 32) { return 1; }    # word boundary (`cat ...`)
            return 0;
        }
        if (load8(line_cstr + i) != wc) { return 0; }
        i = i + 1;
    }
    return 0;
}
fn sh_cat_owl_warning(line_cstr): i64 {
    if (sh_first_word_eq(line_cstr, "cat") == 0) { return 0; }
    println("cat: AGNOS reads files with owl -- try 'owl FILE' (or 'owl -p FILE' for plain output)");
    return 1;
}
