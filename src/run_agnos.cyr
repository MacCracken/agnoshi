# run_agnos.cyr — committed agnos program-launch path for agnsh.
#
# WHY THIS LIVES IN src/ (tracked), NOT lib/: the vendored lib/process_agnos.cyr is
# gitignored and regenerated by `cyrius update` from the version-pinned cyrius
# snapshot, whose run() uses sys_spawn(#3)+sys_waitpid(#4). That pair carries NO argv
# and, on iron, hard-hangs (waitpid hlt-spins with IF=0) / triple-faults (spawn's
# in-memory elf_load CR3-switch memcpy of an unmapped arena). The cyrius master stdlib
# has no execwait wrapper either, and cyrius is hands-off — so agnsh's durable launch
# path lives here and calls the kernel execwait (#37) syscall directly. Any execwait
# edit applied to lib/ would be silently lost on the next `cyrius update`.
#
# execwait(#37) is the ring-3 blocking-exec primitive (agnos 1.43.0): the kernel loads
# the static ELF from the ext2 root under boot CR3 and runs it synchronously in ring 3,
# returning the child's exit code (or -1). ARGV: we pass the WHOLE command line
# ("PATH arg1 arg2 ..") as the syscall's (path,len). The kernel opens the PATH TOKEN
# only (up to the first space) and tokenizes the full line into argv (agnos
# syscall.cyr #37 + elf.cyr — the 1436-burn argv fix). So argv flows simply by handing
# the untouched "PATH args" line straight through; no client-side splitting.
#
# This whole file is agnos-only; the host build keeps the lib fork/exec run().
# ---- Host-testable command-line parsers ----
#
# These sit OUTSIDE the CYRIUS_TARGET_AGNOS block ON PURPOSE. They are pure byte
# manipulation over the raw input line (plus alloc), with no syscall and no agnos
# ABI, and they are the shell's UNTRUSTED-INPUT PARSERS — the code that decides
# where a pipe splits, where a redirect target begins, and whether a line is a
# background request.
#
# Until 1.9.3 the whole file was one #ifdef, so on a Linux host they compiled to
# nothing and `cyrius test` could not reach them: 22/22 untested, on the least
# trustworthy input in the program. Hoisting them here costs nothing on agnos
# (same code, same call sites) and makes them directly assertable from
# tests/test_core.tcyr, which is what let 1.9.3's fixes below be verified rather
# than merely reviewed.
#
# Anything needing a syscall (_sh_bin_probe's open/close, every launcher) stays
# inside the #ifdef.

# Detect a trailing `&` (ASCII 38) and report the length of the command part
# before it. Returns that length for a background request, or -1 if the line is
# not one. **Does NOT modify the line.**
#
# ⛔ This replaced an in-place `sh_strip_trailing_amp` that TRUNCATED the caller's
# buffer at the top of sh_try_bareword_launch — before the token scan, before the
# existence probe, and therefore before the two paths that give the line BACK to
# the caller. So `sleeper &` with no /bin/sleeper fell through to the natural-
# language path as plain `sleeper`, and that truncated text is what reached the
# NL parser, the history file and the audit record. The line the shell reported
# was not the line the user typed. Returning a length leaves the caller's buffer
# untouched on every path, including the fall-throughs.
fn sh_scan_trailing_amp(line): i64 {
    var len = 0;
    while (load8(line + len) != 0) { len = len + 1; }
    var e = len;
    while (e > 0) { if (load8(line + e - 1) == 32) { e = e - 1; } else { break; } }  # skip trailing spaces
    if (e == 0) { return 0 - 1; }
    if (load8(line + e - 1) != 38) { return 0 - 1; }         # no trailing '&'
    e = e - 1;                                               # the '&' position
    while (e > 0) { if (load8(line + e - 1) == 32) { e = e - 1; } else { break; } }  # spaces before '&'
    return e;                                                # length of the command part
}

# Offset of the FIRST '|' pipe separator (byte 124), or -1 if absent. Surrounding spaces
# are OPTIONAL — `a|b`, `a |b`, `a| b`, and `a | b` all split identically because
# _sh_bin_segment ltrim/rtrims each stage. The tolerance is deliberate: the xHCI keyboard
# drops the occasional keystroke on iron (the agnos pipe-smoke.py harness retries on exactly
# this), and a swallowed space around the '|' must NOT silently demote a pipeline to a
# bareword launch — whose is_safe_path then rejects the '|' as a shell metacharacter, the
# baffling "run: unsafe path" the 1.46.11 burn hit on `anuenue | brnmr` (one space eaten).
fn _sh_find_pipe(line): i64 {
    var i = 0;
    while (load8(line + i) != 0) {
        if (load8(line + i) == 124) { return i; }   # '|'
        i = i + 1;
    }
    return 0 - 1;
}

# Build "/bin/" + line[start..end], leading/trailing spaces trimmed, NUL-terminated.
# Returns a freshly alloc'd cstr, or 0 on an empty/alloc-failed segment.
fn _sh_bin_segment(line, start, end): i64 {
    while (start < end) { if (load8(line + start) == 32) { start = start + 1; } else { break; } }  # ltrim
    while (end > start) { if (load8(line + end - 1) == 32) { end = end - 1; } else { break; } }    # rtrim
    var sl = end - start;
    if (sl <= 0) { return 0; }
    var cmd = alloc(5 + sl + 1);
    if (cmd == 0) { return 0; }
    store8(cmd + 0, 47); store8(cmd + 1, 98); store8(cmd + 2, 105);   # "/bi"
    store8(cmd + 3, 110); store8(cmd + 4, 47);                        # "n/"
    var k = 0;
    while (k < sl) { store8(cmd + 5 + k, load8(line + start + k)); k = k + 1; }
    store8(cmd + 5 + sl, 0);
    return cmd;
}

# Offset of the FIRST '>' (byte 62), or -1 if absent. Spaces around it are optional
# (_sh_bin_segment / _sh_path_segment trim each side), same tolerance as the pipe split.
fn _sh_find_redirect(line): i64 {
    var i = 0;
    while (load8(line + i) != 0) {
        if (load8(line + i) == 62) { return i; }   # '>'
        i = i + 1;
    }
    return 0 - 1;
}

# Could `word` (`wl` bytes) name a program? Non-empty, no '/', and only letters, digits and `._+-`.
# Nothing is looked up for a word that fails — no path is built from it, nothing is opened — and the
# line is natural language (ADR-007 decision 1: the discriminator is the program lookup).
# ⭐ 2.0.1: shared by both targets' bareword launchers; it was the host's `_host_prog_word_ok`, and
# agnos had no such gate, so it validated the WHOLE line before looking anything up (see
# sh_try_bareword_launch).
fn sh_prog_word_ok(word, wl): i64 {
    if (wl <= 0) { return 0; }
    for (var i = 0; i < wl; i = i + 1) {
        var c = load8(word + i);
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }     # a-z
        if (c >= 65) { if (c <= 90) { ok = 1; } }      # A-Z
        if (c >= 48) { if (c <= 57) { ok = 1; } }      # 0-9
        if (c == 46 || c == 95 || c == 43 || c == 45) { ok = 1; }   # . _ + -
        if (ok == 0) { return 0; }
    }
    return 1;
}

# A wait status from agnos, as the shell reports it: the child's exit code, or 128 + N when signal
# N killed it. Negative values (a launch failure, "not our child") pass through.
#
# ⛔ 2.0.1 — agnos 1.57.7 reports a child killed by signal N as `0x100 | N` (WSTAT_SIGNALED; a
# fault stays an exit code, 128 + vector, e.g. 142). agnsh passed that through, so a SIGKILLed
# `run` said `run: exit 265`, audited 265, and `agnsh -c` exited 265 & 0xFF = 9 — indistinguishable
# from a program that exited 9. ADR-008 § 4 promises 128 + N, which every POSIX shell reports and the
# host launcher always has (host_exec). Every status agnsh reaps on agnos passes through here.
# Hoisted out of the agnos block so the host suite can assert it: it is pure arithmetic.
fn sh_exit_status(ws): i64 {
    if (ws >= 0x100) { return 128 + (ws & 0xFF); }
    return ws;
}

# line[start..end] trimmed + NUL-terminated, VERBATIM (no "/bin/" prefix — this is a
# file path, not a program). Fresh alloc, or 0 on an empty / alloc-failed segment.
fn _sh_path_segment(line, start, end): i64 {
    while (start < end) { if (load8(line + start) == 32) { start = start + 1; } else { break; } }
    while (end > start) { if (load8(line + end - 1) == 32) { end = end - 1; } else { break; } }
    var sl = end - start;
    if (sl <= 0) { return 0; }
    var p = alloc(sl + 1);
    if (p == 0) { return 0; }
    var k = 0;
    while (k < sl) { store8(p + k, load8(line + start + k)); k = k + 1; }
    store8(p + sl, 0);
    return p;
}

# ---- The `run` builtin's launch path ----
#
# ⛔ MOVED OUT OF src/agnsh.cyr IN 1.9.10, and the reason is the same one that
# drove the 1.9.7 relocations: a test binary cannot include the entry file (it
# owns `main` and calls `_entry()` at top level), so anything living there is
# unreachable from every test regardless of how ordinary it is. sh_run_program
# is the function that decides whether an arbitrary on-disk binary gets launched
# — the mode gate, the pre-launch audit record, and the outcome record all live
# here — and it was the LAST host-reachable function in the tree with no
# assertion of any kind.
#
# It belongs here on merit too: run_agnos.cyr:sh_dispatch already called it as a
# forward reference INTO agnsh.cyr, and its sibling sh_run_program_bg is in this
# file. The move deletes a cross-file forward reference rather than adding one.
#
# ⚠ It sits ABOVE the `#ifdef CYRIUS_TARGET_AGNOS` block deliberately. Inside
# it, the function would compile only on agnos and the host test would be right
# back where it started. Its own #ifdef/#ifndef pair picks the launch mechanism.

# ---- The gate every shell line passes (ADR-008, 2.0.0) ----
#
# Shell lines — `run`, barewords, pipelines, redirects, `&` jobs — are the user's own commands and do
# not pass the permission tiers the NL path uses. What they do pass: HUMAN/STRICT confirm before any
# launch, and a line the classifier calls BLOCKED (`rm -rf`, `dd`, `mkfs`, `chmod`, `chown`, `shred`)
# confirms in EVERY mode (ruled 2026-09-23). Shell-first on the host would otherwise have let
# `agnsh -c "rm -rf ~"` run in `auto`, where 1.9.x classified it BLOCKED and ran nothing. The AI never
# runs BLOCKED (nlexec.cyr); the human may, after an explicit yes.

# Does the permission classifier call this shell line BLOCKED? `line` is a command line whose first
# word may be a path ("/bin/rm -rf x") — the classifier works on the basename.
fn shell_line_blocked(line) {
    var cmd_out[8];
    store64(&cmd_out, 0);
    var args = vec_new();
    var argc = split_command_line(str_from(line), &cmd_out, args);
    if (load64(&cmd_out) == 0) { return 0; }
    if (analyze_command_permission(load64(&cmd_out), args, argc) == PermissionLevel.BLOCKED) { return 1; }
    return 0;
}

# The launch gate. `action` is what the prompt names ("run /bin/ls -la"); `blocked` is
# shell_line_blocked's answer for the line (a pipeline's is either stage's). Returns 1 to proceed, 0
# when declined — the caller audits `denied` and returns EXIT_NOT_RUN.
fn shell_launch_gate(action, blocked, mode) {
    if (blocked == 0) {
        if (mode_needs_confirm(mode) == 0) { return 1; }
        return verb_confirm(action);
    }
    return verb_confirm(str_cat3_cstr("BLOCKED: ", action, ""));
}

# RUN_EXECWAIT_READY gates the `run` builtin's live exec path. **LIVE since agnos
# 1.43.0 shipped execwait (#37).** On agnos the launch goes through sh_exec_line
# (src/run_agnos.cyr → syscall(37, cmdline, len)), NOT the vendored lib run() — that
# lib is gitignored/regenerated by `cyrius update` and reverts to the sys_spawn(#3)+
# waitpid(#4) pair this flag used to gate off:
#   - waitpid(#4) busy-waited on a bare `hlt` while IF=0 → the box HARD-HUNG;
#   - spawn(#3) → in-memory elf_load CR3-switch memcpy of an unmapped arena
#     buffer → #PF/#DF/triple fault.
# execwait sidesteps both (the kernel owns the load under boot CR3; no waitpid spin).
# argv flows as of the 1436-burn fix: the kernel opens the path token and tokenizes
# the full command line into argv (so `run /bin/bnrmr AGNOS` passes "AGNOS"). The host
# build keeps the lib fork/exec run().
var RUN_EXECWAIT_READY = 1;

# What sh_launch_line returns when no child ran — distinct from every exit status a child can have.
var LAUNCH_FAILED = 0 - 1;      # it could not be launched
var LAUNCH_DECLINED = 0 - 2;    # the gate refused it: declined, or BLOCKED without an explicit yes

# Run a program from disk. Shared by the interactive loop and the -c one-shot
# path. `path` is an already-validated command line whose first word is an
# absolute path ("/bin/ls -la"). Returns the child's exit code; EXIT_NOT_RUN
# (126) when refused or declined; EXIT_NOTHING_TO_RUN (127) when it could not be
# launched (ADR-008 § 4 — until 2.0.0 every one of those was 1).
fn sh_run_program(path, mode) {
    var code = sh_launch_line(path, mode);
    if (code == LAUNCH_DECLINED) { return EXIT_NOT_RUN; }
    if (code == LAUNCH_FAILED) { return EXIT_NOTHING_TO_RUN; }
    return code;
}

# sh_run_program's body, keeping "no child ran" apart from a child's own 126 or 127: NL execution
# (nlexec.cyr) reports a declined prompt differently from a program that could not be launched, and
# from a program that ran and exited 127 itself. Returns the child's exit code, LAUNCH_DECLINED or
# LAUNCH_FAILED.
fn sh_launch_line(path, mode) {
    if (RUN_EXECWAIT_READY == 0) {
        eprintln_cstr("run: external programs not yet available (pending agnos 1.43.x execwait)");
        audit_exec_ctx(path, "denied", AUDIT_NO_EXIT);
        return LAUNCH_FAILED;
    }
    # Launching an arbitrary on-disk binary is at least as consequential as a
    # destructive file verb, so it takes the same FIX 4 mode gate — HUMAN/STRICT
    # confirm, AUTO/ASSIST run directly — and a BLOCKED line confirms in every
    # mode (the shell-line gate above). verb_confirm prints "(aborted)" itself on
    # a no/Enter, so stay silent here rather than double-reporting.
    if (shell_launch_gate(str_cat3_cstr("run ", path, ""), shell_line_blocked(path), mode) == 0) {
        audit_exec_ctx(path, "denied", AUDIT_NO_EXIT);
        return LAUNCH_DECLINED;
    }
    # ⚠ HOST ONLY: probe before claiming a launch. The exec-surface vocabulary
    # defines `error` as "the launch itself failed (missing binary, exec
    # refused)" and `failed` as "the child ran to completion, non-zero exit" —
    # but the host path goes through the lib fork/exec run(), where a missing
    # binary means the FORK succeeded and the exec failed inside the child. run()
    # sees Ok(127), so the log said `launched` followed by `failed:127` for a
    # program that never existed, contradicting its own documented vocabulary.
    # agnos does not have this problem: sh_exec_line_sched returns < 0 for a
    # launch failure and already maps to `error`.
    #
    # ⚠ This closes the common case, not the whole gap: a file that exists but
    # is not executable still fails inside the child and is still reported as
    # `failed` with the child's 126. Distinguishing that needs exec feedback the
    # fork/exec path does not hand back, so it is stated rather than papered
    # over. Found by the first test ever written against sh_run_program (1.9.10).
    #ifndef CYRIUS_TARGET_AGNOS
    # 2.0.0: `run PATH ARGS…` takes arguments on the host too, so the probe is on the program — the
    # first word — not on the whole line.
    var hargv = host_argv(0, path);
    if (vec_len(hargv) == 0 || file_exists(vec_get(hargv, 0)) == 0) {
        eprintln_cstr("run: failed to launch program");
        audit_exec_ctx(path, "error", 0 - 1);
        return LAUNCH_FAILED;
    }
    #endif
    # The agnos twin of that probe (2.0.1): spawn_path's line form carries at most 127 bytes, and so
    # does execwait's since agnos 1.57.7, so a longer line cannot launch — say why before claiming a
    # launch. Until 2.0.1 such a line fell back to #37 "which has no cap", was refused there too, and
    # was reported as a bare `run: failed to launch program` after a `launched` record.
    #ifdef CYRIUS_TARGET_AGNOS
    if (strlen(path) > SH_SPAWN_LINE_MAX) {
        eprintln_cstr("run: command line too long (agnos launches at most 127 bytes)");
        audit_exec_ctx(path, "error", AUDIT_NO_EXIT);
        return LAUNCH_FAILED;
    }
    #endif
    # Written BEFORE the child starts. A foreground program can hang forever,
    # kill the shell, or (reboot/poweroff/halt) take the machine down — an
    # outcome-only record would leave no trace of any of those. A `launched`
    # with no matching outcome line IS the signal.
    audit_exec_ctx(path, "launched", AUDIT_NO_EXIT);
    # agnos: route through execwait #37 (sh_exec_line) — the kernel owns the load and
    # stages argv from the full command line. The vendored lib run() is sys_spawn-based
    # (no argv, hard-hangs on iron) so it is NOT used here.
    #ifdef CYRIUS_TARGET_AGNOS
    # The foreground runs under the SCHEDULER (spawn_path #43 + a blocking waitpid), not execwait #37.
    # Until agnos 1.57.7 execwait ran the child inside agnsh's own syscall frame with IF cleared and the
    # child marked non-schedulable, so nothing else on the box ran for the child's whole life — including
    # procs the child spawns. That is why the compositor painted its chrome while its setu clients never
    # executed an instruction. Rationale + the exit-code contract: sh_exec_line_sched (run_agnos.cyr).
    #
    # ⚠ This routing was reverted once (1.8.6) after a 15.6 MB compositor was #PF-killed on
    # archaemenid (`run: exit 142`). That was an agnos kernel defect — the #37 handler restored the
    # CPU's SYSCALL kstack to the raw identity VA instead of its direct-map alias, re-arming a fault
    # for any later proc whose image reached past 15.06 MB — fixed in 1.56.34 and demonstrated with a
    # QEMU control (unfixed kernel triple-faults the armed sequence; fixed kernel reaches 2 clients).
    # ⛔ NOT yet re-confirmed on iron. If large-binary `run` regresses there, swap this one call back
    # to sh_exec_line and the old behaviour returns exactly.
    #
    # ⚠ `>` redirects stay on #37 (sh_run_redirect); pipelines spawn both stages on #43
    # (sh_run_pipeline). Since agnos 1.57.6 exec_redirect#62 arms the caller's NEXT #43 or #37 and is
    # applied into that child's own fd table, so neither needs the other's launch path any more.
    var ecode = sh_exec_line_sched(path);
    if (ecode < 0) {
        eprintln_cstr("run: failed to launch program");
        audit_exec_ctx(path, "error", ecode);
        return LAUNCH_FAILED;
    }
    if (ecode != 0) {
        # Shell metadata about the child, not the child's own output — stderr,
        # so a caller piping the program's stdout gets only the program's stdout.
        eprint_str(str_from("run: exit "));
        eprint_line(str_from_int(ecode));
    }
    audit_exec_ctx(path, audit_exec_outcome(ecode), ecode);
    return ecode;
    #endif
    # host: the one launcher every host program goes through (run_host.cyr, ADR-008 § 3) — an argv
    # vector, agnsh's environment, never a shell. Until 2.0.0 this was lib run(path, 0, 0): no
    # arguments and an EMPTY environment.
    #ifndef CYRIUS_TARGET_AGNOS
    var code = host_exec(hargv);
    if (code < 0) {
        eprintln_cstr("run: failed to launch program");
        audit_exec_ctx(path, "error", 0 - 1);
        return LAUNCH_FAILED;
    }
    if (code != 0) {
        eprint_str(str_from("run: exit "));
        eprint_line(str_from_int(code));
    }
    audit_exec_ctx(path, audit_exec_outcome(code), code);
    return code;
    #endif
}

#ifdef CYRIUS_TARGET_AGNOS

# ===================================================================================
# Background jobs (agnos 1.44.13 kernel halves: spawn_path #43 + non-blocking read).
# A trailing `&` launches the program via spawn_path(#43) — a NON-BLOCKING from-disk
# spawn that returns the child's pid immediately, so agnsh stays live. The prompt loop
# polls these pids with waitpid(#4) (non-blocking, returns -2 while alive) and prints
# "[n] Done" + reaps when one exits. Single-core: this table is agnsh's own state, no
# locking ([[project_multithreading_future_arc]]).
# ===================================================================================
var job_pid[8];          # child pids of live background jobs
var job_num[8];          # the "[n]" job number shown to the user
# Command line per live job — 8 slots x 128 bytes ([128] = 1024 B, 8N). Needed
# so job_reap_poll can say WHAT finished in the audit record: the reap happens
# long after the launch, the caller's line buffer has been reused by then, and
# a bare pid is not an audit trail. 128 matches the 127-char cap that
# sh_run_program_bg already enforces, so a stored command is never truncated.
var job_cmd[128];
var job_count = 0;       # live jobs in [0, job_count)
var job_next_num = 1;    # monotonic job-number counter

fn job_any(): i64 { return job_count; }

# Is the job table full? Checked BEFORE spawning (see sh_run_program_bg) so a
# refusal never strands a live child.
fn job_full(): i64 {
    if (job_count >= 8) { return 1; }
    return 0;
}

# Record a freshly-spawned bg child + announce it as "[n] <pid>".
fn job_add(pid, cmd): i64 {
    if (job_count >= 8) { eprintln_cstr("run: too many background jobs (max 8)"); return 0 - 1; }
    var n = job_next_num;
    job_next_num = job_next_num + 1;
    store64(&job_pid + job_count * 8, pid);
    store64(&job_num + job_count * 8, n);
    # Copy (not borrow) the command: the caller's buffer is the reused line
    # buffer and this outlives the current dispatch.
    var dst = &job_cmd + job_count * 128;
    var ci = 0;
    while (ci < 127) {
        var cb = load8(cmd + ci);
        if (cb == 0) { break; }
        store8(dst + ci, cb);
        ci = ci + 1;
    }
    store8(dst + ci, 0);
    job_count = job_count + 1;
    str_print(str_from("[")); str_print(str_from_int(n)); str_print(str_from("] "));
    str_print(str_from_int(pid)); println("");
    return 0;
}

# Poll every live bg job once (non-blocking waitpid #4). A return != -2/WOULD_BLOCK means
# the child exited (and #4 already reaped it): announce "[n] Done" and compact the slot
# (swap-with-last). Cheap to call every prompt tick.
fn job_reap_poll(): i64 {
    var i = 0;
    while (i < job_count) {
        var pid = load64(&job_pid + i * 8);
        var r = sh_exit_status(syscall(SYS_WAITPID, pid));  # -2 passes through
        if (r != 0 - 2) {                                   # exited (not WOULD_BLOCK)
            var n = load64(&job_num + i * 8);
            str_print(str_from("[")); str_print(str_from_int(n)); println("] Done");
            # The background half of the exec audit surface. The launch wrote a
            # `launched` line; this is its matching outcome, and without it a bg
            # job was the one execution path that could complete with no record
            # of having finished at all.
            audit_exec_bg_done(&job_cmd + i * 128, r);
            job_count = job_count - 1;                       # compact: last slot -> i
            store64(&job_pid + i * 8, load64(&job_pid + job_count * 8));
            store64(&job_num + i * 8, load64(&job_num + job_count * 8));
            # Move the last slot's command with its pid/num.
            var src = &job_cmd + job_count * 128;
            var dst2 = &job_cmd + i * 128;
            var cj = 0;
            while (cj < 128) { store8(dst2 + cj, load8(src + cj)); cj = cj + 1; }
            # do NOT advance i — re-check the swapped-in slot
        } else { i = i + 1; }
    }
    return 0;
}

# Background launch: spawn `cmd` ("/bin/<word> [args..]") via spawn_path(#43, non-blocking)
# and record the pid. Returns 0 on launch (the child runs concurrently), 1 on refusal/failure.
# Mirrors sh_run_program's mode gate (HUMAN/STRICT confirm; AUTO/ASSIST run directly).
fn sh_run_program_bg(cmd, mode): i64 {
    if (shell_launch_gate(str_cat3_cstr("run ", cmd, " &"), shell_line_blocked(cmd), mode) == 0) {
        audit_exec_ctx(cmd, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    var len = 0;
    while (load8(cmd + len) != 0) { len = len + 1; }
    if (len > 127) {
        eprintln_cstr("run: command too long for a background job (max 127)");
        audit_exec_ctx(cmd, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    # ⛔ CHECK CAPACITY BEFORE SPAWNING. The order used to be spawn-then-record,
    # and job_add's refusal was ignored: a 9th background request spawned a real
    # child, failed to record it, and returned — leaving a process that is never
    # reaped, never shown by the job list, and never audited on completion,
    # because nothing knows it exists. Refusing before the spawn means the
    # failure costs nothing.
    if (job_full() == 1) {
        eprintln_cstr("run: too many background jobs (max 8)");
        audit_exec_ctx(cmd, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    # Literal 43 = spawn_path (the literal-37 execwait precedent below): lib/ is the
    # gitignored, `cyrius update`-regenerated stdlib snapshot, so an enum added THERE is
    # silently lost on regeneration — committed src must not depend on it. (1.6.1 fix: the
    # 1.6.0 cut used a snapshot-local SYS_SPAWN_PATH enum that a regen would have dropped.)
    # Env inheritance for bg jobs too (see sh_build_env_blob) — explicit 5-arg form.
    var blen = sh_build_env_blob();
    var pid = 0 - 1;
    if (blen > 0) { pid = syscall(43, cmd, len, &sh_env_blob, blen); }
    else { pid = syscall(43, cmd, len, 0, 0); }
    if (pid < 0) {
        eprintln_cstr("run: failed to launch background job");
        audit_exec_ctx(cmd, "error", pid);
        return 1;
    }
    # job_add can still refuse (table full). Audit what actually happened rather
    # than assuming success: an unrecorded child is exactly the case that must
    # not vanish from the trail.
    # Belt-and-braces: capacity was checked above, so this cannot fire today.
    # Kept because the consequence of it firing (an unrecorded live child) is bad
    # enough to be worth an explicit branch rather than a silent discard.
    if (job_add(pid, cmd) < 0) {
        audit_exec_ctx(cmd, "error", AUDIT_NO_EXIT);
        return 1;
    }
    audit_exec_ctx(cmd, "launched", AUDIT_NO_EXIT);
    return 0;
}

# ===================================================================================
# Per-process env (agnos 1.44.19): children INHERIT agnsh's environment. agnsh walks its
# OWN envp off the exec init stack (_agnos_init_rsp, the _agnos_getenv shape — ABI §4.6)
# and concatenates every "KEY=VALUE" into a flat NUL-separated blob, passed to the kernel
# as (a3=blob, a4=len) on execwait(37) and spawn_path(43) — the explicit 5-arg syscall
# form (the cyrius builtin pops exactly N arg regs; a 3-arg call leaves GARBAGE in
# a3/a4, which the kernel's fallback gate tolerates but never propagates). CLIENT-CLAMPED
# to the kernel caps (<=1024 B, <=16 entries — oversized degrades to the default env
# kernel-side, so clamping here keeps inheritance working). Today agnsh's env is the
# kybernet seed (HOME=/ PWD=/), so children see identical CONTENT either way — the
# inheritance becomes observable the moment agnsh's env first differs (PWD-tracking on
# agnos and PATH are flagged candidates, not added here). [128] = 1024 B (8N).
var sh_env_blob[128];
fn sh_build_env_blob(): i64 {
    # cyrius 6.1.32+ parks the exec init-stack base in r15 at entry, read via
    # _agnos_argv_base() (was the _agnos_init_rsp global, retired with the old
    # capture-after-gvar-init scheme). Same ABI §4.6 shape: [base]=argc, argv,
    # NULL, envp.
    var irsp = _agnos_argv_base();
    if (irsp == 0) { return 0; }
    var acnt = load64(irsp);
    var base = irsp + 8 + (acnt + 1) * 8;   # &envp[0]
    var off = 0;
    var j = 0;
    while (j < 16) {
        var ep = load64(base + j * 8);
        if (ep == 0) { break; }                        # envp NULL terminator
        var el = 0;
        while (load8(ep + el) != 0) { el = el + 1; }
        if (off + el + 1 > 1024) { break; }            # clamp: keep whole entries only
        var k = 0;
        while (k < el) { store8(&sh_env_blob + off + k, load8(ep + k)); k = k + 1; }
        store8(&sh_env_blob + off + el, 0);
        off = off + el + 1;
        j = j + 1;
    }
    return off;                                        # 0 = no env to pass
}

# agnos ABI values this file passes by number — for the reason the syscall numbers are literals:
# lib/ is regenerated from the pinned snapshot, so committed src must not depend on a name there.
var SH_SPAWN_LINE_MAX = 127;       # spawn_path#43 / execwait#37: the "PATH arg.." line form's cap
var SH_SPAWN_CLEANFD = 0x20000;    # #43 a2 flag SPAWN_F_CLEANFD (agnos 1.57.6): the child gets fds
#                                    0/1/2 after its armed redirects, and none of the shell's others
var SH_WAIT_BLOCK = 0x100;         # waitpid#4 a1 = SH_WAIT_BLOCK | pid (agnos 1.57.7): block on it

# Launch `line` ("ABS_PATH [args..]", a NUL-terminated cstr) via execwait (#37) and
# return the child's exit code, or -1 on launch failure. The literal 37 mirrors the
# literal-60 sys_exit call in agnsh.cyr (the agnos syscall enum tops out at 33 and has
# no execwait slot, so there is no constant to reference).
fn sh_exec_line(line): i64 {
    var len = 0;
    while (load8(line + len) != 0) { len = len + 1; }
    var blen = sh_build_env_blob();
    # #37's success value is the child's wait status (a signal death is 0x100 | N): sh_exit_status.
    if (blen > 0) { return sh_exit_status(syscall(37, line, len, &sh_env_blob, blen)); }   # a3/a4 explicit
    return sh_exit_status(syscall(37, line, len, 0, 0));   # explicit zeros — never garbage a3/a4
}

# Wait for child `pid` to exit, reap it, and return its exit status — or -1 when it is not the
# shell's to wait for.
#
# ⭐ 2.0.1 — ONE BLOCKING waitpid, NOT A POLL. WAIT_BLOCK parks agnsh in the kernel until the
# child's exit wakes it: POSIX `waitpid(pid, &st, 0)`. Until 2.0.1 the foreground `run` and both
# pipeline reaps polled the non-blocking form (-2 while alive) with sched_yield#44 between polls —
# the only wait agnos offered when the foreground moved onto the scheduler (1.8.6). Since agnos
# 1.57.9 a #44 with nothing else READY on its CPU parks until the next timer tick (~10 ms), as
# Linux sched_yield does, so every round of that poll could add a tick of exit latency, and the
# shell woke ~100 times a second for a foreground program's whole life. Linux sched_yield(2) calls
# waiting for another thread that way a design error; the wait belongs in a blocking primitive.
# ⚠ -2 from the blocking form means the kernel could not block THIS caller (wq_can_block: no
# scheduler yet, or a lock held) — never a ring-3 process on agnos >= 1.57.7. It is still "not
# yet", never a status, so it is retried; the yield makes a surprise cost a tick per round, not a
# hot spin.
# ⚠ pid is a process-table slot (0..15), so `SH_WAIT_BLOCK | pid` never reaches 0x1FF (ANY child).
fn sh_wait_child(pid): i64 {
    if (pid < 0) { return 0 - 1; }
    var r = syscall(SYS_WAITPID, SH_WAIT_BLOCK | pid);
    while (r == 0 - 2) {
        syscall(44);
        r = syscall(SYS_WAITPID, SH_WAIT_BLOCK | pid);
    }
    return sh_exit_status(r);
}

# Foreground launch under the SCHEDULER: spawn_path (#43) + a blocking waitpid (sh_wait_child).
# Returns the child's exit code — the SAME contract as sh_exec_line — or -1 on launch failure.
#
# WHY THIS EXISTS. Until agnos 1.57.7, #37 ran the child inside agnsh's own syscall frame with IF
# CLEARED, and the child was deliberately state=3 (never schedulable — kernel elf.cyr). So for the
# child's entire life NOTHING else on the box ran, including processes the child itself spawned. A
# compositor launched that way painted its chrome perfectly and its setu clients never executed a
# single instruction: measured at 2938 frames / 30 s with zero client output, while the same
# binaries printed freely the moment the compositor was launched any other way. (agnos 1.57.7
# rebuilt #37 as a blocking wait on a scheduled child, so that is history; #43 stays because it
# hands back the pid, which the pipeline needs and #37 never did.)
#
# #43 makes the child an ordinary scheduled proc; agnsh holds the PROMPT, not the kernel. The child
# and the child's children all get scheduled, which is the entire point.
#
# ⚠ THE 1.8.6 REVERT IS ADDRESSED, NOT IGNORED. This routing was tried before and reverted
# because a 15.6 MB compositor spawned this way was #PF-killed on archaemenid (`run: exit 142`).
# The cause was an agnos kernel defect, fixed in 1.56.34: the #37 handler restored the CPU's
# SYSCALL kernel stack to the RAW identity VA 0xF10000 instead of its direct-map alias, so every
# completed foreground run re-armed a fault for any later process whose image reached past
# 15.06 MB. Demonstrated with a control in QEMU: on the unfixed kernel the armed sequence
# (a foreground run, THEN the compositor) triple-faults the machine; on the fixed kernel it
# reaches two clients connected and presented.
# ⛔ Iron has NOT re-confirmed this yet. If `run` regresses on archaemenid for large binaries,
# this routing is the first suspect and sh_exec_line is one line away.
#
# ⚠ A line over SH_SPAWN_LINE_MAX is refused here, and sh_launch_line says why before it gets this
# far. Until 2.0.1 it fell back to #37 "which has no cap" — true until agnos 1.57.7, which gave #37
# the same one, so the fallback only changed which syscall refused it.
fn sh_exec_line_sched(line): i64 {
    var len = 0;
    while (load8(line + len) != 0) { len = len + 1; }
    if (len > SH_SPAWN_LINE_MAX) { return 0 - 1; }
    var blen = sh_build_env_blob();
    var pid = 0 - 1;
    if (blen > 0) { pid = syscall(43, line, len, &sh_env_blob, blen); }
    else { pid = syscall(43, line, len, 0, 0); }
    if (pid < 0) { return 0 - 1; }
    return sh_wait_child(pid);                         # blocks until it exits; reaped, its status
}

# Bareword program launch. If the first word of `line` names an executable at
# /bin/<word>, run it from disk WITH its args and return the child exit code (>= 0;
# EXIT_NOT_RUN when the line is refused or declined, EXIT_NOTHING_TO_RUN when it could
# not be launched, 1 when memory ran out). Returns -1 to mean "not a /bin program" so
# the caller falls through to the NL-intent path — exactly the burn-1436 UX: `doom`
# and `bnrmr AGNOS` launch, the typo `brnmr` interprets. PATH is fixed to /bin (the
# AGNOS userland tool dir). A line already starting with '/' is left to the explicit
# `run` builtin (returns -1 here). The mode is threaded to sh_run_program so HUMAN /
# STRICT still confirm before launch; AUTO / ASSIST run directly (matching `run`).
fn sh_try_bareword_launch(line, mode): i64 {
    if (load8(line) == 47) { return 0 - 1; }       # absolute path → use the `run` builtin
    # 1.44.13: a trailing `&` backgrounds the launch. 1.9.3: detected by LENGTH
    # (sh_scan_trailing_amp) rather than by truncating the caller's buffer, so
    # every fall-through below hands the ORIGINAL line back to the NL path,
    # history and audit. `ll` is the effective length — the command part only,
    # with the `&` and its padding excluded — and every scan below is bounded by
    # it instead of running to the NUL.
    var ll = 0;
    while (load8(line + ll) != 0) { ll = ll + 1; }
    var bg = 0;
    var amp = sh_scan_trailing_amp(line);
    if (amp >= 0) { bg = 1; ll = amp; }
    if (ll == 0) { return 0 - 1; }                 # empty / bare `&` → NL path

    # first-token length (the command word, up to the first space), within ll
    var tl = 0;
    while (tl < ll) { if (load8(line + tl) == 32) { break; } tl = tl + 1; }
    if (tl == 0) { return 0 - 1; }                 # leading space → NL path

    # ⛔ VALIDATE BEFORE OPENING ANYTHING — the WORD before the probe, the whole line once it is
    # a program. The existence probe used to run FIRST, so `sys_open` was handed an unvalidated,
    # attacker-shaped path ("/bin/" + whatever the user typed, traversal included) and the safety
    # check ran only afterwards on a path that had already been opened — check-after-use. The open
    # is a real effect on agnos, so the ordering is the fix.
    # ⭐ 2.0.1: that fix over-reached. It ran is_safe_path over the WHOLE line before the probe, so a
    # sentence like `what's in my $HOME` or `disk use (in GB)` was refused as "run: unsafe path"
    # and never reached the NL parser — against ADR-007 decision 1 (the discriminator is the program
    # lookup) and unlike the host. The probe is now built from the first word alone, and only a word
    # sh_prog_word_ok accepts (no '/'; letters, digits, `._+-`) is probed: nothing input-shaped is
    # ever opened, and a word that fails is natural language.
    if (sh_prog_word_ok(line, tl) == 0) { return 0 - 1; }

    # probe = "/bin/" + token (existence check for the binary). ASCII: '/'=47 'b'=98
    # 'i'=105 'n'=110 '/'=47.
    var probe = alloc(5 + tl + 1);
    if (probe == 0) { eprintln_cstr("run: out of memory"); return 1; }
    store8(probe + 0, 47); store8(probe + 1, 98); store8(probe + 2, 105);
    store8(probe + 3, 110); store8(probe + 4, 47);
    var i = 0;
    while (i < tl) { store8(probe + 5 + i, load8(line + i)); i = i + 1; }
    store8(probe + 5 + tl, 0);
    var fd = sys_open(probe, strlen(probe), 0x0);
    if (fd < 0) { return 0 - 1; }                  # no such /bin program → NL intent
    sys_close(fd);

    # A SHELL LINE from here: its first word is a program, so it is never natural language.
    # cmd = "/bin/" + the command part, handed to the kernel, which opens /bin/<word> and stages
    # argv from the full line.
    var cmd = alloc(5 + ll + 1);
    # ⛔ alloc can fail. Unchecked, the store8s below wrote through a null base and
    # faulted at a line with no obvious relationship to the exhaustion.
    if (cmd == 0) { eprintln_cstr("run: out of memory"); return 1; }
    store8(cmd + 0, 47); store8(cmd + 1, 98); store8(cmd + 2, 105);
    store8(cmd + 3, 110); store8(cmd + 4, 47);
    var j = 0;
    while (j < ll) { store8(cmd + 5 + j, load8(line + j)); j = j + 1; }
    store8(cmd + 5 + ll, 0);
    # The whole command line passes is_safe_path before any launch. A refusal is audited and
    # exits 126, as the host's bareword refusal does — until 2.0.1 it was 1, with no record.
    if (is_safe_path(cmd) == 0) {
        eprintln_cstr("run: unsafe path (traversal or shell metacharacter)");
        audit_exec_ctx(cmd, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }

    if (bg == 1) { return sh_run_program_bg(cmd, mode); }   # `prog &` → non-blocking #43 + job table
    return sh_run_program(cmd, mode);
}

# ===================================================================================
# Two-stage pipelines `cmd1 | cmd2` (e.g. `iam | anuenue`). BOTH stages are spawned with the
# non-blocking spawn_path #43 and are alive together, so the pipe STREAMS through the kernel's
# 4080-byte ring (1.8.8): stage 1's stdout is armed onto the pipe's write end, stage 2's stdin onto
# its read end, and the shell waits only once both exist. Kernel building blocks: pipe()#25,
# exec_redirect#62 (per-process since agnos 1.57.6, applied into the NEXT #43/#37 child's own fd
# table), spawn_path#43 and waitpid#4 (WAIT_BLOCK).
#
# ⛔ THE SHELL HOLDS NO PIPE END ONCE THE STAGE THAT USES IT EXISTS (bash execute_pipeline's
# fds_to_close; every POSIX shell). The kernel decides EOF and EPIPE by scanning for ANY open end of
# the other kind anywhere on the box, so an end the shell keeps is a live peer:
#   · the WRITE end: stage 2 never sees EOF, even after stage 1 exits (fixed in 1.8.8);
#   · the READ end: a producer whose consumer has exited never sees EPIPE. Since agnos 1.57.9 a pipe
#     write BLOCKS while the ring is full and a reader is open (Linux pipe_write, POSIX write()), so
#     `grep . /etc/ssl/cert.pem | echo x` left grep blocked for good and the shell waiting to reap
#     it (2.0.1; agnos pipeline-smoke). Stage 1 must not INHERIT the read end either — hence
#     SH_SPAWN_CLEANFD on both stages.
#
# LIMITS: 2-stage only (no N-stage chain); each stage's "/bin/<cmd> [args]" is at most 127 bytes
# (SH_SPAWN_LINE_MAX, spawn_path's line form), checked before anything is armed.

# Thin syscall wrappers — literals, same convention as the literal-37/43 execwait/spawn
# calls above (the agnos syscall enum has no slot for these, so there's no constant).
fn sh_pipe(fds_ptr): i64 { return syscall(25, fds_ptr); }             # pipe(): rfd@[0], wfd@[8]
fn sh_exec_redirect(src, dst): i64 { return syscall(62, src, dst); }  # armed for the NEXT #43/#37

# Spawn pipeline stage `cmd` via the non-blocking #43 and return its pid WITHOUT waiting: both stages
# must be alive together for the pipe to stream. SH_SPAWN_CLEANFD gives the stage fds 0/1/2 after its
# armed redirect and nothing else — in particular NOT the shell's copy of the other pipe end.
# ⚠ With a flag set the kernel applies its env-blob gate strictly: a blob the flagless form would
# quietly replace with the default env is REFUSED. sh_env_blob is agnsh's own envp, which the kernel
# validated when it staged it, so it passes.
# ⛔ NO RETURN BEFORE THE SYSCALL. Every #43 return clears the caller's whole arm set, success or
# not; returning without one leaves the armed redirect waiting for the shell's NEXT launch, whose
# stdout (or stdin) then lands on a closed pipe end. Until 2.0.1 the 127-byte cap was checked here in
# exactly that way; sh_run_pipeline now checks it before arming anything.
fn _sh_pipe_spawn(cmd): i64 {
    var len = 0;
    while (load8(cmd + len) != 0) { len = len + 1; }
    var blen = sh_build_env_blob();
    if (blen > 0) { return syscall(43, cmd, len | SH_SPAWN_CLEANFD, &sh_env_blob, blen); }
    return syscall(43, cmd, len | SH_SPAWN_CLEANFD, 0, 0);
}

# Run a 2-stage pipeline. Returns cmd2's exit code (>=0); EXIT_NOT_RUN when a stage is refused or the
# line is declined, EXIT_NOTHING_TO_RUN when a stage is not a program, 1 for an empty stage.
fn sh_run_pipeline(line, mode): i64 {
    var pi = _sh_find_pipe(line);
    if (pi < 0) { return 0 - 1; }                   # no ' | ' → not a pipeline (caller falls through)
    var llen = 0;
    while (load8(line + llen) != 0) { llen = llen + 1; }
    var cmd1 = _sh_bin_segment(line, 0, pi);          # [0, pi)   — _sh_bin_segment rtrims any gap before '|'
    var cmd2 = _sh_bin_segment(line, pi + 1, llen);   # (pi, end) — _sh_bin_segment ltrims any gap after '|'
    if (cmd1 == 0) {
        eprintln_cstr("run: empty pipeline stage before '|'");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    if (cmd2 == 0) {
        eprintln_cstr("run: empty pipeline stage after '|'");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    # Validate EACH stage individually — the '|' is split out, so no stage holds it.
    if (is_safe_path(cmd1) == 0) {
        eprintln_cstr("run: unsafe path in pipeline stage 1");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    if (is_safe_path(cmd2) == 0) {
        eprintln_cstr("run: unsafe path in pipeline stage 2");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    # Both stages must EXIST before we open the pipe or arm any redirect: a missing program is
    # reported by name, before any confirm prompt. (Until agnos 1.57.6 a launch that failed with
    # the redirect armed also left it armed for the NEXT command; every #43/#37 return now clears
    # the caller's arm set, success or not.)
    if (_sh_bin_probe(cmd1) == 0) {
        eprintln_cstr("run: no such command in pipeline stage 1");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return EXIT_NOTHING_TO_RUN;
    }
    if (_sh_bin_probe(cmd2) == 0) {
        eprintln_cstr("run: no such command in pipeline stage 2");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return EXIT_NOTHING_TO_RUN;
    }
    # Each stage must also fit spawn_path's line form, checked before anything is armed: refused here
    # with a reason, never by _sh_pipe_spawn, which must not return without the #43 its arm is for.
    if (strlen(cmd1) > SH_SPAWN_LINE_MAX || strlen(cmd2) > SH_SPAWN_LINE_MAX) {
        eprintln_cstr("run: pipeline stage too long (agnos launches at most 127 bytes)");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return EXIT_NOTHING_TO_RUN;
    }
    # HUMAN/STRICT confirm the whole pipeline BEFORE arming any redirect (verb_confirm
    # never execs, so it can't consume the one-shot redirect); a BLOCKED stage makes it
    # confirm in every mode.
    var pblocked = shell_line_blocked(cmd1);
    if (shell_line_blocked(cmd2) == 1) { pblocked = 1; }
    if (shell_launch_gate(str_cat3_cstr("run pipeline: ", line, ""), pblocked, mode) == 0) {
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    # Written before the pipe is wired and either stage is spawned: from here on
    # the shell has committed, and a stage that hangs must still leave a trace.
    audit_exec_ctx(line, "launched", AUDIT_NO_EXIT);
    # Wire the pipe. var X[N] is N BYTES at function scope, so [16] = two u64 slots.
    var fds[16];
    if (sh_pipe(&fds) != 0) {
        eprintln_cstr("run: pipe() failed");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return 1;
    }
    var rfd = load64(&fds);
    var wfd = load64(&fds + 8);
    # ⭐⭐ BOTH STAGES ARE SPAWNED, AND NEITHER IS WAITED FOR UNTIL BOTH EXIST (agnos ipc bite 11).
    # That is what makes a pipeline STREAM. `sh_exec_line` (#37) and `sh_exec_line_sched` (#43 plus
    # a wait) each run their child to completion, so either leaves exactly one stage alive at a
    # time, and the producer can only ever deliver one ring-full before a consumer exists. Measured
    # with stage 1 on `sh_exec_line_sched`: `grep . /etc/ssl/cert.pem | wc` reported **4080** — the
    # ring size, to the byte.
    # ⛔ CHECK THE ARM. exec_redirect#62's return was discarded at all three arm
    # sites: if arming failed, the stage ran anyway with its stdout still on the
    # terminal, so a pipeline silently degraded into "run stage 1 normally, then
    # feed stage 2 nothing" — output in the wrong place and a plausible-looking
    # exit code. Fail closed instead.
    if (sh_exec_redirect(1, wfd) < 0) {
        eprintln_cstr("run: failed to arm pipeline stage 1 redirect");
        sys_close(wfd);
        sys_close(rfd);
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return 1;
    }
    var pid1 = _sh_pipe_spawn(cmd1);
    if (pid1 < 0) {
        eprintln_cstr("run: failed to launch pipeline stage 1");
        sys_close(wfd);
        sys_close(rfd);
        audit_exec_ctx(line, "error", pid1);
        return 1;
    }
    # ⛔ CLOSE OUR WRITE END NOW, BEFORE STAGE 2 EXISTS. The kernel decides EOF by scanning for ANY
    # open write end anywhere on the box; stage 1 holds its own copy, so this drops only the SHELL's
    # claim. Leave it open and stage 2 never sees EOF even after the producer exits — and cmd1 exiting
    # cannot drop it either, because this fd belongs to US, not to cmd1.
    sys_close(wfd);
    # Stage 2: stdin -> the read end, ALSO spawned, so producer and consumer are alive together. It
    # drains while stage 1 writes and sees a genuine EOF once stage 1's write end is gone.
    # ⛔ IF STAGE 2 CANNOT START, CLOSE OUR READ END BEFORE REAPING STAGE 1. Stage 1 may already be
    # blocked on a full ring, and with no stage 2 our rfd is the last reader on the box: closed, its
    # write fails with EPIPE and it exits; held across the reap, the shell waits for a producer that
    # is waiting for a reader (2.0.1 — agnos pipeline-smoke `s2fail`, `grep . /etc/ssl/cert.pem |
    # notelf` with /bin/notelf not an ELF).
    if (sh_exec_redirect(0, rfd) < 0) {
        eprintln_cstr("run: failed to arm pipeline stage 2 redirect");
        sys_close(rfd);
        sh_wait_child(pid1);
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return 1;
    }
    var pid2 = _sh_pipe_spawn(cmd2);
    if (pid2 < 0) {
        eprintln_cstr("run: failed to launch pipeline stage 2");
        sys_close(rfd);
        sh_wait_child(pid1);
        audit_exec_ctx(line, "error", pid2);
        return 1;
    }
    # ⛔ AND CLOSE IT AS SOON AS STAGE 2 EXISTS (2.0.1). The arm was applied into stage 2's own fd
    # table at the spawn, so this drops only the shell's claim. Until 2.0.1 it was held until after
    # both reaps, which kept a reader alive once stage 2 had exited: a producer with more to write
    # blocked on the full ring for good while the shell waited to reap it (agnos pipeline-smoke
    # `early`, `grep . /etc/ssl/cert.pem | echo pipeearly`).
    sys_close(rfd);
    var rc2 = sh_wait_child(pid2);
    sh_wait_child(pid1);                            # producer normally exits first; reap it regardless
    # The pipeline's exit status is stage 2's, matching the return contract.
    audit_exec_ctx(line, audit_exec_outcome(rc2), rc2);
    # ⛔ NEVER RETURN A BARE NEGATIVE. The dispatcher reads <0 as "this launcher
    # did not claim the line, fall through" — so a reap failure was indistinguish-
    # able from "not a pipeline", and the line was silently retried down the
    # bareword and NL paths after both stages had already run. Collapse the
    # failure to a handled 1; the audit line above carries the real code.
    if (rc2 < 0) { return 1; }
    return rc2;
}

# Dispatch hook — checked BEFORE sh_try_bareword_launch (whose is_safe_path rejects the
# '|') and before the NL-intent path. Returns >=0 (handled, = cmd2 exit or a handled
# error) when the line is a ' | ' pipeline; -1 when there's no pipe so the caller falls
# through. Does NOT mutate `line` (the fall-through path sees the original).
fn sh_try_pipeline_launch(line, mode): i64 {
    if (_sh_find_pipe(line) < 0) { return 0 - 1; }
    return sh_run_pipeline(line, mode);
}

# ===================================================================================
# Output redirection `cmd > file` — the write sibling of the pipeline. exec_redirect#62
# copies the DST fd's vfs-table entry into the child's SRC slot, so DST can be a plain
# FILE fd (not just a pipe): open FILE for write, arm (1 -> FILE), run cmd under #37,
# and cmd's stdout lands straight in FILE — no intermediate pipe. Since agnos 1.57.7 the
# arm is applied into the child's own fd table, so there is nothing to restore; we close
# FILE after.
#
# SAFETY (why this does NOT reopen audit C2's execve-injection hole): '>' is a shell
# metacharacter is_safe_path rejects, exactly like '|'. We never pass it THROUGH to a
# subprocess — we split it out structurally here, then validate the command and the
# target path INDIVIDUALLY (each side is metachar-free, so no `$()`/backtick/`;` rides
# into execve). The '>' is consumed by this parser alone.
#
# MVP scope: a single `cmd > file` (truncate; AO_WRONLY|AO_CREAT|AO_TRUNC, plus AO_NOFOLLOW
# since 1.9.14 so a symlink at the target is refused rather than written through). `>>`
# append, multiple `>`, and combined pipe+redirect are NOT supported — each safely fails
# the is_safe_path check on the residual '>' rather than misbehaving. The target should
# be an absolute path (agnos userland has no cwd). Agnos-only, like the pipeline.

# "/bin/<word>" (the FIRST token of a "/bin/<word> [args]" cmd) exists on disk?
# 1 = yes, 0 = no / empty. Mirrors the sh_try_bareword_launch probe (O_RDONLY open +
# close). Used to refuse arming a redirect/pipe for a command that can't launch.
fn _sh_bin_probe(cmd): i64 {
    var tl = 0;
    while (load8(cmd + tl) != 0) { if (load8(cmd + tl) == 32) { break; } tl = tl + 1; }
    if (tl == 0) { return 0; }
    var probe = alloc(tl + 1);
    if (probe == 0) { return 0; }
    var i = 0;
    while (i < tl) { store8(probe + i, load8(cmd + i)); i = i + 1; }
    store8(probe + tl, 0);
    var fd = sys_open(probe, strlen(probe), 0x0);
    if (fd < 0) { return 0; }
    sys_close(fd);
    return 1;
}

# Run `cmd > file`. Returns cmd's exit code (>=0); EXIT_NOT_RUN when refused or declined,
# EXIT_NOTHING_TO_RUN when cmd is not a program, 1 for a line with nothing before or after the '>'.
fn sh_run_redirect(line, mode): i64 {
    var ri = _sh_find_redirect(line);
    if (ri < 0) { return 0 - 1; }                    # no '>' → not a redirect (caller falls through)
    var llen = 0;
    while (load8(line + llen) != 0) { llen = llen + 1; }
    var cmd = _sh_bin_segment(line, 0, ri);          # "/bin/<cmd [args]>"
    var file = _sh_path_segment(line, ri + 1, llen); # the target file path
    if (cmd == 0) {
        eprintln_cstr("run: empty command before '>'");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    if (file == 0) {
        eprintln_cstr("run: no file after '>'");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return 1;
    }
    # Validate EACH side individually — the '>' is split out, so neither holds it. This is
    # the injection guard (audit C2): a metachar in cmd or file is rejected right here.
    if (is_safe_path(cmd) == 0) {
        eprintln_cstr("run: unsafe path in command");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    if (is_safe_path(file) == 0) {
        eprintln_cstr("run: unsafe redirect target");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    # ⛔ REFUSE TO REDIRECT OVER THE SHELL'S OWN STATE FILES. The target is opened
    # AO_TRUNC, so `owl /x > /.agnsh_audit.log` truncated the audit trail — and,
    # before 1.9.2, left no record of having done so, in either direction. An audit
    # log that a single ordinary command can silently erase is not an audit log.
    # Checked here rather than in is_safe_path because these are agnsh-specific
    # paths, not a general traversal/metachar property.
    #
    # ⚠ SCOPE: this is an exact-string comparison against the resolved path, so
    # it stops the direct `> /.agnsh_audit.log` case, not every alias of it
    # (`//.agnsh_audit.log`, a bind mount). A symlink pointing at it is refused
    # since 1.9.14, but by the target open's AO_NOFOLLOW below, not by this check.
    # Closing the rest needs canonicalisation, which agnos has no realpath for.
    # It is a foot-gun guard, NOT a security boundary — an actor who can already
    # run arbitrary /bin programs has other ways to truncate a file. What it
    # does guarantee is that the *accidental* case is refused and, either way,
    # the attempt is now recorded.
    if (streq(file, audit_log_path()) == 1) {
        eprintln_cstr("run: refusing to redirect over the shell's audit log");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    if (streq(file, history_path()) == 1) {
        eprintln_cstr("run: refusing to redirect over the shell's history file");
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    # Probe the command EXISTS before opening the target or arming the one-shot redirect.
    # Otherwise a typo (`notacmd > f`) would arm exec_redirect#62, then #37 fails on the
    # missing binary BEFORE the kernel consumes/restores it — leaving the redirect live to
    # swallow the NEXT command's stdout. Probing first = no dangling arm, and no empty
    # target file created for a typo. (agnos 1.57.6+ clears the arm on every #37 return,
    # so the dangling arm is history; the empty file for a typo is not.)
    if (_sh_bin_probe(cmd) == 0) {
        eprintln_cstr("run: no such command");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return EXIT_NOTHING_TO_RUN;
    }
    # The same reasoning for a command #37 will refuse outright (2.0.1): a line over the 127-byte
    # cap used to reach the launch, which failed silently AFTER the target had been truncated.
    if (strlen(cmd) > SH_SPAWN_LINE_MAX) {
        eprintln_cstr("run: command line too long (agnos launches at most 127 bytes)");
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return EXIT_NOTHING_TO_RUN;
    }
    # HUMAN/STRICT confirm BEFORE opening/arming (verb_confirm never execs, so it can't
    # consume the one-shot redirect).
    if (shell_launch_gate(str_cat3_cstr("run redirect: ", line, ""), shell_line_blocked(cmd), mode) == 0) {
        audit_exec_ctx(line, "denied", AUDIT_NO_EXIT);
        return EXIT_NOT_RUN;
    }
    # Committed from here: the target is about to be opened AO_TRUNC.
    audit_exec_ctx(line, "launched", AUDIT_NO_EXIT);
    # Open FILE for write, truncating — and REFUSE a symlink at its final component.
    # ⛔ Until 1.9.14 this was 0x301 (AO_WRONLY|AO_CREAT|AO_TRUNC) with no AO_NOFOLLOW, the last
    # state-changing open in agnsh without it. Measured in QEMU on agnos 1.57.5
    # (scripts/agnos-qemu-test.py): with /redir-link -> /redir-target.txt, `echo pwned >
    # /redir-link` truncated the target and wrote into it. agnos honours AO_NOFOLLOW from 1.56.53
    # (the open answers -1); the flags are the agnos peer's AgnosOpenFlag names, not numbers.
    var fd = sys_open(file, strlen(file), AO_WRONLY | AO_CREAT | AO_TRUNC | AO_NOFOLLOW);
    if (fd < 0) {
        eprintln_cstr("run: cannot open redirect target");
        audit_exec_ctx(line, "error", fd);
        return 1;
    }
    # Arm stdout -> FILE, then run cmd to completion (#37 applies the arm into the child's table).
    # The arm's return is checked: unarmed, the command would run with its output
    # on the terminal while the (already-created, already-truncated) target stayed
    # empty — the user's file silently emptied and the output somewhere else.
    if (sh_exec_redirect(1, fd) < 0) {
        eprintln_cstr("run: failed to arm redirect");
        sys_close(fd);
        audit_exec_ctx(line, "error", AUDIT_NO_EXIT);
        return 1;
    }
    var rc = sh_exec_line(cmd);
    sys_close(fd);
    audit_exec_ctx(line, audit_exec_outcome(rc), rc);
    # ⛔ Same sentinel collision as the pipeline: sh_exec_line returns the raw
    # #37 result, and a -1 launch failure propagated out of sh_run_redirect ->
    # sh_try_redirect_launch, where the dispatcher read it as "not a redirect"
    # and fell through — so a redirect that FAILED to launch was retried as a
    # bareword and then as natural language, with the target file already
    # truncated. Collapse to a handled 1 — and say so: until 2.0.1 this path was the one
    # launch failure that printed nothing at all.
    if (rc < 0) {
        eprintln_cstr("run: failed to launch program");
        return 1;
    }
    return rc;
}

fn sh_try_redirect_launch(line, mode): i64 {
    if (_sh_find_redirect(line) < 0) { return 0 - 1; }
    return sh_run_redirect(line, mode);
}
#endif
