enum PermissionLevel {
    SAFE = 0;
    READ_ONLY = 1;
    USER_WRITE = 2;
    SYSTEM_WRITE = 3;
    ADMIN = 4;
    BLOCKED = 5;
}
fn perm_requires_approval(level) {
    return (level == PermissionLevel.SYSTEM_WRITE)
    || (level == PermissionLevel.ADMIN)
    || (level == PermissionLevel.BLOCKED);
}
fn perm_ai_allowed(level) {
    return (level != PermissionLevel.BLOCKED);
}
fn check_permission(user, required) {
    if (streq(user, "root") == 1) {
        return 1;
    }
    if (required == PermissionLevel.SAFE) { return 1; }
    if (required == PermissionLevel.READ_ONLY) { return 1; }
    if (required == PermissionLevel.USER_WRITE) { return 1; }
    if (required == PermissionLevel.SYSTEM_WRITE) { return 0; }
    if (required == PermissionLevel.ADMIN) { return 0; }
    if (required == PermissionLevel.BLOCKED) { return 0; }
    return 0;
}
# Cheap-reject comparison against a command-table literal.
#
# ⚡ `streq` calls strlen on BOTH arguments before comparing a single byte
# (lib/string.cyr), so the permission tables — 81 `streq(cmd, "...")` entries
# across five functions — walked `cmd` 81 times over for one classification,
# plus 81 walks of the literals. Testing the first byte first rejects the ~95%
# of entries that cannot match without touching strlen at all; only entries
# sharing an initial letter pay the full comparison.
#
# `c0` is the caller's already-loaded first byte of `cmd`, hoisted out of the
# table so it is read once rather than per entry.
fn _cmd_eq(cmd, c0, lit): i64 {
    if (c0 != load8(lit)) { return 0; }
    return streq(cmd, lit);
}
fn is_blocked_command(cmd) {
    var c0 = load8(cmd);
    if (_cmd_eq(cmd, c0, "dd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "mkfs") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "fdisk") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "parted") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "chmod") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "chown") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "chgrp") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "shred") == 1) { return 1; }
    return 0;
}
fn is_admin_command(cmd) {
    var c0 = load8(cmd);
    if (_cmd_eq(cmd, c0, "apt") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "yum") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "dnf") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "pacman") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "systemctl") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "service") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "useradd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "userdel") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "usermod") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "groupadd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "mount") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "umount") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "modprobe") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "insmod") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "rmmod") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "kill") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "killall") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "pkill") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "reboot") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "shutdown") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "poweroff") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "halt") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "iptables") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ip6tables") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "nft") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ufw") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "crontab") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "visudo") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "su") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "swapoff") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "swapon") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "mknod") == 1) { return 1; }
    return 0;
}
fn is_write_command(cmd) {
    var c0 = load8(cmd);
    if (_cmd_eq(cmd, c0, "cp") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "mv") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ln") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "touch") == 1) { return 1; }
