    if (_cmd_eq(cmd, c0, "sed") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "awk") == 1) { return 1; }
    return 0;
}
fn is_readonly_command(cmd) {
    var c0 = load8(cmd);
    if (_cmd_eq(cmd, c0, "ls") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "cat") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "head") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "tail") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "less") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "more") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "grep") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "find") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ps") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "top") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "htop") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "df") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "du") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "free") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "uptime") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "uname") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ifconfig") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ip") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "netstat") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "ss") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "pwd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "echo") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "date") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "whoami") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "id") == 1) { return 1; }
    return 0;
}
fn is_safe_command(cmd) {
    var c0 = load8(cmd);
    if (_cmd_eq(cmd, c0, "cd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "pwd") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "clear") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "exit") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "history") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "help") == 1) { return 1; }
    if (_cmd_eq(cmd, c0, "agnsh") == 1) { return 1; }
    return 0;
}
fn cstr_starts_with(s, prefix) {
    var slen = strlen(s);
    var plen = strlen(prefix);
    if (plen > slen) { return 0; }
    for (var i = 0; i < plen; i = i + 1) {
        if (load8(s + i) != load8(prefix + i)) { return 0; }
    }
    return 1;
}
fn has_system_path_arg(args, argc) {
    for (var i = 0; i < argc; i = i + 1) {
        var arg = vec_get(args, i);
        if (cstr_starts_with(arg, "/etc/") == 1) { return 1; }
        if (cstr_starts_with(arg, "/usr/") == 1) { return 1; }
        if (cstr_starts_with(arg, "/bin/") == 1) { return 1; }
        if (cstr_starts_with(arg, "/sbin/") == 1) { return 1; }
        if (cstr_starts_with(arg, "/lib") == 1) { return 1; }
    }
    return 0;
}
fn rm_has_dangerous_flags(args, argc) {
    for (var i = 0; i < argc; i = i + 1) {
        var arg = vec_get(args, i);
        var len = strlen(arg);
        if (streq(arg, "--") == 1) { return 1; }
        if (cstr_starts_with(arg, "--recursive") == 1) { return 1; }
        if (cstr_starts_with(arg, "--force") == 1) { return 1; }
        if (cstr_starts_with(arg, "--no-preserve-root") == 1) { return 1; }
        if (len >= 2 && load8(arg) == 45 && load8(arg + 1) != 45) {
            for (var j = 1; j < len; j = j + 1) {
                var ch = load8(arg + j);
                if (ch == 114) { return 1; }
                if (ch == 102) { return 1; }
                if (ch == 82) { return 1; }
            }
        }
    }
    return 0;
}
fn analyze_command_permission(cmd, args, argc) {
    var base = get_command_basename(cmd);
    if (streq(base, "rm") == 1) {
        if (rm_has_dangerous_flags(args, argc) == 1) {
            return PermissionLevel.BLOCKED;
        }
        return PermissionLevel.ADMIN;
    }
    if (is_blocked_command(base) == 1) {
        return PermissionLevel.BLOCKED;
    }
    if (is_admin_command(base) == 1) {
        return PermissionLevel.ADMIN;
    }
    if (is_write_command(base) == 1) {
        if (has_system_path_arg(args, argc) == 1) {
            return PermissionLevel.SYSTEM_WRITE;
        }
        return PermissionLevel.USER_WRITE;
    }
    if (is_readonly_command(base) == 1) {
        return PermissionLevel.READ_ONLY;
    }
    if (is_safe_command(base) == 1) {
        return PermissionLevel.SAFE;
    }
    return PermissionLevel.USER_WRITE;
}
