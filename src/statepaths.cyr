# statepaths.cyr — where the shell's state files live.
#
# Split out of src/agnsh.cyr in 1.9.7. These are ordinary library functions with
# no dependency on the entry point, but living in agnsh.cyr made them
# UNTESTABLE: a test binary cannot include the entry (it owns `main` and the
# top-level `_entry()` call), so every function in that file scored 0% coverage
# — 14 of them, including the audit-record and path helpers that decide where a
# security log is written and under what name. Moving them here makes them
# reachable from tests/test_core.tcyr.

# Build "/tmp/<stem>.<uid>" as a NUL-terminated cstring.
#
# ⛔ The HOME-unset fallbacks used to be the FIXED paths "/tmp/agnsh_history"
# and "/tmp/agnsh_audit.log". /tmp is world-writable and shared, so on any
# multi-user host those names are a collision between every user running agnsh
# — and worse, they are predictable, so another user can create the file FIRST
# and then own the shell's audit trail: the open succeeds (the file exists and
# is writable), agnsh appends its record of every command to a file it does not
# own, and the 0600 it sets afterwards does not undo the ownership.
#
# Qualifying by uid removes the collision and the pre-creation race between
# DIFFERENT users. Residual, stated rather than papered over: a same-uid
# attacker is unaffected, and /tmp is still the wrong place for an audit log —
# this is the fallback for a broken environment, not a supported configuration.
# O_NOFOLLOW (1.9.1) already blocks the symlink variant.
fn tmp_state_path(stem) {
    var uid = sys_getuid();
    if (uid < 0) { uid = 0; }
    # ⛔ FUNCTION-SCOPE `var X[N]` IS N BYTES, NOT N SLOTS. (Module-scope is 8N —
    # the two differ, and both spellings appear in this tree.) This was declared
    # `var ubuf[3]` in 1.9.4 against a comment saying "at most 20 digits": three
    # bytes. A uid of 1000 writes four digits and ran one byte past the buffer;
    # a 10-digit uid ran seven past. 24 bytes covers the 19 digits of a positive
    # i64 with slack.
    var ubuf[24];
    var ulen = 0;
    if (uid == 0) { store8(&ubuf, 48); ulen = 1; }
    else {
        var tmp = uid;
        var digits = 0;
        while (tmp > 0) { digits = digits + 1; tmp = tmp / 10; }
        ulen = digits;
        tmp = uid;
        var k = digits;
        while (k > 0) {
            k = k - 1;
            store8(&ubuf + k, 48 + (tmp % 10));
            tmp = tmp / 10;
        }
    }
    var prefix = "/tmp/";
    var plen = strlen(prefix);
    var slen = strlen(stem);
    var buf = alloc(plen + slen + 1 + ulen + 1);
    if (buf == 0) { return stem; }
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, stem, slen);
    store8(buf + plen + slen, 46);                 # '.'
    memcpy(buf + plen + slen + 1, &ubuf, ulen);
    store8(buf + plen + slen + 1 + ulen, 0);
    return buf;
}

fn history_path() {
    # Mirrors audit_log_path's shape — cstring with manual concat so
    # file_exists/read/write can use it directly. `$HOME/.agnsh_history`
    # matches the docs/agnsh.1 convention.
    #
    # agnos: resolve the path WITHOUT calling getenv. The kernel default env is
    # always HOME=/ (elf.cyr stages it), so $HOME/.agnsh_history is statically
    # /.agnsh_history — no envp walk needed; this is just a simplification.
    # NB: the old "getenv's buf[8192] overflows the ~12 KB ring-3 stack" rationale
    # for avoiding getenv here was WRONG — a Cyrius function-local `var X[N]` is a
    # .bss global (0 stack bytes), so getenv never cost stack. The real agnoshi_147
    # banner-hang cause was cyrius lib/fnptr.cyr's fncall0..8 missing a
    # CYRIUS_TARGET_AGNOS asm branch (every fncallN returned 0 → alloc_via/vec_new
    # returned 0 → CommandHistory_new null-deref before the first prompt). Fixed by
    # the agnoshi stopgap scripts/patch-fnptr-agnos.py; durable fix tracked in
    # cyrius issue 2026-06-08-fnptr-fncall-missing-agnos-branch.md.
    #ifdef CYRIUS_TARGET_AGNOS
    return "/.agnsh_history";
    #endif
    # host: full $HOME resolution; falls back to /tmp when HOME is unset.
    var home = getenv("HOME");
    if (home == 0) { return tmp_state_path("agnsh_history"); }
    var hlen = strlen(home);
    # Drop one trailing '/' so HOME=/ → /.agnsh_history (not //.agnsh_history);
    # HOME=/root stays /root/.agnsh_history. The suffix carries the separator.
    if (hlen > 0) { if (load8(home + hlen - 1) == 47) { hlen = hlen - 1; } }
    var suffix = "/.agnsh_history";
    var slen = strlen(suffix);
    var buf = alloc(hlen + slen + 1);
    memcpy(buf, home, hlen);
    memcpy(buf + hlen, suffix, slen);
    store8(buf + hlen + slen, 0);
    return buf;
}
# ---- Private state folders: the report folder and the checkpoint store ----
#
# Both keep what nobody else should read — the command lines agnsh ran, and copies of the files it
# removed — so both follow one set of rules, gathered here when the checkpoint store (2.0.3) became
# the second user. On the host they are XDG state: $XDG_STATE_HOME/agnoshi/<name>, by default
# $HOME/.local/state/agnoshi/<name>. agnos keeps its root-dotfile style (report_dir, ckpt_dir).

# 0700 — what a private state folder is created with.
var STATE_DIR_MODE = 448;

# `base` + `suffix` as a fresh cstring, dropping one trailing '/' from `base` so that HOME=/
# gives /.local/... rather than //.local/... — the same rule history_path follows.
fn state_join(base, suffix) {
    var blen = strlen(base);
    if (blen > 0) { if (load8(base + blen - 1) == 47) { blen = blen - 1; } }
    var slen = strlen(suffix);
    var buf = alloc(blen + slen + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, base, blen);
    memcpy(buf + blen, suffix, slen);
    store8(buf + blen + slen, 0);
    return buf;
}

# The host folder for the state called `name` ("reports", "checkpoints"), from its inputs: `xdg` and
# `home` are $XDG_STATE_HOME and $HOME, 0 when unset — split out so the rule is testable without an
# environment. The XDG base-directory rule: an unset, empty or RELATIVE $XDG_STATE_HOME is ignored and
# the default is $HOME/.local/state. HOME must be absolute too; without a usable one the folder falls
# back to /tmp, qualified by uid (tmp_state_path says what that does and does not defend against —
# state_dir_prepare's ownership check covers the rest).
fn state_dir_from(xdg, home, name) {
    if (xdg != 0) { if (load8(xdg) == 47) { return state_join(xdg, str_cat3_cstr("/agnoshi/", name, "")); } }
    if (home != 0) {
        if (load8(home) == 47) { return state_join(home, str_cat3_cstr("/.local/state/agnoshi/", name, "")); }
    }
    return tmp_state_path(str_cat3_cstr("agnoshi-", name, ""));
}

# Make a private state folder usable: create it 0700 (parents too) and, on the host, refuse it unless
# it is a real directory — not a symlink — that this user owns and nobody else can write. A folder
# someone else pre-created, which the /tmp fallback invites, would hand them everything in it. `what`
# names the folder in the reason ("report folder"). Returns 0 when usable, otherwise the reason as a
# cstring for the caller's notice.
fn state_dir_prepare(dir, what) {
    if (dir == 0) { return str_cat3_cstr("no ", what, ""); }
    if (xmkdir_p(dir, STATE_DIR_MODE) != 0) { return str_cat3_cstr("cannot create the ", what, ""); }
    #ifndef CYRIUS_TARGET_AGNOS
    var st[STAT_BUFSZ];
    if (sys_lstat(dir, &st) != 0) { return str_cat3_cstr("cannot inspect the ", what, ""); }
    var mode = load32(&st + STAT_MODE);
    if ((mode & 61440) != 16384) { return str_cat3_cstr("the ", what, " is not a directory"); }   # S_IFMT/S_IFDIR
    if (load32(&st + STAT_UID) != sys_getuid()) { return str_cat3_cstr("the ", what, " belongs to another user"); }
    if ((mode & 18) != 0) { return str_cat3_cstr("others can write the ", what, ""); }   # 0022
    #endif
    return 0;
}

# ---- The audit-log path seam ----
#
# ⛔ THIS IS A TEST SEAM AND NOTHING ELSE. NOTHING IN THE SHELL MAY CALL THE
# SETTER — `scripts/lint-cstr-str.sh` Category H fails the build if any file in
# src/ other than this one references it.
#
# Why it has to exist: `audit_one_shot` and `audit_exec` resolve their
# destination by calling `audit_log_path()` internally, and the comment in
# audit.cyr explains why they must — threading a path parameter would mean
# editing five launchers inside `#ifdef CYRIUS_TARGET_AGNOS` that a host test
# cannot exercise. The consequence was that the six functions which WRITE THE
# SECURITY LOG had no assertion of any kind: a test could not name a file to
# read back, so nothing ever checked what a record actually says. The audit
# trail was the least-tested code in the tree and the most security-relevant.
#
# Why a mutable global is acceptable here, stated rather than assumed: the
# setter is not reachable from any input-driven path. Cyrius has no dynamic
# dispatch, no reflection and no call-by-name, so a function nothing calls is
# inert — an attacker cannot reach it from a command line, and the lint gate
# stops a future edit from wiring it up by accident. The override is checked
# BEFORE the $HOME resolution so a test never depends on the ambient
# environment, and it is per-process, so it cannot leak between runs.
var g_audit_path_override = 0;

# Point the audit log at `path` (a cstring) for the rest of this process, or
# pass 0 to restore the real resolution. Tests only — see the banner above.
fn audit_path_override_set(path) {
    g_audit_path_override = path;
    return 0;
}

fn audit_log_path() {
    # Test seam first, so an override never depends on the ambient $HOME.
    if (g_audit_path_override != 0) { return g_audit_path_override; }
    # `$HOME/.agnsh_audit.log` is the v1.0 convention (per docs/agnsh.1).
    # Returns a NULL-TERMINATED cstring (not a Str) because AuditLogger_log
    # passes the path to syscall(SYS_OPEN) directly, and str_cat allocates
    # a length-prefixed buffer with no trailing zero. Falls back to /tmp
    # when HOME is unset (test harness / restricted envs).
    #
    # agnos: resolve WITHOUT getenv — HOME=/ is the fixed kernel default, so this
    # is statically /.agnsh_audit.log (a simplification, not a fix). See
    # history_path for why the old "getenv overflows the ring-3 stack" rationale was
    # wrong (the real agnoshi_147 cause was cyrius fnptr.cyr's missing agnos branch).
    #ifdef CYRIUS_TARGET_AGNOS
    return "/.agnsh_audit.log";
    #endif
    # host: full $HOME resolution; falls back to /tmp when HOME is unset.
    var home = getenv("HOME");
    if (home == 0) { return tmp_state_path("agnsh_audit.log"); }
    var hlen = strlen(home);
    # Drop one trailing '/' (HOME=/ → /.agnsh_audit.log); the suffix has the sep.
    if (hlen > 0) { if (load8(home + hlen - 1) == 47) { hlen = hlen - 1; } }
    var suffix = "/.agnsh_audit.log";
    var slen = strlen(suffix);
    var buf = alloc(hlen + slen + 1);
    memcpy(buf, home, hlen);
    memcpy(buf + hlen, suffix, slen);
    store8(buf + hlen + slen, 0);
    return buf;
}
