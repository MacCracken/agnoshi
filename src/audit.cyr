struct AuditEntry {
    timestamp;
    user;
    mode;
    input;
    action;
    approved;
    result;
    exit_code;
}
# Sentinel for "this record describes something that never ran, so an exit code
# is not meaningful". Emitted as JSON `null` rather than a magic number so a
# consumer cannot mistake it for a real status. Real codes are 0..255 and
# launch failures are small negatives, so this cannot collide.
var AUDIT_NO_EXIT = 0 - 999999;
fn AuditEntry_new(user, mode, input, action, approved, result) {
    return AuditEntry_new_x(user, mode, input, action, approved, result, AUDIT_NO_EXIT);
}
# Exit-code-carrying constructor. AuditEntry_new stays 6-arg so the parse-time
# (non-exec) call sites and their tests are untouched.
fn AuditEntry_new_x(user, mode, input, action, approved, result, exit_code) {
    var ts = chrono_now_rfc3339();
    var p = alloc(64);
    store64(p, ts);
    store64(p + 8, user);
    store64(p + 16, mode);
    store64(p + 24, input);
    store64(p + 32, action);
    store64(p + 40, approved);
    store64(p + 48, result);
    store64(p + 56, exit_code);
    return p;
}
# Map a launcher's return value to an exec-surface result label. Lives here
# beside the record it labels, and is the SINGLE mapping point so no call site
# re-decides it. Negative = launch failure (every launcher's convention),
# 0 = clean exit, positive = the child's own non-zero status.
#
# These five labels (launched / executed / failed / error / denied) are
# deliberately DISJOINT from classify_audit_result's six parse-time labels, so
# one `select` separates what the shell DID from what it merely considered.
fn audit_exec_outcome(exit_code) {
    if (exit_code < 0) { return "error"; }
    if (exit_code == 0) { return "executed"; }
    return "failed";
}
fn AuditEntry_to_json(self) {
    var builder = str_builder_new();
    str_builder_add(builder, "{\"timestamp\":\"");
    str_builder_add(builder, json_escape(load64(self)));
    str_builder_add(builder, "\",\"user\":\"");
    str_builder_add(builder, json_escape(load64(self + 8)));
    str_builder_add(builder, "\",\"mode\":\"");
    str_builder_add(builder, json_escape(load64(self + 16)));
    str_builder_add(builder, "\",\"input\":\"");
    str_builder_add(builder, json_escape(load64(self + 24)));
    str_builder_add(builder, "\",\"action\":\"");
    str_builder_add(builder, json_escape(load64(self + 32)));
    str_builder_add(builder, "\",\"approved\":");
    str_builder_add(builder, str_from_int(load64(self + 40)));
    str_builder_add(builder, ",\"result\":\"");
    str_builder_add(builder, json_escape(load64(self + 48)));
    # exit_code is always present so the record shape is stable for consumers;
    # `null` when the entry describes something that never ran.
    str_builder_add(builder, "\",\"exit_code\":");
    if (load64(self + 56) == AUDIT_NO_EXIT) {
        str_builder_add(builder, "null");
    } else {
        str_builder_add(builder, str_from_int(load64(self + 56)));
    }
    str_builder_add(builder, "}");
    return str_builder_build(builder);
}
struct AuditLogger { file_path; }
# Set once the first audit write fails, so the warning below is printed once per process.
# Tests reset it to exercise the warning again.
var audit_write_warned = 0;
# Every failure to record an action lands here. Until 1.9.15 they were all SILENT: a
# refused symlink, a full disk, a read-only home or (agnos) a failed seek dropped the
# record and the shell said nothing, while the history save warned about the same
# conditions. An audit trail that can stop without a word is not one an operator can
# rely on. Once per process is enough — repeating it on every command would be noise,
# and the first one is the signal.
fn _audit_write_failed() {
    if (audit_write_warned == 0) {
        audit_write_warned = 1;
        var w = "agnsh: warning: an audit record could not be written (later failures are not reported)\n";
        sys_write(2, w, strlen(w));
    }
    return 0 - 1;
}
fn AuditLogger_new(file_path) {
    var p = alloc(8);
    store64(p, file_path);
    return p;
}
fn AuditLogger_log(self, entry) {
    # Use the lib/io.cyr `sys_open` / `sys_write` / `sys_close` wrappers
    # so aarch64 cross-builds compile. aarch64 doesn't expose bare
    # SYS_OPEN (= io_setup in its generic syscall table) and routes
    # the open through openat(AT_FDCWD, ...) inside `sys_open`. Direct
    # `syscall(SYS_OPEN, ...)` broke the cross-build at CI.
    # ⛔ RAW `sys_open` IS NOT THE SAME FUNCTION ON BOTH TARGETS.
    #   Linux/macOS: sys_open(path, flags, mode)
    #   agnos:       sys_open(name, namelen, flags)
    # The Linux-shaped `sys_open(load64(self), 1089, 384)` that used to live
    # here passed 1089 as agnos's `namelen` and 384 as its `flags`, so on agnos
    # every open was malformed and AUDIT LOGGING WAS SILENTLY DEAD on the
    # primary target — the one platform where agnsh actually executes programs.
    # `file_open` is the length-carrying bridge that exists precisely for this
    # (lib/io.cyr:75); use it instead of hand-rolling the split.
    #
    # O_NOFOLLOW closes the pre-placed-symlink hijack of the audit trail: with
    # a symlink at $HOME/.agnsh_audit.log, the old open followed it and wrote
    # (and chmod'd 0600) an arbitrary user-owned file. ⚠ On aarch64 it did so
    # until 1.9.13 — OPEN_NOFOLLOW carried x86_64's value, which arm64 reads as
    # O_LARGEFILE (see src/sanitize.cyr). On agnos, file_open maps the bit to
    # AO_NOFOLLOW (cyrius 6.6.4; agnos ≥ 1.56.53); before that it dropped it.
    var line = AuditEntry_to_json(entry);
    var fd = file_open(load64(self),
      OPEN_WRONLY | OPEN_CREAT | OPEN_APPEND | OPEN_NOFOLLOW, STATE_FILE_MODE);
    if (fd < 0) { return _audit_write_failed(); }
    # ⛔ agnos IGNORES AO_APPEND. Its ext2_open starts every file at position 0 and keeps no
    # open flags, so until 1.9.14 each record on agnos was written at offset 0 over the last.
    # Measured in QEMU on agnos 1.57.5 (scripts/agnos-qemu-test.py): a session's whole trail
    # came back as its final record plus the torn tails of longer ones — the launched+outcome
    # pair this log exists to keep could never survive to be read. Seek to the end explicitly,
    # as lib/io.cyr's file_append_locked does on agnos (whence 2 = SEEK_END). If the seek
    # fails, write nothing: a lost record is recoverable, a record written over the log is not.
    #ifdef CYRIUS_TARGET_AGNOS
    if (xlseek(fd, 0, 2) < 0) {
        file_close(fd);
        return _audit_write_failed();
    }
    #endif
    # ⛔ REPAIR THE MODE, DO NOT ASSUME IT. The 0600 above applies only when THIS
    # open creates the file. An audit log that already exists — created by an
    # earlier agnsh under a different umask, restored from a backup, or copied
    # into place — keeps whatever mode it had, so the trail of every command the
    # user has run could sit world-readable indefinitely and nothing would ever
    # notice. Re-assert it on every open; it is one syscall on a path that is
    # already doing I/O.
    # Return checked, per lint Category E: a failing chmod here means the audit
    # log is sitting at whatever mode it had — potentially world-readable, or
    # owned by another user (the /tmp pre-creation case). That is exactly the
    # state an operator needs told about, and it is rare enough that a warning
    # per write is not noise: if it fires every invocation, something really is
    # wrong with the log's ownership.
    # ⛔ ON THE OPEN FD, NOT THE PATH (1.9.15). A path chmod follows a symlink swapped in
    # between the O_NOFOLLOW open and this call, re-permissioning whatever it points at;
    # fchmod on the descriptor can only reach the file actually opened. agnos has no
    # permission bits — its peer's sys_chmod is a stub that returns 0 — and no fchmod
    # (⛔ syscall 91, fchmod on Linux x86_64, is gpu_blit_bb on agnos), so it keeps the stub.
    #ifdef CYRIUS_TARGET_AGNOS
    var arc = sys_chmod(load64(self), STATE_FILE_MODE);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var arc = sys_fchmod(fd, STATE_FILE_MODE);
    #endif
    if (arc != 0) {
        var awarn = "agnsh: warning: could not enforce 0600 on the audit log\n";
        sys_write(2, awarn, strlen(awarn));
    }
    var len = str_len(line);
    # Short writes are real on a full disk or a quota'd home, and a partial
    # audit line is a CORRUPT audit line. Report failure instead of returning 0
    # and letting the caller believe the action was recorded.
    var w1 = file_write(fd, str_data(line), len);
    var w2 = file_write(fd, "\n", 1);
    file_close(fd);
    if (w1 != len) { return _audit_write_failed(); }
    if (w2 != 1) { return _audit_write_failed(); }
    return 0;
}
struct AuditFilter {
    agent;
    action;
    approved;
    limit;
    since_seconds;
}
fn AuditFilter_default() {
    var p = alloc(40);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0 - 1);
    store64(p + 24, 0);
    store64(p + 32, 0);
    return p;
}
struct AuditViewer { file_path; }
fn AuditViewer_new(file_path) {
    var p = alloc(8);
    store64(p, file_path);
    return p;
}
fn AuditViewer_query(self, filter) {
    # v1.2.x — local file-read query path. The current Cyrius 5.10.x
    # stdlib doesn't expose the API this body relied on (fs_exists →
    # file_exists rename; json_get_str → json_get rename; file_read_all
    # is now buffer-based, not malloc-return). The AUDIT_VIEW intent
    # already routes through MCP via translate_audit_view, so this
    # in-process fallback isn't needed for v1.2.x. Return empty until
    # the audit-read flow is the lead item and the stdlib alignment is
    # done together.
    return vec_new();
}
fn audit_format_table(entries) {
    var count = vec_len(entries);
    if (count == 0) {
        # str_from: this function returns a Str (str_builder_build below), so a
        # bare cstring here would hand callers a value of the wrong shape.
        return str_from("No audit entries found.");
    }
    var builder = str_builder_new();
    str_builder_add(builder, "TIMESTAMP                USER         ACTION     OK?      INPUT\n");
    for (var i = 0; i < 90; i = i + 1) {
        str_builder_add(builder, "-");
    }
    str_builder_add(builder, "\n");
    for (var i = 0; i < count; i = i + 1) {
        var e = vec_get(entries, i);
        var ts = str_substr(load64(e), 0, 24);
        # ⛔ str_builder_add is declared (sb, s: Str). A LITERAL at that
        # parameter is promoted by the compiler, which is why the header and
        # separator lines above work — but a literal held in a VARIABLE is not,
        # so these two read load64(approved_str + 8) as a length and memcpy'd
        # that many bytes. Verified: str_len on a variable-held cstring returns
        # a garbage 19-digit value.
        var approved_str = str_from("NO");
        if (load64(e + 40) == 1) { approved_str = str_from("yes"); }
        var input_display = load64(e + 24);
        if (str_len(load64(e + 24)) > 30) {
            input_display = str_cat(str_substr(load64(e + 24), 0, 27), str_from("..."));
        }
        str_builder_add(builder, ts);
        str_builder_add(builder, " ");
        str_builder_add(builder, load64(e + 8));
        str_builder_add(builder, " ");
        str_builder_add(builder, load64(e + 32));
        str_builder_add(builder, " ");
        str_builder_add(builder, approved_str);
        str_builder_add(builder, " ");
        str_builder_add(builder, input_display);
        str_builder_add(builder, "\n");
    }
    return str_builder_build(builder);
}

# ---- Audit-record construction (moved out of src/agnsh.cyr in 1.9.7) ----
#
# These are audit functions and belong beside the record they build. They lived
# in the entry file for historical reasons, which made them untestable — a test
# binary cannot include an entry that owns `main`. Same code, reachable home.

fn classify_audit_result(tag, perm, desc_cstr) {
    # Maps the parse+translate outcome to one of six audit-result
    # labels. Mirrors slice 8's user-facing Hint: lines so a downstream
    # `jq 'select(.result == "rejected_safety")'` can find exactly the
    # same input shapes the user saw a Hint for. Order matters:
    # safety-rejected, needs_llm, and needs_exec are tag/description
    # properties that supersede the permission-derived classification.
    #
    #   rejected_safety  -- translator's safety check rejected (path
    #                       traversal, shell metachars, leading-dash
    #                       commit msg, null pid, etc.). Detected by
    #                       translate_unknown's "Unknown intent" stamp.
    #   needs_llm        -- QUESTION intent: parser routed to LLM but
    #                       streaming isn't wired yet.
    #   needs_exec       -- PIPELINE intent: no translator arm yet.
    #   blocked          -- BLOCKED permission: caller-must-approve.
    #   needs_approval   -- HIGH risk (ADMIN / SYSTEM_WRITE): runnable
    #                       only after an interactive approval prompt
    #                       (interactive-shell exec wire-up).
    #   proposed         -- SAFE / READ_ONLY / USER_WRITE: the shell would
    #                       allow this, but the NL path does not exec yet
    #                       (roadmap 1.10.x — NL exec). An actual execution is
    #                       recorded separately by the exec surface, which uses
    #                       launched/executed/failed/error/denied.
    # QUESTION and PIPELINE tags first — PIPELINE has no translator
    # arm (`translate_extended` doesn't handle 41) so the dispatch
    # falls through to translate_unknown, stamping the same "Unknown
    # intent" description as a real safety-rejected translation.
    # Without the tag-first order PIPELINE would mis-classify as
    # rejected_safety.
    if (tag == IntentTag.QUESTION) { return "needs_llm"; }
    if (tag == IntentTag.PIPELINE) { return "needs_exec"; }
    if (streq(desc_cstr, "Unknown intent") == 1) { return "rejected_safety"; }
    if (perm == PermissionLevel.BLOCKED) { return "blocked"; }
    if (risk_from_permission(perm) == RiskLevel.HIGH) { return "needs_approval"; }
    return "proposed";
}
fn audit_one_shot(input_cstr, cmd_cstr, perm, mode_label_cstr, tag, desc_cstr) {
    # Every -c invocation produces one audit line. `approved` is 1 for
    # auto-runnable (SAFE/READ_ONLY/USER_WRITE), 0 for anything that
    # would require an interactive approval prompt (SYSTEM_WRITE/ADMIN)
    # or is outright blocked. `result` carries the slice-9 audit-result
    # vocabulary (see classify_audit_result).
    #
    # NB this function covers the PARSE-TIME surface only — what the shell
    # decided about a line it did not run. The exec surface has its own
    # vocabulary and its own entry point (audit_exec / audit_exec_ctx, 1.9.2);
    # the two label sets are disjoint on purpose so a consumer can separate
    # "considered" from "did" with one `select`. The old note here promised
    # that "proposed" would be *replaced* by executed/denied/error once exec
    # landed — that turned out to be the wrong shape: a proposal and an
    # execution are different events and both deserve a record.
    var approved = 0;
    if (perm == PermissionLevel.SAFE) { approved = 1; }
    elif (perm == PermissionLevel.READ_ONLY) { approved = 1; }
    elif (perm == PermissionLevel.USER_WRITE) { approved = 1; }
    var result_label = classify_audit_result(tag, perm, desc_cstr);
    var entry = AuditEntry_new(
      str_from("user"),
      str_from(mode_label_cstr),
      str_from(input_cstr),
      str_from(cmd_cstr),
      approved,
      str_from(result_label)
      );
    var logger = AuditLogger_new(audit_log_path());
    AuditLogger_log(logger, entry);
}

# ---- The EXEC audit surface ----
#
# ⛔ Until 1.9.2 NOTHING THAT ACTUALLY RAN A PROGRAM WAS AUDITED. `audit_one_shot`
# is reached only from `print_intent_result`, which runs only when nothing has
# executed — so the audit log recorded exactly the actions that never happened,
# while `run`, bareword launch, pipelines, redirection and background jobs were
# all invisible. `agnsh -c 'run /bin/echo'` ran the program and did not even
# create the log file. That directly contradicted CLAUDE.md's "every command
# must be auditable".
#
# Result vocabulary for this surface. The six parse-time labels
# (classify_audit_result) describe what the shell DECIDED; these describe what
# it DID, and the two sets are deliberately disjoint so a consumer can tell them
# apart with a single `select`:
#   launched  -- emitted BEFORE the child starts
#   executed  -- child ran to completion, exit 0
#   failed    -- child ran to completion, non-zero exit
#   error     -- the launch itself failed (missing binary, exec refused)
#   denied    -- refused before any launch (mode confirm declined, unsafe path,
#                non-absolute path, usage error)
#
# WHY A `launched` RECORD IS WRITTEN BEFORE THE EXEC: a foreground child can
# hang forever, kill the shell, or (reboot/poweroff/halt) take the whole
# machine down. An outcome-only record would leave no trace of any of those.
# The pair is the point — a `launched` with no matching outcome IS the signal.
# Dispatch-scoped audit context. Set ONCE per input line, then read by every
# launcher, so the exec audit needs no signature change to the agnos-only
# launch chain (sh_run_program / sh_try_bareword_launch / sh_try_pipeline_launch
# / sh_try_redirect_launch / sh_run_program_bg). Threading an extra parameter
# through that chain would mean editing five functions inside
# `#ifdef CYRIUS_TARGET_AGNOS` that cannot be exercised on a Linux host; a
# context set at the two dispatch entry points is verifiable on both.
#
# Lifetime: g_audit_line points at the caller's line buffer (the interactive
# loop's `&buf`, or argv for -c). Every audit_exec_ctx call happens inside the
# same dispatch iteration, and audit_exec copies via str_from before the buffer
# is reused, so the borrow never outlives the line.
var g_audit_line = 0;
var g_audit_mode = 0;

fn audit_set_context(line_cstr, mode_label_cstr) {
    g_audit_line = line_cstr;
    g_audit_mode = mode_label_cstr;
    return 0;
}

# Context-using form — what the launchers call.
fn audit_exec_ctx(cmd_cstr, result_label_cstr, exit_code) {
    var line = g_audit_line;
    if (line == 0) { line = cmd_cstr; }
    var mode_label = g_audit_mode;
    if (mode_label == 0) { mode_label = "unknown"; }
    return audit_exec(line, cmd_cstr, mode_label, result_label_cstr, exit_code);
}

fn audit_exec(input_cstr, cmd_cstr, mode_label_cstr, result_label_cstr, exit_code) {
    # `approved` means "the shell permitted this to proceed", so only an
    # explicit refusal is 0. A child that ran and failed was still approved.
    var approved = 1;
    if (streq(result_label_cstr, "denied") == 1) { approved = 0; }
    var entry = AuditEntry_new_x(
      str_from("user"),
      str_from(mode_label_cstr),
      str_from(input_cstr),
      str_from(cmd_cstr),
      approved,
      str_from(result_label_cstr),
      exit_code
      );
    var logger = AuditLogger_new(audit_log_path());
    return AuditLogger_log(logger, entry);
}

# Outcome record for a BACKGROUND job, emitted from job_reap_poll.
#
# ⚠ The dispatch context is deliberately NOT used for `input` here. A reap
# happens at some later prompt tick, so g_audit_line points at whatever the user
# most recently typed — attributing the completion to that line would be an
# actively wrong audit record. The command stored in the job table at launch is
# the honest answer, so it serves as both input and action. `mode` still comes
# from the context because the shell's mode at observation time is real.
#
# `wait_rc` is whatever waitpid(#4) returned for a completed child; it is passed
# through rather than reinterpreted, and audit_exec_outcome maps <0 / 0 / >0 the
# same way it does for the foreground paths.
fn audit_exec_bg_done(cmd_cstr, wait_rc) {
    var mode_label = g_audit_mode;
    if (mode_label == 0) { mode_label = "unknown"; }
    return audit_exec(cmd_cstr, cmd_cstr, mode_label, audit_exec_outcome(wait_rc), wait_rc);
}
