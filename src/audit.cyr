struct AuditEntry {
    timestamp;
    user;
    mode;
    input;
    action;
    approved;
    result;
    exit_code;
}
# Sentinel for "this record describes something that never ran, so an exit code
# is not meaningful". Emitted as JSON `null` rather than a magic number so a
# consumer cannot mistake it for a real status. Real codes are 0..255 and
# launch failures are small negatives, so this cannot collide.
var AUDIT_NO_EXIT = 0 - 999999;
fn AuditEntry_new(user, mode, input, action, approved, result) {
    return AuditEntry_new_x(user, mode, input, action, approved, result, AUDIT_NO_EXIT);
}
# Exit-code-carrying constructor. AuditEntry_new stays 6-arg so the parse-time
# (non-exec) call sites and their tests are untouched.
fn AuditEntry_new_x(user, mode, input, action, approved, result, exit_code) {
    var ts = chrono_now_rfc3339();
    var p = alloc(64);
    store64(p, ts);
    store64(p + 8, user);
    store64(p + 16, mode);
    store64(p + 24, input);
    store64(p + 32, action);
    store64(p + 40, approved);
    store64(p + 48, result);
    store64(p + 56, exit_code);
    return p;
}
# Map a launcher's return value to an exec-surface result label. Lives here
# beside the record it labels, and is the SINGLE mapping point so no call site
# re-decides it. Negative = launch failure (every launcher's convention),
# 0 = clean exit, positive = the child's own non-zero status.
#
# These five labels (launched / executed / failed / error / denied) are
# deliberately DISJOINT from classify_audit_result's six parse-time labels, so
# one `select` separates what the shell DID from what it merely considered.
fn audit_exec_outcome(exit_code) {
    if (exit_code < 0) { return "error"; }
    if (exit_code == 0) { return "executed"; }
    return "failed";
}
fn AuditEntry_to_json(self) {
    var builder = str_builder_new();
    str_builder_add(builder, "{\"timestamp\":\"");
    str_builder_add(builder, json_escape(load64(self)));
    str_builder_add(builder, "\",\"user\":\"");
    str_builder_add(builder, json_escape(load64(self + 8)));
    str_builder_add(builder, "\",\"mode\":\"");
    str_builder_add(builder, json_escape(load64(self + 16)));
    str_builder_add(builder, "\",\"input\":\"");
    str_builder_add(builder, json_escape(load64(self + 24)));
    str_builder_add(builder, "\",\"action\":\"");
    str_builder_add(builder, json_escape(load64(self + 32)));
    str_builder_add(builder, "\",\"approved\":");
    str_builder_add(builder, str_from_int(load64(self + 40)));
    str_builder_add(builder, ",\"result\":\"");
    str_builder_add(builder, json_escape(load64(self + 48)));
    # exit_code is always present so the record shape is stable for consumers;
    # `null` when the entry describes something that never ran.
    str_builder_add(builder, "\",\"exit_code\":");
    if (load64(self + 56) == AUDIT_NO_EXIT) {
        str_builder_add(builder, "null");
    } else {
        str_builder_add(builder, str_from_int(load64(self + 56)));
    }
    str_builder_add(builder, "}");
    return str_builder_build(builder);
}
struct AuditLogger { file_path; }
fn AuditLogger_new(file_path) {
    var p = alloc(8);
    store64(p, file_path);
    return p;
}
fn AuditLogger_log(self, entry) {
    # Use the lib/io.cyr `sys_open` / `sys_write` / `sys_close` wrappers
    # so aarch64 cross-builds compile. aarch64 doesn't expose bare
    # SYS_OPEN (= io_setup in its generic syscall table) and routes
    # the open through openat(AT_FDCWD, ...) inside `sys_open`. Direct
    # `syscall(SYS_OPEN, ...)` broke the cross-build at CI.
    # ⛔ RAW `sys_open` IS NOT THE SAME FUNCTION ON BOTH TARGETS.
    #   Linux/macOS: sys_open(path, flags, mode)
    #   agnos:       sys_open(name, namelen, flags)
    # The Linux-shaped `sys_open(load64(self), 1089, 384)` that used to live
    # here passed 1089 as agnos's `namelen` and 384 as its `flags`, so on agnos
    # every open was malformed and AUDIT LOGGING WAS SILENTLY DEAD on the
    # primary target — the one platform where agnsh actually executes programs.
    # `file_open` is the length-carrying bridge that exists precisely for this
    # (lib/io.cyr:75); use it instead of hand-rolling the split.
    #
    # O_NOFOLLOW closes the pre-placed-symlink hijack of the audit trail: with
    # a symlink at $HOME/.agnsh_audit.log, the old open followed it and wrote
    # (and chmod'd 0600) an arbitrary user-owned file. file_open's agnos branch
    # masks only bits 3|64|512|1024, so the extra bit is dropped there rather
    # than corrupting the flags — graceful degrade until agnos gains AO_NOFOLLOW.
    var line = AuditEntry_to_json(entry);
    var fd = file_open(load64(self), 1089 | O_NOFOLLOW_LINUX, 384);
    if (fd < 0) { return 0 - 1; }
    var len = str_len(line);
    # Short writes are real on a full disk or a quota'd home, and a partial
    # audit line is a CORRUPT audit line. Report failure instead of returning 0
    # and letting the caller believe the action was recorded.
    var w1 = file_write(fd, str_data(line), len);
    var w2 = file_write(fd, "\n", 1);
    file_close(fd);
    if (w1 != len) { return 0 - 1; }
    if (w2 != 1) { return 0 - 1; }
    return 0;
}
struct AuditFilter {
    agent;
    action;
    approved;
    limit;
    since_seconds;
}
fn AuditFilter_default() {
    var p = alloc(40);
    store64(p, 0);
    store64(p + 8, 0);
    store64(p + 16, 0 - 1);
    store64(p + 24, 0);
    store64(p + 32, 0);
    return p;
}
struct AuditViewer { file_path; }
fn AuditViewer_new(file_path) {
    var p = alloc(8);
    store64(p, file_path);
    return p;
}
fn AuditViewer_query(self, filter) {
    # v1.2.x — local file-read query path. The current Cyrius 5.10.x
    # stdlib doesn't expose the API this body relied on (fs_exists →
    # file_exists rename; json_get_str → json_get rename; file_read_all
    # is now buffer-based, not malloc-return). The AUDIT_VIEW intent
    # already routes through MCP via translate_audit_view, so this
    # in-process fallback isn't needed for v1.2.x. Return empty until
    # the audit-read flow is the lead item and the stdlib alignment is
    # done together.
    return vec_new();
}
fn audit_format_table(entries) {
    var count = vec_len(entries);
    if (count == 0) {
        return "No audit entries found.";
    }
    var builder = str_builder_new();
    str_builder_add(builder, "TIMESTAMP                USER         ACTION     OK?      INPUT\n");
    for (var i = 0; i < 90; i = i + 1) {
        str_builder_add(builder, "-");
    }
    str_builder_add(builder, "\n");
    for (var i = 0; i < count; i = i + 1) {
        var e = vec_get(entries, i);
        var ts = str_substr(load64(e), 0, 24);
        var approved_str = "NO";
        if (load64(e + 40) == 1) { approved_str = "yes"; }
        var input_display = load64(e + 24);
        if (str_len(load64(e + 24)) > 30) {
            input_display = str_cat(str_substr(load64(e + 24), 0, 27), str_from("..."));
        }
        str_builder_add(builder, ts);
        str_builder_add(builder, " ");
        str_builder_add(builder, load64(e + 8));
        str_builder_add(builder, " ");
        str_builder_add(builder, load64(e + 32));
        str_builder_add(builder, " ");
        str_builder_add(builder, approved_str);
        str_builder_add(builder, " ");
        str_builder_add(builder, input_display);
        str_builder_add(builder, "\n");
    }
    return str_builder_build(builder);
}
