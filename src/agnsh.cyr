# agnsh.cyr -- minimal working agnoshi binary for v1.0
# Demonstrates the core NL -> command translation pipeline.
# Uses only Cyrius stdlib features that actually work.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/args.cyr"
include "lib/chrono.cyr"
# process.cyr → process_agnos.cyr under CYRIUS_TARGET_AGNOS. NB the vendored agnos
# run() is sys_spawn-based (the lib is gitignored + regenerated by `cyrius update`,
# and the cyrius snapshot has no execwait). agnsh's DURABLE agnos launch path is in
# src/run_agnos.cyr (committed), which calls execwait #37 directly; the lib run() is
# used only by the host build's fork/exec path.
include "lib/process.cyr"

# `chrono_now_rfc3339` reaches into lib/chrono.cyr's iso8601_now (real wall-clock
# time) instead of the v1.0-era fixed-string stub; the wrap converts iso8601_now's
# cstring buffer to a Str so audit's json_escape (Str-typed) reads a valid length
# header.
# ⚠ No `ui_show_*` stand-ins here since 1.9.15. Two `return 0` stubs used to sit here
# for callers that are all outside the include graph (src/aliases.cyr,
# src/session.cyr), so the first caller wired in would have dropped its message
# without a word. Wiring either module now fails to compile until its UI calls get
# real bodies — session.cyr calls seven more `ui_show_*` that never had stubs anyway.
# tests/harness.cyr keeps its own stubs for the test binaries.
fn chrono_now_rfc3339() { return str_from(iso8601_now()); }

include "src/sanitize.cyr"
include "src/statepaths.cyr"
include "src/report.cyr"
include "src/mode.cyr"
include "src/permissions.cyr"
include "src/intent.cyr"
include "src/commands.cyr"
include "src/translate.cyr"
include "src/interpreter.cyr"
include "src/approval.cyr"
include "src/audit.cyr"
include "src/history.cyr"
include "src/run_agnos.cyr"
include "src/run_host.cyr"
include "src/nlexec.cyr"

var VERSION_STR = "agnoshi 2.0.1";

fn print_version() {
    println(VERSION_STR);
}

fn print_usage() {
    println("Usage: agnsh [OPTIONS] [-c COMMAND]");
    println("");
    println("  -c, --command CMD   Run one command and exit: stdout is the program's, and");
    println("                      the report goes to the report folder");
    println("  -n, --dry-run       With -c: classify and report on stdout, run nothing");
    println("      --mode NAME     With -c: auto|assist|human|strict (default auto)");
    println("  -v, --version       Show version");
    println("  -h, --help          Show this help");
    println("");
    println("Interactive mode (no args): type natural language or shell commands.");
    println("  help                -- builtin, file, and run commands");
    #ifdef CYRIUS_TARGET_AGNOS
    println("  cp mv rm ls ...     -- file tools via /bin (kriya); owl reads files");
    #endif
    println("  run PATH            -- run a program from disk");
    println("  exit                -- leave shell");
}

# Line-splitting read buffer (module-static so the leftover survives between
# calls). Module-scope `var X[N]` allocates N*u64 = 8N bytes, so [512] = 4096 B.
var rl_buf[512];
var rl_len = 0;   # bytes currently held in rl_buf
var rl_pos = 0;   # read cursor into rl_buf

#ifdef CYRIUS_TARGET_AGNOS
# One BLOCKING read of stdin into rl_buf (a4 = 0): the byte count, 0 at EOF, or -1. The keyboard's
# read waits for a full line, and since agnos 1.57.8 a pipe or CHANNEL read waits for data or EOF
# too, so a PTY-hosted agnsh sleeps in the kernel between commands instead of polling.
# ⭐ 2.0.1: until now the no-jobs path retried a -2 here with sched_yield#44 plus a 20,000-iteration
# spin, because "the kernel NEVER blocks on a channel" — true when 1.8.7 wrote it (one SYSCALL stack
# per CPU), false since agnos 1.57.8, whose read#5 waits on an empty pipe or channel like any other
# blocking call (per-process kernel stacks arrived in 1.57.6).
# ⛔ -2 / -3 ARE STILL "NOT YET", NEVER EOF (1.8.7: a PTY-hosted shell exited before its first prompt
# when -2 fell into the EOF check). A ring-3 blocking read returns neither on agnos >= 1.57.8 — -2 is
# the kernel's answer for a context that cannot block — so this retry is a guard that does not run:
# its yield makes a surprise cost a tick per round, not a hot spin.
# NOTE: read(fd0) MUST pass a4 EXPLICITLY — see read_line.
fn rl_read_blocking(): i64 {
    var r = syscall(SYS_READ, 0, &rl_buf, 4095, 0);
    while (r == 0 - 2 || r == 0 - 3) {
        syscall(44);
        r = syscall(SYS_READ, 0, &rl_buf, 4095, 0);
    }
    return r;
}
#endif

fn read_line(buf, maxlen) {
    # Return exactly ONE line from stdin, buffering any leftover for the next
    # call. This is target-agnostic and the reason we don't just `read()` once:
    #   - On agnos the kernel's read(fd=0) is line-disciplined (canonical-lite,
    #     1.41.15): it blocks until Enter, echoes + handles backspace as you
    #     type, and returns ONE line with its trailing newline — so rl_buf holds
    #     exactly that line and drains empty each call. (The old per-byte read
    #     masked IRQ1 in the ring-3 IF=0 gap between syscalls and dropped
    #     shift-release breaks — the 1.41.14 "Command: D" stuck-shift collapse;
    #     the kernel now owns echo + line discipline, so we never echo here.)
    #   - On the host (Linux pipe) read() returns a MULTI-line blob in one go; a
    #     naive single read would swallow several user lines into one buffer and
    #     break line-oriented dispatch (streq against builtins, etc.). The carry
    #     buffer hands those back one line at a time.
    # Returns the line length excluding the newline, 0 for an empty line (bare
    # Enter), -1 on EOF before any data.
    #ifdef CYRIUS_TARGET_AGNOS
    job_reap_poll();                            # reap finished bg jobs (+ "[n] Done") before we block
    #endif
    var i = 0;
    while (1 == 1) {
        if (rl_pos >= rl_len) {                 # carry buffer empty -> refill
            rl_pos = 0;
            #ifdef CYRIUS_TARGET_AGNOS
            # 1.44.13 schedulable agnsh (Option B): with LIVE bg jobs, POLL stdin non-blocking
            # (read fd0 a4=1 -> -2/WOULD_BLOCK until a full line) interleaved with bg-job reaping,
            # so bg jobs time-slice in the preemptible RING-3 gap between polls (the timer preempts
            # this loop). NO preempt-disabling wait here (sleep_ms#41 would FREEZE the bg jobs).
            # CRITICAL: special-case -2 (poll again) BEFORE the <=0 EOF check below. With no jobs,
            # use the efficient BLOCKING read (the default).
            # NOTE: read(fd0) MUST pass the a4 flag EXPLICITLY (0=blocking, 1=non-blocking). The
            # kernel sets ksyscall_a4 = r10 unconditionally (syscall_hw.cyr) — it is NOT zeroed for
            # calls that don't intend a4 — so a 4-arg read(0) would deliver GARBAGE r10 as a4 and
            # mis-route to the non-blocking path (returns -2 -> agnsh reads it as EOF -> exits).
            if (job_any() > 0) {
                # ⚠ THE ONE POLL LEFT, DELIBERATELY. This waits for EITHER a key OR a job's exit, and
                # no single agnos call covers both yet — shells elsewhere use SIGCHLD plus a blocking
                # read (bash) or poll/select on the terminal (zsh). Since agnos 1.57.9 a #44 with
                # nothing else READY parks until the next timer tick, so a round costs up to a tick
                # of latency, not a spin. Every other wait in agnsh blocks (2.0.1).
                var done = 0;
                while (done == 0) {
                    var r = syscall(SYS_READ, 0, &rl_buf, 4095, 1);   # a4=1 -> non-blocking
                    if (r == 0 - 2) {                                 # nothing buffered: reap + retry
                        job_reap_poll();
                        if (job_any() == 0) {                         # no jobs AND no partial line ->
                            rl_len = rl_read_blocking();              # block (a4=0), as with no jobs
                            done = 1;
                        } else {
                            # sched_yield (literal 44, agnos 1.44.16; see the literal-43/37 rationale
                            # in run_agnos.cyr): donate the REST of our timer slice to the bg job
                            # instead of busy-polling it away — bg throughput roughly doubles, and
                            # keystrokes still land within ~2 ticks (latched in kb_buf, drained on
                            # the next poll; imperceptible against human typing).
                            syscall(44);
                        }
                    } elif (r == 0 - 3) {                             # PARTIAL line in the kernel
                        job_reap_poll();                              # accumulator: KEEP polling so it
                        # isn't orphaned (the blocking read accumulates into a DIFFERENT buffer); the
                        # next read_line (no jobs) blocks. Reap finished jobs meanwhile.
                        syscall(44);                                  # donate the slice here too — a
                        # half-typed line must not busy-spin the slice away (same rationale as -2).
                    } else { rl_len = r; done = 1; }                  # a complete line (or EOF 0)
                }
            } else {
                rl_len = rl_read_blocking();
            }
            #endif
            #ifndef CYRIUS_TARGET_AGNOS
            rl_len = syscall(SYS_READ, 0, &rl_buf, 4095);
            # ⛔ A NEGATIVE read() IS AN ERRNO, NOT END-OF-INPUT. This fell
            # straight into the `rl_len <= 0` check below, so EVERY error was
            # read as EOF and the shell exited silently, with status 0, as though
            # the user had typed Ctrl-D. The common case is -EINTR (-4): a signal
            # delivered while blocked in read — a window resize (SIGWINCH) under a
            # terminal that does not restart syscalls is enough — and an
            # interactive shell must not die because the window was resized.
            # (The agnos branch above already distinguished its own -2/-3
            # "not yet" codes; only the host path conflated them.)
            if (rl_len < 0) {
                if (rl_len == 0 - 4) {          # -EINTR: retry, keeping any partial line
                    rl_len = 0;
                    rl_pos = 0;
                    continue;
                }
                # Anything else is a genuine failure. Say so on stderr and exit
                # non-zero rather than pretending the input simply ended.
                eprintln_cstr("agnsh: read error on stdin");
                return 0 - 2;
            }
            #endif
            if (rl_len <= 0) {
                if (i == 0) { return 0 - 1; }   # EOF, nothing accumulated
                break;                          # EOF after a newline-less tail
            }
        }
        while (rl_pos < rl_len) {
            var ch = load8(&rl_buf + rl_pos);
            rl_pos = rl_pos + 1;
            if (ch == 10) {                     # line terminator: done
                store8(buf + i, 0);
                return i;
            }
            if (i < maxlen - 1) {
                store8(buf + i, ch);
                i = i + 1;
            }
        }
        # buffer drained with no newline -> loop refills and keeps accumulating
    }
    store8(buf + i, 0);
    return i;
}

#ifdef CYRIUS_TARGET_AGNOS
# Platform power control — ONE helper so the three verbs cannot drift apart.
#
# ⛔ THE AUDIT RECORD AND THE HISTORY SAVE MUST HAPPEN BEFORE THE SYSCALL, because the syscall does
# NOT RETURN on success. Until 1.9.11 neither happened: each arm called syscall(13,...) then
# `continue`, and the only reachable CommandHistory_save is after the loop — so every command typed
# in a session ended by a power verb was LOST, and the three verbs that take the machine down were
# the only ones that left no audit trail at all. run_agnos.cyr already writes the "launched" record
# for exactly this reason, and says so: an unmatched "launched" IS the signal for a call that cannot
# report its own outcome.
# ⚠ AUDIT FIRST, THEN HISTORY: the audit line is one open/write/close append and is the more
# important record; the history save rewrites a whole file and is likelier to be the one that loses
# a race with the platform going down.
fn sh_power_verb(history, typed_cstr, cmd) {
    audit_exec_ctx(typed_cstr, "launched", AUDIT_NO_EXIT);
    CommandHistory_add(history, typed_cstr);
    CommandHistory_save(history);
    syscall(13, 0x50575231, 0x50575232, cmd, 0);
    return 0;
}
#endif

fn interactive_loop() {
    var rl_failed = 0;
    println(VERSION_STR);
    println("AI-native shell -- type a natural-language command, or 'exit' to quit.");
    # 1.9.11 — the power verbs are AGNOS-only (see the guard in the loop), so do not advertise
    # them on a host build. Same fix the kriya barewords already got one screen below.
    #ifdef CYRIUS_TARGET_AGNOS
    println("Built-ins: help, version, mode, history, clear, exit, reboot, poweroff, halt");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    println("Built-ins: help, version, mode, history, clear, exit");
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    println("Files: cp mv rm ls mkdir rmdir touch echo wc find grep (kriya) - owl FILE (cat)   Run: run");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    println("Run: a program's name, or run /abs/path   (pipelines, > and & are AGNOS-only)");
    #endif
    println("");

    var buf[4096];
    var interp = Interpreter_new();
    # ShellConfig_default sets Mode.AI_ASSISTED — same starting point
    # as the v1.0 design intent. ModeManager owns the "allow_switching"
    # bit; 1 means the user can change modes at runtime.
    var mode_mgr = ModeManager_new(Mode.AI_ASSISTED, 1);
    # CommandHistory keeps the last 1000 lines (ShellConfig default is
    # 10000 but that's heavy for interactive; 1000 covers a long session
    # without bloating the on-disk file). Loads from $HOME/.agnsh_history
    # if present, so history survives across sessions.
    var history = CommandHistory_new(history_path(), HISTORY_MAX_ENTRIES);

    while (1 == 1) {
        # Prompt carries the current mode prefix so the user always
        # knows the AI-autonomy level before typing. Pre-v1.2.1 the
        # prompt was a bare `> ` regardless of mode.
        var cur_mode = ModeManager_current(mode_mgr);
        str_print(str_from(mode_prompt_prefix(cur_mode)));
        str_print(str_from(" > "));
        var n = read_line(&buf, 4096);
        # -1 = clean EOF (Ctrl-D / end of a pipe). -2 = a real read error, which
        # read_line has already reported on stderr; propagate it as a non-zero
        # exit so a caller can tell "the user finished" from "stdin broke".
        if (n == 0 - 2) { rl_failed = 1; break; }
        if (n < 0) { break; }
        if (n == 0) { continue; }
        # One context per input line, read by every launcher below. See
        # audit_set_context for why the exec audit is context-scoped rather
        # than threaded through the agnos-only launch chain.
        audit_set_context(&buf, mode_display(cur_mode));

        if (streq(&buf, "exit") == 1) { break; }
        if (streq(&buf, "quit") == 1) { break; }
        # Platform power control. Calls agnos syscall #13 by RAW NUMBER. 0x50575231/0x50575232 =
        # "PWR1"/"PWR2" — the kernel's arming token, which exists so stale nullary callers that
        # deliver garbage in the argument registers fail closed instead of resetting the machine.
        # cmd 3 = reboot, 2 = power off, 1 = halt. None of these returns when it succeeds.
        #
        # ⛔⛔ 1.9.11 — ARCH-GUARDED. These three were OUTSIDE any #ifdef, so a HOST build emitted a
        # raw Linux syscall 13, which is rt_sigaction. The return was discarded, so it failed
        # silently — inert BY ACCIDENT, not by design. Decision O5 in agnos's userland-ABI doc names
        # this exact shape.
        # ⛔ AND DO NOT "TIDY" THIS INTO cyrius's sys_reboot(). Its ARITY DIFFERS PER TARGET:
        # lib/syscalls_linux_common.cyr is `sys_reboot(cmd)` (1 arg, hardcoding the REAL
        # LINUX_REBOOT_MAGIC1/2), while lib/syscalls_x86_64_agnos.cyr is
        # `sys_reboot(magic1, magic2, cmd, arg)`. A 4-arg call cannot compile on host; "fixing" that
        # by adopting the host's 1-arg form would carry genuine 0xFEE1DEAD against Linux SYS_REBOOT
        # and ACTUALLY REBOOT A DEVELOPER'S WORKSTATION under CAP_SYS_BOOT. The tidier-looking
        # migration is the dangerous one. (The old comment here said a cyrius issue was filed to
        # widen the wrapper "until it lands" — it landed at 6.4.68; that is not the blocker.)
        #ifdef CYRIUS_TARGET_AGNOS
        if (streq(&buf, "reboot") == 1) {
            sh_power_verb(history, &buf, 3);
            println("reboot: platform did not reset");
            continue;
        }
        if (streq(&buf, "poweroff") == 1) {
            sh_power_verb(history, &buf, 2);
            println("poweroff: platform did not power off");
            continue;
        }
        if (streq(&buf, "halt") == 1) {
            sh_power_verb(history, &buf, 1);
            println("halt: platform did not halt");
            continue;
        }
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        if (streq(&buf, "reboot") == 1 || streq(&buf, "poweroff") == 1 || streq(&buf, "halt") == 1) {
            println("power control is AGNOS-only");
            continue;
        }
        #endif
        if (streq(&buf, "history") == 1) {
            var recent = CommandHistory_get_recent(history, 20);
            var rcount = vec_len(recent);
            if (rcount == 0) {
                println("(history empty)");
            } else {
                for (var i = 0; i < rcount; i = i + 1) {
                    str_print(str_from("  "));
                    str_print(str_from_int(i + 1));
                    str_print(str_from("  "));
                    str_print(vec_get(recent, i));
                    println("");
                }
            }
            continue;
        }
        if (streq(&buf, "help") == 1) {
            println("Built-ins:");
            println("  help                                 show this help");
            println("  version                              show version");
            println("  mode                                 show current mode");
            println("  mode auto|assist|human|strict        switch mode");
            println("  history                              show last 20 commands");
            println("  clear                                clear screen");
            println("  exit, quit                           leave shell (saves history)");
            #ifdef CYRIUS_TARGET_AGNOS
            println("  reboot, poweroff, halt               platform power control");
            #endif
            # The kriya/owl bareword launchers live in run_agnos.cyr, which is
            # entirely #ifdef CYRIUS_TARGET_AGNOS. Advertising them on the host
            # build told the user to type `ls -la` and then silently did nothing
            # but print an intent — `run /abs/path` is the ONLY host exec path.
            #ifdef CYRIUS_TARGET_AGNOS
            println("Files (external /bin tools — type the name to run):");
            println("  cp mv rm ls mkdir rmdir touch echo wc find grep   kriya (/bin/<verb>)");
            println("  owl FILE                             print a file (AGNOS's cat; -p = plain)");
            println("Run:");
            println("  run /abs/path                        run a program from disk");
            println("  <name> [args]                        run /bin/<name> directly");
            println("  cmd1 | cmd2                          two-stage pipeline");
            println("  cmd > file                           redirect stdout to a file");
            println("  prog &                               run in the background");
            #endif
            #ifndef CYRIUS_TARGET_AGNOS
            println("Run:");
            println("  <name> [args]                        run a program found on $PATH");
            println("  run /abs/path [args]                 run a program from disk");
            println("  (pipelines, > redirects and & jobs are AGNOS-only)");
            #endif
            println("Or type a natural-language command.");
            continue;
        }
        if (streq(&buf, "version") == 1) {
            print_version();
            continue;
        }
        if (streq(&buf, "clear") == 1) {
            # ANSI ED + CUP — clear screen + cursor to home (0,0).
            str_print(str_from("\x1b[2J\x1b[H"));
            continue;
        }
        if (streq(&buf, "mode") == 1) {
            str_print(str_from("Current mode: "));
            str_print(str_from(mode_display(cur_mode)));
            println("");
            println("Available: auto, assist, human, strict");
            continue;
        }
        if (cstr_starts_with(&buf, "mode ") == 1) {
            var arg = &buf + 5;
            if (try_mode_switch(mode_mgr, arg) == 1) {
                str_print(str_from("Mode -> "));
                str_print(str_from(mode_display(ModeManager_current(mode_mgr))));
                println("");
            } else {
                str_print(str_from("Unknown mode: "));
                println(arg);
                println("Available: auto, assist, human, strict");
            }
            continue;
        }

        # `run PATH` — launch a program from disk. A first-class builtin, matched
        # before the bareword launcher so an explicit `run` is never confused with
        # a /bin program of the same name. Validates the path here; sh_run_program
        # owns the mode gate + the kernel-gated exec (see RUN_EXECWAIT_READY).
        if (streq(&buf, "run") == 1) {
            eprintln_cstr("usage: run /abs/path/to/program");
            audit_exec_ctx("", "denied", AUDIT_NO_EXIT);
            continue;
        }
        if (cstr_starts_with(&buf, "run ") == 1) {
            var rpath = &buf + 4;
            while (load8(rpath) == 32) { rpath = rpath + 1; }
            if (load8(rpath) == 0) {
                eprintln_cstr("usage: run /abs/path/to/program");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                continue;
            }
            if (load8(rpath) != 47) {
                eprintln_cstr("run: path must be absolute (start with /)");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                continue;
            }
            # A path rejected by is_safe_path is exactly the case an operator
            # most wants in the trail — it is an attempted traversal or a shell
            # metacharacter in a launch path, and before 1.9.2 it left no record.
            if (is_safe_path(rpath) == 0) {
                eprintln_cstr("run: unsafe path (traversal or shell metacharacter)");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                continue;
            }
            sh_run_program(rpath, cur_mode);
            CommandHistory_add(history, &buf);
            continue;
        }

        # File verbs are no longer in-process (1.5.0 delegation). cp/mv/rm/ls/
        # mkdir/rmdir/touch/echo/wc/find/grep are DELEGATED to the staged
        # /bin/kriya dispatcher via the bareword launcher below; `cat` is the one
        # verb with no /bin entry (owl is AGNOS's cat, kriya has none by design)
        # — nudge the user to owl rather than silently dropping `cat` on the NL
        # path. Everything else falls through to sh_try_bareword_launch.
        # agnos-only: owl does not exist on the host, where `cat` is an ordinary
        # line for the NL path (ADR-007). Until 1.9.16 the host printed the hint too.
        #ifdef CYRIUS_TARGET_AGNOS
        if (sh_cat_owl_warning(&buf) == 1) {
            CommandHistory_add(history, &buf);
            continue;
        }
        #endif

        # Bareword program launch (agnos): if the first word resolves to /bin/<word>,
        # run it from disk with its args; a non-binary first word (typo / real NL
        # query) falls through to the NL-intent path below. Restores the burn-1436 UX
        # (`doom` / `bnrmr AGNOS` launch, `brnmr` interprets). agnos-only — the host
        # keeps barewords on the NL path so the smoke tests stay green.
        #ifdef CYRIUS_TARGET_AGNOS
        # `cmd1 | cmd2` pipelines run BEFORE the bareword launcher (whose is_safe_path
        # rejects the '|') and before the NL-intent path. Non-pipeline lines return -1.
        if (sh_try_pipeline_launch(&buf, cur_mode) >= 0) {
            CommandHistory_add(history, &buf);
            continue;
        }
        # `cmd > file` output redirect — after the pipeline split, before the bareword
        # launcher (whose is_safe_path rejects the '>'). Non-redirect lines return -1.
        if (sh_try_redirect_launch(&buf, cur_mode) >= 0) {
            CommandHistory_add(history, &buf);
            continue;
        }
        if (sh_try_bareword_launch(&buf, cur_mode) >= 0) {
            CommandHistory_add(history, &buf);
            continue;
        }
        #endif
        # Shell-first on the host (ADR-007, ADR-008 § 3): `|`, `>` and `&` are shell syntax the host
        # cannot run yet — refused, never natural language — and a bareword that is a program on
        # $PATH runs as that program.
        #ifndef CYRIUS_TARGET_AGNOS
        if (host_refuse_operators(&buf) >= 0) {
            CommandHistory_add(history, &buf);
            continue;
        }
        if (host_try_bareword_launch(&buf, cur_mode) >= 0) {
            CommandHistory_add(history, &buf);
            continue;
        }
        #endif

        # Record every non-builtin input in history. Persists on exit.
        CommandHistory_add(history, &buf);

        # Audit entry carries the actual session mode (vs `-c`'s
        # hardcoded "auto"); a downstream filter on `"mode":"HUMAN"`
        # can now distinguish interactive-human sessions from
        # interactive-auto.
        # The report block, then the command if it may run (ADR-008; src/nlexec.cyr).
        nl_run_interactive(&buf, cur_mode);
    }
    CommandHistory_save(history);
    # History is saved either way — a broken stdin must not also cost the user
    # their history — but the exit status tells the difference.
    if (rl_failed == 1) { return 1; }
    println("bye");
    return 0;
}

fn main() {
    alloc_init();
    args_init();

    var n_args = argc();
    if (n_args < 2) {
        return interactive_loop();
    }

    var arg1 = argv(1);
    if (streq(arg1, "-v") == 1 || streq(arg1, "--version") == 1) {
        print_version();
        return 0;
    }
    if (streq(arg1, "-h") == 1 || streq(arg1, "--help") == 1) {
        print_usage();
        return 0;
    }
    # Leading options before -c, in either order (2.0.0): `--mode NAME` and `--dry-run` / `-n`.
    # --mode lets the one-shot path drive the FIX 4 mode-gated confirm non-interactively (and host
    # smoke tests pipe y/n under a chosen mode); the default for -c stays AUTO. --dry-run classifies
    # and files the report but runs nothing (ADR-008).
    var c_mode = Mode.AI_AUTONOMOUS;
    var c_dry = 0;
    var c_idx = 1;     # index of the -c flag
    var c_opts = 1;
    while (c_opts == 1) {
        if (c_idx >= n_args) {
            c_opts = 0;
        } elif (streq(argv(c_idx), "--mode") == 1) {
            if (c_idx + 1 >= n_args) {
                eprintln_cstr("Error: --mode requires a name (auto|assist|human|strict)");
                return 1;
            }
            # ⛔ FAIL CLOSED. This used to pass Mode.AI_AUTONOMOUS as the fallback,
            # so `--mode assit` (or any typo) silently selected the MOST permissive
            # mode — the one that skips the launch confirmation — while the user
            # believed they had asked for `strict`. A misspelled safety flag must
            # be an error, never a downgrade. The interactive `mode <name>` builtin
            # already rejects unknown names via try_mode_switch; this is the CLI
            # path catching up. Mode values are 0..3, so -1 is a safe sentinel.
            c_mode = mode_from_name(argv(c_idx + 1), 0 - 1);
            if (c_mode == 0 - 1) {
                str_print(str_from("Error: unknown mode '"));
                str_print(str_from(argv(c_idx + 1)));
                println("' (expected auto|assist|human|strict)");
                return 1;
            }
            c_idx = c_idx + 2;
        } elif (streq(argv(c_idx), "--dry-run") == 1 || streq(argv(c_idx), "-n") == 1) {
            c_dry = 1;
            c_idx = c_idx + 1;
        } else {
            c_opts = 0;
        }
    }
    if (c_idx >= n_args) {
        print_usage();
        return 1;
    }
    arg1 = argv(c_idx);
    if (streq(arg1, "-c") == 1 || streq(arg1, "--command") == 1) {
        if (n_args < c_idx + 2) {
            eprintln_cstr("Error: -c requires a command argument");
            return 1;
        }
        var c_cmd = argv(c_idx + 1);
        audit_set_context(c_cmd, mode_display(c_mode));
        # --dry-run runs NOTHING (ADR-008) — not a power verb, not `run`, not a launcher. Every line
        # goes to the classifier, which prints its report: exactly what 1.9.x `-c` printed on the host.
        if (c_dry == 1) { return nl_run_c(c_cmd, c_mode, 1, report_dir()); }
        # ⭐ 1.9.11 — THE POWER VERBS ARE NOW SCRIPTABLE. They existed ONLY in interactive_loop, so
        # `agnsh -c "poweroff"` fell through to print_intent_result and was not a power operation at
        # all. That is also why no smoke could ever drive the agnsh half of the shutdown path: there
        # was no non-interactive way to reach it.
        # ⚠ NO HISTORY SAVE HERE, deliberately: -c is a single command with no session to preserve.
        # The audit record still happens, and for a call that cannot report its own outcome that is
        # the half that matters.
        #ifdef CYRIUS_TARGET_AGNOS
        if (streq(c_cmd, "reboot") == 1) {
            audit_exec_ctx(c_cmd, "launched", AUDIT_NO_EXIT);
            syscall(13, 0x50575231, 0x50575232, 3, 0);
            eprintln_cstr("reboot: platform did not reset");
            return 1;
        }
        if (streq(c_cmd, "poweroff") == 1) {
            audit_exec_ctx(c_cmd, "launched", AUDIT_NO_EXIT);
            syscall(13, 0x50575231, 0x50575232, 2, 0);
            eprintln_cstr("poweroff: platform did not power off");
            return 1;
        }
        if (streq(c_cmd, "halt") == 1) {
            audit_exec_ctx(c_cmd, "launched", AUDIT_NO_EXIT);
            syscall(13, 0x50575231, 0x50575232, 1, 0);
            eprintln_cstr("halt: platform did not halt");
            return 1;
        }
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        if (streq(c_cmd, "reboot") == 1 || streq(c_cmd, "poweroff") == 1 || streq(c_cmd, "halt") == 1) {
            eprintln_cstr("power control is AGNOS-only");
            return 1;
        }
        #endif
        # File verbs are delegated to /bin/kriya via the bareword launcher below
        # (1.5.0); `cat` -> owl nudge (no /bin/cat; owl is AGNOS's cat). agnos-only,
        # as in the interactive loop: the host has no owl (ADR-007).
        #ifdef CYRIUS_TARGET_AGNOS
        if (sh_cat_owl_warning(c_cmd) == 1) { return 0; }
        #endif
        # `run PATH` in one-shot mode (`agnsh -c "run /bin/klug"`). Same
        # validation + kernel gate as the interactive path.
        if (streq(c_cmd, "run") == 1) {
            eprintln_cstr("usage: run /abs/path/to/program");
            audit_exec_ctx("", "denied", AUDIT_NO_EXIT);
            return 1;
        }
        if (cstr_starts_with(c_cmd, "run ") == 1) {
            var rpath = c_cmd + 4;
            while (load8(rpath) == 32) { rpath = rpath + 1; }
            if (load8(rpath) == 0) {
                eprintln_cstr("usage: run /abs/path/to/program");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                return 1;
            }
            if (load8(rpath) != 47) {
                eprintln_cstr("run: path must be absolute (start with /)");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                return 1;
            }
            # Refused by the safety checks: 126, ADR-008 § 4 (it was 1 until 2.0.1 — one of the refusals
            # 2.0.0's move to 126 / 127 missed; the agnos `&`, `|` and `>` launchers were the rest, and
            # followed after 2.0.1).
            if (is_safe_path(rpath) == 0) {
                eprintln_cstr("run: unsafe path (traversal or shell metacharacter)");
                audit_exec_ctx(rpath, "denied", AUDIT_NO_EXIT);
                return EXIT_NOT_RUN;
            }
            return sh_run_program(rpath, c_mode);
        }
        # Bareword program launch in one-shot mode (`agnsh -c "doom /DOOM1.WAD"`),
        # mirroring the interactive arm. agnos-only; -1 falls through to NL-intent.
        #ifdef CYRIUS_TARGET_AGNOS
        var c_pl = sh_try_pipeline_launch(c_cmd, c_mode);   # `cmd1 | cmd2` before bareword
        if (c_pl >= 0) { return c_pl; }
        var c_rd = sh_try_redirect_launch(c_cmd, c_mode);   # `cmd > file` before bareword
        if (c_rd >= 0) { return c_rd; }
        var c_bw = sh_try_bareword_launch(c_cmd, c_mode);
        if (c_bw >= 0) { return c_bw; }
        #endif
        # Shell-first on the host, as in the interactive loop.
        #ifndef CYRIUS_TARGET_AGNOS
        var h_op = host_refuse_operators(c_cmd);
        if (h_op >= 0) { return h_op; }
        var h_bw = host_try_bareword_launch(c_cmd, c_mode);
        if (h_bw >= 0) { return h_bw; }
        #endif
        # -c is one-shot non-interactive; the audit `mode` field reflects the
        # resolved mode label (was hardcoded "auto"; --mode now selects). The report goes to the
        # report folder and stdout stays the program's (ADR-008); the status is the program's, or
        # 126 / 127 when nothing ran.
        return nl_run_c(c_cmd, c_mode, 0, report_dir());
    }

    print_usage();
    return 1;
}

# Bare-call entry (NOT `var exit_code = main();`): on the agnos target a
# `var = main()` top-level makes main a gvar-initializer that runs BEFORE
# cyrius's init-rsp capture (placed after gvar-inits, cyrius 6.1.14), so
# argc()/argv() would read 0/null. A bare statement runs in PARSE_PROG, after
# the capture, so args resolve correctly.
fn _agnos_entry(): i64 {
    var exit_code = main();
    syscall(SYS_EXIT, exit_code);
    return 0;
}
_agnos_entry();
